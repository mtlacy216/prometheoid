                // Add person
                addPerson(event) {
                    event.preventDefault();
                    const form = event.target;
                    
                    // Validate role exists
                    const roleId = parseInt(form.roleId.value);
                    if (!roleId || !this.data.roles.find(r => r.id === roleId)) {
                        this.showNotification('Please select a valid role', 3000);
                        return;
                    }
                    
                    // Check for duplicate email
                    const email = form.email.value.trim().toLowerCase();
                    if (this.data.people.some(p => p.email.toLowerCase() === email)) {
                        this.showNotification('A person with this email already exists', 3000);
                        return;
                    }
                    
                    const newPerson = {
                        id: Date.now(),
                        name: form.name.value.trim(),
                        email: form.email.value.trim(),
                        department: form.department.value.trim(),
                        roleId: roleId,
                        startDate: form.startDate.value,
                        status: 'active',
                        isTemplate: false
                    };
                    
                    this.data.people.push(newPerson);
                    this.data.hasChanges = true;
                    if (this.data.autoSave !== false) this.saveData();
                    this.render();
                    this.updateCounts();
                    this.updateSyncStatus();
                    this.closeModal();
                    this.showNotification(`${newPerson.name} added successfully!`);
                },

                // Add role
                addRole(event) {
                    event.preventDefault();
                    const form = event.target;
                    
                    try {
                        // Get form values
                        const roleName = form.name.value.trim();
                        const roleCode = form.code.value.toUpperCase().trim();
                        
                        // Basic validation
                        if (!roleName) {
                            this.showNotification('Please enter a role name', 3000);
                            return;
                        }
                        
                        if (!roleCode) {
                            this.showNotification('Please enter a role code', 3000);
                            return;
                        }
                        
                        // Ensure arrays are initialized
                        if (!Array.isArray(this.tempResponsibilities)) {
                            console.error('tempResponsibilities is not an array:', this.tempResponsibilities);
                            this.tempResponsibilities = [];
                        }
                        
                        if (!Array.isArray(this.tempOwnership)) {
                            console.error('tempOwnership is not an array:', this.tempOwnership);
                            this.tempOwnership = [];
                        }
                        
                        // Validate that we have at least one responsibility and ownership
                        if (this.tempResponsibilities.length === 0) {
                            this.showNotification('Please add at least one responsibility', 3000);
                            return;
                        }
                        
                        if (this.tempOwnership.length === 0) {
                            this.showNotification('Please add at least one ownership area', 3000);
                            return;
                        }
                        
                        // Check for duplicate role names or codes
                        if (this.data.roles.some(r => r.name.toLowerCase() === roleName.toLowerCase())) {
                            this.showNotification('A role with this name already exists', 3000);
                            return;
                        }
                        
                        if (this.data.roles.some(r => r.code === roleCode)) {
                            this.showNotification('A role with this code already exists', 3000);
                            return;
                        }
                        
                        const newRole = {
                            id: Date.now(),
                            name: roleName,
                            code: roleCode,
                            responsibilities: [...this.tempResponsibilities],
                            ownership: [...this.tempOwnership],
                            isTemplate: false
                        };
                        
                        // Ensure roles array exists
                        if (!Array.isArray(this.data.roles)) {
                            this.data.roles = [];
                        }
                        
                        this.data.roles.push(newRole);
                        this.data.hasChanges = true;
                        if (this.data.autoSave !== false) this.saveData();
                        
                        // Clear temporary lists
                        this.tempResponsibilities = [];
                        this.tempOwnership = [];
                        
                        this.render();
                        this.updateCounts();
                        this.updateSyncStatus();
                        this.closeModal();
                        this.showNotification(`${newRole.name} role created successfully!`);
                    } catch (error) {
                        console.error('Error adding role:', error);
                        this.showNotification('An error occurred while adding the role. Please try again.', 5000);
