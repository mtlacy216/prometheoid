                </div>
                <div style="text-align: center; margin-top: 24px;">
                    <p style="color: var(--text-secondary); font-size: 0.875rem;">
                        Need help creating your data? 
                        <a href="#" class="entity-link" onclick="event.preventDefault(); window.app.showAIAssistFromWelcome()">
                            Use AI Assist →
                        </a>
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- Main App -->
    <div id="mainApp" style="display: none;">
        <header class="app-header">
            <div class="header-content">
                <div class="header-left">
                    <div class="logo">
                        Team Operations <span class="divider">//</span> Archive
                    </div>
                    <span class="org-name-display" id="orgNameDisplay" onclick="window.app.editOrgName()" title="Click to edit organization name">
                        <span id="orgNameText">Unnamed Organization</span>
                    </span>
                    <nav class="nav-tabs">
                        <button class="nav-tab active" onclick="window.app.showView('overview')">Overview</button>
                        <button class="nav-tab" onclick="window.app.showView('people')">People</button>
                        <button class="nav-tab" onclick="window.app.showView('roles')">Roles</button>
                        <button class="nav-tab" onclick="window.app.showView('groups')">Groups</button>
                        <button class="nav-tab" onclick="window.app.showView('flows')">Flows</button>
                        <button class="nav-tab" onclick="window.app.showView('ai-assist')">AI Assist</button>
                    </nav>
                </div>
                <div class="header-right">
                    <div class="sync-status needs-download" id="syncStatus">
                        <span class="sync-indicator"></span>
                        <span id="syncText">No downloads yet</span>
                    </div>
                    <button class="download-btn" onclick="window.app.exportData()" title="Download your data">
                        <span>💾</span>
                        <span>Save</span>
                    </button>
                    <button class="theme-toggle" onclick="window.app.cycleTheme()" title="Change theme">
                        <span id="themeIcon">☀️</span>
                    </button>
                    <button class="settings-btn" onclick="window.app.showSettings()">
                        <span>⚙️</span>
                        Settings
                    </button>
                </div>
            </div>
        </header>

        <div class="container">
            <!-- Overview View -->
            <div id="overview-view" class="view-container active">
                <div class="page-header">
                    <h1 class="page-title">System Overview</h1>
                    <p class="page-description">Current organizational structure and operational flows</p>
                </div>

                <div id="downloadReminder" class="download-info" style="display: none;">
                    <span class="download-info-icon">💡</span>
                    <div>
                        <strong>Remember to save your work!</strong><br>
                        <span id="downloadReminderText"></span>
                    </div>
                </div>

                <div class="download-info" id="aiAssistHint" style="background: rgba(0, 102, 204, 0.1); border-color: var(--accent-blue); display: none;">
                    <span class="download-info-icon">🤖</span>
                    <div>
                        <strong>New to Team Operations Archive?</strong><br>
                        Check out the <a href="#" class="entity-link" onclick="event.preventDefault(); window.app.showView('ai-assist')">AI Assist</a> tab to quickly generate your organizational data using AI!
                    </div>
                    <button class="btn-icon" onclick="document.getElementById('aiAssistHint').style.display='none'" style="margin-left: auto;" title="Dismiss">
                        ×
                    </button>
                </div>

                <div class="grid">
                    <div class="card">
                        <div class="card-header">
                            <div>
                                <h3 class="card-title">Active People</h3>
                                <p class="card-subtitle">Team members in the system</p>
                            </div>
                            <span class="badge badge-blue" id="peopleCount">0</span>
                        </div>
                        <button class="btn-primary" onclick="window.app.showView('people')">
                            View People →
                        </button>
                    </div>

                    <div class="card">
                        <div class="card-header">
                            <div>
                                <h3 class="card-title">Defined Roles</h3>
                                <p class="card-subtitle">Organizational positions</p>
                            </div>
                            <span class="badge badge-green" id="rolesCount">0</span>
                        </div>
                        <button class="btn-primary" onclick="window.app.showView('roles')">
                            View Roles →
                        </button>
                    </div>

                    <div class="card">
                        <div class="card-header">
                            <div>
                                <h3 class="card-title">Role Groups</h3>
                                <p class="card-subtitle">Hierarchical role organization</p>
                            </div>
                            <span class="badge badge-purple" id="groupsCount">0</span>
                        </div>
                        <button class="btn-primary" onclick="window.app.showView('groups')">
                            View Groups →
                        </button>
                    </div>

                    <div class="card">
                        <div class="card-header">
                            <div>
                                <h3 class="card-title">Active Flows</h3>
                                <p class="card-subtitle">Operational connections</p>
                        </div>
                        <span class="badge badge-yellow" id="flowsCount">0</span>
                    </div>
                    <button class="btn-primary" onclick="window.app.showView('flows')">
                        View Flows →
                    </button>
                </div>
            </div>
        </div>

        <!-- People View -->
        <div id="people-view" class="view-container">
            <div class="page-header">
                <h1 class="page-title">People</h1>
                <p class="page-description">Manage team members and their role assignments</p>
            </div>

            <div class="action-bar">
