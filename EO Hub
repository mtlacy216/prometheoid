                    // Ensure the modal system is ready
                    if (!document.getElementById('modal')) {
                        console.error('Modal not ready');
                        return;
                    }
                    
                    this.showModal(`
                        <div class="modal-header">
                            <h2 class="modal-title">Organization Name</h2>
                            <button class="modal-close" onclick="window.app.closeModal()">×</button>
                        </div>
                        <form id="editOrgNameForm" onsubmit="window.app.updateOrgName(event)">
                            <div class="modal-body">
                                <div class="form-group">
                                    <label class="form-label">Organization Name</label>
                                    <input type="text" class="form-input" name="orgName" 
                                           value="${this.data.organizationName}" 
                                           placeholder="Enter organization name" required>
                                    <p style="font-size: 0.75rem; color: var(--text-secondary); margin-top: 8px;">
