    <!-- Modal -->
    <div class="modal" id="modal">
        <div class="modal-content" id="modalContent"></div>
    </div>

    <script>
        // Debug mode
        const DEBUG = false;
        
        // Global error handler for debugging
        window.addEventListener('error', (e) => {
            console.error('Global error:', e.error);
            console.error('Stack:', e.error?.stack);
        });
        
        // Check if functions are available
        window.addEventListener('DOMContentLoaded', () => {
            console.log('Team Operations Archive loaded');
            if (DEBUG) {
                console.log('Debug mode enabled');
            }
        });
        
        // Ensure window.app exists before defining it
        if (typeof window.app === 'undefined') {
            // App object
            window.app = {
                // Data
                data: {
                    organizationName: '',
                    people: [],
                    roles: [],
                    groups: [],
                    flows: [],
                    currentTheme: 'light',
                    autoSave: true,
                    showInactive: false,
                    lastDownloadTime: null,
                    hasChanges: false,
                    originalFileName: null,
                    includesSampleData: false
                },
                
                // Navigation
                currentView: 'overview',
                previousView: 'overview',
                
                // Temporary data for form builders - initialized here
                tempResponsibilities: [],
                tempOwnership: [],
                
                // Theme management
                themes: ['light', 'dark', 'terminal'],
                themeIcons: {
                    light: '☀️',
                    dark: '🌙',
                    terminal: '💻'
                },

                // Initialize
                init() {
                    // Initialize temporary arrays
                    this.tempResponsibilities = [];
                    this.tempOwnership = [];
                    
                    // Ensure data arrays are initialized
                    if (!Array.isArray(this.data.people)) this.data.people = [];
                    if (!Array.isArray(this.data.roles)) this.data.roles = [];
                    if (!Array.isArray(this.data.groups)) this.data.groups = [];
                    if (!Array.isArray(this.data.flows)) this.data.flows = [];
                    
                    // Load theme
                    const savedTheme = localStorage.getItem('appTheme') || 'light';
                    this.setTheme(savedTheme);
                    
                    // Initialize currentView
                    this.currentView = 'overview';
                    this.previousView = 'overview';
                    
                    // Check if there's existing data
                    const savedData = localStorage.getItem('teamOpsData');
                    if (savedData) {
                        try {
                            const parsed = JSON.parse(savedData);
                            this.data = { 
                                ...this.data, 
                                organizationName: parsed.organizationName || '',
                                people: parsed.people || [],
                                roles: parsed.roles || [],
                                groups: parsed.groups || [],
                                flows: parsed.flows || [],
                                autoSave: parsed.autoSave !== undefined ? parsed.autoSave : true,
                                showInactive: parsed.showInactive || false,
                                lastDownloadTime: parsed.lastDownloadTime || null,
                                originalFileName: parsed.originalFileName || null,
                                includesSampleData: parsed.includesSampleData || false
                            };
                            
                            // Show main app directly
                            document.getElementById('welcomeScreen').style.display = 'none';
                            document.getElementById('mainApp').style.display = 'block';
                            
                            // Initialize view state
                            this.currentView = 'overview';
                            this.previousView = 'overview';
                            
                            // Update UI
                            this.updateOrgNameDisplay();
                            this.updateCounts();
                            this.updateSyncStatus();
                            this.render();
                        } catch (e) {
                            console.error('Failed to load saved data:', e);
                            // Reset to defaults if data is corrupted
                            this.data = {
                                organizationName: '',
                                people: [],
                                roles: [],
                                groups: [],
                                flows: [],
                                currentTheme: 'light',
                                autoSave: true,
                                showInactive: false,
                                lastDownloadTime: null,
                                hasChanges: false,
                                originalFileName: null,
                                includesSampleData: false
                            };
                        }
                    }
                    
                    // Track changes
                    setInterval(() => this.updateSyncStatus(), 10000); // Update every 10 seconds
                },

                // Start blank
                startBlank() {
                    // Simple direct approach
                    const result = confirm('Would you like to include sample data to help you get started?\n\nClick OK to include sample data, or Cancel to start with a blank workspace.');
                    
                    if (result) {
                        this.loadSampleData();
                    } else {
                        // Ensure arrays are initialized
                        this.data.people = [];
                        this.data.roles = [];
                        this.data.groups = [];
                        this.data.flows = [];
                    }
                    
                    this.data.includesSampleData = result;
                    this.data.originalFileName = 'team-operations-archive.json';
                    
                    // Save initial state
                    this.saveData();
                    
                    // Show main app
                    document.getElementById('welcomeScreen').style.display = 'none';
                    document.getElementById('mainApp').style.display = 'block';
                    
                    // Initialize view state
                    this.currentView = 'overview';
                    this.previousView = 'overview';
                    
                    // Update UI
                    this.updateOrgNameDisplay();
                    this.updateCounts();
                    this.updateSyncStatus();
                    this.render();
                    
                    if (result) {
                        this.showNotification('Started with sample data. Feel free to modify or delete it!');
                    } else {
                        this.showNotification('Started with a blank workspace!');
                    }
                    
                    // Prompt to set organization name
                    setTimeout(() => {
                        this.editOrgName();
                    }, 1000);
                },

                // Confirm start blank
                confirmStartBlank() {
                    const includeSample = document.getElementById('includeSampleData').checked;
                    
                    if (includeSample) {
                        this.loadSampleData();
                    } else {
                        this.data.people = [];
                        this.data.roles = [];
                        this.data.groups = [];
                        this.data.flows = [];
                    }
                    
                    this.data.includesSampleData = includeSample;
                    this.data.originalFileName = 'team-operations-archive.json';
                    
                    // Save initial state
                    this.saveData();
                    
                    // Show main app
                    document.getElementById('welcomeScreen').style.display = 'none';
                    document.getElementById('mainApp').style.display = 'block';
                    
                    // Update UI
                    this.updateOrgNameDisplay();
                    this.updateCounts();
                    this.updateSyncStatus();
                    this.render();
                    this.currentView = 'overview';
                    this.previousView = 'overview';
                    this.closeModal();
                    
                    if (includeSample) {
                        this.showNotification('Started with sample data. Feel free to modify or delete it!');
                    } else {
                        this.showNotification('Started with a blank workspace!');
                    }
                    
                    // Prompt to set organization name
                    setTimeout(() => {
                        this.editOrgName();
                    }, 500);
                },

                // Upload data
                uploadData() {
                    const input = document.createElement('input');
                    input.type = 'file';
                    input.accept = '.json';
                    input.onchange = (e) => {
                        const file = e.target.files[0];
                        this.data.originalFileName = file.name;
                        
                        const reader = new FileReader();
                        reader.onload = (event) => {
                            try {
                                const imported = JSON.parse(event.target.result);
                                
                                // Handle different data formats
                                if (imported.data) {
                                    this.data.people = imported.data.people || [];
                                    this.data.roles = imported.data.roles || [];
                                    this.data.groups = imported.data.groups || [];
                                    this.data.flows = imported.data.flows || [];
                                } else {
                                    // Direct format
                                    this.data.people = imported.people || [];
                                    this.data.roles = imported.roles || [];
                                    this.data.groups = imported.groups || [];
                                    this.data.flows = imported.flows || [];
                                }
                                
                                // Load organization name if present
                                this.data.organizationName = imported.organizationName || '';
                                
                                // Mark as just downloaded
                                this.data.lastDownloadTime = new Date().toISOString();
                                this.data.hasChanges = false;
                                
                                this.saveData();
                                
                                // Show main app
                                document.getElementById('welcomeScreen').style.display = 'none';
                                document.getElementById('mainApp').style.display = 'block';
                                
                                // Initialize view state
                                this.currentView = 'overview';
                                this.previousView = 'overview';
                                
                                // Update UI
                                this.updateOrgNameDisplay();
                                this.updateCounts();
                                this.updateSyncStatus();
                                this.render();
                                this.currentView = 'overview';
                                this.previousView = 'overview';
                                
                                this.showNotification(`Loaded ${file.name} successfully!`);
                            } catch (error) {
                                this.showNotification('Failed to load file. Please check the format.');
                                console.error('Import error:', error);
                            }
                        };
                        reader.readAsText(file);
                    };
                    input.click();
                },

                // Load sample data
                loadSampleData() {
                    // Initialize arrays if needed
                    if (!Array.isArray(this.data.groups)) this.data.groups = [];
                    if (!Array.isArray(this.data.roles)) this.data.roles = [];
                    if (!Array.isArray(this.data.people)) this.data.people = [];
                    if (!Array.isArray(this.data.flows)) this.data.flows = [];
                    
                    // Create sample groups
                    this.data.groups = [
                        {
                            id: 1,
                            name: "Store Management",
                            roleIds: [1], // Manager role
                            childGroupIds: [],
                            parentId: null,
                            isTemplate: true
                        },
                        {
                            id: 2,
                            name: "Sales Team",
                            roleIds: [2], // Sales Associate role
                            childGroupIds: [],
                            parentId: null,
                            isTemplate: true
                        }
                    ];

                    this.data.roles = [
                        {
                            id: 1,
                            name: "Manager",
                            code: "MGR",
                            responsibilities: ["Oversee daily operations", "Approve discounts", "Set schedules"],
                            ownership: ["Daily reports", "Staff scheduling", "Customer escalations"],
                            isTemplate: true
                        },
                        {
                            id: 2,
                            name: "Sales Associate",
                            code: "SALES",
                            responsibilities: ["Assist customers", "Process transactions", "Maintain store"],
                            ownership: ["Customer service", "POS operations", "Product knowledge"],
                            isTemplate: true
                        }
                    ];

                    this.data.people = [
                        {
                            id: 1,
                            name: "Jane Smith",
                            email: "jane.smith@company.com",
                            roleId: 1,
                            department: "Retail",
                            startDate: "2023-01-15",
                            status: "active",
                            isTemplate: true
                        },
                        {
                            id: 2,
                            name: "John Doe",
                            email: "john.doe@company.com",
                            roleId: 2,
                            department: "Retail",
                            startDate: "2023-03-20",
                            status: "active",
                            isTemplate: true
                        }
                    ];

                    this.data.flows = [
                        {
                            id: 1,
                            roleId: 1,
                            action: "okays",
                            connection: "Approves discounts for",
                            counterpartRoleIds: [2],
                            counterpartRoleNames: ["Sales Associate"],
                            counterpartType: "roles",
                            updated: "2024-01-14",
                            isTemplate: true
                        }
                    ];
                },

                // Navigate to entity
                navigateToEntity(type, id) {
                    if (type === 'role') {
                        this.showRoleProfile(id);
                    } else if (type === 'person') {
                        this.showPersonProfile(id);
                    } else if (type === 'flow') {
                        this.showFlowProfile(id);
                    } else if (type === 'group') {
                        this.showGroupProfile(id);
                    }
                },

                // Show person profile
                showPersonProfile(personId) {
                    const person = this.data.people.find(p => p.id == personId);
                    if (!person) {
                        console.error('Person not found:', personId);
                        return;
                    }

                    const role = this.data.roles.find(r => r.id === person.roleId);
                    const flows = role ? this.data.flows.filter(f => 
                        f.roleId === role.id || 
                        (f.counterpartRoleIds && f.counterpartRoleIds.includes(role.id))
                    ) : [];

                    const content = document.getElementById('personProfileContent');
                    if (!content) {
                        console.error('Person profile content element not found');
                        return;
                    }
                    
                    content.innerHTML = `
                        <div class="profile-header">
                            <h1 class="profile-title">${person.name}</h1>
                            <p class="profile-subtitle">${person.email}</p>
                            <div class="profile-meta">
                                <div class="profile-meta-item">
                                    <span class="profile-meta-label">Status</span>
                                    <span class="profile-meta-value">
                                        <span class="badge badge-${person.status === 'active' ? 'green' : 'red'}">${person.status}</span>
                                    </span>
                                </div>
                                <div class="profile-meta-item">
                                    <span class="profile-meta-label">Department</span>
                                    <span class="profile-meta-value">${person.department}</span>
                                </div>
                                <div class="profile-meta-item">
                                    <span class="profile-meta-label">Start Date</span>
                                    <span class="profile-meta-value">${person.startDate}</span>
                                </div>
                                ${person.isTemplate ? `
                                <div class="profile-meta-item">
                                    <span class="profile-meta-label">Type</span>
                                    <span class="profile-meta-value">
                                        <span class="badge" style="background: var(--bg-tertiary); color: var(--text-tertiary);">SAMPLE DATA</span>
                                    </span>
                                </div>
                                ` : ''}
                            </div>
                        </div>

                        <div class="profile-section">
                            <h2 class="profile-section-title">Role</h2>
                            ${role ? `
                                <div class="card">
                                    <div class="card-header">
                                        <div>
                                            <h3 class="card-title">
                                                <span class="entity-link" onclick="window.app.showRoleProfile(${role.id})">
                                                    ${role.name}
                                                </span>
                                            </h3>
                                            <p class="card-subtitle">${role.code}</p>
                                        </div>
                                    </div>
                                    <div class="info-group">
                                        <div class="info-label">Responsibilities</div>
                                        <ul class="info-list">
                                            ${role.responsibilities.map(r => `<li>${r}</li>`).join('')}
                                        </ul>
                                    </div>
                                    <div class="info-group">
                                        <div class="info-label">Ownership Areas</div>
                                        <ul class="info-list">
                                            ${role.ownership.map(o => `<li>${o}</li>`).join('')}
                                        </ul>
                                    </div>
                                </div>
                            ` : '<p style="color: var(--text-tertiary);">No role assigned</p>'}
                        </div>

                        <div class="profile-section">
                            <h2 class="profile-section-title">Related Flows</h2>
                            ${flows.length > 0 ? flows.map(flow => {
                                const flowRole = this.data.roles.find(r => r.id === flow.roleId);
                                let counterpartDisplay = '';
                                if (flow.counterpartRoleNames && flow.counterpartRoleNames.length > 0) {
                                    if (flow.counterpartRoleNames.length === 1 && flow.counterpartRoleIds[0]) {
                                        counterpartDisplay = `<a href="#" class="entity-link" onclick="event.preventDefault(); window.app.showRoleProfile(${flow.counterpartRoleIds[0]})">${flow.counterpartRoleNames[0]}</a>`;
                                    } else {
                                        counterpartDisplay = `<span style="background: var(--bg-secondary); padding: 2px 8px; border-radius: 4px; font-size: 0.875rem;">${flow.counterpartRoleNames.length} roles</span>`;
                                    }
                                }
                                
                                return `
                                    <div class="card">
                                        <div class="card-header">
                                            <div style="flex: 1;">
                                                <h3 class="card-title">
                                                    <a href="#" class="entity-link" onclick="event.preventDefault(); window.app.showFlowProfile(${flow.id})">
                                                        ${flowRole ? flowRole.name : 'Unknown Role'}
                                                    </a>
                                                </h3>
                                                <p class="card-subtitle">
                                                    <span class="badge badge-${flow.action}">${flow.action}</span>
                                                    ${flow.connection} ${counterpartDisplay}
                                                </p>
                                            </div>
                                        </div>
                                    </div>
                                `;
                            }).join('') : '<p style="color: var(--text-tertiary);">No related flows</p>'}
                        </div>

                        <div style="display: flex; gap: calc(var(--spacing) * 2); justify-content: flex-end;">
                            <button class="btn-secondary" onclick="window.app.editPerson(${person.id})">
                                Edit Person
                            </button>
                            <button class="btn-secondary btn-danger" onclick="if(confirm('Delete ${person.name}?')) { window.app.deletePerson(${person.id}); window.app.goBack(); }">
                                Delete Person
                            </button>
                        </div>
                    `;

                    this.showView('person-profile');
                    
                    // Ensure content is visible
                    setTimeout(() => {
                        const profileView = document.getElementById('person-profile-view');
                        if (profileView && !profileView.classList.contains('active')) {
                            console.error('Profile view not active, forcing activation');
                            profileView.classList.add('active');
                        }
                    }, 100);
                },

                // Show role profile
                showRoleProfile(roleId) {
                    const role = this.data.roles.find(r => r.id == roleId);
                    if (!role) {
                        console.error('Role not found:', roleId);
                        return;
                    }

                    const people = this.data.people.filter(p => p.roleId === role.id);
                    const flows = this.data.flows.filter(f => 
                        f.roleId === role.id || 
                        (f.counterpartRoleIds && f.counterpartRoleIds.includes(role.id))
                    );
                    const groups = this.data.groups.filter(g => g.roleIds.includes(role.id));

                    const content = document.getElementById('roleProfileContent');
                    content.innerHTML = `
                        <div class="profile-header">
                            <h1 class="profile-title">${role.name}</h1>
                            <p class="profile-subtitle">${role.code}</p>
                            <div class="profile-meta">
                                <div class="profile-meta-item">
                                    <span class="profile-meta-label">People in Role</span>
                                    <span class="profile-meta-value">${people.length}</span>
                                </div>
                                <div class="profile-meta-item">
                                    <span class="profile-meta-label">Related Flows</span>
                                    <span class="profile-meta-value">${flows.length}</span>
                                </div>
                                <div class="profile-meta-item">
                                    <span class="profile-meta-label">Groups</span>
                                    <span class="profile-meta-value">${groups.length}</span>
                                </div>
                                ${role.isTemplate ? `
                                <div class="profile-meta-item">
                                    <span class="profile-meta-label">Type</span>
                                    <span class="profile-meta-value">
                                        <span class="badge" style="background: var(--bg-tertiary); color: var(--text-tertiary);">SAMPLE DATA</span>
                                    </span>
                                </div>
                                ` : ''}
                            </div>
                        </div>

                        <div class="profile-section">
