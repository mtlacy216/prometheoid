                // Add group
                addGroup(event) {
                    event.preventDefault();
                    const form = event.target;
                    
                    const groupName = form.name.value.trim();
                    
                    // Check for duplicate group names
                    if (this.data.groups.some(g => g.name.toLowerCase() === groupName.toLowerCase())) {
                        this.showNotification('A group with this name already exists', 3000);
                        return;
                    }
                    
                    // Get selected roles
                    const selectedRoles = Array.from(form.roleIds.selectedOptions).map(option => parseInt(option.value));
                    
                    // Get selected child groups
                    const selectedChildGroups = Array.from(form.childGroupIds.selectedOptions).map(option => parseInt(option.value));
                    
                    const parentId = form.parentId.value ? parseInt(form.parentId.value) : null;
                    
                    // Check for circular references
                    if (parentId && selectedChildGroups.includes(parentId)) {
                        this.showNotification('A group cannot be both parent and child of another group', 3000);
                        return;
                    }
                    
                    const newGroup = {
                        id: Date.now(),
                        name: groupName,
                        roleIds: selectedRoles,
                        childGroupIds: selectedChildGroups,
                        parentId: parentId,
                        isTemplate: false
                    };
                    
                    // Add the new group
                    this.data.groups.push(newGroup);
                    
                    // If this group has a parent, add it to the parent's childGroupIds
                    if (newGroup.parentId) {
                        const parent = this.data.groups.find(g => g.id === newGroup.parentId);
                        if (parent && !parent.childGroupIds.includes(newGroup.id)) {
                            parent.childGroupIds.push(newGroup.id);
                        }
                    }
                    
                    // Update any child groups to have this as their parent
                    selectedChildGroups.forEach(childId => {
                        const child = this.data.groups.find(g => g.id === childId);
                        if (child) {
                            // Remove from old parent if exists
                            if (child.parentId) {
                                const oldParent = this.data.groups.find(g => g.id === child.parentId);
                                if (oldParent) {
                                    const index = oldParent.childGroupIds.indexOf(childId);
                                    if (index > -1) {
                                        oldParent.childGroupIds.splice(index, 1);
                                    }
                                }
                            }
                            child.parentId = newGroup.id;
                        }
                    });
                    
                    this.data.hasChanges = true;
                    if (this.data.autoSave !== false) this.saveData();
                    this.render();
                    this.updateCounts();
                    this.updateSyncStatus();
                    this.closeModal();
                    this.showNotification(`${newGroup.name} group created successfully!`);
                },

                // Add flow
                addFlow(event) {
                    event.preventDefault();
                    const form = event.target;
                    
                    const roleId = parseInt(form.roleId.value);
                    
                    // Validate role exists
                    if (!roleId || !this.data.roles.find(r => r.id === roleId)) {
                        this.showNotification('Please select a valid role', 3000);
                        return;
                    }
                    
                    // Validate action is selected
                    if (!form.action.value) {
                        this.showNotification('Please select an action type', 3000);
                        return;
                    }
                    
                    // Get selected counterpart roles
                    const selectedOptions = Array.from(form.counterpartRoles.selectedOptions);
                    const counterpartRoleIds = selectedOptions.map(option => parseInt(option.value));
                    const counterpartRoleNames = selectedOptions.map(option => option.text);
                    
                    // Check if role is trying to connect to itself
                    if (counterpartRoleIds.includes(roleId)) {
                        this.showNotification('A role cannot create a flow to itself. Please select different counterpart roles.', 3000);
                        return;
                    }
                    
                    const newFlow = {
                        id: Date.now(),
                        roleId: roleId,
                        action: form.action.value,
                        connection: form.connection.value.trim(),
                        counterpartRoleIds: counterpartRoleIds,
                        counterpartRoleNames: counterpartRoleNames,
                        counterpartType: 'roles',
                        updated: new Date().toISOString().substring(0, 10),
                        isTemplate: false
                    };
                    
                    this.data.flows.push(newFlow);
                    this.data.hasChanges = true;
                    if (this.data.autoSave !== false) this.saveData();
                    this.render();
                    this.updateCounts();
                    this.updateSyncStatus();
                    this.closeModal();
                    this.showNotification('Flow created successfully!');
                },

                // Save data
                saveData() {
                    localStorage.setItem('teamOpsData', JSON.stringify({
                        organizationName: this.data.organizationName,
                        people: this.data.people,
                        roles: this.data.roles,
                        groups: this.data.groups,
                        flows: this.data.flows,
                        autoSave: this.data.autoSave,
                        showInactive: this.data.showInactive,
                        lastDownloadTime: this.data.lastDownloadTime,
                        originalFileName: this.data.originalFileName,
                        includesSampleData: this.data.includesSampleData
                    }));
                    localStorage.setItem('lastSaveTime', new Date().toISOString());
                },

                // Export data
                exportData() {
                    const data = {
                        version: "1.0.0",
                        exported: new Date().toISOString(),
                        organizationName: this.data.organizationName,
                        theme: this.data.currentTheme,
                        data: {
                            people: this.data.people,
                            roles: this.data.roles,
                            groups: this.data.groups,
                            flows: this.data.flows
                        }
                    };
                    const blob = new Blob([JSON.stringify(data, null, 2)], {type: 'application/json'});
                    const url = URL.createObjectURL(blob);
                    const a = document.createElement('a');
                    a.href = url;
                    
                    // Use original filename if available
                    a.download = this.data.originalFileName || 'team-operations-archive.json';
                    
                    a.click();
                    URL.revokeObjectURL(url);
                    
                    // Update last download time and clear changes flag
                    this.data.lastDownloadTime = new Date().toISOString();
                    this.data.hasChanges = false;
                    this.saveData();
                    this.updateSyncStatus();
                    
                    const message = this.data.originalFileName 
                        ? `Saved! Replace the original "${this.data.originalFileName}" file to keep your changes.`
                        : 'Data exported successfully!';
                    this.showNotification(message, 5000);
                },

