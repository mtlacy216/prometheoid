                                <input type="email" class="form-input" name="email" value="${person.email}" required>
                            </div>
                            <div class="form-group">
                                <label class="form-label">Department</label>
                                <input type="text" class="form-input" name="department" value="${person.department}" required>
                            </div>
                            <div class="form-group">
                                <label class="form-label">Role</label>
                                <select class="form-select" name="roleId" required>
                                    <option value="">Select a role</option>
                                    ${roleOptions}
                                </select>
                            </div>
                            <div class="form-group">
                                <label class="form-label">Status</label>
                                <select class="form-select" name="status" required>
                                    <option value="active" ${person.status === 'active' ? 'selected' : ''}>Active</option>
                                    <option value="inactive" ${person.status === 'inactive' ? 'selected' : ''}>Inactive</option>
                                </select>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn-secondary" onclick="window.app.closeModal()">Cancel</button>
                            <button type="submit" class="btn-primary">Update Person</button>
                        </div>
                    </form>
                `);
            },
            
            // Update person
            updatePerson(event, personId) {
                event.preventDefault();
                const form = event.target;
                const personIndex = this.data.people.findIndex(p => p.id === personId);
                if (personIndex === -1) return;
                
                this.data.people[personIndex] = {
                    ...this.data.people[personIndex],
                    name: form.name.value,
                    email: form.email.value,
                    department: form.department.value,
                    roleId: parseInt(form.roleId.value),
                    status: form.status.value,
                    isTemplate: false  // Once edited, no longer template data
                };
                
                this.data.hasChanges = true;
                if (this.data.autoSave !== false) this.saveData();
                
                // Refresh profile if we're viewing it
                if (this.currentView === 'person-profile') {
                    this.showPersonProfile(personId);
                } else {
                    this.render();
                }
                
                this.updateSyncStatus();
                this.closeModal();
                this.showNotification('Person updated successfully!');
            },
            
            // Delete role
            deleteRole(roleId) {
                const role = this.data.roles.find(r => r.id === roleId);
                if (!role) return;
                
                const peopleInRole = this.data.people.filter(p => p.roleId === roleId);
                const flowsWithRole = this.data.flows.filter(f => 
                    f.roleId === roleId || 
                    (f.counterpartRoleIds && f.counterpartRoleIds.includes(roleId))
                );
                
                let warningMessage = `Are you sure you want to delete the "${role.name}" role?`;
                if (peopleInRole.length > 0) {
                    warningMessage += `\n\nThis will unassign ${peopleInRole.length} people from this role.`;
                }
                if (flowsWithRole.length > 0) {
                    warningMessage += `\n\nThis will affect ${flowsWithRole.length} flows.`;
                }
                
                if (confirm(warningMessage)) {
                    // Unassign people from this role
                    this.data.people.forEach(person => {
                        if (person.roleId === roleId) {
                            person.roleId = null;
                        }
                    });
                    
                    // Remove role from flows
                    this.data.flows = this.data.flows.filter(f => f.roleId !== roleId);
                    this.data.flows.forEach(flow => {
                        if (flow.counterpartRoleIds) {
                            const index = flow.counterpartRoleIds.indexOf(roleId);
                            if (index > -1) {
                                flow.counterpartRoleIds.splice(index, 1);
                                flow.counterpartRoleNames.splice(index, 1);
                            }
                        }
                    });
                    
                    // Delete the role
                    this.data.roles = this.data.roles.filter(r => r.id !== roleId);
                    
                    this.data.hasChanges = true;
                    if (this.data.autoSave !== false) this.saveData();
                    
                    // If we're on the role's profile, go back
                    if (this.currentView === 'role-profile') {
                        this.goBack();
                    }
                    
                    this.render();
                    this.updateCounts();
                    this.updateSyncStatus();
                    this.showNotification(`${role.name} role deleted successfully!`);
                }
            },
            
            // Edit role
            editRole(roleId) {
                const role = this.data.roles.find(r => r.id === roleId);
                if (!role) return;

                this.showModal(`
                    <div class="modal-header">
                        <h2 class="modal-title">Edit Role</h2>
                        <button class="modal-close" onclick="window.app.closeModal()">×</button>
                    </div>
                    <form id="editRoleForm" onsubmit="window.app.updateRole(event, ${roleId})">
                        <div class="modal-body">
                            <div class="form-group">
                                <label class="form-label">Role Name</label>
                                <input type="text" class="form-input" name="name" value="${role.name}" required>
                            </div>
                            <div class="form-group">
                                <label class="form-label">Role Code</label>
                                <input type="text" class="form-input" name="code" value="${role.code}" required>
                            </div>
                            <div class="form-group">
                                <label class="form-label">Responsibilities (one per line)</label>
                                <textarea class="form-textarea" name="responsibilities" required>${role.responsibilities.join('\n')}</textarea>
                            </div>
                            <div class="form-group">
                                <label class="form-label">Ownership Areas (one per line)</label>
                                <textarea class="form-textarea" name="ownership" required>${role.ownership.join('\n')}</textarea>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn-secondary" onclick="window.app.closeModal()">Cancel</button>
                            <button type="submit" class="btn-primary">Update Role</button>
                        </div>
                    </form>
                `);
            },
            
            // Update role
            updateRole(event, roleId) {
                event.preventDefault();
                const form = event.target;
                const roleIndex = this.data.roles.findIndex(r => r.id === roleId);
                if (roleIndex === -1) return;
                
                const oldName = this.data.roles[roleIndex].name;
                const newName = form.name.value;
                
                this.data.roles[roleIndex] = {
                    ...this.data.roles[roleIndex],
                    name: newName,
                    code: form.code.value.toUpperCase(),
                    responsibilities: form.responsibilities.value.split('\n').filter(r => r.trim()),
                    ownership: form.ownership.value.split('\n').filter(o => o.trim()),
                    isTemplate: false  // Once edited, no longer template data
                };
                
                // Update flow counterpart names if role name changed
                if (oldName !== newName) {
                    this.data.flows.forEach(flow => {
                        if (flow.counterpartRoleIds && flow.counterpartRoleIds.includes(roleId)) {
                            const index = flow.counterpartRoleIds.indexOf(roleId);
                            if (index > -1 && flow.counterpartRoleNames) {
                                flow.counterpartRoleNames[index] = newName;
                            }
                        }
                    });
                }
                
                this.data.hasChanges = true;
                if (this.data.autoSave !== false) this.saveData();
                
                // Refresh profile if we're viewing it
                if (this.currentView === 'role-profile') {
                    this.showRoleProfile(roleId);
                } else {
                    this.render();
                }
                
                this.updateSyncStatus();
                this.closeModal();
                this.showNotification('Role updated successfully!');
            },

            // Group management
            createGroup(name, parentGroupId = null) {
                const newGroup = {
                    id: Date.now(),
                    name,
                    roleIds: [],
                    childGroupIds: [],
                    parentId: parentGroupId
                };
                this.data.groups.push(newGroup);
                if (parentGroupId) {
                    const parent = this.data.groups.find(g => g.id === parentGroupId);
                    if (parent && !parent.childGroupIds.includes(newGroup.id)) {
                        parent.childGroupIds.push(newGroup.id);
                    }
                }
                this.data.hasChanges = true;
                if (this.data.autoSave !== false) this.saveData();
                return newGroup.id;
            },

            addRoleToGroup(roleId, groupId) {
                const group = this.data.groups.find(g => g.id === groupId);
                if (!group) return;
                if (!group.roleIds.includes(roleId)) {
                    group.roleIds.push(roleId);
                    this.data.hasChanges = true;
                    if (this.data.autoSave !== false) this.saveData();
                }
            },

            addGroupToGroup(childGroupId, parentGroupId) {
                const child = this.data.groups.find(g => g.id === childGroupId);
                const parent = this.data.groups.find(g => g.id === parentGroupId);
                if (!child || !parent) return;
                // prevent circular nesting
                let current = parent;
                while (current) {
                    if (current.id === childGroupId) return;
                    current = this.data.groups.find(g => g.id === current.parentId);
                }
                child.parentId = parentGroupId;
                if (!parent.childGroupIds.includes(childGroupId)) {
                    parent.childGroupIds.push(childGroupId);
                }
                this.data.hasChanges = true;
                if (this.data.autoSave !== false) this.saveData();
            },

            // Delete flow
            deleteFlow(flowId) {
                if (confirm('Are you sure you want to delete this flow?')) {
                    this.data.flows = this.data.flows.filter(f => f.id !== flowId);
                    this.data.hasChanges = true;
                    if (this.data.autoSave !== false) this.saveData();
                    
                    // If we're on the flow's profile, go back
                    if (this.currentView === 'flow-profile') {
                        this.goBack();
                    }
                    
                    this.render();
                    this.updateCounts();
                    this.updateSyncStatus();
                    this.closeModal();
                    this.showNotification('Flow deleted successfully!');
                }
            },
            
            // Get last save time
            getLastSaveTime() {
                const lastSave = localStorage.getItem('lastSaveTime');
                if (!lastSave) return 'Never';
                
                const date = new Date(lastSave);
                const now = new Date();
                const diff = now - date;
                
                if (diff < 60000) return 'Just now';
                if (diff < 3600000) return `${Math.floor(diff / 60000)} minutes ago`;
                if (diff < 86400000) return `${Math.floor(diff / 3600000)} hours ago`;
                return date.toLocaleDateString();
            },
            
            // Copy to clipboard
            copyToClipboard(elementId) {
                const element = document.getElementById(elementId);
                if (!element) return;
                
                const text = element.textContent || element.innerText;
                
                // Try modern clipboard API first
                if (navigator.clipboard && navigator.clipboard.writeText) {
                    navigator.clipboard.writeText(text)
                        .then(() => this.showNotification('Copied to clipboard!'))
                        .catch(() => this.fallbackCopyToClipboard(text));
                } else {
                    this.fallbackCopyToClipboard(text);
                }
            },
            
            // Fallback copy method
            fallbackCopyToClipboard(text) {
                const textArea = document.createElement('textarea');
                textArea.value = text;
                textArea.style.position = 'fixed';
                textArea.style.left = '-999999px';
                document.body.appendChild(textArea);
                textArea.focus();
                textArea.select();
                
                try {
                    document.execCommand('copy');
                    this.showNotification('Copied to clipboard!');
                } catch (err) {
                    this.showNotification('Failed to copy. Please select and copy manually.');
                }
                
                document.body.removeChild(textArea);
            }
        };

        // Initialize app when DOM is ready
        document.addEventListener('DOMContentLoaded', () => {
            try {
                window.app.init();
                console.log('Team Operations Archive initialized');
            } catch (error) {
                console.error('Failed to initialize app:', error);
            }
        });
        
        // Ensure modal works on click
        window.addEventListener('load', () => {
            const modal = document.getElementById('modal');
            if (modal) {
                modal.addEventListener('click', (e) => {
                    if (e.target === modal) {
                        window.app.closeModal();
                    }
                });
            }
        });
    </script>
</body>
</html>
