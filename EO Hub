                    let html = '<div class="group-tree">';
                    
                    // Roles in this group
                    const roles = this.data.roles.filter(r => group.roleIds.includes(r.id));
                    if (roles.length > 0) {
                        html += '<div style="margin-bottom: 8px;">';
                        roles.slice(0, 3).forEach(role => {
                            html += `<div class="group-tree-item">
                                <span class="group-icon">👤</span>
                                <span style="font-size: 0.875rem;">${role.name}</span>
                            </div>`;
                        });
                        if (roles.length > 3) {
                            html += `<div class="group-tree-item" style="color: var(--text-tertiary);">
                                <span class="group-icon">...</span>
                                <span style="font-size: 0.875rem;">and ${roles.length - 3} more roles</span>
                            </div>`;
                        }
                        html += '</div>';
                    }
                    
                    // Child groups
                    const childGroups = this.data.groups.filter(g => group.childGroupIds.includes(g.id));
                    if (childGroups.length > 0) {
                        childGroups.slice(0, 2).forEach(childGroup => {
                            html += `<div class="group-tree-item">
                                <span class="group-icon">📁</span>
                                <span style="font-size: 0.875rem;">${childGroup.name}</span>
