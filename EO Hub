                                        <button type="button" class="btn-primary" onclick="window.app.addTempResponsibility()" style="padding: 8px 16px;">Add</button>
                                    </div>
                                    <div id="responsibilitiesList" style="background: var(--bg-secondary); border-radius: 4px; padding: 8px; min-height: 60px;">
                                        ${this.tempResponsibilities.map((r, i) => `
                                            <div style="display: flex; justify-content: space-between; align-items: center; padding: 4px 8px; margin: 4px 0; background: var(--bg-primary); border-radius: 4px;">
                                                <span>${this.escapeHtml(r)}</span>
                                                <button type="button" class="btn-icon btn-danger" onclick="window.app.removeTempResponsibility(${i})" style="width: 24px; height: 24px; padding: 0;">×</button>
                                            </div>
                                        `).join('')}
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="form-label">Ownership Areas <span style="color: var(--accent-red);">*</span></label>
                                    <div style="display: flex; gap: 8px; margin-bottom: 8px;">
                                        <input type="text" class="form-input" id="newOwnership" placeholder="Add an ownership area...">
                                        <button type="button" class="btn-primary" onclick="window.app.addTempOwnership()" style="padding: 8px 16px;">Add</button>
                                    </div>
                                    <div id="ownershipList" style="background: var(--bg-secondary); border-radius: 4px; padding: 8px; min-height: 60px;">
                                        ${this.tempOwnership.map((o, i) => `
                                            <div style="display: flex; justify-content: space-between; align-items: center; padding: 4px 8px; margin: 4px 0; background: var(--bg-primary); border-radius: 4px;">
                                                <span>${this.escapeHtml(o)}</span>
                                                <button type="button" class="btn-icon btn-danger" onclick="window.app.removeTempOwnership(${i})" style="width: 24px; height: 24px; padding: 0;">×</button>
                                            </div>
                                        `).join('')}
                                    </div>
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn-secondary" onclick="window.app.closeModal()">Cancel</button>
                                <button type="submit" class="btn-primary">Update Role</button>
                            </div>
                        </form>
                    `);
                    
                    // Add enter key support with delay to ensure DOM is ready
                    setTimeout(() => {
                        const respInput = document.getElementById('newResponsibility');
                        if (respInput) {
                            respInput.addEventListener('keypress', (e) => {
                                if (e.key === 'Enter') {
                                    e.preventDefault();
                                    this.addTempResponsibility();
                                }
                            });
                        }
                        
                        const ownInput = document.getElementById('newOwnership');
                        if (ownInput) {
                            ownInput.addEventListener('keypress', (e) => {
                                if (e.key === 'Enter') {
                                    e.preventDefault();
                                    this.addTempOwnership();
                                }
                            });
                        }
                    }, 100);
                },
                
                // Update role
                updateRole(event, roleId) {
                    event.preventDefault();
                    const form = event.target;
                    const roleIndex = this.data.roles.findIndex(r => r.id === roleId);
                    if (roleIndex === -1) return;
                    
                    try {
                        // Ensure arrays are initialized
                        if (!Array.isArray(this.tempResponsibilities)) {
                            console.error('tempResponsibilities is not an array during update:', this.tempResponsibilities);
                            this.tempResponsibilities = [];
                        }
                        
                        if (!Array.isArray(this.tempOwnership)) {
                            console.error('tempOwnership is not an array during update:', this.tempOwnership);
                            this.tempOwnership = [];
                        }
                        
                        // Validate that we have at least one responsibility and ownership
                        if (this.tempResponsibilities.length === 0) {
                            this.showNotification('Please add at least one responsibility', 3000);
                            return;
                        }
                        
                        if (this.tempOwnership.length === 0) {
                            this.showNotification('Please add at least one ownership area', 3000);
                            return;
                        }
                        
                        const oldName = this.data.roles[roleIndex].name;
                        const newName = form.name.value.trim();
                        const newCode = form.code.value.toUpperCase().trim();
                        
                        // Check for duplicate names/codes (excluding current role)
                        if (this.data.roles.some(r => r.id !== roleId && r.name.toLowerCase() === newName.toLowerCase())) {
                            this.showNotification('A role with this name already exists', 3000);
                            return;
                        }
                        
                        if (this.data.roles.some(r => r.id !== roleId && r.code === newCode)) {
                            this.showNotification('A role with this code already exists', 3000);
                            return;
                        }
                        
                        this.data.roles[roleIndex] = {
                            ...this.data.roles[roleIndex],
                            name: newName,
                            code: newCode,
                            responsibilities: [...this.tempResponsibilities],
                            ownership: [...this.tempOwnership],
                            isTemplate: false  // Once edited, no longer template data
                        };
                        
                        // Update flow counterpart names if role name changed
                        if (oldName !== newName) {
                            this.data.flows.forEach(flow => {
                                if (flow.counterpartRoleIds && flow.counterpartRoleIds.includes(roleId)) {
                                    const index = flow.counterpartRoleIds.indexOf(roleId);
                                    if (index > -1 && flow.counterpartRoleNames) {
                                        flow.counterpartRoleNames[index] = newName;
                                    }
                                }
                            });
                        }
                        
                        // Clear temporary lists
                        this.tempResponsibilities = [];
                        this.tempOwnership = [];
                        
                        this.data.hasChanges = true;
                        if (this.data.autoSave !== false) this.saveData();
                        
                        // Refresh profile if we're viewing it
                        if (this.currentView === 'role-profile') {
                            this.showRoleProfile(roleId);
                        } else {
                            this.render();
                        }
                        
                        this.updateSyncStatus();
                        this.closeModal();
                        this.showNotification('Role updated successfully!');
                    } catch (error) {
                        console.error('Error updating role:', error);
                        this.showNotification('An error occurred while updating the role. Please try again.', 5000);
                    }
                },

                // Edit group
                editGroup(groupId) {
                    const group = this.data.groups.find(g => g.id === groupId);
                    if (!group) return;
                    
                    const roleOptions = this.data.roles.map(r => {
                        const isSelected = group.roleIds.includes(r.id);
                        return `<option value="${r.id}" ${isSelected ? 'selected' : ''}>${r.name}</option>`;
                    }).join('');
                    
                    const groupOptions = this.data.groups
                        .filter(g => g.id !== groupId) // Can't be its own parent
                        .map(g => `<option value="${g.id}" ${g.id === group.parentId ? 'selected' : ''}>${g.name}</option>`)
                        .join('');
                    
                    const childGroupOptions = this.data.groups
                        .filter(g => g.id !== groupId && !this.wouldCreateCircularReference(g.id, groupId))
                        .map(g => {
                            const isSelected = group.childGroupIds.includes(g.id);
                            return `<option value="${g.id}" ${isSelected ? 'selected' : ''}>${g.name}</option>`;
                        }).join('');

                    this.showModal(`
                        <div class="modal-header">
                            <h2 class="modal-title">Edit Group</h2>
                            <button class="modal-close" onclick="window.app.closeModal()">×</button>
                        </div>
                        <form id="editGroupForm" onsubmit="window.app.updateGroup(event, ${groupId})">
                            <div class="modal-body">
                                <div class="form-group">
                                    <label class="form-label">Group Name</label>
                                    <input type="text" class="form-input" name="name" value="${group.name}" required>
                                </div>
                                <div class="form-group">
                                    <label class="form-label">Parent Group (Optional)</label>
                                    <select class="form-select" name="parentId">
                                        <option value="">No parent (top-level group)</option>
                                        ${groupOptions}
                                    </select>
                                </div>
                                <div class="form-group">
                                    <label class="form-label">Roles in this Group</label>
                                    <select class="form-select" name="roleIds" multiple style="height: 150px;">
                                        ${roleOptions}
                                    </select>
                                    <p style="font-size: 0.75rem; color: var(--text-secondary); margin-top: 8px;">
                                        Hold Ctrl (or Cmd on Mac) to select multiple roles
                                    </p>
                                </div>
                                <div class="form-group">
                                    <label class="form-label">Sub-groups (Optional)</label>
                                    <select class="form-select" name="childGroupIds" multiple style="height: 120px;">
                                        ${childGroupOptions}
                                    </select>
                                    <p style="font-size: 0.75rem; color: var(--text-secondary); margin-top: 8px;">
                                        Hold Ctrl (or Cmd on Mac) to select multiple sub-groups
                                    </p>
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn-secondary" onclick="window.app.closeModal()">Cancel</button>
                                <button type="submit" class="btn-primary">Update Group</button>
                            </div>
                        </form>
                    `);
                },
                
                // Check if adding a child would create circular reference
                wouldCreateCircularReference(childId, potentialParentId) {
                    let current = this.data.groups.find(g => g.id === childId);
                    while (current) {
                        if (current.id === potentialParentId) return true;
                        current = current.parentId ? this.data.groups.find(g => g.id === current.parentId) : null;
                    }
                    return false;
                },
                
                // Update group
                updateGroup(event, groupId) {
                    event.preventDefault();
                    const form = event.target;
                    const groupIndex = this.data.groups.findIndex(g => g.id === groupId);
                    if (groupIndex === -1) return;
                    
                    const oldGroup = this.data.groups[groupIndex];
                    
                    // Get selected values
                    const selectedRoles = Array.from(form.roleIds.selectedOptions).map(option => parseInt(option.value));
                    const selectedChildGroups = Array.from(form.childGroupIds.selectedOptions).map(option => parseInt(option.value));
                    const newParentId = form.parentId.value ? parseInt(form.parentId.value) : null;
                    
                    // Update the group
                    this.data.groups[groupIndex] = {
                        ...oldGroup,
                        name: form.name.value,
                        roleIds: selectedRoles,
                        childGroupIds: selectedChildGroups,
                        parentId: newParentId,
                        isTemplate: false  // Once edited, no longer template data
                    };
                    
                    // Update parent relationships
                    if (oldGroup.parentId !== newParentId) {
                        // Remove from old parent
                        if (oldGroup.parentId) {
                            const oldParent = this.data.groups.find(g => g.id === oldGroup.parentId);
                            if (oldParent) {
                                const index = oldParent.childGroupIds.indexOf(groupId);
                                if (index > -1) {
                                    oldParent.childGroupIds.splice(index, 1);
                                }
                            }
                        }
                        
                        // Add to new parent
                        if (newParentId) {
                            const newParent = this.data.groups.find(g => g.id === newParentId);
                            if (newParent && !newParent.childGroupIds.includes(groupId)) {
                                newParent.childGroupIds.push(groupId);
                            }
                        }
                    }
                    
                    // Update child group parent references
                    selectedChildGroups.forEach(childId => {
                        const child = this.data.groups.find(g => g.id === childId);
                        if (child) {
                            child.parentId = groupId;
                        }
                    });
                    
                    // Remove parent reference from groups no longer children
                    oldGroup.childGroupIds.forEach(oldChildId => {
                        if (!selectedChildGroups.includes(oldChildId)) {
                            const child = this.data.groups.find(g => g.id === oldChildId);
                            if (child && child.parentId === groupId) {
                                child.parentId = null;
                            }
                        }
                    });
                    
                    this.data.hasChanges = true;
                    if (this.data.autoSave !== false) this.saveData();
                    
                    // Refresh profile if we're viewing it
                    if (this.currentView === 'group-profile') {
                        this.showGroupProfile(groupId);
                    } else {
                        this.render();
                    }
                    
                    this.updateSyncStatus();
                    this.closeModal();
                    this.showNotification('Group updated successfully!');
                },
                
                // Delete group
                deleteGroup(groupId) {
                    const group = this.data.groups.find(g => g.id === groupId);
                    if (!group) return;
                    
                    let warningMessage = `Are you sure you want to delete the "${group.name}" group?`;
                    warningMessage += '\n\nThis will not delete the roles or sub-groups within it.';
                    
                    if (confirm(warningMessage)) {
                        // Remove this group from its parent's childGroupIds
                        if (group.parentId) {
                            const parent = this.data.groups.find(g => g.id === group.parentId);
                            if (parent) {
                                const index = parent.childGroupIds.indexOf(groupId);
                                if (index > -1) {
                                    parent.childGroupIds.splice(index, 1);
                                }
                            }
                        }
                        
                        // Set child groups' parentId to null
                        group.childGroupIds.forEach(childId => {
                            const child = this.data.groups.find(g => g.id === childId);
                            if (child) {
                                child.parentId = null;
                            }
                        });
                        
                        // Delete the group
                        this.data.groups = this.data.groups.filter(g => g.id !== groupId);
                        
                        this.data.hasChanges = true;
                        if (this.data.autoSave !== false) this.saveData();
                        
                        // If we're on the group's profile, go back
                        if (this.currentView === 'group-profile') {
                            this.goBack();
                        }
                        
                        this.render();
                        this.updateCounts();
                        this.updateSyncStatus();
                        this.showNotification(`${group.name} group deleted successfully!`);
                    }
                },

                // Delete flow
                deleteFlow(flowId) {
                    if (confirm('Are you sure you want to delete this flow?')) {
                        this.data.flows = this.data.flows.filter(f => f.id !== flowId);
                        this.data.hasChanges = true;
                        if (this.data.autoSave !== false) this.saveData();
                        
                        // If we're on the flow's profile, go back
                        if (this.currentView === 'flow-profile') {
                            this.goBack();
                        }
                        
                        this.render();
                        this.updateCounts();
                        this.updateSyncStatus();
                        this.closeModal();
                        this.showNotification('Flow deleted successfully!');
                    }
                },
                
                // Get last save time
                getLastSaveTime() {
                    const lastSave = localStorage.getItem('lastSaveTime');
                    if (!lastSave) return 'Never';
                    
                    const date = new Date(lastSave);
                    const now = new Date();
                    const diff = now - date;
                    
                    if (diff < 60000) return 'Just now';
                    if (diff < 3600000) return `${Math.floor(diff / 60000)} minutes ago`;
                    if (diff < 86400000) return `${Math.floor(diff / 3600000)} hours ago`;
                    return date.toLocaleDateString();
                },
                
                // Helper function to escape HTML
                escapeHtml(text) {
                    const div = document.createElement('div');
                    div.textContent = text;
                    return div.innerHTML;
                },
                
                copyToClipboard(elementId) {
                    const element = document.getElementById(elementId);
                    if (!element) return;
                    
                    const text = element.textContent || element.innerText;
                    
                    // Try modern clipboard API first
                    if (navigator.clipboard && navigator.clipboard.writeText) {
                        navigator.clipboard.writeText(text)
                            .then(() => this.showNotification('Copied to clipboard!'))
                            .catch(() => this.fallbackCopyToClipboard(text));
                    } else {
                        this.fallbackCopyToClipboard(text);
                    }
                },
                
                // Fallback copy method
                fallbackCopyToClipboard(text) {
                    const textArea = document.createElement('textarea');
                    textArea.value = text;
                    textArea.style.position = 'fixed';
                    textArea.style.left = '-999999px';
                    document.body.appendChild(textArea);
                    textArea.focus();
                    textArea.select();
                    
                    try {
                        document.execCommand('copy');
                        this.showNotification('Copied to clipboard!');
                    } catch (err) {
                        this.showNotification('Failed to copy. Please select and copy manually.');
                    }
                    
                    document.body.removeChild(textArea);
                }
            };
        } // End of window.app definition

        // Initialize app when DOM is ready
        document.addEventListener('DOMContentLoaded', () => {
            try {
                // Ensure app is properly attached to window
                if (!window.app) {
                    console.error('App object not found on window');
                    return;
                }
                window.app.init();
                console.log('Team Operations Archive initialized');
                
                // Test that critical functions exist
                if (typeof window.app.addRole !== 'function') {
                    console.error('addRole function not found');
                }
                if (typeof window.app.addTempResponsibility !== 'function') {
                    console.error('addTempResponsibility function not found');
                }
            } catch (error) {
                console.error('Failed to initialize app:', error);
            }
        });
        
        // Ensure modal works on click
        window.addEventListener('load', () => {
            const modal = document.getElementById('modal');
            if (modal) {
                modal.addEventListener('click', (e) => {
                    if (e.target === modal) {
                        window.app.closeModal();
                    }
                });
            }
        });
    </script>
</body>
</html>
