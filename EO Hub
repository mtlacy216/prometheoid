                    + Add Person
                </button>
            </div>

            <div class="list" id="peopleList"></div>
        </div>

        <!-- Roles View -->
        <div id="roles-view" class="view-container">
            <div class="page-header">
                <h1 class="page-title">Roles</h1>
                <p class="page-description">Define organizational roles and responsibilities</p>
            </div>

            <div class="action-bar">
                <div class="search-box">
                    <input type="text" placeholder="Search roles...">
                </div>
                <button class="btn-primary" onclick="window.app.showAddRoleModal()">
                    + Add Role
                </button>
            </div>

            <div class="grid" id="rolesList"></div>
        </div>

        <!-- Groups View -->
        <div id="groups-view" class="view-container">
            <div class="page-header">
                <h1 class="page-title">Groups</h1>
                <p class="page-description">Organize roles into hierarchical groups</p>
            </div>

            <div class="action-bar">
                <div class="search-box">
                    <input type="text" placeholder="Search groups...">
                </div>
                <button class="btn-primary" onclick="window.app.showAddGroupModal()">
                    + Add Group
                </button>
            </div>

            <div class="grid" id="groupsList"></div>
        </div>

        <!-- Flows View -->
        <div id="flows-view" class="view-container">
            <div class="page-header">
                <h1 class="page-title">Flows</h1>
                <p class="page-description">Manage operational connections and workflows</p>
            </div>

            <div class="action-bar">
                <div class="search-box">
                    <input type="text" placeholder="Search flows...">
                </div>
                <button class="btn-primary" onclick="window.app.showAddFlowModal()">
                    + Add Flow
                </button>
            </div>

            <div class="list" id="flowsList"></div>
        </div>

        <!-- Person Profile View -->
        <div id="person-profile-view" class="view-container">
            <button class="back-button" onclick="window.app.goBack()">
                ← Back
            </button>
            <div id="personProfileContent"></div>
        </div>

        <!-- Role Profile View -->
        <div id="role-profile-view" class="view-container">
            <button class="back-button" onclick="window.app.goBack()">
                ← Back
            </button>
            <div id="roleProfileContent"></div>
        </div>

        <!-- Group Profile View -->
        <div id="group-profile-view" class="view-container">
            <button class="back-button" onclick="window.app.goBack()">
                ← Back
            </button>
            <div id="groupProfileContent"></div>
        </div>

        <!-- Flow Profile View -->
        <div id="flow-profile-view" class="view-container">
            <button class="back-button" onclick="window.app.goBack()">
                ← Back
            </button>
            <div id="flowProfileContent"></div>
        </div>

        <!-- AI Assist View -->
        <div id="ai-assist-view" class="view-container">
            <div class="page-header">
                <h1 class="page-title">AI Assist</h1>
                <p class="page-description">Use AI to help create your organizational data</p>
            </div>

            <div class="card">
                <h2 style="margin-bottom: 16px;">Quick Start with AI</h2>
                <p style="margin-bottom: 16px;">You can use any AI assistant (ChatGPT, Claude, Gemini, etc.) to help you quickly create your organizational data in the correct format.</p>
                
                <div style="background: var(--bg-secondary); padding: 16px; border-radius: 8px; margin-bottom: 24px;">
                    <h3 style="margin-bottom: 12px; font-size: 1.125rem;">Step 1: Copy this prompt template</h3>
                    <div style="background: var(--bg-tertiary); padding: 12px; border-radius: 4px; font-family: 'JetBrains Mono', monospace; font-size: 0.875rem; margin-bottom: 12px; position: relative;">
                        <button class="btn-icon" style="position: absolute; top: 8px; right: 8px;" onclick="window.app.copyToClipboard('ai-prompt-template')" title="Copy prompt">
                            📋
                        </button>
                        <pre id="ai-prompt-template" style="margin: 0; white-space: pre-wrap;">Create a JSON file for Team Operations Archive with the following structure for [YOUR ORGANIZATION NAME]:

{
  "version": "1.0.0",
  "organizationName": "[YOUR ORGANIZATION NAME]",
  "data": {
    "people": [
      {
        "id": unique_number,
        "name": "Full Name",
        "email": "email@company.com",
        "roleId": matching_role_id,
        "department": "Department Name",
        "startDate": "YYYY-MM-DD",
        "status": "active" or "inactive"
      }
    ],
    "roles": [
      {
        "id": unique_number,
        "name": "Role Name",
        "code": "SHORT_CODE",
        "responsibilities": ["responsibility 1", "responsibility 2"],
        "ownership": ["ownership area 1", "ownership area 2"]
      }
    ],
    "groups": [
      {
        "id": unique_number,
        "name": "Group Name",
        "roleIds": [array_of_role_ids],
        "childGroupIds": [array_of_child_group_ids],
        "parentId": parent_group_id_or_null
      }
    ],
    "flows": [
      {
        "id": unique_number,
        "roleId": initiating_role_id,
        "action": "okays" or "does" or "shares",
        "connection": "Description of what they do",
        "counterpartRoleIds": [role_ids],
        "counterpartRoleNames": ["Role Names"],
        "counterpartType": "roles",
        "updated": "YYYY-MM-DD"
      }
    ]
  }
}

Please create this for my organization with:
[DESCRIBE YOUR ORGANIZATION, TEAMS, REPORTING STRUCTURE, AND ANY LOGICAL GROUPINGS]</pre>
                    </div>
                    <p style="font-size: 0.875rem; color: var(--text-secondary);">Customize the bracketed parts with your organization's information.</p>
                </div>

                <div style="background: var(--bg-secondary); padding: 16px; border-radius: 8px; margin-bottom: 24px;">
                    <h3 style="margin-bottom: 12px; font-size: 1.125rem;">Step 2: Get AI assistance</h3>
                    <p style="margin-bottom: 12px;">Paste the customized prompt into your preferred AI assistant. Be specific about:</p>
                    <ul style="margin-left: 20px; margin-bottom: 0;">
                        <li>Your organization name and structure</li>
                        <li>Team members and their roles</li>
                        <li>How roles should be grouped (departments, teams, etc.)</li>
                        <li>Who reports to whom</li>
                        <li>Key responsibilities and decision-making authority</li>
                    </ul>
                </div>

                <div style="background: var(--bg-secondary); padding: 16px; border-radius: 8px;">
                    <h3 style="margin-bottom: 12px; font-size: 1.125rem;">Step 3: Import your data</h3>
                    <ol style="margin-left: 20px; margin-bottom: 0;">
                        <li>Copy the JSON output from the AI</li>
                        <li>Save it as a .json file (e.g., "my-organization.json")</li>
                        <li>Use the "Upload Existing File" option on the welcome screen, or</li>
                        <li>Go to Settings → Data → Replace with Another File</li>
                    </ol>
                </div>
            </div>

            <div class="card">
                <h2 style="margin-bottom: 16px;">Understanding the Data Structure</h2>
                
                <div class="info-group" style="margin-bottom: 24px;">
                    <h3 style="margin-bottom: 12px;">People</h3>
                    <p style="margin-bottom: 12px;">Each person in your organization needs:</p>
                    <ul style="margin-left: 20px;">
                        <li><strong>id</strong>: A unique number (e.g., 1, 2, 3...)</li>
                        <li><strong>name</strong>: Their full name</li>
                        <li><strong>email</strong>: Their email address</li>
                        <li><strong>roleId</strong>: Must match an id from the roles section</li>
                        <li><strong>department</strong>: Their department or team</li>
                        <li><strong>startDate</strong>: When they joined (format: "2024-01-15")</li>
                        <li><strong>status</strong>: Either "active" or "inactive"</li>
                    </ul>
                </div>

                <div class="info-group" style="margin-bottom: 24px;">
                    <h3 style="margin-bottom: 12px;">Roles</h3>
                    <p style="margin-bottom: 12px;">Each role needs:</p>
                    <ul style="margin-left: 20px;">
                        <li><strong>id</strong>: A unique number</li>
                        <li><strong>name</strong>: Role title (e.g., "Engineering Manager")</li>
                        <li><strong>code</strong>: Short code (e.g., "ENG_MGR")</li>
                        <li><strong>responsibilities</strong>: Array of what they're responsible for</li>
                        <li><strong>ownership</strong>: Array of what they own/control</li>
                    </ul>
                </div>

                <div class="info-group" style="margin-bottom: 24px;">
                    <h3 style="margin-bottom: 12px;">Groups</h3>
                    <p style="margin-bottom: 12px;">Groups organize roles hierarchically:</p>
                    <ul style="margin-left: 20px;">
                        <li><strong>id</strong>: A unique number</li>
                        <li><strong>name</strong>: Group name (e.g., "Engineering Team")</li>
                        <li><strong>roleIds</strong>: Array of role IDs in this group</li>
                        <li><strong>childGroupIds</strong>: Array of sub-group IDs</li>
                        <li><strong>parentId</strong>: ID of parent group (null for top-level)</li>
                    </ul>
                </div>

                <div class="info-group">
                    <h3 style="margin-bottom: 12px;">Flows</h3>
                    <p style="margin-bottom: 12px;">Each flow represents a connection between roles:</p>
                    <ul style="margin-left: 20px;">
                        <li><strong>id</strong>: A unique number</li>
                        <li><strong>roleId</strong>: The role that initiates the action</li>
                        <li><strong>action</strong>: One of "okays", "does", or "shares"</li>
                        <li><strong>connection</strong>: Description (e.g., "Approves budgets for")</li>
                        <li><strong>counterpartRoleIds</strong>: Array of role IDs this applies to</li>
                        <li><strong>counterpartRoleNames</strong>: Array of role names (must match)</li>
                        <li><strong>updated</strong>: Last update date</li>
                    </ul>
                </div>
            </div>

            <div class="card">
