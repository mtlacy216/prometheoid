            // Show settings tab
            showSettingsTab(tabName) {
                // Hide all tabs
                document.querySelectorAll('.settings-tab-content').forEach(tab => {
                    tab.style.display = 'none';
                });
                
                // Remove active class from all buttons
                document.querySelectorAll('.settings-tab-btn').forEach(btn => {
                    btn.classList.remove('active');
                });
                
                // Show selected tab
                document.getElementById(`settings-${tabName}`).style.display = 'block';
                
                // Add active class to selected button
                document.querySelector(`[data-tab="${tabName}"]`).classList.add('active');
            },
            
            // Show notification
            showNotification(message, duration = 3000) {
                // Ensure DOM is ready
                if (!document.body) {
                    console.log('Notification:', message);
                    return;
                }
                
                const notification = document.createElement('div');
                notification.className = 'notification';
                notification.textContent = message;
                document.body.appendChild(notification);
                
                setTimeout(() => {
                    notification.style.animation = 'slideUp 0.3s ease-out reverse';
                    setTimeout(() => {
                        if (notification.parentNode) {
                            notification.remove();
                        }
                    }, 300);
                }, duration);
            },
            
            // Toggle auto-save
            toggleAutoSave(enabled) {
                this.data.autoSave = enabled;
                this.saveData();
                if (enabled) {
                    this.showNotification('Auto-save enabled');
                } else {
                    this.showNotification('Auto-save disabled. Remember to export your data!');
                }
            },
            
            // Toggle show inactive
            toggleShowInactive(show) {
                this.data.showInactive = show;
                this.saveData();
                this.render();
            },
            
            // Clear all data
            clearAllData() {
                if (confirm('Are you sure you want to delete all data? This cannot be undone!')) {
                    if (confirm('This will permanently delete all people, roles, groups, and flows. Are you really sure?')) {
                        this.data.organizationName = '';
                        this.data.people = [];
                        this.data.roles = [];
                        this.data.groups = [];
                        this.data.flows = [];
                        this.data.lastDownloadTime = null;
                        this.data.hasChanges = false;
                        this.data.originalFileName = null;
                        this.saveData();
                        this.render();
                        this.updateOrgNameDisplay();
                        this.updateCounts();
                        this.updateSyncStatus();
                        this.closeModal();
                        this.showNotification('All data has been cleared');
                    }
                }
            },
            
            // Replace file
            replaceFile() {
                if (confirm('This will replace ALL current data with a new file. Are you sure?')) {
                    const input = document.createElement('input');
                    input.type = 'file';
                    input.accept = '.json';
                    input.onchange = (e) => {
                        const file = e.target.files[0];
                        this.data.originalFileName = file.name;
                        
                        const reader = new FileReader();
                        reader.onload = (event) => {
                            try {
                                const imported = JSON.parse(event.target.result);
                                
                                // Replace all data
                                if (imported.data) {
                                    this.data.people = imported.data.people || [];
                                    this.data.roles = imported.data.roles || [];
                                    this.data.groups = imported.data.groups || [];
                                    this.data.flows = imported.data.flows || [];
                                } else {
                                    // Direct format
                                    this.data.people = imported.people || [];
                                    this.data.roles = imported.roles || [];
                                    this.data.groups = imported.groups || [];
                                    this.data.flows = imported.flows || [];
                                }
                                
                                // Load organization name if present
                                this.data.organizationName = imported.organizationName || '';
                                
                                // Mark as just downloaded
                                this.data.lastDownloadTime = new Date().toISOString();
                                this.data.hasChanges = false;
                                
                                this.saveData();
                                this.render();
                                this.updateOrgNameDisplay();
                                this.updateCounts();
                                this.updateSyncStatus();
                                this.closeModal();
                                
                                // Initialize view state if needed
                                if (!this.currentView) {
                                    this.currentView = 'overview';
                                    this.previousView = 'overview';
                                }
                                
                                this.showNotification(`Replaced with ${file.name} successfully!`);
                            } catch (error) {
                                this.showNotification('Failed to load file. Please check the format.');
                                console.error('Import error:', error);
                            }
                        };
                        reader.readAsText(file);
                    };
                    input.click();
                }
            },
            
            // Import data (merge)
            importData() {
                this.showModal(`
                    <div class="modal-header">
                        <h2 class="modal-title">Import Data</h2>
                        <button class="modal-close" onclick="window.app.closeModal()">×</button>
                    </div>
                    <div class="modal-body">
                        <p style="margin-bottom: 16px;">This will <strong>add</strong> data from another file to your existing data. Duplicate entries may be created.</p>
                        <p style="margin-bottom: 24px;">To <strong>replace</strong> all data instead, use "Replace with Another File" option.</p>
                        
                        <button class="btn-primary" onclick="window.app.confirmImportData()">
                            Choose File to Import
                        </button>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn-secondary" onclick="window.app.closeModal()">Cancel</button>
                    </div>
                `);
            },
            
            // Confirm import data
            confirmImportData() {
                const input = document.createElement('input');
                input.type = 'file';
                input.accept = '.json';
                input.onchange = (e) => {
                    const file = e.target.files[0];
                    
                    const reader = new FileReader();
                    reader.onload = (event) => {
                        try {
                            const imported = JSON.parse(event.target.result);
                            
                            // Merge data (add to existing)
                            if (imported.data) {
                                this.data.people = [...this.data.people, ...(imported.data.people || [])];
                                this.data.roles = [...this.data.roles, ...(imported.data.roles || [])];
                                this.data.groups = [...this.data.groups, ...(imported.data.groups || [])];
                                this.data.flows = [...this.data.flows, ...(imported.data.flows || [])];
                            } else {
                                // Direct format
                                this.data.people = [...this.data.people, ...(imported.people || [])];
                                this.data.roles = [...this.data.roles, ...(imported.roles || [])];
                                this.data.groups = [...this.data.groups, ...(imported.groups || [])];
                                this.data.flows = [...this.data.flows, ...(imported.flows || [])];
                            }
                            
                            // Don't change organization name when merging
                            
                            this.data.hasChanges = true;
                            this.saveData();
                            this.render();
                            this.updateCounts();
                            this.updateSyncStatus();
                            this.closeModal();
                            
                            const counts = {
                                people: (imported.data?.people || imported.people || []).length,
                                roles: (imported.data?.roles || imported.roles || []).length,
                                flows: (imported.data?.flows || imported.flows || []).length,
                                groups: (imported.data?.groups || imported.groups || []).length
                            };

                            this.showNotification(`Imported ${counts.people} people, ${counts.roles} roles, ${counts.flows} flows, and ${counts.groups} groups from ${file.name}`);
                        } catch (error) {
                            this.showNotification('Failed to import data. Please check the file format.');
                            console.error('Import error:', error);
                        }
                    };
                    reader.readAsText(file);
                };
                input.click();
            },
            
            // Export CSV
            exportCSV(type) {
                let csv = '';
                let filename = '';
                
                switch(type) {
                    case 'people':
                        csv = 'Name,Email,Department,Role,Start Date,Status\n';
                        this.data.people.forEach(person => {
                            const role = this.data.roles.find(r => r.id === person.roleId);
                            csv += `"${person.name}","${person.email}","${person.department}","${role ? role.name : 'Unassigned'}","${person.startDate}","${person.status}"\n`;
                        });
                        filename = 'people.csv';
                        break;
                        
                    case 'roles':
                        csv = 'Name,Code,Responsibilities,Ownership,People Count\n';
                        this.data.roles.forEach(role => {
                            const peopleCount = this.data.people.filter(p => p.roleId === role.id).length;
                            csv += `"${role.name}","${role.code}","${role.responsibilities.join('; ')}","${role.ownership.join('; ')}","${peopleCount}"\n`;
                        });
                        filename = 'roles.csv';
                        break;
                        
                    case 'flows':
                        csv = 'Role,Action,Connection,Counterpart,Type,Updated\n';
                        this.data.flows.forEach(flow => {
                            const role = this.data.roles.find(r => r.id === flow.roleId);
                            
                            // Handle both old and new format
                            let counterpart = '';
                            if (flow.counterpartRoleNames && flow.counterpartRoleNames.length > 0) {
                                counterpart = flow.counterpartRoleNames.join('; ');
                            } else if (flow.counterpart) {
                                counterpart = flow.counterpart;
                            }
                            
                            csv += `"${role ? role.name : 'Unknown'}","${flow.action}","${flow.connection}","${counterpart}","${flow.counterpartType || 'role'}","${flow.updated}"\n`;
                        });
                        filename = 'flows.csv';
                        break;
                }
                
                const blob = new Blob([csv], { type: 'text/csv' });
                const url = URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url;
                a.download = filename;
                a.click();
                URL.revokeObjectURL(url);
                
                this.showNotification(`${type.charAt(0).toUpperCase() + type.slice(1)} exported as CSV`);
            },
            
            // Export summary
            exportSummary() {
                const orgName = this.data.organizationName || 'Unnamed Organization';
                let summary = `${orgName.toUpperCase()} - TEAM OPERATIONS SUMMARY\n`;
                summary += '='.repeat(orgName.length + 28) + '\n\n';
                summary += `Generated: ${new Date().toLocaleString()}\n\n`;
                
                summary += 'OVERVIEW\n';
                summary += '--------\n';
                summary += `Organization: ${orgName}\n`;
                summary += `Total People: ${this.data.people.length}\n`;
                summary += `Total Roles: ${this.data.roles.length}\n`;
                summary += `Total Flows: ${this.data.flows.length}\n\n`;
                
                summary += 'ROLES\n';
                summary += '-----\n';
                this.data.roles.forEach(role => {
                    const peopleInRole = this.data.people.filter(p => p.roleId === role.id);
                    summary += `\n${role.name} (${role.code})\n`;
                    summary += `People: ${peopleInRole.length}\n`;
                    summary += `Responsibilities:\n`;
                    role.responsibilities.forEach(r => summary += `  - ${r}\n`);
                    summary += `Ownership:\n`;
                    role.ownership.forEach(o => summary += `  - ${o}\n`);
                });
                
                summary += '\n\nPEOPLE\n';
                summary += '------\n';
                this.data.people.forEach(person => {
                    const role = this.data.roles.find(r => r.id === person.roleId);
                    summary += `\n${person.name}\n`;
                    summary += `  Email: ${person.email}\n`;
                    summary += `  Department: ${person.department}\n`;
                    summary += `  Role: ${role ? role.name : 'Unassigned'}\n`;
                    summary += `  Status: ${person.status}\n`;
                });
                
                summary += '\n\nFLOWS\n';
                summary += '-----\n';
                this.data.flows.forEach(flow => {
                    const role = this.data.roles.find(r => r.id === flow.roleId);
                    
                    // Handle both old and new format
                    let counterpart = '';
                    if (flow.counterpartRoleNames && flow.counterpartRoleNames.length > 0) {
                        counterpart = flow.counterpartRoleNames.join(', ');
                    } else if (flow.counterpart) {
                        counterpart = flow.counterpart;
                    } else {
                        counterpart = '(No counterpart)';
                    }
                    
                    summary += `\n${role ? role.name : 'Unknown'} ${flow.action} ${flow.connection} ${counterpart}\n`;
                });
                
                const blob = new Blob([summary], { type: 'text/plain' });
                const url = URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url;
                a.download = 'team-operations-summary.txt';
                a.click();
                URL.revokeObjectURL(url);
                
                this.showNotification('Summary report exported successfully!');
            },
            
            // Edit flow
            editFlow(flowId) {
                const flow = this.data.flows.find(f => f.id === flowId);
                if (!flow) return;
                
                const roleOptions = this.data.roles.map(r => 
                    `<option value="${r.id}" ${r.id === flow.roleId ? 'selected' : ''}>${r.name}</option>`
                ).join('');
                
                // Pre-select counterpart roles
                const counterpartOptions = this.data.roles.map(r => {
                    const isSelected = flow.counterpartRoleIds && flow.counterpartRoleIds.includes(r.id);
                    return `<option value="${r.id}" ${isSelected ? 'selected' : ''}>${r.name}</option>`;
                }).join('');

                this.showModal(`
                    <div class="modal-header">
                        <h2 class="modal-title">Edit Flow</h2>
                        <button class="modal-close" onclick="window.app.closeModal()">×</button>
                    </div>
                    <form id="editFlowForm" onsubmit="window.app.updateFlow(event, ${flowId})">
                        <div class="modal-body">
                            <div class="form-group">
                                <label class="form-label">Role</label>
                                <select class="form-select" name="roleId" required>
                                    ${roleOptions}
                                </select>
                            </div>
