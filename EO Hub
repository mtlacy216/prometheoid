                                <select class="form-select" name="action" required>
                                    <option value="okays" ${flow.action === 'okays' ? 'selected' : ''}>Okays</option>
                                    <option value="does" ${flow.action === 'does' ? 'selected' : ''}>Does</option>
                                    <option value="shares" ${flow.action === 'shares' ? 'selected' : ''}>Shares</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label class="form-label">Connection</label>
                                <input type="text" class="form-input" name="connection" required 
                                       value="${flow.connection}">
                            </div>
                            <div class="form-group">
                                <label class="form-label">Counterpart Roles (Optional)</label>
                                <select class="form-select" name="counterpartRoles" multiple style="height: 120px;">
                                    ${counterpartOptions}
                                </select>
                                <p style="font-size: 0.75rem; color: var(--text-secondary); margin-top: 8px;">
                                    Hold Ctrl (or Cmd on Mac) to select multiple roles
                                </p>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn-secondary btn-danger" onclick="window.app.deleteFlow(${flowId})">Delete Flow</button>
                            <button type="button" class="btn-secondary" onclick="window.app.closeModal()">Cancel</button>
                            <button type="submit" class="btn-primary">Update Flow</button>
                        </div>
                    </form>
                `);
            },
            
            // Update flow
            updateFlow(event, flowId) {
                event.preventDefault();
                const form = event.target;
                const flowIndex = this.data.flows.findIndex(f => f.id === flowId);
                if (flowIndex === -1) return;
                
                // Get selected counterpart roles
                const selectedOptions = Array.from(form.counterpartRoles.selectedOptions);
                const counterpartRoleIds = selectedOptions.map(option => parseInt(option.value));
                const counterpartRoleNames = selectedOptions.map(option => option.text);
                
                this.data.flows[flowIndex] = {
                    ...this.data.flows[flowIndex],
                    roleId: parseInt(form.roleId.value),
                    action: form.action.value,
                    connection: form.connection.value,
                    counterpartRoleIds: counterpartRoleIds,
                    counterpartRoleNames: counterpartRoleNames,
                    counterpartType: 'roles',
                    updated: new Date().toISOString().substring(0, 10)
                };
                
                this.data.hasChanges = true;
                if (this.data.autoSave !== false) this.saveData();
                
                // Refresh profile if we're viewing it
                if (this.currentView === 'flow-profile') {
                    this.showFlowProfile(flowId);
                } else {
                    this.render();
                }
                
                this.updateSyncStatus();
                this.closeModal();
                this.showNotification('Flow updated successfully!');
            },
            
            // Delete person
            deletePerson(personId) {
                const person = this.data.people.find(p => p.id === personId);
                if (!person) return;
                
                if (confirm(`Are you sure you want to delete ${person.name}?`)) {
                    this.data.people = this.data.people.filter(p => p.id !== personId);
                    this.data.hasChanges = true;
                    if (this.data.autoSave !== false) this.saveData();
                    
                    // If we're on the person's profile, go back
                    if (this.currentView === 'person-profile') {
                        this.goBack();
                    }
                    
                    this.render();
                    this.updateCounts();
                    this.updateSyncStatus();
                    this.showNotification(`${person.name} deleted successfully!`);
                }
            },
            
