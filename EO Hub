                // Update sync status
                updateSyncStatus() {
                    const syncStatus = document.getElementById('syncStatus');
                    const syncText = document.getElementById('syncText');
                    const downloadBtn = document.querySelector('.download-btn');
                    const reminder = document.getElementById('downloadReminder');
                    const reminderText = document.getElementById('downloadReminderText');
                    
                    if (this.data.lastDownloadTime) {
                        const lastDownload = new Date(this.data.lastDownloadTime);
                        const now = new Date();
                        const diff = now - lastDownload;
                        
                        const minutes = Math.floor(diff / 60000);
                        const hours = Math.floor(diff / 3600000);
                        const days = Math.floor(diff / 86400000);
                        
                        let timeText;
                        if (days > 0) {
                            timeText = `${days} day${days > 1 ? 's' : ''} ago`;
                        } else if (hours > 0) {
                            timeText = `${hours} hour${hours > 1 ? 's' : ''} ago`;
                        } else if (minutes > 0) {
                            timeText = `${minutes} minute${minutes > 1 ? 's' : ''} ago`;
                        } else {
                            timeText = 'Just now';
                        }
                        
                        if (this.data.hasChanges) {
                            syncStatus.className = 'sync-status needs-download';
                            syncText.textContent = `Changes since download ${timeText}`;
                            downloadBtn.className = 'download-btn has-changes';
                            
                            // Show reminder if more than 30 minutes
                            if (minutes > 30) {
                                reminder.style.display = 'flex';
                                reminderText.innerHTML = `Last saved ${timeText}. ${this.data.originalFileName ? `Save over <strong>${this.data.originalFileName}</strong>` : 'Download'} to keep your changes.`;
                            } else {
                                reminder.style.display = 'none';
                            }
                        } else {
                            syncStatus.className = 'sync-status downloaded';
                            syncText.textContent = `Downloaded ${timeText}`;
                            downloadBtn.className = 'download-btn';
                            reminder.style.display = 'none';
                        }
                    } else {
                        syncStatus.className = 'sync-status needs-download';
                        syncText.textContent = 'No downloads yet';
                        downloadBtn.className = 'download-btn has-changes';
                        
                        if (this.data.people.length > 0 || this.data.roles.length > 0 || this.data.groups.length > 0 || this.data.flows.length > 0) {
                            reminder.style.display = 'flex';
                            reminderText.innerHTML = 'Download your data to save your work permanently.';
                        }
                    }
                },

                // Theme management
                setTheme(theme) {
                    document.body.className = theme === 'light' ? '' : `theme-${theme}`;
                    this.data.currentTheme = theme;
                    document.getElementById('themeIcon').textContent = this.themeIcons[theme];
                    localStorage.setItem('appTheme', theme);
                },

                cycleTheme() {
                    const currentIndex = this.themes.indexOf(this.data.currentTheme);
                    const nextIndex = (currentIndex + 1) % this.themes.length;
                    this.setTheme(this.themes[nextIndex]);
                },

                // Show view management
                showView(viewName) {
                    // Check if view exists
                    const viewElement = document.getElementById(`${viewName}-view`);
                    if (!viewElement) {
                        console.error('View not found:', viewName);
                        return;
                    }
                    
                    // Track previous view for back navigation
                    if (!viewName.includes('-profile')) {
                        this.previousView = this.currentView || 'overview';
                    }
                    this.currentView = viewName;
                    
                    // Hide all views
                    document.querySelectorAll('.view-container').forEach(view => {
                        view.classList.remove('active');
                    });

                    // Show selected view
                    viewElement.classList.add('active');

                    // Update nav tabs only for main views
                    if (!viewName.includes('-profile')) {
                        document.querySelectorAll('.nav-tab').forEach(tab => {
                            tab.classList.remove('active');
                        });
                        
                        const tabs = document.querySelectorAll('.nav-tab');
                        const tabNames = ['overview', 'people', 'roles', 'groups', 'flows', 'ai-assist'];
                        const tabIndex = tabNames.indexOf(viewName);
                        if (tabIndex !== -1 && tabs[tabIndex]) {
                            tabs[tabIndex].classList.add('active');
                        }
                        
                        // Only render for non-profile views
                        this.render();
                    }

                    // Scroll to top when changing views
                    window.scrollTo(0, 0);
                },

                // Go back to previous view
                goBack() {
                    this.showView(this.previousView);
                },
                
                // Show AI Assist from welcome screen
                showAIAssistFromWelcome() {
                    // Initialize with empty data
                    this.data.people = [];
                    this.data.roles = [];
                    this.data.groups = [];
                    this.data.flows = [];
                    this.data.originalFileName = 'team-operations-archive.json';
                    
                    // Save initial state
                    this.saveData();
                    
                    // Show main app
                    document.getElementById('welcomeScreen').style.display = 'none';
                    document.getElementById('mainApp').style.display = 'block';
                    
                    // Initialize view state
                    this.currentView = 'overview';
                    this.previousView = 'overview';
                    
                    // Update UI
                    this.updateOrgNameDisplay();
                    this.updateCounts();
                    this.updateSyncStatus();
                    this.render();
                    
                    // Show AI Assist tab
                    this.showView('ai-assist');
                },

                // Update organization name display
                updateOrgNameDisplay() {
                    const orgNameText = document.getElementById('orgNameText');
                    const orgNameDisplay = document.getElementById('orgNameDisplay');
                    
                    if (!orgNameText || !orgNameDisplay) return;
                    
                    if (this.data.organizationName) {
                        orgNameText.textContent = this.data.organizationName;
                        orgNameDisplay.classList.remove('unnamed');
                    } else {
                        orgNameText.textContent = 'Unnamed Organization';
                        orgNameDisplay.classList.add('unnamed');
                    }
