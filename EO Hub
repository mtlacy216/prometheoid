                            <ul class="info-list">
                                ${role.responsibilities.map(r => `<li>${r}</li>`).join('')}
                            </ul>
                        </div>

                        <div class="profile-section">
                            <h2 class="profile-section-title">Ownership Areas</h2>
                            <ul class="info-list">
                                ${role.ownership.map(o => `<li>${o}</li>`).join('')}
                            </ul>
                        </div>

                        <div class="profile-section">
                            <h2 class="profile-section-title">Group Memberships</h2>
