                // Delete role
                deleteRole(roleId) {
                    const role = this.data.roles.find(r => r.id === roleId);
                    if (!role) return;
                    
                    const peopleInRole = this.data.people.filter(p => p.roleId === roleId);
                    const flowsWithRole = this.data.flows.filter(f => 
                        f.roleId === roleId || 
                        (f.counterpartRoleIds && f.counterpartRoleIds.includes(roleId))
                    );
                    const groupsWithRole = this.data.groups.filter(g => g.roleIds.includes(roleId));
                    
                    let warningMessage = `Are you sure you want to delete the "${role.name}" role?`;
                    if (peopleInRole.length > 0) {
                        warningMessage += `\n\nThis will unassign ${peopleInRole.length} people from this role.`;
                    }
                    if (flowsWithRole.length > 0) {
                        warningMessage += `\n\nThis will affect ${flowsWithRole.length} flows.`;
                    }
                    if (groupsWithRole.length > 0) {
                        warningMessage += `\n\nThis role will be removed from ${groupsWithRole.length} groups.`;
                    }
                    
                    if (confirm(warningMessage)) {
                        // Unassign people from this role
                        this.data.people.forEach(person => {
                            if (person.roleId === roleId) {
                                person.roleId = null;
                            }
                        });
                        
                        // Remove role from flows
                        this.data.flows = this.data.flows.filter(f => f.roleId !== roleId);
                        this.data.flows.forEach(flow => {
                            if (flow.counterpartRoleIds) {
                                const index = flow.counterpartRoleIds.indexOf(roleId);
                                if (index > -1) {
                                    flow.counterpartRoleIds.splice(index, 1);
                                    flow.counterpartRoleNames.splice(index, 1);
                                }
                            }
                        });
                        
                        // Remove role from groups
                        this.data.groups.forEach(group => {
                            const index = group.roleIds.indexOf(roleId);
                            if (index > -1) {
                                group.roleIds.splice(index, 1);
                            }
                        });
                        
                        // Delete the role
                        this.data.roles = this.data.roles.filter(r => r.id !== roleId);
                        
                        this.data.hasChanges = true;
                        if (this.data.autoSave !== false) this.saveData();
                        
                        // If we're on the role's profile, go back
                        if (this.currentView === 'role-profile') {
                            this.goBack();
                        }
                        
                        this.render();
                        this.updateCounts();
                        this.updateSyncStatus();
                        this.showNotification(`${role.name} role deleted successfully!`);
                    }
