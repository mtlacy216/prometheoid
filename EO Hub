                                <div class="card">
                                    <div class="card-header">
                                        <div>
                                            <h3 class="card-title">
                                                <a href="#" class="entity-link" onclick="event.preventDefault(); window.app.showGroupProfile(${group.id})">
                                                    ${group.name}
                                                </a>
                                            </h3>
                                            <p class="card-subtitle">${group.roleIds.length} roles • ${group.childGroupIds.length} sub-groups</p>
                                        </div>
                                    </div>
                                </div>
                            `).join('') : '<p style="color: var(--text-tertiary);">Not part of any groups</p>'}
                        </div>

                        <div class="profile-section">
                            <h2 class="profile-section-title">People in This Role</h2>
                            ${people.length > 0 ? people.map(person => `
                                <div class="card">
                                    <div class="card-header">
                                        <div style="display: flex; align-items: center; gap: calc(var(--spacing) * 2); flex: 1;">
                                            <div class="avatar">${person.name.split(' ').map(n => n[0]).join('')}</div>
                                            <div>
                                                <h3 class="card-title">
                                                    <a href="#" class="entity-link" onclick="event.preventDefault(); window.app.showPersonProfile(${person.id})">
                                                        ${person.name}
                                                    </a>
                                                </h3>
                                                <p class="card-subtitle">${person.email}</p>
                                            </div>
                                        </div>
                                        <span class="badge badge-${person.status === 'active' ? 'green' : 'red'}">${person.status}</span>
                                    </div>
                                </div>
                            `).join('') : '<p style="color: var(--text-tertiary);">No people assigned to this role</p>'}
                        </div>

                        <div class="profile-section">
                            <h2 class="profile-section-title">Related Flows</h2>
                            ${flows.length > 0 ? flows.map(flow => {
                                const isMainRole = flow.roleId === role.id;
                                const flowRole = this.data.roles.find(r => r.id === flow.roleId);
                                
                                return `
                                    <div class="card">
                                        <div class="card-header">
                                            <div style="flex: 1;">
                                                <h3 class="card-title">
                                                    <a href="#" class="entity-link" onclick="event.preventDefault(); window.app.showFlowProfile(${flow.id})">
                                                        ${isMainRole ? role.name : (flowRole ? flowRole.name : 'Unknown Role')}
                                                        <span class="badge badge-${flow.action}">${flow.action}</span>
                                                        ${flow.connection}
                                                    </a>
                                                </h3>
                                                <p class="card-subtitle">
                                                    ${isMainRole ? 'This role initiates the flow' : 'This role is a counterpart'}
                                                </p>
                                            </div>
                                        </div>
                                    </div>
                                `;
                            }).join('') : '<p style="color: var(--text-tertiary);">No flows involving this role</p>'}
                        </div>

                        <div style="display: flex; gap: calc(var(--spacing) * 2); justify-content: flex-end;">
