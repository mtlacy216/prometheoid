                                    </p>
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn-secondary" onclick="window.app.closeModal()">Cancel</button>
                                <button type="submit" class="btn-primary">Save</button>
                            </div>
                        </form>
                    `);
                },

                // Update organization name
                updateOrgName(event) {
                    event.preventDefault();
                    const form = event.target;
                    this.data.organizationName = form.orgName.value;
                    this.data.hasChanges = true;
                    if (this.data.autoSave !== false) this.saveData();
                    this.updateOrgNameDisplay();
                    this.updateSyncStatus();
                    this.closeModal();
                    this.showNotification('Organization name updated!');
