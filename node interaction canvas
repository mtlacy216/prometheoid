        <div class="connection-type-option" data-type="alternation">
            <span>∿</span>
            <div class="connection-type-tooltip">Turns</div>
        </div>
    </div>

    <!-- Modal for node editing -->
    <div class="modal-overlay" id="modalOverlay">
        <div class="modal">
            <div class="modal-header" id="modalTitle">Edit Node</div>
            <div class="modal-content" id="modalContent">
                <!-- Dynamic content -->
            </div>
            <div class="modal-footer">
                <button onclick="App.closeModal()">Cancel</button>
                <button class="btn-primary" onclick="App.saveModal()">Save</button>
            </div>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/dagre/0.8.5/dagre.min.js"></script>
    <script>
        // Create App namespace
        window.App = {};
        
        // Connection type definitions
        const connectionTypes = {
            designation: { symbol: '⊡', name: 'Approval/Designation', color: '#2196F3', description: 'External marking/approval' },
            superposition: { symbol: '※', name: 'Decision/Superposition', color: '#FF9800', description: 'Decision/conditional' },
            recursion: { symbol: '⟳', name: 'Loop/Recursion', color: '#9C27B0', description: 'Feedback loop' },
            segmentation: { symbol: '|', name: 'Handoff/Segmentation', color: '#F44336', description: 'Handoff/boundary' },
            constitution: { symbol: '☯', name: 'Mutual/Constitution', color: '#00BCD4', description: 'Mutual definition' },
            instance: { symbol: '△', name: 'Pattern/Instance', color: '#8BC34A', description: 'Follows pattern' },
            nullification: { symbol: '∅', name: 'Block/Nullification', color: '#E91E63', description: 'Blocks/cancels' },
            synthesis: { symbol: '*', name: 'Merge/Synthesis', color: '#FFC107', description: 'Merge/create' },
            alternation: { symbol: '∿', name: 'Turns/Alternation', color: '#795548', description: 'Takes turns' }
        };
        
        // Application state
        const state = {
            canvas: null,
            svgElement: null,
            canvasRect: null,
            zoom: 1,
            panX: 0,
            panY: 0,
            flows: [],
            connections: [],
            groups: [],
            selectedItems: new Set(),
            draggedItem: null,
            connectingPort: null,
            tempConnection: null,
            selectionBox: null,
            isPanning: false,
            isSelecting: false,
            activeConnection: null,
            minimap: null,
            minimapContent: null,
            minimapViewport: null,
            minimapBounds: { minX: 0, minY: 0 },
            minimapScale: 1,
            minimapDragging: false,
            flowIdCounter: 0,
            nodeIdCounter: 0,
            groupIdCounter: 0,
            dragThreshold: 5,
            animationFrame: null,
            updateQueue: new Set(),
            clipboard: [],
            // Role filtering
            activeRoles: new Set(['all']),
            filterMode: 'highlight',
            availableRoles: new Set(),
        };
        
        // Sample data
        const availableRoles = [
            'Manager', 'Developer', 'Designer', 'QA Engineer',
            'Product Owner', 'Scrum Master', 'DevOps', 'Data Analyst',
            'Marketing', 'Sales', 'Customer Support', 'HR',
            'Finance', 'Accounting'
        ];
        
        const availableEntities = availableRoles;
        
        // Performance helpers
        function throttle(func, delay) {
            let lastCall = 0;
            return function(...args) {
                const now = Date.now();
                if (now - lastCall >= delay) {
                    lastCall = now;
                    return func.apply(this, args);
                }
            };
        }
        
        function scheduleUpdate(updateFunc) {
            state.updateQueue.add(updateFunc);
            if (!state.animationFrame) {
                state.animationFrame = requestAnimationFrame(() => {
                    state.updateQueue.forEach(fn => fn());
                    state.updateQueue.clear();
                    state.animationFrame = null;
                });
            }
        }
        
        // Initialize
        function init() {
            // Get DOM elements
            state.canvas = document.getElementById('canvas');
            state.svgElement = document.getElementById('connections');
            if (!state.svgElement) {
                console.error('SVG element not found!');
                return;
            }
            state.canvasRect = state.canvas.getBoundingClientRect();
            state.minimap = document.getElementById('minimap');
            if (state.minimap) {
                state.minimapContent = state.minimap.querySelector('.content');
                state.minimapViewport = state.minimap.querySelector('.minimap-viewport');
            }

            setupEventListeners();
            updateCanvasTransform();
            
            // Create sample flows
            const flow1 = createFlow(150, 200);
            flow1.label = 'Manager approves budget';
            flow1.element.querySelector('.flow-label').textContent = flow1.label;
            if (flow1.nodes[0]) flow1.nodes[0].roles = ['Manager'];
            updateFlowIcon(flow1);
            updateRoleDisplay(flow1.nodes[0]);
            
            const flow2 = createFlow(500, 100);
            flow2.label = 'Finance processes payment';
            flow2.element.querySelector('.flow-label').textContent = flow2.label;
            if (flow2.nodes[0]) flow2.nodes[0].roles = ['Finance'];
            updateFlowIcon(flow2);
            updateRoleDisplay(flow2.nodes[0]);
            
            const flow3 = createFlow(500, 300);
            flow3.label = 'Accounting logs transaction';
            flow3.element.querySelector('.flow-label').textContent = flow3.label;
            if (flow3.nodes[0]) flow3.nodes[0].roles = ['Accounting'];
            updateFlowIcon(flow3);
            updateRoleDisplay(flow3.nodes[0]);
            
            // Update role filter after creating flows
            updateAvailableRoles();
            
            // Create a demo connection
            setTimeout(() => {
                if (flow1.ports.output && flow2.ports.input) {
                    createConnection(flow1.ports.output, flow2.ports.input, flow1, flow2, 'designation');
                }
            }, 500);
            
            // Auto-fit to content
            setTimeout(() => {
                App.fitToContent();
            }, 100);

            updateMinimap();
        }
        
        // Update flow icon based on content
        function updateFlowIcon(flow) {
            let icon = flow.element.querySelector('.flow-icon');
            if (!icon) {
                icon = document.createElement('div');
                icon.className = 'flow-icon';
                const labelContainer = flow.element.querySelector('.flow-label-container');
                labelContainer.insertBefore(icon, labelContainer.firstChild);
            }
            
            const label = flow.label.toLowerCase();
            
            // Simple icon mapping
            if (label.includes('approve') || label.includes('okays')) icon.textContent = '✓';
            else if (label.includes('process') || label.includes('does')) icon.textContent = '⚙';
            else if (label.includes('share') || label.includes('communicate')) icon.textContent = '📤';
            else if (label.includes('log') || label.includes('record')) icon.textContent = '📝';
            else if (label.includes('design')) icon.textContent = '🎨';
            else if (label.includes('develop')) icon.textContent = '💻';
            else if (label.includes('test')) icon.textContent = '🧪';
            else icon.textContent = '📋';
        }
        
        // Canvas controls
        function setupEventListeners() {
            state.canvas.addEventListener('wheel', handleWheel, { passive: false });
            state.canvas.addEventListener('mousedown', handleCanvasMouseDown);
            state.canvas.addEventListener('dblclick', handleCanvasDoubleClick);
            document.addEventListener('keydown', handleKeyDown);
            window.addEventListener('resize', () => {
                state.canvasRect = state.canvas.getBoundingClientRect();
                scheduleUpdate(() => {
                    updateAllConnections();
                    updateMinimap();
                });
            });
            
            // Connection type selector
            const selector = document.getElementById('connectionTypeSelector');
            selector.querySelectorAll('.connection-type-option').forEach(option => {
                option.addEventListener('click', () => selectConnectionType(option.dataset.type));
            });
            
            // Click outside to close selector
            document.addEventListener('click', (e) => {
                const selector = document.getElementById('connectionTypeSelector');
                if (!e.target.closest('.connection-type-selector') &&
                    !e.target.closest('.connection-label') &&
                    selector.classList.contains('show')) {
                    selector.classList.remove('show');
                    state.activeConnection = null;
                }
            });

            if (state.minimap) {
                state.minimap.addEventListener('mousedown', handleMinimapDown);
            }
        }
        
        function handleWheel(e) {
            e.preventDefault();
            const delta = e.deltaY > 0 ? 0.9 : 1.1;
            const newZoom = Math.max(0.1, Math.min(5, state.zoom * delta));
            
            const rect = state.canvas.getBoundingClientRect();
            const x = e.clientX - rect.left;
            const y = e.clientY - rect.top;
            
            state.panX = x - (x - state.panX) * (newZoom / state.zoom);
            state.panY = y - (y - state.panY) * (newZoom / state.zoom);
            
            // Apply zoom and refresh visuals
            state.zoom = newZoom;
            updateCanvasTransform();
            updateZoomDisplay();
            scheduleUpdate(() => {
                updateAllConnections();
                updateMinimap();
            });
            scheduleUpdate(updateViewportFlows);
        }

        function updateCanvasTransform() {
            state.canvas.style.transform = `translate(${state.panX}px, ${state.panY}px) scale(${state.zoom})`;
            updateMinimap();
            scheduleUpdate(updateViewportFlows);
        }

        function updateZoomDisplay() {
            const percentage = Math.round(state.zoom * 100);
            document.querySelector('.zoom-level').textContent = percentage + '%';
        }

        function updateMinimap() {
            if (!state.minimap) return;
            const flows = state.flows;
            const minimap = state.minimap;
            const content = state.minimapContent;
            const viewport = state.minimapViewport;
            const width = minimap.clientWidth;
            const height = minimap.clientHeight;

            content.innerHTML = '';
            if (flows.length === 0) {
                viewport.style.display = 'none';
                return;
            }

            let minX = Infinity, minY = Infinity, maxX = -Infinity, maxY = -Infinity;
            flows.forEach(flow => {
                const w = flow.element.offsetWidth;
                const h = flow.element.offsetHeight;
                minX = Math.min(minX, flow.x);
                minY = Math.min(minY, flow.y);
                maxX = Math.max(maxX, flow.x + w);
                maxY = Math.max(maxY, flow.y + h);
            });

            const bboxWidth = maxX - minX;
            const bboxHeight = maxY - minY;
            const scale = Math.min(width / bboxWidth, height / bboxHeight);

            state.minimapScale = scale;
            state.minimapBounds = { minX, minY };

            flows.forEach(flow => {
                const rect = document.createElement('div');
                rect.className = 'minimap-flow';
                rect.style.left = ((flow.x - minX) * scale) + 'px';
                rect.style.top = ((flow.y - minY) * scale) + 'px';
                rect.style.width = (flow.element.offsetWidth * scale) + 'px';
                rect.style.height = (flow.element.offsetHeight * scale) + 'px';
                content.appendChild(rect);
            });

            const viewW = state.canvasRect.width / state.zoom;
            const viewH = state.canvasRect.height / state.zoom;
            const vx = -state.panX / state.zoom;
            const vy = -state.panY / state.zoom;

            viewport.style.display = 'block';
            viewport.style.left = ((vx - minX) * scale) + 'px';
            viewport.style.top = ((vy - minY) * scale) + 'px';
            viewport.style.width = viewW * scale + 'px';
            viewport.style.height = viewH * scale + 'px';
        }

        function updateViewportFlows() {
            const viewLeft = -state.panX / state.zoom;
            const viewTop = -state.panY / state.zoom;
            const viewRight = viewLeft + window.innerWidth / state.zoom;
            const viewBottom = viewTop + window.innerHeight / state.zoom;

            state.flows.forEach(flow => {
                const x = parseFloat(flow.element.style.left) || 0;
                const y = parseFloat(flow.element.style.top) || 0;
                const w = flow.element.offsetWidth;
                const h = flow.element.offsetHeight;
                const inView = x + w > viewLeft && x < viewRight && y + h > viewTop && y < viewBottom;
                flow.element.classList.toggle('viewport-hidden', !inView);
            });

            state.connections.forEach(conn => {
                const outHidden = conn.outputOwner.element.classList.contains('viewport-hidden');
                const inHidden = conn.inputOwner.element.classList.contains('viewport-hidden');
                conn.group.classList.toggle('viewport-hidden', outHidden || inHidden);
            });
        }

        function handleMinimapDown(e) {
            e.preventDefault();
            moveFromEvent(e);

            function moveFromEvent(ev) {
                const rect = state.minimap.getBoundingClientRect();
                const x = Math.max(0, Math.min(rect.width, ev.clientX - rect.left));
                const y = Math.max(0, Math.min(rect.height, ev.clientY - rect.top));
                const canvasX = x / state.minimapScale + state.minimapBounds.minX;
                const canvasY = y / state.minimapScale + state.minimapBounds.minY;
                state.panX = -canvasX * state.zoom + state.canvasRect.width / 2;
                state.panY = -canvasY * state.zoom + state.canvasRect.height / 2;
                updateCanvasTransform();
                scheduleUpdate(() => {
                    updateAllConnections();
                    updateMinimap();
                });
            }

            function stop() {
                document.removeEventListener('mousemove', moveFromEvent);
                document.removeEventListener('mouseup', stop);
            }

            document.addEventListener('mousemove', moveFromEvent);
            document.addEventListener('mouseup', stop);
        }
        
        function handleCanvasMouseDown(e) {
            if (e.target === state.canvas || e.target === state.svgElement) {
                if (e.shiftKey) {
                    startSelection(e);
                } else if (e.button === 0) {
                    startPanning(e);
                }
            }
        }
        
        function handleCanvasDoubleClick(e) {
            if (e.target === state.canvas) {
                const rect = state.canvas.getBoundingClientRect();
                const x = (e.clientX - rect.left - state.panX) / state.zoom;
                const y = (e.clientY - rect.top - state.panY) / state.zoom;
                createFlow(x, y);
            }
        }
        
        function handleKeyDown(e) {
            if (e.key === 'Delete' && state.selectedItems.size > 0) {
                deleteSelected();
            } else if (e.ctrlKey && e.key.toLowerCase() === 'c') {
                e.preventDefault();
                copySelectedFlows();
            } else if (e.ctrlKey && e.key.toLowerCase() === 'x') {
                e.preventDefault();
                cutSelectedFlows();
            } else if (e.ctrlKey && e.key.toLowerCase() === 'v') {
                e.preventDefault();
                pasteFlows();
            } else if (e.key.toLowerCase() === 'f') {
                App.fitToContent();
            } else if (e.key === 'Tab' && state.activeConnection) {
                e.preventDefault();
                cycleConnectionType();
            } else if (e.key.toLowerCase() === 'r') {
                App.toggleRoleFilter('all');
            }
        }
        
        function startPanning(e) {
            state.isPanning = true;
            state.canvas.classList.add('grabbing');
            const startX = e.clientX;
            const startY = e.clientY;
            const startPanX = state.panX;
            const startPanY = state.panY;
            
            const pan = throttle((e) => {
                state.panX = startPanX + (e.clientX - startX);
                state.panY = startPanY + (e.clientY - startY);
                updateCanvasTransform();
                scheduleUpdate(() => {
                    updateAllConnections();
                    updateMinimap();
                });
            }, 16);
            
            function stopPanning() {
                state.isPanning = false;
                state.canvas.classList.remove('grabbing');
                document.removeEventListener('mousemove', pan);
                document.removeEventListener('mouseup', stopPanning);
            }
            
            document.addEventListener('mousemove', pan);
            document.addEventListener('mouseup', stopPanning);
        }
        
        // Flow creation and management
        function createFlow(x, y) {
            const flow = {
                id: 'flow-' + state.flowIdCounter++,
                x: x,
                y: y,
                collapsed: false,
                label: 'New Flow',
                nodes: [],
                element: null,
                ports: {
                    input: {},
                    output: {}
                }
            };
            
            const el = document.createElement('div');
            el.className = 'flow';
            el.style.left = x + 'px';
            el.style.top = y + 'px';
            
            el.innerHTML = `
                <div class="port port-input" data-type="input" title="Input: Connect from another flow"></div>
                <div class="port port-output" data-type="output" title="Output: Connect to another flow"></div>
                <div class="flow-header">
                    <div class="flow-label-container">
                        <div class="flow-label" title="Double-click to rename">${flow.label}</div>
                        <span class="edit-hint">✎</span>
                    </div>
                    <div class="flow-controls">
                        <div class="flow-control" onclick="App.toggleFlow('${flow.id}')">${flow.collapsed ? '▶' : '▼'}</div>
                    </div>
                </div>
                <div class="flow-content"></div>
            `;
            
            state.canvas.appendChild(el);
            flow.element = el;
            flow.contentElement = el.querySelector('.flow-content');
            flow.ports.input = el.querySelector('.port-input');
            flow.ports.output = el.querySelector('.port-output');
            
            const labelEl = el.querySelector('.flow-label');
            const editHint = el.querySelector('.edit-hint');
            
            // Click edit hint to edit
            if (editHint) {
                editHint.addEventListener('click', (e) => {
                    e.stopPropagation();
                    startEditingLabel();
                });
            }
            
            // Double-click to edit label
            const startEditingLabel = () => {
                labelEl.contentEditable = true;
                labelEl.classList.add('editing');
                labelEl.focus();
                
                // Select all text
                const range = document.createRange();
                range.selectNodeContents(labelEl);
                const selection = window.getSelection();
                selection.removeAllRanges();
                selection.addRange(range);
            };
            
            labelEl.addEventListener('dblclick', (e) => {
                e.stopPropagation();
                startEditingLabel();
            });
            
            // Handle blur and enter key
            const finishEditing = () => {
                labelEl.contentEditable = false;
                labelEl.classList.remove('editing');
                flow.label = labelEl.textContent;
                updateFlowGrammar(flow);
                updateFlowIcon(flow);
            };
            
            labelEl.addEventListener('blur', finishEditing);
            
            labelEl.addEventListener('keydown', (e) => {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    labelEl.blur();
                } else if (e.key === 'Escape') {
                    e.preventDefault();
                    labelEl.textContent = flow.label; // Revert
                    labelEl.blur();
                }
            });
            
            setupFlowInteractions(flow);
            state.flows.push(flow);
            populateFlow(flow);

            scheduleUpdate(() => {
                updateAllConnections();
                updateMinimap();
            });

            return flow;
        }
        
        function setupFlowInteractions(flow) {
            const el = flow.element;
            const header = el.querySelector('.flow-header');
            
            // Drag from header or flow body (but not from interactive elements)
            el.addEventListener('mousedown', (e) => {
                const isInteractive = e.target.classList.contains('flow-label') || 
                                    e.target.classList.contains('edit-hint') ||
                                    e.target.classList.contains('flow-control') ||
                                    e.target.closest('.node') ||
                                    e.target.classList.contains('port') ||
                                    e.target.tagName === 'INPUT';
                
                if (!isInteractive) {
                    startDragFlow(e, flow);
                }
            });
            
            // Double-click header background to collapse
            header.addEventListener('dblclick', (e) => {
                if (!e.target.classList.contains('flow-label') && 
                    !e.target.classList.contains('edit-hint') &&
                    !e.target.classList.contains('flow-control') &&
                    !e.target.closest('.flow-label-container')) {
                    e.stopPropagation();
                    App.toggleFlow(flow.id);
                }
            });
            
            // Better port interactions
            [flow.ports.input, flow.ports.output].forEach(port => {
                port.addEventListener('mousedown', (e) => {
                    e.stopPropagation();
                    startConnection(e, port, flow);
                });
            });
        }
        
        function populateFlow(flow) {
            flow.contentElement.innerHTML = '';
            flow.nodes = [];
            
            const role = createNodeInFlow(flow, 'role', { roles: ['Manager'] });
            const transform = createNodeInFlow(flow, 'transform', { transformType: 'Does' });
            const action = createNodeInFlow(flow, 'action', { 
                text: 'process request',
                hasRoleAfter: false 
            });
            
            flow.nodes = [role, transform, action];
            resizeFlowToFitContent(flow);
            
            // Update available roles when flow is populated
            updateAvailableRoles();
        }
        
        function createNodeInFlow(flow, type, data) {
            const node = {
                id: 'node-' + state.nodeIdCounter++,
                type: type,
                flow: flow,
                element: null,
                ...data
            };
            
            const el = document.createElement('div');
            el.className = 'node node-' + type;
            
            switch(type) {
                case 'role':
                    node.roles = node.roles || [];
                    el.innerHTML = `
                        <div class="node-role">
                            <div class="node-role-title">ROLE</div>
                            <div class="node-role-content">Select roles...</div>
                            <div class="node-role-tags"></div>
                        </div>
                    `;
                    break;
                    
                case 'transform':
                    el.className += ' ' + data.transformType.toLowerCase();
                    el.innerHTML = `
                        <div class="node-transform">
                            <div class="node-transform-content">${data.transformType}</div>
                        </div>
                    `;
                    break;
                    
                case 'action':
                    el.innerHTML = `
                        <div class="node-action">
                            <div class="node-action-title">ACTION</div>
                            <div class="node-action-content">${data.text}</div>
                            <div class="node-action-checkbox">
                                <input type="checkbox" id="role-after-${node.id}" ${data.hasRoleAfter ? 'checked' : ''}>
                                <label for="role-after-${node.id}">Has recipient/target</label>
                            </div>
                        </div>
                    `;
                    break;
                    
                case 'operand':
                    el.innerHTML = `
                        <div class="node-operand">
                            <div class="node-operand-content">${data.entity}</div>
                        </div>
                    `;
                    break;
            }
            
            flow.contentElement.appendChild(el);
            node.element = el;
            
            el.addEventListener('click', (e) => {
                if (e.target.type !== 'checkbox') {
                    openNodeModal(node);
                }
            });
            
            if (type === 'action') {
                const checkbox = el.querySelector('input[type="checkbox"]');
                checkbox.addEventListener('change', (e) => {
                    node.hasRoleAfter = e.target.checked;
                    updateFlowOperand(flow, node);
                });
            }
            
            if (type === 'role') {
                updateRoleDisplay(node);
            }
            
            return node;
        }
        
        function updateFlowGrammar(flow) {
            if (!flow.nodes || flow.nodes.length === 0) return;
            
            let grammarText = '';
            const roleNode = flow.nodes.find(n => n.type === 'role');
            const transformNode = flow.nodes.find(n => n.type === 'transform');
            const actionNode = flow.nodes.find(n => n.type === 'action');
            const operandNode = flow.nodes.find(n => n.type === 'operand');
            
            if (roleNode && roleNode.roles.length > 0) {
                grammarText += roleNode.roles[0];
            }
            
            if (transformNode) {
                grammarText += ' ' + transformNode.transformType.toLowerCase();
            }
            
            if (actionNode) {
                grammarText += ' ' + actionNode.text;
            }
            
            if (operandNode) {
                grammarText += ' for ' + operandNode.entity;
            }
            
            const labelEl = flow.element.querySelector('.flow-label');
            if (labelEl.textContent === flow.label || flow.label === 'New Flow') {
                flow.label = grammarText || 'New Flow';
                labelEl.textContent = flow.label;
            }
        }
        
        function updateFlowOperand(flow, actionNode) {
            let operandNode = flow.nodes.find(n => n.type === 'operand');
            
            if (actionNode.hasRoleAfter && !operandNode) {
                operandNode = createNodeInFlow(flow, 'operand', { entity: 'Team' });
                flow.nodes.push(operandNode);
            } else if (!actionNode.hasRoleAfter && operandNode) {
                operandNode.element.remove();
                flow.nodes = flow.nodes.filter(n => n.type !== 'operand');
            }
            
            resizeFlowToFitContent(flow);
        }
        
        function resizeFlowToFitContent(flow) {
            const padding = 40;
            const nodeSpacing = 30;
            let totalWidth = padding * 2;
            
            flow.nodes.forEach((node, index) => {
                if (node.element) {
                    totalWidth += node.element.offsetWidth;
                    if (index > 0) totalWidth += nodeSpacing;
                }
            });
            
            flow.element.style.width = Math.max(600, totalWidth) + 'px';
            scheduleUpdate(() => {
                updateAllConnections();
                updateMinimap();
            });
        }
        
        // Dragging with performance optimizations
        function startDragFlow(e, flow) {
            if (e.target.classList.contains('port')) return;
            e.stopPropagation();
            
            const startX = e.clientX;
            const startY = e.clientY;
            const el = flow.element;
            const rect = el.getBoundingClientRect();
            const canvasRect = state.canvas.getBoundingClientRect();
            const offsetX = e.clientX - rect.left;
            const offsetY = e.clientY - rect.top;
            
            let dragStarted = false;
            
            const checkDragStart = throttle((e) => {
                const distance = Math.hypot(e.clientX - startX, e.clientY - startY);
                
                if (distance > state.dragThreshold && !dragStarted) {
                    dragStarted = true;
                    state.draggedItem = flow;
                    el.classList.add('dragging');
                    el.style.cursor = 'grabbing';
                }
                
                if (dragStarted) {
                    const x = (e.clientX - canvasRect.left - state.panX) / state.zoom - offsetX;
                    const y = (e.clientY - canvasRect.top - state.panY) / state.zoom - offsetY;
                    
                    el.style.left = x + 'px';
                    el.style.top = y + 'px';
                    flow.x = x;
                    flow.y = y;

                    scheduleUpdate(() => {
                        updateAllConnections();
                        updateMinimap();
                    });
                }
            }, 16);
            
            function stopDrag() {
                if (dragStarted) {
                    el.classList.remove('dragging');
                    el.style.cursor = '';
                    state.draggedItem = null;
                }
                
                document.removeEventListener('mousemove', checkDragStart);
                document.removeEventListener('mouseup', stopDrag);
            }
            
            document.addEventListener('mousemove', checkDragStart);
            document.addEventListener('mouseup', stopDrag);
        }
        
        // Connections - Connect first, configure later
        function startConnection(e, port, owner) {
            e.preventDefault();
            
            state.connectingPort = { port, owner };
            port.classList.add('connecting');
            state.canvas.classList.add('connecting');
            
            const rect = port.getBoundingClientRect();
            const containerRect = document.getElementById('canvas-container').getBoundingClientRect();
            const startX = rect.left + rect.width / 2 - containerRect.left;
            const startY = rect.top + rect.height / 2 - containerRect.top;
            
            state.tempConnection = document.createElementNS('http://www.w3.org/2000/svg', 'path');
            state.tempConnection.classList.add('connection', 'temp');
            state.svgElement.appendChild(state.tempConnection);
            
            const dragConnection = throttle((e) => {
                const containerRect = document.getElementById('canvas-container').getBoundingClientRect();
                const currentX = e.clientX - containerRect.left;
                const currentY = e.clientY - containerRect.top;
                
                const path = calculateBezierPath(startX, startY, currentX, currentY);
                state.tempConnection.setAttribute('d', path);
                
                highlightCompatiblePorts(e);
            }, 16);
            
            function endConnection(e) {
                const targetPort = document.querySelector('.port.highlight');
                
                document.querySelectorAll('.port').forEach(p => {
                    p.classList.remove('highlight');
                });
                
                if (targetPort && isValidConnection(state.connectingPort, targetPort)) {
                    const targetOwner = findPortOwner(targetPort);
                    
                    // Create connection immediately
                    const sourcePort = state.connectingPort.port;
                    const sourceOwner = state.connectingPort.owner;
                    
                    createConnection(
                        sourcePort.dataset.type === 'output' ? sourcePort : targetPort,
                        sourcePort.dataset.type === 'input' ? sourcePort : targetPort,
                        sourcePort.dataset.type === 'output' ? sourceOwner : targetOwner,
                        sourcePort.dataset.type === 'input' ? sourceOwner : targetOwner,
                        'designation' // Default type
                    );
                }
                
                // Clean up
                state.connectingPort.port.classList.remove('connecting');
                state.canvas.classList.remove('connecting');
                
                if (state.tempConnection) state.tempConnection.remove();
                state.tempConnection = null;
                state.connectingPort = null;
                
                document.removeEventListener('mousemove', dragConnection);
                document.removeEventListener('mouseup', endConnection);
            }
            
            document.addEventListener('mousemove', dragConnection);
            document.addEventListener('mouseup', endConnection);
        }
        
        function showConnectionTypeSelector(connection, x, y) {
            const selector = document.getElementById('connectionTypeSelector');
            
            // Update active states
            selector.querySelectorAll('.connection-type-option').forEach(opt => {
                opt.classList.toggle('active', opt.dataset.type === connection.type);
            });
            
            state.activeConnection = connection;
            
            // Position relative to viewport
            selector.style.left = x + 'px';
            selector.style.top = y + 'px';
            selector.classList.add('show');
            
            // Ensure it's within viewport bounds
            setTimeout(() => {
                const rect = selector.getBoundingClientRect();
                if (rect.right > window.innerWidth) {
                    selector.style.left = (window.innerWidth - rect.width - 10) + 'px';
                }
                if (rect.bottom > window.innerHeight) {
                    selector.style.top = (window.innerHeight - rect.height - 10) + 'px';
                }
            }, 0);
        }
        
        function selectConnectionType(type) {
            const selector = document.getElementById('connectionTypeSelector');
            selector.classList.remove('show');
            
            if (state.activeConnection) {
                state.activeConnection.type = type;
                state.activeConnection.path.className = 'connection ' + type;
                state.activeConnection.path.style.stroke = connectionTypes[type].color;
                state.activeConnection.label.textContent = connectionTypes[type].symbol;
                
                state.activeConnection = null;
            }
        }
        
        function cycleConnectionType() {
            if (!state.activeConnection) return;
            
            const types = Object.keys(connectionTypes);
            const currentIndex = types.indexOf(state.activeConnection.type);
            const nextIndex = (currentIndex + 1) % types.length;
            const nextType = types[nextIndex];
            
            selectConnectionType(nextType);
        }
        
        function createConnection(outputPort, inputPort, outputOwner, inputOwner, type = 'designation') {
            if (!outputPort || !inputPort || !outputOwner || !inputOwner) {
                console.error('Invalid connection parameters');
                return;
            }
            
            const connection = {
                id: 'conn-' + Date.now(),
                output: outputPort,
                input: inputPort,
                outputOwner: outputOwner,
                inputOwner: inputOwner,
                type: type,
                path: null,
                label: null,
                group: null,
                labelBg: null
            };
            
            const g = document.createElementNS('http://www.w3.org/2000/svg', 'g');
            g.setAttribute('id', connection.id);
            g.setAttribute('class', 'connection-group');
            
            // Invisible hit area for better interaction
            const hitArea = document.createElementNS('http://www.w3.org/2000/svg', 'path');
            hitArea.classList.add('connection-hit-area');
            
            const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
            path.classList.add('connection', type);
            path.style.stroke = connectionTypes[type].color;
            
            // Label background
            const labelBg = document.createElementNS('http://www.w3.org/2000/svg', 'rect');
            labelBg.classList.add('connection-label-bg');
            
            const text = document.createElementNS('http://www.w3.org/2000/svg', 'text');
            text.classList.add('connection-label');
            text.textContent = connectionTypes[type].symbol;
            
            g.appendChild(hitArea);
            g.appendChild(path);
            g.appendChild(labelBg);
            g.appendChild(text);
            
            connection.path = path;
            connection.label = text;
            connection.group = g;
            connection.labelBg = labelBg;
            connection.hitArea = hitArea;
            
            state.svgElement.appendChild(g);
            
            outputPort.classList.add('connected');
            inputPort.classList.add('connected');
            
            state.connections.push(connection);
            updateConnection(connection);
            
            // Click to remove
            hitArea.addEventListener('click', (e) => {
                if (!e.shiftKey) {
                    e.stopPropagation();
                    removeConnection(connection);
                }
            });
            
            // Click label to change type
            [text, labelBg].forEach(el => {
                el.addEventListener('click', (e) => {
                    e.stopPropagation();
                    const rect = text.getBoundingClientRect();
                    showConnectionTypeSelector(connection, rect.left + rect.width / 2, rect.bottom + 5);
                });
            });
            
            // Shift+click to change type
            hitArea.addEventListener('click', (e) => {
                if (e.shiftKey) {
                    e.stopPropagation();
                    const rect = text.getBoundingClientRect();
                    showConnectionTypeSelector(connection, rect.left + rect.width / 2, rect.bottom + 5);
                }
            });
        }
        
        function removeConnection(connection) {
            const index = state.connections.indexOf(connection);
            if (index > -1) {
                state.connections.splice(index, 1);
                connection.group.remove();
                connection.output.classList.remove('connected');
                connection.input.classList.remove('connected');
            }
        }
        
        function updateConnection(connection) {
            if (!connection.output || !connection.input) return;
            
            const outputRect = connection.output.getBoundingClientRect();
            const inputRect = connection.input.getBoundingClientRect();
            const containerRect = document.getElementById('canvas-container').getBoundingClientRect();
            
            const x1 = outputRect.left + outputRect.width / 2 - containerRect.left;
            const y1 = outputRect.top + outputRect.height / 2 - containerRect.top;
            const x2 = inputRect.left + inputRect.width / 2 - containerRect.left;
            const y2 = inputRect.top + inputRect.height / 2 - containerRect.top;
            
            const path = calculateBezierPath(x1, y1, x2, y2);
            connection.path.setAttribute('d', path);
            connection.hitArea.setAttribute('d', path);
            
            // Position label at midpoint
            const mx = (x1 + x2) / 2;
            const my = (y1 + y2) / 2;
            
            // Update label background
            const bbox = { width: 30, height: 24 }; // Approximate size
            connection.labelBg.setAttribute('x', mx - bbox.width / 2);
            connection.labelBg.setAttribute('y', my - bbox.height / 2 - 3);
            connection.labelBg.setAttribute('width', bbox.width);
            connection.labelBg.setAttribute('height', bbox.height);
            
            connection.label.setAttribute('x', mx);
            connection.label.setAttribute('y', my + 2);
        }
        
        function updateAllConnections() {
            state.connections.forEach(updateConnection);
        }
        
        function calculateBezierPath(x1, y1, x2, y2) {
            const dx = Math.abs(x2 - x1);
            const tension = Math.min(dx * 0.5, 150);
            const cp1x = x1 + tension;
            const cp2x = x2 - tension;
            
            return `M ${x1} ${y1} C ${cp1x} ${y1}, ${cp2x} ${y2}, ${x2} ${y2}`;
        }
        
        function highlightCompatiblePorts(e) {
            const ports = document.querySelectorAll('.port');
            const threshold = 50;
            
            ports.forEach(p => {
                if (p !== state.connectingPort.port && p.dataset.type !== state.connectingPort.port.dataset.type) {
                    const rect = p.getBoundingClientRect();
                    const dist = Math.hypot(
                        e.clientX - (rect.left + rect.width / 2),
                        e.clientY - (rect.top + rect.height / 2)
                    );
                    
                    if (dist < threshold && isValidConnection(state.connectingPort, p)) {
                        p.classList.add('highlight');
                    } else {
                        p.classList.remove('highlight');
                    }
                }
            });
        }
        
        function isValidConnection(source, targetPort) {
            if (source.port.dataset.type === targetPort.dataset.type) return false;
            
            if (targetPort.dataset.type === 'input' && targetPort.classList.contains('connected')) {
                return false;
            }
            
            return true;
        }
        
        function findPortOwner(port) {
            for (let flow of state.flows) {
                if (flow.ports && Object.values(flow.ports).includes(port)) return flow;
            }
            return null;
        }
        
        // Selection
        function startSelection(e) {
            state.isSelecting = true;
            state.canvas.classList.add('selecting');
            
            const rect = state.canvas.getBoundingClientRect();
            const startX = (e.clientX - rect.left - state.panX) / state.zoom;
            const startY = (e.clientY - rect.top - state.panY) / state.zoom;
            
            state.selectionBox = document.createElement('div');
            state.selectionBox.className = 'selection-box';
            state.canvas.appendChild(state.selectionBox);
            
            function updateSelection(e) {
                const currentX = (e.clientX - rect.left - state.panX) / state.zoom;
                const currentY = (e.clientY - rect.top - state.panY) / state.zoom;
                
                const left = Math.min(startX, currentX);
                const top = Math.min(startY, currentY);
                const width = Math.abs(currentX - startX);
                const height = Math.abs(currentY - startY);
                
                state.selectionBox.style.left = left + 'px';
                state.selectionBox.style.top = top + 'px';
                state.selectionBox.style.width = width + 'px';
                state.selectionBox.style.height = height + 'px';
                
                selectItemsInBox(left, top, width, height);
            }
            
            function endSelection() {
                state.isSelecting = false;
                state.canvas.classList.remove('selecting');
                if (state.selectionBox) {
                    state.selectionBox.remove();
                    state.selectionBox = null;
                }
                document.removeEventListener('mousemove', updateSelection);
                document.removeEventListener('mouseup', endSelection);
            }
            
            document.addEventListener('mousemove', updateSelection);
            document.addEventListener('mouseup', endSelection);
        }
        
        function selectItemsInBox(x, y, w, h) {
            state.selectedItems.clear();

            state.flows.forEach(flow => {
                const el = flow.element;
                const flowX = parseInt(el.style.left);
                const flowY = parseInt(el.style.top);
                const flowW = el.offsetWidth;
                const flowH = el.offsetHeight;

                if (flowX < x + w && flowX + flowW > x &&
                    flowY < y + h && flowY + flowH > y) {
                    state.selectedItems.add(flow);
                    el.classList.add('selected');
                } else {
                    el.classList.remove('selected');
                }
            });

            state.groups.forEach(group => {
                const el = group.element;
                const gX = parseInt(el.style.left);
                const gY = parseInt(el.style.top);
                const gW = el.offsetWidth;
                const gH = el.offsetHeight;

                if (gX < x + w && gX + gW > x &&
                    gY < y + h && gY + gH > y) {
                    state.selectedItems.add(group);
                    el.classList.add('selected');
                } else {
                    el.classList.remove('selected');
                }
            });
        }
        
        function deleteSelected() {
            state.selectedItems.forEach(item => {
                if (item.element) {
                    state.connections = state.connections.filter(conn => {
                        if (conn.outputOwner === item || conn.inputOwner === item) {
                            conn.group.remove();
                            conn.output.classList.remove('connected');
                            conn.input.classList.remove('connected');
                            return false;
                        }
                        return true;
                    });

                    item.element.remove();
                    state.flows = state.flows.filter(f => f !== item);
                    state.groups = state.groups.filter(g => g !== item);
                }
            });

            state.selectedItems.clear();
            updateAvailableRoles(); // Update roles after deletion
        }

        function serializeFlow(flow) {
            return {
                x: flow.x,
                y: flow.y,
                collapsed: flow.collapsed,
                label: flow.label,
                nodes: flow.nodes.map(n => {
                    const data = { type: n.type };
                    if (n.roles) data.roles = [...n.roles];
                    if (n.transformType) data.transformType = n.transformType;
                    if (n.text) data.text = n.text;
                    if (typeof n.hasRoleAfter !== 'undefined') data.hasRoleAfter = n.hasRoleAfter;
                    if (n.entity) data.entity = n.entity;
                    return data;
                })
            };
        }

        function copySelectedFlows() {
            const flows = Array.from(state.selectedItems).filter(item => state.flows.includes(item));
            if (flows.length === 0) return;
            state.clipboard = flows.map(f => serializeFlow(f));
        }

        function cutSelectedFlows() {
            const flows = Array.from(state.selectedItems).filter(item => state.flows.includes(item));
            if (flows.length === 0) return;
            state.clipboard = flows.map(f => serializeFlow(f));
            deleteSelected();
        }

        function pasteFlows() {
            if (!state.clipboard || state.clipboard.length === 0) return;
            const offset = 20;
            state.clipboard.forEach(data => {
                const clone = JSON.parse(JSON.stringify(data));
                const flow = createFlow(clone.x + offset, clone.y + offset);

                flow.label = clone.label;
                const labelEl = flow.element.querySelector('.flow-label');
                if (labelEl) labelEl.textContent = flow.label;

                if (clone.collapsed !== flow.collapsed) {
                    App.toggleFlow(flow.id);
                }

                flow.contentElement.innerHTML = '';
                flow.nodes = [];
                clone.nodes.forEach(nodeData => {
                    const node = createNodeInFlow(flow, nodeData.type, nodeData);
                    flow.nodes.push(node);
                });
                resizeFlowToFitContent(flow);
                updateFlowGrammar(flow);
            });
            updateAvailableRoles();
        }
        
        // Modal
