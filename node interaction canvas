        </div>
        <div class="connection-type-option" data-type="constitution">
            <span>☯</span>
            <div class="connection-type-tooltip">Mutual</div>
        </div>
        <div class="connection-type-option" data-type="instance">
            <span>△</span>
            <div class="connection-type-tooltip">Pattern</div>
        </div>
        <div class="connection-type-option" data-type="nullification">
            <span>∅</span>
            <div class="connection-type-tooltip">Block</div>
