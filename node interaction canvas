                                <option value="Okays" ${node.transformType === 'Okays' ? 'selected' : ''}>Okays (approves/validates)</option>
                                <option value="Shares" ${node.transformType === 'Shares' ? 'selected' : ''}>Shares (communicates/sends)</option>
                            </select>
                        </div>
                    `;
                    break;
                    
                case 'action':
                    title.textContent = 'Edit Action';
                    content.innerHTML = `
                        <div class="form-group">
                            <label>Action Description</label>
                            <textarea id="actionText" placeholder="e.g., process invoices, review proposals...">${node.text}</textarea>
                        </div>
                        <div class="form-group">
                            <label>
                                <input type="checkbox" id="hasRoleAfter" ${node.hasRoleAfter ? 'checked' : ''}>
                                Has a recipient or target role
                            </label>
                        </div>
                    `;
                    break;
                    
                case 'operand':
                    title.textContent = 'Edit Target/Recipient';
                    content.innerHTML = `
                        <div class="form-group">
                            <label>Select Target Role</label>
                            <select id="operandEntity">
                                ${availableEntities.map(entity => `
                                    <option value="${entity}" ${node.entity === entity ? 'selected' : ''}>${entity}</option>
                                `).join('')}
                            </select>
                        </div>
                    `;
                    break;
            }
        }
        
        function updateRoleDisplay(node) {
            const roleEl = node.element.querySelector('.node-role');
            if (!roleEl) return;
            
            const content = roleEl.querySelector('.node-role-content');
            const tags = roleEl.querySelector('.node-role-tags');
            
            if (!content || !tags) return;
            
            if (!node.roles || node.roles.length === 0) {
                content.textContent = 'Select roles...';
                tags.innerHTML = '';
            } else {
                content.textContent = node.roles[0];
                tags.innerHTML = node.roles.slice(1).map(role => 
                    `<span class="role-tag">${role}</span>`
                ).join('');
            }
        }
        
        // Role Filtering
        function updateAvailableRoles() {
            state.availableRoles.clear();
            
            // Extract all roles from flows
            state.flows.forEach(flow => {
                if (flow.nodes) {
                    flow.nodes.forEach(node => {
                        if (node.type === 'role' && node.roles) {
                            node.roles.forEach(role => state.availableRoles.add(role));
                        }
                    });
                }
            });
            
            // Update role filter bar
            const roleChips = document.querySelector('.role-chips');
            if (!roleChips) return;
            
            // Keep the "All" chip and add role chips
            const allChip = roleChips.querySelector('[data-role="all"]');
            roleChips.innerHTML = '';
            roleChips.appendChild(allChip);
            
            Array.from(state.availableRoles).sort().forEach(role => {
                const chip = document.createElement('div');
                chip.className = 'role-chip';
                chip.setAttribute('data-role', role);
                chip.textContent = role;
                chip.onclick = () => App.toggleRoleFilter(role);
                roleChips.appendChild(chip);
            });
        }
        
        function getFlowRoles(flow) {
            const roles = new Set();
            if (flow.nodes) {
                flow.nodes.forEach(node => {
                    if (node.type === 'role' && node.roles) {
                        node.roles.forEach(role => roles.add(role));
                    }
                });
            }
            return roles;
        }
        
        function applyRoleFilter() {
            const statusEl = document.querySelector('.filter-status');
            
            if (state.activeRoles.has('all')) {
                // Show all flows normally
                state.flows.forEach(flow => {
                    flow.element.classList.remove('dimmed', 'hidden', 'highlighted');
                });
                state.connections.forEach(conn => {
                    conn.group.classList.remove('dimmed', 'hidden');
                });
                if (statusEl) statusEl.textContent = '';
                return;
            }
            
            // Apply role-based filtering
            let visibleCount = 0;
            let totalCount = state.flows.length;
            
            state.flows.forEach(flow => {
                const flowRoles = getFlowRoles(flow);
                const hasActiveRole = Array.from(state.activeRoles).some(role => flowRoles.has(role));
                
                flow.element.classList.remove('dimmed', 'hidden', 'highlighted');
                
                if (hasActiveRole) {
                    flow.element.classList.add('highlighted');
                    visibleCount++;
                } else {
                    if (state.filterMode === 'hide') {
                        flow.element.classList.add('hidden');
                    } else {
                        flow.element.classList.add('dimmed');
                        visibleCount++;
                    }
                }
            });
            
            // Update connections based on flow visibility
            state.connections.forEach(conn => {
                const outputVisible = !conn.outputOwner.element.classList.contains('hidden');
                const inputVisible = !conn.inputOwner.element.classList.contains('hidden');
                const outputDimmed = conn.outputOwner.element.classList.contains('dimmed');
                const inputDimmed = conn.inputOwner.element.classList.contains('dimmed');
                
                conn.group.classList.remove('dimmed', 'hidden');
                
                if (!outputVisible || !inputVisible) {
                    conn.group.classList.add('hidden');
                } else if (outputDimmed && inputDimmed) {
                    conn.group.classList.add('dimmed');
                }
            });
            
            // Update status text
            if (statusEl) {
                if (state.filterMode === 'hide') {
                    statusEl.textContent = `Showing ${visibleCount} of ${totalCount} flows`;
                } else {
                    const highlightedCount = document.querySelectorAll('.flow.highlighted').length;
                    statusEl.textContent = `${highlightedCount} relevant flows`;
                }
            }
        }
        
        // Export public functions
        App.createNewFlow = function() {
            const viewportCenterX = (window.innerWidth / 2 - state.panX) / state.zoom;
            const viewportCenterY = (window.innerHeight / 2 - state.panY) / state.zoom;
            
            const x = viewportCenterX + (Math.random() - 0.5) * 100;
            const y = viewportCenterY + (Math.random() - 0.5) * 100;
            
            const flow = createFlow(x, y);
            
            const templates = [
                { role: 'Manager', action: 'okays', text: 'budget requests' },
                { role: 'Developer', action: 'shares', text: 'code updates', hasOperand: true },
                { role: 'Designer', action: 'does', text: 'create mockups' },
                { role: 'QA Engineer', action: 'okays', text: 'release builds' },
                { role: 'Product Owner', action: 'shares', text: 'requirements', hasOperand: true },
                { role: 'Sales', action: 'does', text: 'process orders' },
                { role: 'Finance', action: 'okays', text: 'expense reports' },
                { role: 'HR', action: 'shares', text: 'policy updates', hasOperand: true }
            ];
            
            const template = templates[Math.floor(Math.random() * templates.length)];
            
            if (flow.nodes[0]) flow.nodes[0].roles = [template.role];
            if (flow.nodes[1]) flow.nodes[1].transformType = template.action.charAt(0).toUpperCase() + template.action.slice(1);
            if (flow.nodes[2]) {
                flow.nodes[2].text = template.text;
                flow.nodes[2].hasRoleAfter = template.hasOperand || false;
            }
            
            populateFlow(flow);
            updateFlowIcon(flow);
            updateAvailableRoles(); // Update role filter when new flow is created
            
            return flow;
        };
        
        App.zoomIn = function() {
            state.zoom = Math.min(5, state.zoom * 1.2);
            updateCanvasTransform();
            updateZoomDisplay();
        };
        
        App.zoomOut = function() {
            state.zoom = Math.max(0.1, state.zoom / 1.2);
            updateCanvasTransform();
            updateZoomDisplay();
        };
        
        App.resetZoom = function() {
            state.zoom = 1;
            state.panX = 0;
            state.panY = 0;
            updateCanvasTransform();
            updateZoomDisplay();
        };
        
        App.fitToContent = function() {
            if (state.flows.length === 0) return;
            
            let minX = Infinity, minY = Infinity;
            let maxX = -Infinity, maxY = -Infinity;
            
            state.flows.forEach(flow => {
                const x = parseInt(flow.element.style.left);
                const y = parseInt(flow.element.style.top);
                const w = flow.element.offsetWidth;
                const h = flow.element.offsetHeight;
                
                minX = Math.min(minX, x);
                minY = Math.min(minY, y);
                maxX = Math.max(maxX, x + w);
                maxY = Math.max(maxY, y + h);
            });
            
            const padding = 50;
            const contentWidth = maxX - minX + padding * 2;
            const contentHeight = maxY - minY + padding * 2;
            const viewportWidth = window.innerWidth;
            const viewportHeight = window.innerHeight;
            
            const scaleX = viewportWidth / contentWidth;
            const scaleY = viewportHeight / contentHeight;
            state.zoom = Math.min(scaleX, scaleY, 1);
            
            state.panX = (viewportWidth - contentWidth * state.zoom) / 2 - (minX - padding) * state.zoom;
            state.panY = (viewportHeight - contentHeight * state.zoom) / 2 - (minY - padding) * state.zoom;
            
            updateCanvasTransform();
            updateZoomDisplay();
        };

        App.autoLayout = function() {
            if (state.flows.length === 0) return;

            const g = new dagre.graphlib.Graph();
            g.setGraph({ rankdir: 'LR', nodesep: 50, ranksep: 100 });
            g.setDefaultEdgeLabel(() => ({}));

            state.flows.forEach(flow => {
                const width = flow.element.offsetWidth;
                const height = flow.element.offsetHeight;
                g.setNode(flow.id, { width, height });
            });

            state.connections.forEach(conn => {
                if (conn.outputOwner && conn.inputOwner) {
                    g.setEdge(conn.outputOwner.id, conn.inputOwner.id);
                }
            });

            dagre.layout(g);

            g.nodes().forEach(id => {
                const node = g.node(id);
                const flow = state.flows.find(f => f.id === id);
                if (flow) {
                    flow.element.style.left = (node.x - node.width / 2) + 'px';
                    flow.element.style.top = (node.y - node.height / 2) + 'px';
                }
            });

            scheduleUpdate(() => updateAllConnections());
            App.fitToContent();
        };
        
        App.toggleFlow = function(flowId) {
            const flow = state.flows.find(f => f.id === flowId);
            if (!flow) return;
            
            flow.collapsed = !flow.collapsed;
            flow.element.classList.toggle('collapsed');
            
            const control = flow.element.querySelector('.flow-control');
            if (control) control.textContent = flow.collapsed ? '▶' : '▼';
            
            // Update connections after transition
            setTimeout(() => {
                scheduleUpdate(() => {
                    updateAllConnections();
                    updateMinimap();
                });
            }, 50);
        };
        
        App.groupSelected = function() {
            if (state.selectedItems.size < 2) return;

            const id = state.groupIdCounter++;
            const group = {
                id: 'group-' + id,
                items: Array.from(state.selectedItems),
                roles: new Set(),
                element: null
            };

            let minX = Infinity, minY = Infinity;
            let maxX = -Infinity, maxY = -Infinity;

            group.items.forEach(item => {
                const el = item.element;
                const x = parseInt(el.style.left);
                const y = parseInt(el.style.top);
                const w = el.offsetWidth;
                const h = el.offsetHeight;

                minX = Math.min(minX, x);
                minY = Math.min(minY, y);
                maxX = Math.max(maxX, x + w);
                maxY = Math.max(maxY, y + h);

                let itemRoles;
                if (state.flows.includes(item)) {
                    itemRoles = getFlowRoles(item);
                } else if (state.groups.includes(item)) {
                    itemRoles = new Set(item.roles);
                } else {
                    itemRoles = new Set();
                }
                itemRoles.forEach(r => group.roles.add(r));
            });

            group.roles = Array.from(group.roles);

            const groupEl = document.createElement('div');
            groupEl.className = 'group';
            groupEl.style.left = (minX - 20) + 'px';
            groupEl.style.top = (minY - 20) + 'px';
            groupEl.style.width = (maxX - minX + 40) + 'px';
            groupEl.style.height = (maxY - minY + 40) + 'px';

            const roleLabel = group.roles.join(', ') || `Group ${id}`;
            groupEl.innerHTML = `<div class="group-header" contenteditable="true">${roleLabel}</div>`;

            groupEl.addEventListener('mousedown', (e) => {
                e.stopPropagation();
                if (!e.shiftKey) {
                    state.selectedItems.clear();
                    document.querySelectorAll('.selected').forEach(el => el.classList.remove('selected'));
                }
                state.selectedItems.add(group);
                groupEl.classList.add('selected');
            });

            state.canvas.insertBefore(groupEl, state.canvas.firstChild);
            group.element = groupEl;
            state.groups.push(group);

            state.selectedItems.clear();
            document.querySelectorAll('.selected').forEach(el => el.classList.remove('selected'));
        };
        
        App.exportAsText = function() {
            let text = 'Flow Process Map\n================\n\n';
            
            text += 'Flows:\n';
            state.flows.forEach(flow => {
                text += `- ${flow.label}\n`;
            });
            
            text += '\nConnections:\n';
            state.connections.forEach(conn => {
                const type = connectionTypes[conn.type];
                text += `- ${conn.outputOwner.label} ${type.symbol} ${conn.inputOwner.label} (${type.name})\n`;
            });
            
            // Copy to clipboard
            const el = document.createElement('textarea');
            el.value = text;
            document.body.appendChild(el);
            el.select();
            document.execCommand('copy');
            document.body.removeChild(el);
            
            alert('Flow map copied to clipboard!');
        };
        
        App.closeModal = function() {
            document.getElementById('modalOverlay').style.display = 'none';
        };
        
        App.saveModal = function() {
            const modal = document.getElementById('modalOverlay');
            const node = modal.currentNode;
            
            switch(node.type) {
                case 'role':
                    const selectedRoles = [];
                    document.querySelectorAll('#roleSelect input:checked').forEach(cb => {
                        selectedRoles.push(cb.value);
                    });
                    node.roles = selectedRoles;
                    updateRoleDisplay(node);
                    updateAvailableRoles(); // Update role filter when roles change
                    break;
                    
                case 'transform':
                    node.transformType = document.getElementById('transformType').value;
                    node.element.querySelector('.node-transform-content').textContent = node.transformType;
                    node.element.className = 'node node-transform ' + node.transformType.toLowerCase();
                    break;
                    
                case 'action':
                    node.text = document.getElementById('actionText').value;
                    node.element.querySelector('.node-action-content').textContent = node.text;
                    const wasChecked = node.hasRoleAfter;
                    node.hasRoleAfter = document.getElementById('hasRoleAfter').checked;
                    node.element.querySelector('input[type="checkbox"]').checked = node.hasRoleAfter;
                    
                    if (wasChecked !== node.hasRoleAfter) {
                        updateFlowOperand(node.flow, node);
                    }
                    break;
                    
                case 'operand':
                    node.entity = document.getElementById('operandEntity').value;
                    node.element.querySelector('.node-operand-content').textContent = node.entity;
                    break;
            }
            
            if (node.flow) {
                updateFlowGrammar(node.flow);
                updateFlowIcon(node.flow);
            }
            
            App.closeModal();
        };
        
        App.toggleRoleFilter = function(role) {
            const chip = document.querySelector(`[data-role="${role}"]`);
            if (!chip) return;
            
            if (role === 'all') {
                // Clear all selections and activate "all"
                state.activeRoles.clear();
                state.activeRoles.add('all');
                document.querySelectorAll('.role-chip').forEach(c => c.classList.remove('active'));
                chip.classList.add('active');
            } else {
                // Toggle individual role
                if (state.activeRoles.has('all')) {
                    state.activeRoles.clear();
                }
                
                if (state.activeRoles.has(role)) {
                    state.activeRoles.delete(role);
                    chip.classList.remove('active');
                } else {
                    state.activeRoles.add(role);
                    chip.classList.add('active');
                }
                
                // If no roles selected, go back to "all"
                if (state.activeRoles.size === 0) {
                    state.activeRoles.add('all');
                    document.querySelector('[data-role="all"]').classList.add('active');
                }
                
                // Update "all" chip state
                document.querySelector('[data-role="all"]').classList.remove('active');
            }
            
            applyRoleFilter();
        };
        
        App.updateFilterMode = function() {
            const mode = document.querySelector('input[name="filterMode"]:checked').value;
            state.filterMode = mode;
            applyRoleFilter();
        };
        
        // Initialize when DOM is ready
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', init);
        } else {
            init();
        }
    </script>
</body>
