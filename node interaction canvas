                                <option value="Okays" ${node.transformType === 'Okays' ? 'selected' : ''}>Okays</option>
                                <option value="Shares" ${node.transformType === 'Shares' ? 'selected' : ''}>Shares</option>
                            </select>
                        </div>
                    `;
                    break;
                    
                case 'action':
                    title.textContent = 'Edit Action';
                    content.innerHTML = `
                        <div class="form-group">
                            <label>Action Description</label>
                            <textarea id="actionText" placeholder="e.g., writes meeting notes, gives reports to...">${node.text}</textarea>
                        </div>
                        <div class="form-group">
                            <label>
                                <input type="checkbox" id="hasRoleAfter" ${node.hasRoleAfter ? 'checked' : ''}>
                                A role is involved after this
                            </label>
                        </div>
                    `;
                    break;
                    
                case 'operand':
                    title.textContent = 'Edit Operand';
                    content.innerHTML = `
                        <div class="form-group">
                            <label>Select Entity</label>
                            <select id="operandEntity">
                                ${availableEntities.map(entity => `
                                    <option value="${entity}" ${node.entity === entity ? 'selected' : ''}>${entity}</option>
                                `).join('')}
                            </select>
                        </div>
                    `;
                    break;
            }
        }
        
        function updateRoleDisplay(node) {
            const content = node.element.querySelector('.node-role-content');
            const tags = node.element.querySelector('.node-role-tags');
            
            if (node.roles.length === 0) {
                content.textContent = 'Select roles...';
                tags.innerHTML = '';
            } else {
                content.textContent = node.roles[0];
                tags.innerHTML = node.roles.map(role => 
                    `<span class="role-tag">${role}</span>`
                ).join('');
            }
        }
        
        // Export public functions
        App.createNewFlow = function() {
            const viewportCenterX = (window.innerWidth / 2 - state.panX) / state.zoom;
            const viewportCenterY = (window.innerHeight / 2 - state.panY) / state.zoom;
            
            const x = viewportCenterX + (Math.random() - 0.5) * 100;
            const y = viewportCenterY + (Math.random() - 0.5) * 100;
            
            const flow = createFlow(x, y, 1);
            
            const templates = [
                { role: 'Manager', action: 'approves', text: 'budget requests' },
                { role: 'Developer', action: 'shares', text: 'code updates', hasOperand: true },
                { role: 'Designer', action: 'does', text: 'create mockups' },
                { role: 'QA Engineer', action: 'okays', text: 'release builds' },
                { role: 'Product Owner', action: 'shares', text: 'requirements', hasOperand: true }
            ];
            
            const template = templates[Math.floor(Math.random() * templates.length)];
            
            if (flow.nodes[0]) flow.nodes[0].roles = [template.role];
            if (flow.nodes[1]) flow.nodes[1].transformType = template.action.charAt(0).toUpperCase() + template.action.slice(1);
            if (flow.nodes[2]) {
                flow.nodes[2].text = template.text;
                flow.nodes[2].hasRoleAfter = template.hasOperand || false;
            }
            
            populateFlow(flow);
            
            return flow;
        };
        
        App.zoomIn = function() {
            state.zoom = Math.min(5, state.zoom * 1.2);
            updateCanvasTransform();
            updateZoomDisplay();
        };
        
        App.zoomOut = function() {
            state.zoom = Math.max(0.1, state.zoom / 1.2);
            updateCanvasTransform();
            updateZoomDisplay();
        };
        
        App.resetZoom = function() {
            state.zoom = 1;
            state.panX = 0;
            state.panY = 0;
            updateCanvasTransform();
            updateZoomDisplay();
        };
        
        App.fitToContent = function() {
            if (state.flows.length === 0) return;
            
            let minX = Infinity, minY = Infinity;
            let maxX = -Infinity, maxY = -Infinity;
            
            state.flows.forEach(flow => {
                const x = parseInt(flow.element.style.left);
                const y = parseInt(flow.element.style.top);
                const w = flow.element.offsetWidth;
                const h = flow.element.offsetHeight;
                
                minX = Math.min(minX, x);
                minY = Math.min(minY, y);
                maxX = Math.max(maxX, x + w);
                maxY = Math.max(maxY, y + h);
            });
            
            const padding = 50;
            const contentWidth = maxX - minX + padding * 2;
            const contentHeight = maxY - minY + padding * 2;
            const viewportWidth = window.innerWidth;
            const viewportHeight = window.innerHeight;
            
            const scaleX = viewportWidth / contentWidth;
            const scaleY = viewportHeight / contentHeight;
            state.zoom = Math.min(scaleX, scaleY, 1);
            
            state.panX = (viewportWidth - contentWidth * state.zoom) / 2 - (minX - padding) * state.zoom;
            state.panY = (viewportHeight - contentHeight * state.zoom) / 2 - (minY - padding) * state.zoom;
            
            updateCanvasTransform();
            updateZoomDisplay();
        };
        
        window.fitToContent = App.fitToContent;
        
        App.toggleLayer = function(level) {
            state.layerVisibility[level] = !state.layerVisibility[level];
            const btn = document.querySelector(`.layer-toggle.level-${level}`);
            btn.classList.toggle('active');
            
            state.flows.forEach(flow => {
                if (flow.level === level) {
                    flow.element.style.display = state.layerVisibility[level] ? 'block' : 'none';
                }
            });
            
            updateAllConnections();
        };
        
        App.toggleFlow = function(flowId) {
            const flow = state.flows.find(f => f.id === flowId);
            if (!flow) return;
            
            flow.collapsed = !flow.collapsed;
            flow.element.classList.toggle('collapsed');
            
            const control = flow.element.querySelector('.flow-control');
            control.textContent = flow.collapsed ? '▶' : '▼';
            
            updateAllConnections();
        };
        
        App.groupSelected = function() {
            if (state.selectedItems.size < 2) return;
            
            const group = {
                id: 'group-' + state.groupIdCounter++,
                items: Array.from(state.selectedItems),
                element: null
            };
            
            let minX = Infinity, minY = Infinity;
            let maxX = -Infinity, maxY = -Infinity;
            
            group.items.forEach(item => {
                const el = item.element;
                const x = parseInt(el.style.left);
                const y = parseInt(el.style.top);
                const w = el.offsetWidth;
                const h = el.offsetHeight;
                
                minX = Math.min(minX, x);
                minY = Math.min(minY, y);
                maxX = Math.max(maxX, x + w);
                maxY = Math.max(maxY, y + h);
            });
            
            const groupEl = document.createElement('div');
            groupEl.className = 'group';
            groupEl.style.left = (minX - 20) + 'px';
            groupEl.style.top = (minY - 20) + 'px';
            groupEl.style.width = (maxX - minX + 40) + 'px';
            groupEl.style.height = (maxY - minY + 40) + 'px';
            
            groupEl.innerHTML = `<div class="group-header" contenteditable="true">Group ${state.groupIdCounter}</div>`;
            
            state.canvas.insertBefore(groupEl, state.canvas.firstChild);
            group.element = groupEl;
            state.groups.push(group);
            
            state.selectedItems.clear();
            document.querySelectorAll('.selected').forEach(el => el.classList.remove('selected'));
        };
        
        App.closeModal = function() {
            document.getElementById('modalOverlay').style.display = 'none';
        };
        
        App.saveModal = function() {
            const modal = document.getElementById('modalOverlay');
            const node = modal.currentNode;
            
            switch(node.type) {
                case 'role':
                    const selectedRoles = [];
                    document.querySelectorAll('#roleSelect input:checked').forEach(cb => {
                        selectedRoles.push(cb.value);
                    });
                    node.roles = selectedRoles;
                    updateRoleDisplay(node);
                    break;
                    
                case 'transform':
                    node.transformType = document.getElementById('transformType').value;
                    node.element.querySelector('.node-transform-content').textContent = node.transformType;
                    node.element.className = 'node node-transform ' + node.transformType.toLowerCase();
                    break;
                    
                case 'action':
                    node.text = document.getElementById('actionText').value;
                    node.element.querySelector('.node-action-content').textContent = node.text;
                    const wasChecked = node.hasRoleAfter;
                    node.hasRoleAfter = document.getElementById('hasRoleAfter').checked;
                    node.element.querySelector('input[type="checkbox"]').checked = node.hasRoleAfter;
                    
                    if (wasChecked !== node.hasRoleAfter) {
                        updateFlowOperand(node.flow, node);
                    }
                    break;
                    
                case 'operand':
                    node.entity = document.getElementById('operandEntity').value;
                    node.element.querySelector('.node-operand-content').textContent = node.entity;
                    break;
            }
            
            if (node.flow) {
                updateFlowGrammar(node.flow);
            }
            
            App.closeModal();
        };
        
        // Initialize when DOM is ready
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', init);
        } else {
            init();
        }
    </script>
</body>
</html>
