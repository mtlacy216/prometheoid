            }
            
            const archiveUrl = `${ARCHIVE_BASE}${guid}.json`;
            document.getElementById('dev-output').textContent = `Testing: ${archiveUrl}\n\nFetching...`;
            
            try {
                const response = await fetch(archiveUrl, { mode: 'cors' });
