<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Emergency Contact QR System</title>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            padding: 20px;
        }

        .container {
            max-width: 800px;
            margin: 0 auto;
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            border-radius: 20px;
            padding: 40px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
        }

        h1 {
            color: #333;
            margin-bottom: 30px;
            text-align: center;
            font-size: 28px;
            background: linear-gradient(135deg, #667eea, #764ba2);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .tabs {
            display: flex;
            gap: 10px;
            margin-bottom: 30px;
            background: #f8f9fa;
            padding: 5px;
            border-radius: 10px;
        }

        .tab {
            flex: 1;
            padding: 12px;
            background: white;
            color: #666;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.3s;
            font-weight: 600;
        }

        .tab.active {
            background: linear-gradient(135deg, #667eea, #764ba2);
            color: white;
        }

        .tab-content {
            display: none;
        }

        .tab-content.active {
            display: block;
            animation: fadeIn 0.5s ease-out;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .form-group {
            margin-bottom: 20px;
        }

        label {
            display: block;
            margin-bottom: 8px;
            color: #555;
            font-weight: 600;
            font-size: 14px;
        }

        input, textarea, select {
            width: 100%;
            padding: 12px;
            border: 2px solid #e0e0e0;
            border-radius: 8px;
            font-size: 14px;
            transition: border-color 0.3s;
        }

        input:focus, textarea:focus, select:focus {
            outline: none;
            border-color: #667eea;
        }

        textarea {
            resize: vertical;
            min-height: 100px;
        }

        button {
            padding: 12px 24px;
            background: linear-gradient(135deg, #667eea, #764ba2);
            color: white;
            border: none;
            border-radius: 10px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            width: 100%;
            margin-top: 10px;
        }

        button:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 25px rgba(102, 126, 234, 0.3);
        }

        button:disabled {
            opacity: 0.6;
            cursor: not-allowed;
        }

        .qr-container {
            background: white;
            border-radius: 15px;
            padding: 30px;
            text-align: center;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
            margin-top: 20px;
        }

        #qrcode {
            display: inline-block;
            padding: 20px;
            background: white;
            border-radius: 10px;
        }

        .emergency-display {
            background: white;
            border-radius: 15px;
            padding: 20px;
            margin-top: 20px;
        }

        .emergency-header {
            background: linear-gradient(135deg, #f093fb, #f5576c);
            color: white;
            padding: 20px;
            border-radius: 10px;
            margin-bottom: 20px;
            text-align: center;
        }

        .contact-info {
            margin-bottom: 15px;
            padding: 15px;
            background: #f8f9fa;
            border-radius: 10px;
        }

        .contact-label {
            font-weight: 600;
            color: #666;
            margin-bottom: 5px;
            font-size: 12px;
            text-transform: uppercase;
        }

        .contact-value {
            color: #333;
            font-size: 16px;
            word-break: break-word;
        }

        .call-button {
            background: #4CAF50;
            margin-top: 15px;
        }

        .status-message {
            padding: 15px;
            border-radius: 10px;
            margin-top: 20px;
            text-align: center;
            font-weight: 600;
        }

        .status-success {
            background: #d4edda;
            color: #155724;
            border: 1px solid #c3e6cb;
        }

        .status-error {
            background: #f8d7da;
            color: #721c24;
            border: 1px solid #f5c6cb;
        }

        .status-info {
            background: #d1ecf1;
            color: #0c5460;
            border: 1px solid #bee5eb;
        }

        .loading {
            display: inline-block;
            width: 20px;
            height: 20px;
            border: 3px solid rgba(102, 126, 234, 0.3);
            border-top: 3px solid #667eea;
            border-radius: 50%;
            animation: spin 1s linear infinite;
            margin-left: 10px;
        }

        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        .qr-info {
            margin-top: 20px;
            padding: 15px;
            background: #f8f9fa;
            border-radius: 10px;
            text-align: left;
        }

        .qr-info-item {
            margin: 10px 0;
            font-size: 14px;
        }

        .qr-info-label {
            font-weight: 600;
            color: #666;
        }

        .qr-info-value {
            color: #333;
            word-break: break-all;
            font-family: 'Courier New', monospace;
            font-size: 12px;
        }

        @media (max-width: 768px) {
            .container {
                padding: 20px;
            }
            
            h1 {
                font-size: 24px;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>🚨 Emergency Contact QR System</h1>
        
        <div class="tabs">
            <button class="tab active" onclick="switchTab('create', this)">Create QR Code</button>
            <button class="tab" onclick="switchTab('read', this)">Read QR Code</button>
        </div>

        <!-- Create Tab -->
        <div id="create-tab" class="tab-content active">
            <!-- Saved QR Codes Section -->
            <div id="saved-section" style="display: none; margin-bottom: 30px;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px;">
                    <h3 style="color: #666; margin: 0;">📂 Saved QR Codes</h3>
                    <div>
                        <button onclick="exportAllQRs()" style="padding: 5px 10px; font-size: 12px; margin: 2px;">📥 Export All</button>
                        <button onclick="importQRs()" style="padding: 5px 10px; font-size: 12px; margin: 2px;">📤 Import</button>
                    </div>
                </div>
                <div id="saved-list" style="background: #f8f9fa; padding: 15px; border-radius: 10px;">
                    <!-- Saved items will appear here -->
                </div>
            </div>
            
            <form id="contact-form">
                <div class="form-group">
                    <label for="person-name">Person's Name *</label>
                    <input type="text" id="person-name" required placeholder="John Doe">
                </div>

                <h3 style="margin: 30px 0 20px; color: #666;">Emergency Contacts</h3>

                <div class="form-group">
                    <label for="contact1-name">Contact 1 - Name *</label>
                    <input type="text" id="contact1-name" required placeholder="Jane Doe">
                </div>

                <div class="form-group">
                    <label for="contact1-phone">Contact 1 - Phone *</label>
                    <input type="tel" id="contact1-phone" required placeholder="+1-555-123-4567">
                </div>

                <div class="form-group">
                    <label for="contact1-relation">Contact 1 - Relation</label>
                    <input type="text" id="contact1-relation" placeholder="Spouse, Parent, etc.">
                </div>

                <div class="form-group">
                    <label for="contact2-name">Contact 2 - Name</label>
                    <input type="text" id="contact2-name" placeholder="Bob Smith">
                </div>

                <div class="form-group">
                    <label for="contact2-phone">Contact 2 - Phone</label>
                    <input type="tel" id="contact2-phone" placeholder="+1-555-987-6543">
                </div>

                <div class="form-group">
                    <label for="contact2-relation">Contact 2 - Relation</label>
                    <input type="text" id="contact2-relation" placeholder="Brother, Friend, etc.">
                </div>

                <h3 style="margin: 30px 0 20px; color: #666;">Medical Information (Optional)</h3>

                <div class="form-group">
                    <label for="blood-type">Blood Type</label>
                    <select id="blood-type">
                        <option value="">Unknown</option>
                        <option value="A+">A+</option>
                        <option value="A-">A-</option>
                        <option value="B+">B+</option>
                        <option value="B-">B-</option>
                        <option value="AB+">AB+</option>
                        <option value="AB-">AB-</option>
                        <option value="O+">O+</option>
                        <option value="O-">O-</option>
                    </select>
                </div>

                <div class="form-group">
                    <label for="allergies">Allergies</label>
                    <textarea id="allergies" placeholder="List any allergies..."></textarea>
                </div>

                <div class="form-group">
                    <label for="medications">Current Medications</label>
                    <textarea id="medications" placeholder="List current medications..."></textarea>
                </div>

                <div class="form-group">
                    <label for="medical-conditions">Medical Conditions</label>
                    <textarea id="medical-conditions" placeholder="List any medical conditions..."></textarea>
                </div>

                <div class="form-group">
                    <label for="notes">Additional Notes</label>
                    <textarea id="notes" placeholder="Any additional important information..."></textarea>
                </div>

                <button type="submit" id="submit-btn">Generate QR Code</button>
                <button type="button" onclick="clearForm()" style="background: #6c757d; margin-top: 10px;">Clear Form</button>
            </form>

            <div id="qr-result" class="qr-container" style="display: none;">
                <h3>✅ QR Code Generated!</h3>
                <div id="qrcode"></div>
                
                <div class="qr-info">
                    <div class="qr-info-item">
                        <span class="qr-info-label">Status:</span>
                        <span id="upload-status" class="qr-info-value">Not saved to server yet</span>
                    </div>
                    <div class="qr-info-item">
                        <span class="qr-info-label">GUID:</span>
                        <span id="guid-display" class="qr-info-value"></span>
                    </div>
                    <div class="qr-info-item">
                        <span class="qr-info-label">QR URL:</span>
                        <span id="url-display" class="qr-info-value"></span>
                    </div>
                </div>
                
                <button onclick="printQRCode()">🖨️ Print QR Code</button>
                <button onclick="downloadQRCode()">💾 Download QR Code</button>
                <button onclick="testQRCode()">🔍 Test QR Code</button>
                <button onclick="saveToLocal()" style="background: #28a745;">☁️ Save to Server</button>
                <button onclick="downloadEncryptedJSON()" style="background: #17a2b8;">📄 Download JSON</button>
                <button onclick="updateExisting()" id="update-btn" style="background: #ffc107; display: none;">🔄 Update on Server</button>
            </div>

            <div id="create-status"></div>
        </div>

        <!-- Read Tab -->
        <div id="read-tab" class="tab-content">
            <div class="form-group">
                <label for="qr-url">Enter QR Code URL or GUID</label>
                <input type="text" id="qr-url" placeholder="Paste full URL or just the GUID">
                <button onclick="readEmergencyContact()">Load Emergency Contact</button>
            </div>

            <div id="emergency-display" style="display: none;">
                <!-- Emergency contact info will be displayed here -->
            </div>

            <div id="read-status"></div>
        </div>
    </div>

    <script>
        // Configuration
        const WEBHOOK_URL = 'https://n8n.intelechia.com/webhook-test/d5e99c29-2cf1-44c1-b5b4-95a1ca048441';
        const ARCHIVE_ITEM_ID = 'emergency-contacts-data'; // Default item ID for Archive.org
        
        // Global variables
        let currentTab = 'create';
        let qrcode = null;
        let currentGUID = null;
        let currentKey = null;
        let currentData = null;
        let currentEncryptedData = null; // Store encrypted data for later save
        let editingGUID = null; // Track if we're editing an existing entry

        // Initialize on load
        window.onload = function() {
            checkURLParams();
            loadSavedQRCodes();
        };

        // Check if URL has parameters (for reading QR)
        function checkURLParams() {
            const urlParams = new URLSearchParams(window.location.search);
            const guid = urlParams.get('guid');
            const hash = window.location.hash.substring(1);
            
            if (guid && hash) {
                switchTab('read', document.querySelector('.tab:nth-child(2)'));
                document.getElementById('qr-url').value = window.location.href;
                readEmergencyContact();
            }
        }

        // Tab switching
        function switchTab(tab, btn) {
            currentTab = tab;
            
            document.querySelectorAll('.tab').forEach(b => b.classList.remove('active'));
            document.querySelectorAll('.tab-content').forEach(content => content.classList.remove('active'));
            
            btn.classList.add('active');
            document.getElementById(`${tab}-tab`).classList.add('active');
        }

        // Generate GUID
        function generateGUID() {
            return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function(c) {
                const r = Math.random() * 16 | 0;
                const v = c === 'x' ? r : (r & 0x3 | 0x8);
                return v.toString(16);
            });
        }

        // Generate random key
        function generateKey(length = 32) {
            const array = new Uint8Array(length);
            crypto.getRandomValues(array);
            return btoa(String.fromCharCode.apply(null, array))
                .replace(/\+/g, '-')
                .replace(/\//g, '_')
                .replace(/=/g, '');
        }

        // Encryption functions
        async function encrypt(text, password) {
            const enc = new TextEncoder();
            const salt = crypto.getRandomValues(new Uint8Array(16));
            const iv = crypto.getRandomValues(new Uint8Array(12));
            
            const passwordKey = await crypto.subtle.importKey(
                "raw",
                enc.encode(password),
                "PBKDF2",
                false,
                ["deriveBits", "deriveKey"]
            );
            
            const aesKey = await crypto.subtle.deriveKey(
                {
                    name: "PBKDF2",
                    salt: salt,
                    iterations: 100000,
                    hash: "SHA-256"
                },
                passwordKey,
                { name: "AES-GCM", length: 256 },
                false,
                ["encrypt"]
            );
            
            const encrypted = await crypto.subtle.encrypt(
                { name: "AES-GCM", iv: iv },
                aesKey,
                enc.encode(text)
            );
            
            const encryptedContent = new Uint8Array(encrypted);
            const buf = new Uint8Array(salt.byteLength + iv.byteLength + encryptedContent.byteLength);
            buf.set(salt, 0);
            buf.set(iv, salt.byteLength);
            buf.set(encryptedContent, salt.byteLength + iv.byteLength);
            
            return btoa(String.fromCharCode(...buf));
        }

        async function decrypt(encryptedData, password) {
            const enc = new TextEncoder();
            const dec = new TextDecoder();
            
            const data = Uint8Array.from(atob(encryptedData), c => c.charCodeAt(0));
            const salt = data.slice(0, 16);
            const iv = data.slice(16, 28);
            const encrypted = data.slice(28);
            
            const passwordKey = await crypto.subtle.importKey(
                "raw",
                enc.encode(password),
                "PBKDF2",
                false,
                ["deriveBits", "deriveKey"]
            );
            
            const aesKey = await crypto.subtle.deriveKey(
                {
                    name: "PBKDF2",
                    salt: salt,
                    iterations: 100000,
                    hash: "SHA-256"
                },
                passwordKey,
                { name: "AES-GCM", length: 256 },
                false,
                ["decrypt"]
            );
            
            const decrypted = await crypto.subtle.decrypt(
                { name: "AES-GCM", iv: iv },
                aesKey,
                encrypted
            );
            
            return dec.decode(decrypted);
        }

        // Form submission
        document.getElementById('contact-form').addEventListener('submit', async function(e) {
            e.preventDefault();
            
            // If we're editing and user clicks "Generate New", reset editing mode
            if (editingGUID) {
                editingGUID = null;
                currentEncryptedData = null;
                document.getElementById('update-btn').style.display = 'none';
            }
            
            const submitBtn = document.getElementById('submit-btn');
            submitBtn.disabled = true;
            submitBtn.innerHTML = 'Generating... <span class="loading"></span>';
            
            showStatus('create-status', 'Creating encrypted emergency contact...', 'info');
            
            try {
                // Collect form data
                const contactData = {
                    personName: document.getElementById('person-name').value,
                    contacts: [
                        {
                            name: document.getElementById('contact1-name').value,
                            phone: document.getElementById('contact1-phone').value,
                            relation: document.getElementById('contact1-relation').value
                        }
                    ],
                    medical: {
                        bloodType: document.getElementById('blood-type').value,
                        allergies: document.getElementById('allergies').value,
                        medications: document.getElementById('medications').value,
                        conditions: document.getElementById('medical-conditions').value
                    },
                    notes: document.getElementById('notes').value,
                    created: new Date().toISOString(),
                    version: 1
                };
                
                // Add second contact if provided
                if (document.getElementById('contact2-name').value) {
                    contactData.contacts.push({
                        name: document.getElementById('contact2-name').value,
                        phone: document.getElementById('contact2-phone').value,
                        relation: document.getElementById('contact2-relation').value
                    });
                }
                
                currentData = contactData;
                
                // Generate GUID and key
                currentGUID = generateGUID();
                currentKey = generateKey();
                
                // Encrypt data and store for later save
                currentEncryptedData = await encrypt(JSON.stringify(contactData), currentKey);
                
                // Generate QR code immediately (before upload)
                const baseUrl = window.location.origin + window.location.pathname;
                const qrUrl = `${baseUrl}?guid=${currentGUID}#${currentKey}`;
                
                generateQRCode(qrUrl);
                
                // Display results
                document.getElementById('guid-display').textContent = currentGUID;
                document.getElementById('url-display').textContent = qrUrl;
                document.getElementById('qr-result').style.display = 'block';
                
                // Set status - not uploaded yet
                document.getElementById('upload-status').textContent = '⚠️ Not saved to server yet';
                document.getElementById('upload-status').style.color = '#ffc107';
                
                showStatus('create-status', '✅ QR code generated! Click "Save to Server" to upload.', 'success');
                
            } catch (error) {
                showStatus('create-status', 'Error: ' + error.message, 'error');
                console.error(error);
            } finally {
                submitBtn.disabled = false;
                submitBtn.innerHTML = 'Generate QR Code';
                submitBtn.textContent = 'Generate QR Code';
            }
        });

        // Generate QR code
        function generateQRCode(text) {
            const qrContainer = document.getElementById('qrcode');
            qrContainer.innerHTML = '';
            
            qrcode = new QRCode(qrContainer, {
                text: text,
                width: 300,
                height: 300,
                colorDark: '#000000',
                colorLight: '#ffffff',
                correctLevel: QRCode.CorrectLevel.H
            });
        }

        // Read emergency contact
        async function readEmergencyContact() {
            const input = document.getElementById('qr-url').value.trim();
            if (!input) {
                showStatus('read-status', 'Please enter a QR code URL or GUID', 'error');
                return;
            }
            
            showStatus('read-status', 'Loading emergency contact...', 'info');
            
            try {
                let guid, key;
                
                // Check if input is full URL or just GUID
                if (input.includes('?')) {
                    // Full URL
                    const urlObj = new URL(input);
                    guid = urlObj.searchParams.get('guid');
                    key = urlObj.hash.substring(1);
                } else if (input.includes('#')) {
                    // GUID with key
                    [guid, key] = input.split('#');
                } else {
                    // Just GUID - need key
                    showStatus('read-status', 'Please provide the full QR URL including the encryption key', 'error');
                    return;
                }
                
                if (!guid || !key) {
                    throw new Error('Invalid QR code URL - missing GUID or key');
                }
                
                // Fetch from Archive.org (no auth needed for reading)
                const archiveUrl = `https://archive.org/download/${ARCHIVE_ITEM_ID}/${guid}.json`;
                const response = await fetch(archiveUrl);
                
                if (!response.ok) {
                    throw new Error('Could not fetch emergency contact data. It may not be uploaded yet.');
                }
                
                const encryptedData = await response.text();
                
                // Decrypt
                const decryptedData = await decrypt(encryptedData, key);
                const contactData = JSON.parse(decryptedData);
                
                // Display emergency contact
                displayEmergencyContact(contactData);
                showStatus('read-status', 'Emergency contact loaded successfully!', 'success');
                
            } catch (error) {
                showStatus('read-status', 'Error: ' + error.message, 'error');
                console.error(error);
            }
        }

        // Display emergency contact
        function displayEmergencyContact(data) {
            const display = document.getElementById('emergency-display');
            
            let html = `
                <div class="emergency-header">
                    <h2>🚨 Emergency Contact Information</h2>
                    <p>For: ${data.personName}</p>
                </div>
            `;
            
            if (data.contacts && data.contacts.length > 0) {
                data.contacts.forEach((contact, index) => {
                    html += `
                        <div class="contact-info">
                            <div class="contact-label">Emergency Contact ${index + 1}</div>
                            <div class="contact-value">${contact.name}</div>
                            <div class="contact-value">${contact.phone}</div>
                            ${contact.relation ? `<div class="contact-value">${contact.relation}</div>` : ''}
                            <button class="call-button" onclick="window.location.href='tel:${contact.phone}'">
                                📞 Call ${contact.name}
                            </button>
                        </div>
                    `;
                });
            }
            
            if (data.medical) {
                if (data.medical.bloodType) {
                    html += `
                        <div class="contact-info">
                            <div class="contact-label">Blood Type</div>
                            <div class="contact-value">${data.medical.bloodType}</div>
                        </div>
                    `;
                }
                
                if (data.medical.allergies) {
                    html += `
                        <div class="contact-info">
                            <div class="contact-label">Allergies</div>
                            <div class="contact-value">${data.medical.allergies}</div>
                        </div>
                    `;
                }
                
                if (data.medical.medications) {
                    html += `
                        <div class="contact-info">
                            <div class="contact-label">Current Medications</div>
                            <div class="contact-value">${data.medical.medications}</div>
                        </div>
                    `;
                }
                
                if (data.medical.conditions) {
                    html += `
                        <div class="contact-info">
                            <div class="contact-label">Medical Conditions</div>
                            <div class="contact-value">${data.medical.conditions}</div>
                        </div>
                    `;
                }
            }
            
            if (data.notes) {
                html += `
                    <div class="contact-info">
                        <div class="contact-label">Additional Notes</div>
                        <div class="contact-value">${data.notes}</div>
                    </div>
                `;
            }
            
            display.innerHTML = html;
            display.style.display = 'block';
        }

        // UI Helper functions
        function showStatus(elementId, message, type) {
            const element = document.getElementById(elementId);
            element.className = 'status-message status-' + type;
            element.textContent = message;
            element.style.display = 'block';
            
            if (type === 'success') {
                setTimeout(() => {
                    element.style.display = 'none';
                }, 5000);
            }
        }

        function printQRCode() {
            const printWindow = window.open('', '_blank');
            const qrCanvas = document.querySelector('#qrcode canvas');
            const qrImage = document.querySelector('#qrcode img');
            const dataUrl = qrCanvas ? qrCanvas.toDataURL() : (qrImage ? qrImage.src : '');
            
            printWindow.document.write(`
                <html>
                <head>
                    <title>Emergency Contact QR Code</title>
                    <style>
                        body { text-align: center; padding: 20px; font-family: Arial; }
                        img { max-width: 400px; margin: 20px auto; }
                        .info { margin: 20px; padding: 20px; border: 1px solid #ccc; }
                    </style>
                </head>
                <body>
                    <h1>Emergency Contact QR Code</h1>
                    <img src="${dataUrl}" />
                    <div class="info">
                        <p><strong>Person:</strong> ${currentData.personName}</p>
                        <p><strong>GUID:</strong> ${currentGUID}</p>
                        <p><strong>Created:</strong> ${new Date().toLocaleDateString()}</p>
                        <p style="color: red;"><strong>⚠️ Keep this QR code safe!</strong></p>
                    </div>
                    <script>window.print();<\/script>
                </body>
                </html>
            `);
        }

        function downloadQRCode() {
            const qrCanvas = document.querySelector('#qrcode canvas');
            const qrImage = document.querySelector('#qrcode img');
            const link = document.createElement('a');
            link.download = `emergency-qr-${currentData.personName.replace(/\s+/g, '-')}.png`;
            
            if (qrCanvas) {
                link.href = qrCanvas.toDataURL();
            } else if (qrImage) {
                link.href = qrImage.src;
            }
            
            link.click();
        }
        
        async function downloadEncryptedJSON() {
            if (!currentGUID || !currentKey || !currentData) {
                showStatus('create-status', 'No data to download', 'error');
                return;
            }
            
            // Use existing encrypted data or encrypt current data
            const encryptedData = currentEncryptedData || await encrypt(JSON.stringify(currentData), currentKey);
            
            // Create JSON object with all necessary info
            const exportData = {
                guid: currentGUID,
                encryptedData: encryptedData,
                itemId: ARCHIVE_ITEM_ID,
                created: currentData.created,
                personName: currentData.personName,
                // Include the QR URL for reference (key is in fragment)
                qrUrl: `${window.location.origin}${window.location.pathname}?guid=${currentGUID}#${currentKey}`
            };
            
            const blob = new Blob([JSON.stringify(exportData, null, 2)], { type: 'application/json' });
            const url = URL.createObjectURL(blob);
            const link = document.createElement('a');
            link.href = url;
            link.download = `${currentGUID}.json`;
            link.click();
            URL.revokeObjectURL(url);
            
            showStatus('create-status', '✅ Downloaded encrypted JSON file', 'success');
        }

        function testQRCode() {
            const baseUrl = window.location.origin + window.location.pathname;
            const testUrl = `${baseUrl}?guid=${currentGUID}#${currentKey}`;
            window.open(testUrl, '_blank');
        }

        // Save/Load Functions
        async function saveToLocal() {
            if (!currentGUID || !currentKey || !currentData) {
                showStatus('create-status', 'No QR code to save', 'error');
                return;
            }
            
            const saveBtn = document.querySelector('button[onclick="saveToLocal()"]');
            saveBtn.disabled = true;
            saveBtn.innerHTML = 'Saving... <span class="loading"></span>';
            showStatus('create-status', 'Saving to server...', 'info');
            
            try {
                // Use existing encrypted data or encrypt current data
                const encryptedData = currentEncryptedData || await encrypt(JSON.stringify(currentData), currentKey);
                
                // Send to webhook
                const response = await fetch(WEBHOOK_URL, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        guid: currentGUID,
                        data: encryptedData,
                        itemId: ARCHIVE_ITEM_ID,
                        timestamp: new Date().toISOString(),
                        action: 'save'
                    })
                });
                
                if (!response.ok) {
                    throw new Error('Failed to save to server');
                }
                
                // If webhook succeeded, save to localStorage
                const saved = JSON.parse(localStorage.getItem('saved-qr-codes') || '{}');
                
                // Save current QR
                saved[currentGUID] = {
                    guid: currentGUID,
                    key: currentKey,
                    name: currentData.personName,
                    created: currentData.created,
                    updated: new Date().toISOString(),
                    data: currentData
                };
                
                localStorage.setItem('saved-qr-codes', JSON.stringify(saved));
                
                // Update UI
                loadSavedQRCodes();
                document.getElementById('upload-status').textContent = '✅ Saved to server!';
                document.getElementById('upload-status').style.color = '#28a745';
                showStatus('create-status', '✅ QR code saved to server and locally!', 'success');
                
            } catch (error) {
                // Even if webhook fails, save locally
                const saved = JSON.parse(localStorage.getItem('saved-qr-codes') || '{}');
                saved[currentGUID] = {
                    guid: currentGUID,
                    key: currentKey,
                    name: currentData.personName,
                    created: currentData.created,
                    updated: new Date().toISOString(),
                    data: currentData
                };
                localStorage.setItem('saved-qr-codes', JSON.stringify(saved));
                loadSavedQRCodes();
                
                document.getElementById('upload-status').textContent = '⚠️ Saved locally only (server error)';
                document.getElementById('upload-status').style.color = '#ffc107';
                showStatus('create-status', '⚠️ Saved locally (server unavailable)', 'error');
                console.error('Save to webhook failed:', error);
            } finally {
                saveBtn.disabled = false;
                saveBtn.innerHTML = '☁️ Save to Server';
            }
        }
        
        function loadSavedQRCodes() {
            const saved = JSON.parse(localStorage.getItem('saved-qr-codes') || '{}');
            const savedSection = document.getElementById('saved-section');
            const savedList = document.getElementById('saved-list');
            
            if (Object.keys(saved).length === 0) {
                savedSection.style.display = 'none';
                return;
            }
            
            savedSection.style.display = 'block';
            
            let html = '';
            for (const [guid, item] of Object.entries(saved)) {
                const date = new Date(item.updated || item.created).toLocaleDateString();
                html += `
                    <div style="background: white; padding: 10px; margin: 10px 0; border-radius: 8px; border-left: 4px solid #667eea;">
                        <div style="display: flex; justify-content: space-between; align-items: center;">
                            <div>
                                <strong>${item.name}</strong>
                                <div style="font-size: 12px; color: #666;">
                                    GUID: ${guid.substring(0, 8)}... | Updated: ${date}
                                </div>
                            </div>
                            <div>
                                <button onclick="loadSavedQR('${guid}')" style="padding: 5px 10px; font-size: 12px; margin: 2px;">📋 Load</button>
                                <button onclick="deleteSavedQR('${guid}')" style="padding: 5px 10px; font-size: 12px; margin: 2px; background: #dc3545;">🗑️</button>
                            </div>
                        </div>
                    </div>
                `;
            }
            
            savedList.innerHTML = html;
        }
        
        async function loadSavedQR(guid) {
            const saved = JSON.parse(localStorage.getItem('saved-qr-codes') || '{}');
            const item = saved[guid];
            
            if (!item) {
                showStatus('create-status', 'Saved QR not found', 'error');
                return;
            }
            
            // Set editing mode
            editingGUID = guid;
            currentGUID = item.guid;
            currentKey = item.key;
            currentData = item.data;
            
            // Prepare encrypted data
            currentEncryptedData = await encrypt(JSON.stringify(item.data), item.key);
            
            // Fill form with saved data
            document.getElementById('person-name').value = item.data.personName || '';
            
            if (item.data.contacts && item.data.contacts[0]) {
                document.getElementById('contact1-name').value = item.data.contacts[0].name || '';
                document.getElementById('contact1-phone').value = item.data.contacts[0].phone || '';
                document.getElementById('contact1-relation').value = item.data.contacts[0].relation || '';
            }
            
            if (item.data.contacts && item.data.contacts[1]) {
                document.getElementById('contact2-name').value = item.data.contacts[1].name || '';
                document.getElementById('contact2-phone').value = item.data.contacts[1].phone || '';
                document.getElementById('contact2-relation').value = item.data.contacts[1].relation || '';
            }
            
            if (item.data.medical) {
                document.getElementById('blood-type').value = item.data.medical.bloodType || '';
                document.getElementById('allergies').value = item.data.medical.allergies || '';
                document.getElementById('medications').value = item.data.medical.medications || '';
                document.getElementById('medical-conditions').value = item.data.medical.conditions || '';
            }
            
            document.getElementById('notes').value = item.data.notes || '';
            
            // Generate QR code
            const baseUrl = window.location.origin + window.location.pathname;
            const qrUrl = `${baseUrl}?guid=${currentGUID}#${currentKey}`;
            generateQRCode(qrUrl);
            
            // Display results
            document.getElementById('guid-display').textContent = currentGUID;
            document.getElementById('url-display').textContent = qrUrl;
            document.getElementById('upload-status').textContent = '✅ Loaded from local storage';
            document.getElementById('upload-status').style.color = '#28a745';
            document.getElementById('qr-result').style.display = 'block';
            
            // Show update button
            document.getElementById('update-btn').style.display = 'inline-block';
            
            // Change submit button text
            document.getElementById('submit-btn').textContent = 'Generate New QR Code';
            
            showStatus('create-status', '✅ Loaded saved QR code. You can update it or generate a new one.', 'success');
        }
        
        function deleteSavedQR(guid) {
            if (!confirm('Delete this saved QR code?')) return;
            
            const saved = JSON.parse(localStorage.getItem('saved-qr-codes') || '{}');
            delete saved[guid];
            localStorage.setItem('saved-qr-codes', JSON.stringify(saved));
            
            loadSavedQRCodes();
            showStatus('create-status', 'QR code deleted', 'info');
            
            // If we were editing this one, clear the form
            if (editingGUID === guid) {
                clearForm();
            }
        }
        
        async function updateExisting() {
            if (!currentGUID || !currentKey) {
                showStatus('create-status', 'No QR code to update', 'error');
                return;
            }
            
            const updateBtn = document.getElementById('update-btn');
            updateBtn.disabled = true;
            updateBtn.innerHTML = 'Updating... <span class="loading"></span>';
            
            try {
                // Collect updated form data
                const contactData = {
                    personName: document.getElementById('person-name').value,
                    contacts: [
                        {
                            name: document.getElementById('contact1-name').value,
                            phone: document.getElementById('contact1-phone').value,
                            relation: document.getElementById('contact1-relation').value
                        }
                    ],
                    medical: {
                        bloodType: document.getElementById('blood-type').value,
                        allergies: document.getElementById('allergies').value,
                        medications: document.getElementById('medications').value,
                        conditions: document.getElementById('medical-conditions').value
                    },
                    notes: document.getElementById('notes').value,
                    created: currentData.created || new Date().toISOString(),
                    updated: new Date().toISOString(),
                    version: (currentData.version || 1) + 1
                };
                
                // Add second contact if provided
                if (document.getElementById('contact2-name').value) {
                    contactData.contacts.push({
                        name: document.getElementById('contact2-name').value,
                        phone: document.getElementById('contact2-phone').value,
                        relation: document.getElementById('contact2-relation').value
                    });
                }
                
                currentData = contactData;
                
                // Encrypt with same key and store
                const encryptedData = await encrypt(JSON.stringify(contactData), currentKey);
                currentEncryptedData = encryptedData;
                
                // Upload update to webhook
                document.getElementById('upload-status').textContent = 'Updating on server...';
                document.getElementById('upload-status').style.color = '#ffc107';
                
                const response = await fetch(WEBHOOK_URL, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        guid: currentGUID,
                        data: encryptedData,
                        itemId: ARCHIVE_ITEM_ID,
                        timestamp: new Date().toISOString(),
                        action: 'update'
                    })
                });
                
                if (response.ok) {
                    document.getElementById('upload-status').textContent = '✅ Updated successfully!';
                    document.getElementById('upload-status').style.color = '#28a745';
                    
                    // Update local storage
                    saveToLocal();
                    
                    showStatus('create-status', '✅ QR code updated successfully!', 'success');
                } else {
                    throw new Error('Update failed');
                }
            } catch (error) {
                document.getElementById('upload-status').textContent = '⚠️ Update failed';
                document.getElementById('upload-status').style.color = '#dc3545';
                showStatus('create-status', 'Update failed: ' + error.message, 'error');
            } finally {
                updateBtn.disabled = false;
                updateBtn.innerHTML = '🔄 Update on Server';
            }
        }
        
        function clearForm() {
            document.getElementById('contact-form').reset();
            document.getElementById('qr-result').style.display = 'none';
            document.getElementById('update-btn').style.display = 'none';
            document.getElementById('submit-btn').textContent = 'Generate QR Code';
            
            editingGUID = null;
            currentGUID = null;
            currentKey = null;
            currentData = null;
            currentEncryptedData = null;
            
            showStatus('create-status', 'Form cleared', 'info');
        }
        
        // Add export/import all saved QRs
        function exportAllQRs() {
            const saved = localStorage.getItem('saved-qr-codes');
            if (!saved || saved === '{}') {
                showStatus('create-status', 'No saved QR codes to export', 'error');
                return;
            }
            
            const blob = new Blob([saved], { type: 'application/json' });
            const url = URL.createObjectURL(blob);
            const link = document.createElement('a');
            link.href = url;
            link.download = `emergency-qr-backup-${new Date().toISOString().split('T')[0]}.json`;
            link.click();
            URL.revokeObjectURL(url);
            
            showStatus('create-status', '✅ Exported all saved QR codes', 'success');
        }
        
        function importQRs() {
            const input = document.createElement('input');
            input.type = 'file';
            input.accept = '.json';
            
            input.onchange = async (e) => {
                const file = e.target.files[0];
                const text = await file.text();
                
                try {
                    const imported = JSON.parse(text);
                    const existing = JSON.parse(localStorage.getItem('saved-qr-codes') || '{}');
                    
                    // Merge imported with existing
                    const merged = { ...existing, ...imported };
                    localStorage.setItem('saved-qr-codes', JSON.stringify(merged));
                    
                    loadSavedQRCodes();
                    showStatus('create-status', '✅ Imported QR codes successfully', 'success');
                } catch (error) {
                    showStatus('create-status', 'Invalid import file', 'error');
                }
            };
            
            input.click();
        }
    </script>
</body>
</html>
