                    }
                },

                // Remove temporary relationship
                removeTempRelationship(index) {
                    this.tempRelationships.splice(index, 1);
                    
                    const listEl = document.getElementById('relationshipsList');
                    if (listEl) {
                        if (this.tempRelationships.length === 0) {
                            listEl.innerHTML = '<p style="color: var(--text-tertiary); text-align: center; margin: 16px 0; font-size: 0.875rem;">No relationships added yet (optional)</p>';
                        } else {
                            listEl.innerHTML = this.tempRelationships.map((rel, i) => `
                                <div class="added-relationship">
                                    <div class="added-relationship-text">
                                        ${this.operators[rel.operator].userTerm} ${rel.targetName} ${rel.description}
                                    </div>
                                    <button type="button" class="btn-icon btn-danger" onclick="window.app.removeTempRelationship(${i})">×</button>
                                </div>
                            `).join('');
                        }
                    }
                },

                // Complete role wizard
                completeRoleWizard(event) {
                    event.preventDefault();
                    
                    // Create the role
                    const newRole = {
                        id: Date.now(),
                        name: this.tempRoleName,
                        code: this.tempRoleCode,
                        purpose: this.tempRolePurpose,
                        responsibilities: [...this.tempResponsibilities],
                        ownership: [...this.tempOwnership],
                        operators: this.detectedOperators,
                        created: new Date().toISOString(),
                        modified: new Date().toISOString(),
                        isTemplate: false
                    };
                    
                    this.data.roles.push(newRole);
                    
                    // Create flows from relationships
                    this.tempRelationships.forEach(rel => {
                        const newFlow = {
                            id: Date.now() + Math.random(),
                            roleId: newRole.id,
                            operator: rel.operator,
                            action: this.mapOperatorToLegacyAction(rel.operator),
                            connection: rel.description || `${this.operators[rel.operator].userTerm.toLowerCase()}`,
                            counterpartRoleIds: [rel.targetId],
                            counterpartRoleNames: [rel.targetName],
                            counterpartType: 'roles',
                            strength: 0.5,
                            frequency: 'adhoc',
                            lastActive: new Date().toISOString(),
                            updated: new Date().toISOString().substring(0, 10)
                        };
                        
                        this.data.flows.push(newFlow);
                    });
                    
                    this.data.hasChanges = true;
                    if (this.data.autoSave) this.saveData();
                    
                    this.render();
                    this.updateCounts();
                    this.updateSyncStatus();
                    this.closeModal();
                    
                    // Run analytics if enabled
                    if (this.data.analyticsEnabled) {
                        this.runAnalytics();
                    }
                    
                    this.showNotification(`${newRole.name} role created successfully!`);
                },

                // Map operator to legacy action
                mapOperatorToLegacyAction(operator) {
                    const map = {
                        'DES': 'okays',
                        'SYN': 'does',
                        'CON': 'shares',
                        'REC': 'shares',
                        'INS': 'shares'
                    };
                    return map[operator] || 'shares';
                },

                // Add group modal
                showAddGroupModal() {
