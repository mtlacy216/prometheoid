                            <div class="wizard-step ${step >= 3 ? 'active' : ''}">
                                <div class="step-number">3</div>
                                <div>Relationships</div>
                            </div>
                        </div>
                    `;
                    
                    if (step === 1) {
                        content += `
                            <form id="roleWizardForm" onsubmit="window.app.nextRoleStep(event)">
