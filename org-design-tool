                                <div class="form-group">
                                    <label class="form-label">Sub-groups <span style="color: var(--text-tertiary);">(Optional)</span></label>
                                    <select class="form-select" name="childGroupIds" multiple style="height: 120px;">
                                        ${groupOptions}
                                    </select>
                                    <p style="font-size: 0.75rem; color: var(--text-secondary); margin-top: 8px;">
                                        Hold Ctrl (or Cmd on Mac) to select existing groups to nest under this one
                                    </p>
                                </div>
                                <div style="margin-top: 16px; padding: 12px; background: var(--bg-secondary); border-radius: 4px; font-size: 0.875rem;">
                                    <strong>Note:</strong> Only the group name is required. You can add roles and sub-groups at any time.
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn-secondary" onclick="window.app.closeModal()">Cancel</button>
                                <button type="submit" class="btn-primary">Add Group</button>
                            </div>
                        </form>
                    `);
                },

                // Add flow modal
                showAddFlowModal() {
                    const roleOptions = this.data.roles.map(r => 
                        `<option value="${r.id}">${r.name}</option>`
                    ).join('');

                    this.showModal(`
                        <div class="modal-header">
                            <h2 class="modal-title">Add New Flow</h2>
                            <button class="modal-close" onclick="window.app.closeModal()">×</button>
                        </div>
                        <form id="addFlowForm" onsubmit="window.app.addFlow(event)">
                            <div class="modal-body">
                                <div class="form-group">
                                    <label class="form-label">Role <span style="color: var(--accent-red);">*</span></label>
                                    <select class="form-select" name="roleId" required>
                                        <option value="">Select a role that initiates this flow</option>
                                        ${roleOptions}
                                    </select>
                                    ${this.data.roles.length === 0 ? '<p style="color: var(--accent-yellow); font-size: 0.75rem; margin-top: 4px;">⚠️ No roles defined yet. Please create roles first.</p>' : ''}
                                </div>
                                <div class="form-group">
                                    <label class="form-label">Relationship Type <span style="color: var(--accent-red);">*</span></label>
                                    <select class="form-select" name="action" required onchange="window.app.updateFlowOperator(this.value)">
                                        <option value="">Select relationship type</option>
                                        <optgroup label="Common">
                                            <option value="okays" data-operator="DES">Approves/Decides</option>
                                            <option value="shares" data-operator="CON">Partners with</option>
                                            <option value="does" data-operator="SYN">Creates from</option>
                                        </optgroup>
                                        ${this.data.analyticsEnabled ? `
                                        <optgroup label="Advanced">
                                            <option value="INS" data-operator="INS">Embodies patterns from</option>
                                            <option value="REC" data-operator="REC">Reviews/Validates</option>
                                            <option value="SEG" data-operator="SEG">Maintains boundaries</option>
                                            <option value="NUL" data-operator="NUL">Can cancel/stop</option>
                                            <option value="ALT" data-operator="ALT">Alternates with</option>
                                            <option value="SUP" data-operator="SUP">Keeps options for</option>
                                        </optgroup>
                                        ` : ''}
                                    </select>
                                    <input type="hidden" name="operator" id="flowOperator" value="">
                                    <p style="font-size: 0.75rem; color: var(--text-secondary); margin-top: 4px;">
                                        Choose the type of relationship this role has
                                    </p>
                                </div>
                                <div class="form-group">
                                    <label class="form-label">Connection <span style="color: var(--accent-red);">*</span></label>
                                    <input type="text" class="form-input" name="connection" required 
                                           placeholder="e.g., Approves budgets for, Reports status to, Manages tasks for">
                                    <p style="font-size: 0.75rem; color: var(--text-secondary); margin-top: 4px;">
                                        Describe what this role does in relation to the counterpart roles
                                    </p>
                                </div>
                                <div class="form-group">
                                    <label class="form-label">Counterpart Roles <span style="color: var(--text-tertiary);">(Optional but recommended)</span></label>
                                    <select class="form-select" name="counterpartRoles" multiple style="height: 120px;">
                                        ${roleOptions}
                                    </select>
                                    <p style="font-size: 0.75rem; color: var(--text-secondary); margin-top: 8px;">
                                        Select the roles that are affected by this flow. Hold Ctrl (or Cmd) for multiple selections.
                                    </p>
                                </div>
                                <div class="form-group">
                                    <label class="form-label">Frequency</label>
                                    <select class="form-select" name="frequency">
                                        <option value="adhoc">Ad-hoc</option>
                                        <option value="daily">Daily</option>
                                        <option value="weekly">Weekly</option>
                                        <option value="monthly">Monthly</option>
                                        <option value="quarterly">Quarterly</option>
                                    </select>
                                </div>
                                <div class="form-group">
                                    <label class="form-label">Strength</label>
                                    <input type="range" class="form-input" name="strength" min="0" max="1" step="0.1" value="0.5">
                                    <p style="font-size: 0.75rem; color: var(--text-secondary); margin-top: 4px;">
                                        How strong is this connection? (0 = weak, 1 = critical)
                                    </p>
                                </div>
                                <div style="margin-top: 16px; padding: 12px; background: var(--bg-secondary); border-radius: 4px; font-size: 0.875rem;">
                                    <strong>Example:</strong> If "Manager" <em>approves</em> "Approves discounts for" <em>Sales Associate</em>, 
                                    then Manager is the role, "Approves/Decides" is the relationship type, "Approves discounts for" is the connection, 
                                    and Sales Associate is the counterpart role.
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn-secondary" onclick="window.app.closeModal()">Cancel</button>
                                <button type="submit" class="btn-primary" ${this.data.roles.length === 0 ? 'disabled' : ''}>Add Flow</button>
                            </div>
                        </form>
                    `);
                },

                // Update flow operator
                updateFlowOperator(value) {
                    const select = document.querySelector('select[name="action"]');
                    const operatorInput = document.getElementById('flowOperator');
                    if (select && operatorInput) {
                        const selectedOption = select.options[select.selectedIndex];
                        const operator = selectedOption.getAttribute('data-operator') || value;
                        operatorInput.value = operator;
                    }
                },

                // Add person
                addPerson(event) {
                    event.preventDefault();
                    const form = event.target;
                    
                    // Validate role exists
                    const roleId = parseInt(form.roleId.value);
                    if (!roleId || !this.data.roles.find(r => r.id === roleId)) {
                        this.showNotification('Please select a valid role', 3000);
                        return;
                    }
                    
                    // Check for duplicate email
                    const email = form.email.value.trim().toLowerCase();
                    if (this.data.people.some(p => p.email.toLowerCase() === email)) {
                        this.showNotification('A person with this email already exists', 3000);
                        return;
                    }
                    
                    const newPerson = {
                        id: Date.now(),
                        name: form.name.value.trim(),
                        email: form.email.value.trim(),
                        department: form.department.value.trim(),
                        roleId: roleId,
                        startDate: form.startDate.value,
                        status: 'active',
                        isTemplate: false
                    };
                    
                    this.data.people.push(newPerson);
                    this.data.hasChanges = true;
                    if (this.data.autoSave !== false) this.saveData();
                    this.render();
                    this.updateCounts();
                    this.updateSyncStatus();
                    this.closeModal();
                    
                    // Run analytics if enabled
                    if (this.data.analyticsEnabled) {
                        this.runAnalytics();
                    }
                    
                    this.showNotification(`${newPerson.name} added successfully!`);
                },

                // Add group
                addGroup(event) {
                    event.preventDefault();
                    const form = event.target;
                    
                    const groupName = form.name.value.trim();
                    
                    // Check for duplicate group names
                    if (this.data.groups.some(g => g.name.toLowerCase() === groupName.toLowerCase())) {
                        this.showNotification('A group with this name already exists', 3000);
                        return;
                    }
                    
                    // Get selected roles
                    const selectedRoles = Array.from(form.roleIds.selectedOptions).map(option => parseInt(option.value));
                    
                    // Get selected child groups
                    const selectedChildGroups = Array.from(form.childGroupIds.selectedOptions).map(option => parseInt(option.value));
                    
                    const parentId = form.parentId.value ? parseInt(form.parentId.value) : null;
                    
                    // Check for circular references
                    if (parentId && selectedChildGroups.includes(parentId)) {
                        this.showNotification('A group cannot be both parent and child of another group', 3000);
                        return;
                    }
                    
                    const newGroup = {
                        id: Date.now(),
                        name: groupName,
                        purpose: form.purpose.value.trim(),
                        roleIds: selectedRoles,
                        childGroupIds: selectedChildGroups,
                        parentId: parentId,
                        isTemplate: false
                    };
                    
                    // Add the new group
                    this.data.groups.push(newGroup);
                    
                    // If this group has a parent, add it to the parent's childGroupIds
                    if (newGroup.parentId) {
                        const parent = this.data.groups.find(g => g.id === newGroup.parentId);
                        if (parent && !parent.childGroupIds.includes(newGroup.id)) {
                            parent.childGroupIds.push(newGroup.id);
                        }
                    }
                    
                    // Update any child groups to have this as their parent
                    selectedChildGroups.forEach(childId => {
                        const child = this.data.groups.find(g => g.id === childId);
                        if (child) {
                            // Remove from old parent if exists
                            if (child.parentId) {
                                const oldParent = this.data.groups.find(g => g.id === child.parentId);
                                if (oldParent) {
