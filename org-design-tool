                            this.previousView = 'overview';
                            
                            // Update UI
                            this.updateOrgNameDisplay();
                            this.updateCounts();
                            this.updateSyncStatus();
                            this.updateAnalyticsIndicator();
                            this.render();
                            
                            // Run analytics if enabled
