                                    <label class="form-label">Frequency</label>
                                    <select class="form-select" name="frequency">
                                        <option value="adhoc" ${flow.frequency === 'adhoc' ? 'selected' : ''}>Ad-hoc</option>
                                        <option value="daily" ${flow.frequency === 'daily' ? 'selected' : ''}>Daily</option>
                                        <option value="weekly" ${flow.frequency === 'weekly' ? 'selected' : ''}>Weekly</option>
                                        <option value="monthly" ${flow.frequency === 'monthly' ? 'selected' : ''}>Monthly</option>
                                        <option value="quarterly" ${flow.frequency === 'quarterly' ? 'selected' : ''}>Quarterly</option>
                                    </select>
                                </div>
                                <div class="form-group">
                                    <label class="form-label">Strength</label>
                                    <input type="range" class="form-input" name="strength" min="0" max="1" step="0.1" value="${flow.strength || 0.5}">
                                    <p style="font-size: 0.75rem; color: var(--text-secondary); margin-top: 4px;">
                                        Current: ${Math.round((flow.strength || 0.5) * 100)}%
                                    </p>
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn-secondary" onclick="window.app.closeModal()">Cancel</button>
                                <button type="submit" class="btn-primary">Update Flow</button>
                            </div>
                        </form>
                    `);
                },

                updateFlow(event, flowId) {
                    event.preventDefault();
                    const form = event.target;
                    const flow = this.data.flows.find(f => f.id == flowId);
                    if (!flow) return;

                    flow.roleId = parseInt(form.roleId.value);
                    flow.action = form.action.value;
                    flow.operator = form.operator.value || form.action.value;
                    flow.connection = form.connection.value.trim();
                    flow.frequency = form.frequency.value;
                    flow.strength = parseFloat(form.strength.value);
                    flow.updated = new Date().toISOString().substring(0, 10);
                    
                    // Update counterpart roles
                    const selectedOptions = Array.from(form.counterpartRoles.selectedOptions);
                    flow.counterpartRoleIds = selectedOptions.map(option => parseInt(option.value));
                    flow.counterpartRoleNames = selectedOptions.map(option => option.text);

                    this.data.hasChanges = true;
                    if (this.data.autoSave !== false) this.saveData();
                    this.render();
                    this.updateSyncStatus();
                    this.closeModal();
                    
                    // Run analytics if enabled
                    if (this.data.analyticsEnabled) {
                        this.runAnalytics();
                    }
                    
                    this.showNotification('Flow updated successfully!');
                },

                // Delete methods
                deletePerson(personId) {
                    if (!confirm('Are you sure you want to delete this person?')) return;
                    
                    const index = this.data.people.findIndex(p => p.id == personId);
                    if (index !== -1) {
                        this.data.people.splice(index, 1);
                        this.data.hasChanges = true;
                        if (this.data.autoSave !== false) this.saveData();
                        this.render();
                        this.updateCounts();
                        this.updateSyncStatus();
                        
                        // Run analytics if enabled
                        if (this.data.analyticsEnabled) {
                            this.runAnalytics();
                        }
                        
                        this.showNotification('Person deleted successfully!');
                    }
                },

                deleteRole(roleId) {
                    const peopleWithRole = this.data.people.filter(p => p.roleId === roleId);
                    const flowsWithRole = this.data.flows.filter(f => 
                        f.roleId === roleId || 
                        (f.counterpartRoleIds && f.counterpartRoleIds.includes(roleId))
                    );
                    
                    let confirmMessage = 'Are you sure you want to delete this role?';
                    if (peopleWithRole.length > 0 || flowsWithRole.length > 0) {
                        confirmMessage += `\n\nThis will affect:\n- ${peopleWithRole.length} people\n- ${flowsWithRole.length} flows`;
                    }
                    
                    if (!confirm(confirmMessage)) return;
                    
                    const index = this.data.roles.findIndex(r => r.id == roleId);
                    if (index !== -1) {
                        this.data.roles.splice(index, 1);
                        
                        // Remove role from groups
                        this.data.groups.forEach(group => {
                            const roleIndex = group.roleIds.indexOf(roleId);
                            if (roleIndex !== -1) {
                                group.roleIds.splice(roleIndex, 1);
                            }
                        });
                        
                        // Delete flows that use this role
                        this.data.flows = this.data.flows.filter(f => {
                            if (f.roleId === roleId) return false;
                            if (f.counterpartRoleIds && f.counterpartRoleIds.includes(roleId)) {
                                // Remove the role from counterparts
                                const idx = f.counterpartRoleIds.indexOf(roleId);
                                if (idx !== -1) {
                                    f.counterpartRoleIds.splice(idx, 1);
                                    f.counterpartRoleNames.splice(idx, 1);
                                }
                                // If no counterparts left, remove the flow
                                return f.counterpartRoleIds.length > 0;
                            }
                            return true;
                        });
                        
                        this.data.hasChanges = true;
                        if (this.data.autoSave !== false) this.saveData();
                        this.render();
                        this.updateCounts();
                        this.updateSyncStatus();
                        
                        // Run analytics if enabled
                        if (this.data.analyticsEnabled) {
                            this.runAnalytics();
                        }
                        
                        this.showNotification('Role deleted successfully!');
                    }
                },

                deleteGroup(groupId) {
                    if (!confirm('Are you sure you want to delete this group? The roles and sub-groups will not be deleted.')) return;
                    
                    const index = this.data.groups.findIndex(g => g.id == groupId);
                    if (index !== -1) {
                        const group = this.data.groups[index];
                        
                        // Remove from parent's childGroupIds
                        if (group.parentId) {
                            const parent = this.data.groups.find(g => g.id === group.parentId);
                            if (parent) {
                                const idx = parent.childGroupIds.indexOf(groupId);
                                if (idx !== -1) {
                                    parent.childGroupIds.splice(idx, 1);
                                }
                            }
                        }
                        
                        // Set child groups' parentId to null
                        group.childGroupIds.forEach(childId => {
                            const child = this.data.groups.find(g => g.id === childId);
                            if (child) {
                                child.parentId = null;
                            }
                        });
                        
                        this.data.groups.splice(index, 1);
                        this.data.hasChanges = true;
                        if (this.data.autoSave !== false) this.saveData();
                        this.render();
                        this.updateCounts();
                        this.updateSyncStatus();
                        
                        // Run analytics if enabled
                        if (this.data.analyticsEnabled) {
                            this.runAnalytics();
                        }
                        
                        this.showNotification('Group deleted successfully!');
                    }
                },

                deleteFlow(flowId) {
                    if (!confirm('Are you sure you want to delete this flow?')) return;
                    
                    const index = this.data.flows.findIndex(f => f.id == flowId);
                    if (index !== -1) {
                        this.data.flows.splice(index, 1);
                        this.data.hasChanges = true;
                        if (this.data.autoSave !== false) this.saveData();
                        this.render();
                        this.updateCounts();
                        this.updateSyncStatus();
                        
                        // Run analytics if enabled
                        if (this.data.analyticsEnabled) {
                            this.runAnalytics();
                        }
                        
                        this.showNotification('Flow deleted successfully!');
                    }
                },

                // Settings management
                showSettings() {
                    const modal = document.getElementById('modal');
                    const modalContent = document.getElementById('modalContent');
                    
                    modalContent.innerHTML = `
                        <div class="modal-header">
                            <h2 class="modal-title">Settings</h2>
                            <button class="modal-close" onclick="window.app.closeModal()">×</button>
                        </div>
                        <div class="modal-body">
                            <div style="display: flex; gap: 16px; margin-bottom: 24px; border-bottom: 1px solid var(--border-color);">
                                <button class="settings-tab-btn active" onclick="window.app.showSettingsTab('general')">General</button>
                                <button class="settings-tab-btn" onclick="window.app.showSettingsTab('analytics')">Analytics</button>
                                <button class="settings-tab-btn" onclick="window.app.showSettingsTab('data')">Data</button>
                                <button class="settings-tab-btn" onclick="window.app.showSettingsTab('about')">About</button>
                            </div>
                            
                            <div id="settings-general" class="settings-tab-content">
                                <h3 style="margin-bottom: 16px;">General Settings</h3>
                                <div class="checkbox-group">
                                    <label class="checkbox-label">
                                        <input type="checkbox" ${this.data.autoSave !== false ? 'checked' : ''} 
                                               onchange="window.app.toggleAutoSave(this.checked)">
                                        <div class="checkbox-text">
                                            <div class="checkbox-title">Auto-save to browser</div>
                                            <div class="checkbox-desc">Automatically save changes to browser storage</div>
                                        </div>
                                    </label>
                                    
                                    <label class="checkbox-label">
                                        <input type="checkbox" ${this.data.showInactive ? 'checked' : ''} 
                                               onchange="window.app.toggleShowInactive(this.checked)">
                                        <div class="checkbox-text">
                                            <div class="checkbox-title">Show inactive people</div>
                                            <div class="checkbox-desc">Display people with inactive status in the people list</div>
                                        </div>
                                    </label>
                                </div>
                            </div>
                            
                            <div id="settings-analytics" class="settings-tab-content" style="display: none;">
                                <h3 style="margin-bottom: 16px;">Analytics & Insights</h3>
                                <div class="checkbox-group">
                                    <label class="checkbox-label">
                                        <input type="checkbox" ${this.data.analyticsEnabled ? 'checked' : ''} 
                                               onchange="window.app.toggleAnalytics(this.checked)">
                                        <div class="checkbox-text">
                                            <div class="checkbox-title">Enable E.O. Analytics</div>
                                            <div class="checkbox-desc">Discover organizational patterns and unofficial functions</div>
                                        </div>
                                    </label>
                                </div>
                                
                                ${this.data.analyticsEnabled ? `
                                    <div style="margin-top: 24px;">
                                        <h4 style="margin-bottom: 12px;">What Analytics Provides:</h4>
                                        <ul style="margin-left: 20px; font-size: 0.875rem; color: var(--text-secondary);">
                                            <li>Role development tracking (shadow → emerging → integrated)</li>
                                            <li>Team maturity assessments</li>
                                            <li>Detection of unofficial functions</li>
                                            <li>Recommendations for role improvement</li>
                                            <li>Advanced relationship types (E.O. operators)</li>
                                        </ul>
                                        
                                        <button class="btn-primary" onclick="window.app.runAnalytics()" style="margin-top: 16px;">
                                            Refresh Analytics Now
                                        </button>
                                    </div>
                                ` : ''}
                            </div>
                            
                            <div id="settings-data" class="settings-tab-content" style="display: none;">
                                <h3 style="margin-bottom: 16px;">Data Management</h3>
                                
                                <div style="margin-bottom: 24px;">
                                    <h4 style="margin-bottom: 12px;">Export Data</h4>
                                    <button class="btn-primary" onclick="window.app.exportData()">
                                        Download as JSON
                                    </button>
                                    <p style="font-size: 0.75rem; color: var(--text-secondary); margin-top: 8px;">
                                        Save your data to a file on your computer
                                    </p>
                                </div>
                                
                                <div style="margin-bottom: 24px;">
                                    <h4 style="margin-bottom: 12px;">Replace Data</h4>
                                    <button class="btn-secondary" onclick="window.app.importData()">
                                        Replace with Another File
                                    </button>
                                    <p style="font-size: 0.75rem; color: var(--text-secondary); margin-top: 8px;">
                                        ⚠️ Warning: This will replace all current data
                                    </p>
                                </div>
                                
                                <div>
                                    <h4 style="margin-bottom: 12px;">Clear All Data</h4>
                                    <button class="btn-secondary btn-danger" onclick="window.app.clearAllData()">
                                        Delete Everything
                                    </button>
                                    <p style="font-size: 0.75rem; color: var(--text-secondary); margin-top: 8px;">
                                        ⚠️ This cannot be undone. Make sure to export first!
                                    </p>
                                </div>
                            </div>
                            
                            <div id="settings-about" class="settings-tab-content" style="display: none;">
                                <h3 style="margin-bottom: 16px;">About</h3>
                                <div style="font-size: 0.875rem; color: var(--text-secondary);">
                                    <p style="margin-bottom: 12px;">
                                        <strong>Team Operations Archive v2.0</strong><br>
                                        With E.O. (Enterprise Operators) Integration
                                    </p>
                                    <p style="margin-bottom: 12px;">
                                        Discover hidden work patterns and develop your organizational capabilities.
                                    </p>
                                    <p style="margin-bottom: 12px;">
                                        This tool helps you map your organization's real structure - not just the org chart, 
                                        but how work actually flows between people and roles.
                                    </p>
                                    <p>
                                        <strong>Privacy:</strong> All data is stored locally in your browser. 
                                        Nothing is sent to any server.
                                    </p>
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button class="btn-primary" onclick="window.app.closeModal()">Done</button>
                        </div>
                    `;
                    
                    modal.classList.add('active');
                },

                showSettingsTab(tab) {
                    // Update tab buttons
                    document.querySelectorAll('.settings-tab-btn').forEach(btn => {
                        btn.classList.remove('active');
                    });
                    event.target.classList.add('active');
                    
                    // Show/hide content
                    document.querySelectorAll('.settings-tab-content').forEach(content => {
                        content.style.display = 'none';
                    });
                    const tabContent = document.getElementById(`settings-${tab}`);
                    if (tabContent) {
                        tabContent.style.display = 'block';
                    }
                },

                toggleAutoSave(enabled) {
                    this.data.autoSave = enabled;
                    if (enabled) {
                        this.saveData();
                        this.showNotification('Auto-save enabled');
                    } else {
                        this.showNotification('Auto-save disabled');
                    }
                },

                toggleShowInactive(show) {
                    this.data.showInactive = show;
                    this.saveData();
                    this.render();
                    this.showNotification(show ? 'Showing all people' : 'Hiding inactive people');
                },

                // Save/Load data
                saveData() {
                    if (this.data.autoSave === false) return;
                    
                    const dataToSave = {
                        version: '2.0.0',
                        organizationName: this.data.organizationName,
                        people: this.data.people,
                        roles: this.data.roles,
                        groups: this.data.groups,
                        flows: this.data.flows,
                        shadowFunctions: this.data.shadowFunctions,
                        autoSave: this.data.autoSave,
                        showInactive: this.data.showInactive,
                        lastDownloadTime: this.data.lastDownloadTime,
                        originalFileName: this.data.originalFileName,
                        includesSampleData: this.data.includesSampleData,
                        analyticsEnabled: this.data.analyticsEnabled
                    };
                    
                    localStorage.setItem('teamOpsData', JSON.stringify(dataToSave));
                },

                // Export data
                exportData() {
                    const dataToExport = {
                        version: '2.0.0',
                        organizationName: this.data.organizationName,
                        analyticsEnabled: this.data.analyticsEnabled,
                        data: {
                            people: this.data.people,
                            roles: this.data.roles,
                            groups: this.data.groups,
                            flows: this.data.flows,
                            shadowFunctions: this.data.shadowFunctions
                        }
                    };
                    
                    const blob = new Blob([JSON.stringify(dataToExport, null, 2)], { type: 'application/json' });
                    const url = URL.createObjectURL(blob);
                    const a = document.createElement('a');
                    a.href = url;
                    
                    // Generate filename
                    const orgName = this.data.organizationName ? 
                        this.data.organizationName.toLowerCase().replace(/[^a-z0-9]/g, '-') : 
                        'organization';
                    const date = new Date().toISOString().substring(0, 10);
                    const filename = `team-ops-${orgName}-${date}.json`;
                    
                    a.download = filename;
                    document.body.appendChild(a);
                    a.click();
                    document.body.removeChild(a);
                    URL.revokeObjectURL(url);
                    
                    // Update download tracking
                    this.data.lastDownloadTime = new Date().toISOString();
                    this.data.hasChanges = false;
                    this.data.originalFileName = filename;
                    this.saveData();
                    this.updateSyncStatus();
                    
                    this.showNotification(`Saved as ${filename}`);
                },

                // Import data
                importData() {
                    if (!confirm('This will replace all current data. Are you sure?')) return;
                    
                    const input = document.createElement('input');
                    input.type = 'file';
                    input.accept = '.json';
                    input.onchange = (e) => {
                        const file = e.target.files[0];
                        const reader = new FileReader();
                        reader.onload = (event) => {
                            try {
                                const imported = JSON.parse(event.target.result);
                                
                                // Handle different data formats
                                if (imported.data) {
                                    this.data.people = imported.data.people || [];
                                    this.data.roles = imported.data.roles || [];
                                    this.data.groups = imported.data.groups || [];
                                    this.data.flows = imported.data.flows || [];
                                    this.data.shadowFunctions = imported.data.shadowFunctions || [];
                                } else {
                                    // Direct format
                                    this.data.people = imported.people || [];
                                    this.data.roles = imported.roles || [];
                                    this.data.groups = imported.groups || [];
                                    this.data.flows = imported.flows || [];
                                    this.data.shadowFunctions = imported.shadowFunctions || [];
                                }
                                
                                // Load settings
                                this.data.organizationName = imported.organizationName || '';
                                this.data.analyticsEnabled = imported.analyticsEnabled !== undefined ? imported.analyticsEnabled : true;
                                
                                // Reset tracking
                                this.data.lastDownloadTime = new Date().toISOString();
                                this.data.hasChanges = false;
                                this.data.originalFileName = file.name;
                                this.data.includesSampleData = false;
                                
                                // Migrate if needed
                                this.migrateDataIfNeeded();
                                
                                this.saveData();
                                this.updateOrgNameDisplay();
                                this.render();
                                this.updateCounts();
                                this.updateSyncStatus();
                                this.updateAnalyticsIndicator();
                                
                                // Run analytics if enabled
                                if (this.data.analyticsEnabled) {
                                    this.runAnalytics();
                                }
                                
                                this.closeModal();
                                this.showNotification(`Imported ${file.name} successfully!`);
                            } catch (error) {
                                this.showNotification('Failed to import file. Please check the format.');
                                console.error('Import error:', error);
                            }
                        };
                        reader.readAsText(file);
                    };
                    input.click();
                },

                // Clear all data
                clearAllData() {
                    if (!confirm('Are you sure you want to delete all data? This cannot be undone!')) return;
                    if (!confirm('This will delete EVERYTHING. Are you absolutely sure?')) return;
                    
                    this.data.people = [];
                    this.data.roles = [];
                    this.data.groups = [];
                    this.data.flows = [];
                    this.data.shadowFunctions = [];
                    this.data.organizationName = '';
                    this.data.lastDownloadTime = null;
                    this.data.hasChanges = false;
                    this.data.originalFileName = null;
                    this.data.includesSampleData = false;
                    
                    localStorage.removeItem('teamOpsData');
                    
                    this.updateOrgNameDisplay();
                    this.render();
                    this.updateCounts();
                    this.updateSyncStatus();
                    this.updateAnalyticsIndicator();
                    this.closeModal();
                    
                    this.showNotification('All data cleared');
                    
                    // Prompt to set organization name
                    setTimeout(() => {
                        this.editOrgName();
                    }, 1000);
                },

                // Show notification
                showNotification(message, duration = 3000) {
                    const existing = document.querySelector('.notification');
                    if (existing) {
                        existing.remove();
                    }
                    
                    const notification = document.createElement('div');
                    notification.className = 'notification';
                    notification.textContent = message;
                    document.body.appendChild(notification);
                    
                    setTimeout(() => {
                        notification.remove();
                    }, duration);
                },

                // Copy to clipboard
                copyToClipboard(elementId) {
                    const element = document.getElementById(elementId);
                    if (!element) return;
                    
                    const text = element.textContent || element.innerText;
                    
                    if (navigator.clipboard) {
                        navigator.clipboard.writeText(text).then(() => {
                            this.showNotification('Copied to clipboard!');
                        }).catch(() => {
                            this.fallbackCopyToClipboard(text);
                        });
                    } else {
                        this.fallbackCopyToClipboard(text);
                    }
                },

                fallbackCopyToClipboard(text) {
                    const textArea = document.createElement("textarea");
                    textArea.value = text;
                    textArea.style.position = "fixed";
                    textArea.style.left = "-999999px";
                    document.body.appendChild(textArea);
                    textArea.focus();
                    textArea.select();
                    
                    try {
                        document.execCommand('copy');
                        this.showNotification('Copied to clipboard!');
                    } catch (err) {
                        this.showNotification('Failed to copy');
                    }
                    
                document.body.removeChild(textArea);
            }
        };
        
        app.scorer = new EoRoleScorer(app.data);

        // Wait for DOM and initialize
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', () => {
                    // Update loading status
                    const loadingStatus = document.getElementById('loadingStatus');
                    if (loadingStatus) {
                        loadingStatus.textContent = 'Application ready!';
                        loadingStatus.style.color = 'var(--accent-green)';
                    }
                    
                    // Add slight delay to ensure everything is rendered
                    setTimeout(() => {
                        app.init();
                    }, 100);
                });
            } else {
                // DOM is already loaded
                setTimeout(() => {
                    app.init();
                }, 100);
            }
    </script>
</body>
</html>
