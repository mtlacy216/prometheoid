                                    <div class="wizard-content active">
                                        <div class="form-group">
                                            <label class="form-label">Role Name <span style="color: var(--accent-red);">*</span></label>
                                            <input type="text" class="form-input" id="roleName" name="name" required placeholder="e.g., Engineering Manager">
                                        </div>
                                        <div class="form-group">
                                            <label class="form-label">Role Code <span style="color: var(--accent-red);">*</span></label>
