        .card.clickable:hover {
            border-color: var(--accent-blue);
            box-shadow: 0 0 0 2px rgba(0, 102, 204, 0.2), var(--shadow-md);
        }

        .card-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: calc(var(--spacing) * 2);
