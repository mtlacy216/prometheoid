                // Confirm assign shadow
                confirmAssignShadow(event, shadowId) {
                    event.preventDefault();
                    const form = event.target;
                    const roleId = parseInt(form.roleId.value);
                    const assignType = form.assignType.value;
                    
                    const shadow = this.data.shadowFunctions.find(s => s.id == shadowId);
                    const role = this.data.roles.find(r => r.id === roleId);
                    
                    if (!shadow || !role) return;
                    
                    // Add to role
                    if (assignType === 'responsibility') {
                        if (!role.responsibilities.includes(shadow.name)) {
                            role.responsibilities.push(shadow.name);
                        }
                    } else {
                        if (!role.ownership.includes(shadow.name)) {
                            role.ownership.push(shadow.name);
                        }
                    }
                    
                    // Update role modification time
                    role.modified = new Date().toISOString();
                    
                    // Mark shadow as resolved
                    shadow.status = 'resolved';
                    shadow.resolvedBy = roleId;
                    
                    this.data.hasChanges = true;
                    if (this.data.autoSave) this.saveData();
                    
                    this.closeModal();
                    
