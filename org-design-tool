            background: var(--accent-blue);
            color: white;
            border-radius: calc(var(--spacing) * 0.5);
            font-family: inherit;
            font-size: 0.875rem;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.2s ease;
            display: flex;
            align-items: center;
            gap: calc(var(--spacing) * 1);
        }

        .btn-primary:hover {
            background: #0052A3;
            transform: translateY(-1px);
