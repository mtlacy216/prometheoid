                // Toggle operator input
                toggleOperatorInput(type) {
                    const checkbox = document.getElementById(`op-${type}`);
                    const input = document.getElementById(`op-${type}-input`);
                    if (checkbox && input) {
                        input.style.display = checkbox.checked ? 'block' : 'none';
                        if (checkbox.checked) {
                            input.focus();
                        }
                    }
                },

                // Next role step
                nextRoleStep(event) {
                    event.preventDefault();
                    const form = event.target;
                    
                    if (this.currentRoleStep === 1) {
                        // Save basic info
                        this.tempRoleName = form.name.value.trim();
                        this.tempRoleCode = form.code.value.toUpperCase().trim();
                        this.tempRolePurpose = form.purpose.value.trim();
                        
                        this.showRoleWizardStep(2);
                    } else if (this.currentRoleStep === 2) {
                        // Validate responsibilities
                        if (this.tempResponsibilities.length === 0) {
                            this.showNotification('Please add at least one responsibility', 3000);
                            return;
                        }
                        
                        // Collect operator inputs
                        this.collectOperatorInputs();
                        
                        this.showRoleWizardStep(3);
                    }
                },

                // Collect operator inputs
                collectOperatorInputs() {
                    // Clear previous
                    this.detectedOperators = {
                        identity: { INS: [], DES: [], REC: [] },
                        space: { SEG: [], NUL: [], SYN: [] },
                        time: { ALT: [], SUP: [], CON: [] }
                    };
                    
                    // Collect from checkboxes
                    if (document.getElementById('op-decides')?.checked) {
                        const value = document.getElementById('op-decides-input')?.value;
                        if (value) {
                            this.detectedOperators.identity.DES = value.split(',').map(v => v.trim()).filter(v => v);
                        }
                    }
                    
                    if (document.getElementById('op-creates')?.checked) {
                        const value = document.getElementById('op-creates-input')?.value;
                        if (value) {
                            this.detectedOperators.space.SYN = value.split(',').map(v => v.trim()).filter(v => v);
                        }
                    }
                    
                    if (document.getElementById('op-reviews')?.checked) {
                        const value = document.getElementById('op-reviews-input')?.value;
                        if (value) {
                            this.detectedOperators.identity.REC = value.split(',').map(v => v.trim()).filter(v => v);
                        }
                    }
                    
                    if (document.getElementById('op-partners')?.checked) {
                        const value = document.getElementById('op-partners-input')?.value;
                        if (value) {
                            this.detectedOperators.time.CON = value.split(',').map(v => v.trim()).filter(v => v);
                        }
                    }
                    
                    // Also detect from responsibilities
                    this.tempResponsibilities.forEach(resp => {
                        if (resp.match(/approve|decide|authorize/i)) {
                            this.detectedOperators.identity.DES.push(resp);
                        }
                        if (resp.match(/review|validate|check/i)) {
                            this.detectedOperators.identity.REC.push(resp);
                        }
                        if (resp.match(/create|design|build|develop/i)) {
                            this.detectedOperators.space.SYN.push(resp);
                        }
                    });
                },

                // Add temporary relationship
                addTempRelationship() {
                    const typeSelect = document.getElementById('relationType');
                    const targetSelect = document.getElementById('targetRole');
                    const descInput = document.getElementById('relationDescription');
                    
                    if (!targetSelect.value) {
                        this.showNotification('Please select a target role', 2000);
                        return;
                    }
                    
                    const targetRole = this.data.roles.find(r => r.id == targetSelect.value);
                    if (!targetRole) return;
                    
                    this.tempRelationships.push({
                        operator: typeSelect.value,
                        targetId: parseInt(targetSelect.value),
                        targetName: targetRole.name,
                        description: descInput.value.trim()
                    });
                    
                    // Clear inputs
                    targetSelect.value = '';
                    descInput.value = '';
                    
                    // Re-render relationships list
                    const listEl = document.getElementById('relationshipsList');
                    if (listEl) {
                        listEl.innerHTML = this.tempRelationships.map((rel, i) => `
                            <div class="added-relationship">
                                <div class="added-relationship-text">
                                    ${this.operators[rel.operator].userTerm} ${rel.targetName} ${rel.description}
                                </div>
                                <button type="button" class="btn-icon btn-danger" onclick="window.app.removeTempRelationship(${i})">×</button>
                            </div>
