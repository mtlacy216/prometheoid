        .badge-SEG { background: rgba(156, 163, 175, 0.1); color: var(--text-tertiary); }
        .badge-NUL { background: rgba(220, 38, 38, 0.1); color: var(--accent-red); }
        .badge-SYN { background: rgba(245, 158, 11, 0.1); color: var(--accent-yellow); }
        .badge-ALT { background: rgba(59, 130, 246, 0.1); color: #3B82F6; }
        .badge-SUP { background: rgba(139, 92, 246, 0.1); color: #8B5CF6; }
        .badge-CON { background: rgba(16, 185, 129, 0.1); color: var(--accent-green); }

        /* Legacy badges for backward compatibility */
        .badge-okays { background: rgba(0, 102, 204, 0.1); color: var(--accent-blue); }
        .badge-does { background: rgba(0, 168, 80, 0.1); color: var(--accent-green); }
        .badge-shares { background: rgba(245, 158, 11, 0.1); color: var(--accent-yellow); }

        .grid {
