                        } catch (e) {
                            console.error('Failed to load saved data:', e);
                            // Reset to defaults if data is corrupted
                            this.data = {
                                organizationName: '',
                                people: [],
                                roles: [],
                                groups: [],
                                flows: [],
                                shadowFunctions: [],
                                currentTheme: 'light',
                                autoSave: true,
                                showInactive: false,
                                lastDownloadTime: null,
                                hasChanges: false,
                                originalFileName: null,
                                includesSampleData: false,
                                analyticsEnabled: true
                            };
                        }
                    } else {
                        // For new users, analytics is enabled by default
                        this.data.analyticsEnabled = true;
                    }
                    
                    // Track changes
                    setInterval(() => this.updateSyncStatus(), 10000); // Update every 10 seconds

                    // Dashboard toggle
                    const toggleBtn = document.getElementById('toggleSystemHealth');
                    const healthContent = document.getElementById('systemHealthContent');
                    if (toggleBtn && healthContent) {
                        toggleBtn.addEventListener('click', () => {
                            const hidden = healthContent.classList.toggle('hidden');
                            toggleBtn.textContent = hidden ? 'Show Dashboard' : 'Hide Dashboard';
                        });
                    }
                },

                // Migrate data to add E.O. fields if needed
                migrateDataIfNeeded() {
                    let migrated = false;
                    
                    // Migrate roles
                    this.data.roles.forEach(role => {
                        if (!role.operators) {
                            role.operators = {
                                identity: { INS: [], DES: [], REC: [] },
                                space: { SEG: [], NUL: [], SYN: [] },
                                time: { ALT: [], SUP: [], CON: [] }
                            };
                            migrated = true;
                        }
                        if (!role.phasepost) {
                            role.phasepost = null; // Will be calculated when analytics run
                            migrated = true;
                        }
                        if (!role.created) {
                            role.created = new Date().toISOString();
                            migrated = true;
                        }
                        if (!role.modified) {
                            role.modified = role.created || new Date().toISOString();
                            migrated = true;
                        }
                        if (!role.purpose) {
                            role.purpose = '';
                            migrated = true;
                        }
                    });
                    
                    // Migrate groups
                    this.data.groups.forEach(group => {
                        if (!group.purpose) {
                            group.purpose = '';
                            migrated = true;
                        }
                        if (!group.maturity) {
                            group.maturity = null; // Will be calculated when analytics run
                            migrated = true;
                        }
                    });
                    
                    // Migrate flows
                    this.data.flows.forEach(flow => {
                        if (!flow.operator) {
                            // Map legacy actions to E.O. operators
                            const actionMap = {
                                okays: 'DES',
                                does: 'SYN',
                                shares: 'CON'
                            };
                            flow.operator = actionMap[flow.action] || flow.action;
                            migrated = true;
                        }
                        if (!flow.strength) {
                            flow.strength = 0.5; // Default medium strength
                            migrated = true;
                        }
                        if (!flow.frequency) {
                            flow.frequency = 'adhoc';
                            migrated = true;
                        }
                        if (!flow.lastActive) {
                            flow.lastActive = flow.updated || new Date().toISOString();
                            migrated = true;
                        }
                    });
                    
                    if (migrated && this.data.autoSave) {
                        this.saveData();
                    }
                },

                // Update analytics indicator
                updateAnalyticsIndicator() {
                    const indicator = document.getElementById('analyticsIndicator');
                    if (indicator) {
                        indicator.classList.toggle('active', this.data.analyticsEnabled);
                    }
                },

                // Toggle analytics
                toggleAnalytics(enabled) {
                    this.data.analyticsEnabled = enabled;
                    this.saveData();
                    this.updateAnalyticsIndicator();
                    
                    if (enabled) {
                        this.runAnalytics();
                        this.showNotification('Analytics enabled - discovering organizational insights');
                    } else {
                        // Hide analytics UI
                        const systemHealth = document.getElementById('systemHealth');
                        if (systemHealth) {
                            systemHealth.classList.remove('active');
                        }
                        this.showNotification('Analytics disabled');
                    }
                },

                // Run analytics
                runAnalytics() {
                    if (!this.data.analyticsEnabled) return;

                    const scorer = new EoRoleScorer(this.data);

                    // Calculate formalization for all roles
                    this.data.roles.forEach(role => {
                        role.phasepost = this.calculateFormalization(role);
                        role.phasepost.coordinates = scorer.calculatePhasepostCoordinates(role);
                        role.phasepost.bdf = scorer.analyzeBDFDynamic(role);
                    });
                    
                    // Calculate maturity for all groups
                    this.data.groups.forEach(group => {
                        group.maturity = this.calculateGroupMaturity(group);
                    });
                    
                    // Detect shadow functions
                    this.detectShadowFunctions();
                    
                    // Update UI
                    this.updateSystemHealth();
                    
                    // Save if needed
                    if (this.data.autoSave) {
                        this.saveData();
                    }
                },

                // Calculate formalization score for a role
                calculateFormalization(role) {
                    let score = 0;
                    const details = {};
                    
                    // 1. Explicit assignment (20 points)
                    const assignedPeople = this.data.people.filter(p => p.roleId === role.id && p.status === 'active');
                    if (role.id) score += 5;
                    if (assignedPeople.length >= 1) score += 5;
                    if (assignedPeople.length >= 2) score += 5;
                    if (assignedPeople.length >= 3) score += 5;
                    details.assignment = assignedPeople.length;
                    
                    // 2. Definition quality (15 points)
                    if (role.purpose?.length > 20) score += 5;
                    if (role.responsibilities?.length > 0) score += 5;
                    if (role.responsibilities?.length > 3) score += 5;
                    details.definition = role.responsibilities?.length || 0;
                    
                    // 3. Operator completeness (25 points)
                    const ops = role.operators || {};
                    let operatorCount = 0;
                    
                    // Identity operators
                    if (ops.identity?.INS?.length > 0) { score += 3; operatorCount++; }
                    if (ops.identity?.DES?.length > 0) { score += 3; operatorCount++; }
                    if (ops.identity?.REC?.length > 0) { score += 4; operatorCount++; } // Critical
                    
                    // Space operators
                    if (ops.space?.SEG?.length > 0) { score += 3; operatorCount++; }
                    if (ops.space?.NUL?.length > 0) { score += 2; operatorCount++; }
                    if (ops.space?.SYN?.length > 0) { score += 3; operatorCount++; }
                    
                    // Time operators
                    if (ops.time?.ALT?.length > 0) { score += 2; operatorCount++; }
                    if (ops.time?.SUP?.length > 0) { score += 2; operatorCount++; }
                    if (ops.time?.CON?.length > 0) { score += 3; operatorCount++; } // Critical
                    
                    details.operators = operatorCount;
                    
                    // 4. Flow integration (20 points)
                    const flows = this.data.flows.filter(f => 
                        f.roleId === role.id || 
                        (f.counterpartRoleIds && f.counterpartRoleIds.includes(role.id))
                    );
                    if (flows.length >= 1) score += 3;
                    if (flows.length >= 3) score += 3;
                    if (flows.length >= 5) score += 4;
                    
                    const hasIncoming = flows.some(f => f.counterpartRoleIds?.includes(role.id));
                    const hasOutgoing = flows.some(f => f.roleId === role.id);
                    const hasBidirectional = flows.some(f => f.operator === 'CON');
                    
                    if (hasIncoming && hasOutgoing) score += 3;
                    if (hasBidirectional) score += 3;
                    if (this.detectFeedbackLoop(role, flows)) score += 4;
                    details.flows = flows.length;
                    
                    // 5. Temporal persistence (10 points)
                    const age = this.daysSince(role.created);
                    if (age > 30) score += 2;
                    if (age > 90) score += 2;
                    if (age > 180) score += 2;
                    if (this.daysSince(role.modified) < 30) score += 2;
                    if (assignedPeople.length > 0) score += 2; // Active role
                    details.age = age;
                    
                    // 6. Shadow signals (10 points)
                    let shadowPenalty = 0;
                    if (!role.id) shadowPenalty += 5;
                    if (assignedPeople.length === 0) shadowPenalty += 3;
                    if (this.detectPassiveReferences(role)) shadowPenalty += 2;
                    
                    score += (10 - shadowPenalty);
                    
                    // Convert to percentage and category
                    const percentage = Math.min(100, score); // Cap at 100
                    let category;
                    if (percentage < 30) category = 'shadow';
                    else if (percentage < 70) category = 'emerging';
                    else category = 'integrated';
                    
                    // Calculate phasepost position (1-27)
                    const position = Math.ceil((percentage / 100) * 27);
                    
                    // E.O. phase coordinates and BDF metrics
                    const coords = this.scorer.calculatePhasepostCoordinates(role);
                    const bdf = this.scorer.analyzeBDFDynamic(role);

                    // Generate recommendations
                    const recommendations = this.generateRecommendations(role, { percentage, category });

                    return {
                        score,
                        percentage,
                        category,
                        position,
                        coords,
                        bdf,
                        details,
                        recommendations,
                        lastCalculated: new Date().toISOString()
                    };
                },

                // Detect feedback loop
                detectFeedbackLoop(role, flows) {
                    // Check if role has flows that create a cycle back to itself
                    const outgoing = flows.filter(f => f.roleId === role.id);
                    const incoming = flows.filter(f => f.counterpartRoleIds?.includes(role.id));
                    
                    // Simple check: does any outgoing flow target a role that flows back?
                    return outgoing.some(out => {
                        return incoming.some(inc => 
                            out.counterpartRoleIds?.includes(inc.roleId)
                        );
                    });
                },

                // Detect passive references
                detectPassiveReferences(role) {
                    // Check if role is referenced in passive voice in flows
                    return this.data.flows.some(flow => {
                        const desc = flow.connection.toLowerCase();
                        return desc.includes('gets done') || 
                               desc.includes('happens') ||
                               desc.includes('is handled');
                    });
                },

                // Days since date
                daysSince(dateStr) {
                    if (!dateStr) return 0;
                    const date = new Date(dateStr);
                    const now = new Date();
                    return Math.floor((now - date) / (1000 * 60 * 60 * 24));
                },

                // Generate recommendations
                generateRecommendations(role, formalization) {
                    const recommendations = [];
                    
                    // Shadow function recommendations
                    if (formalization.category === 'shadow') {
                        if (this.data.people.filter(p => p.roleId === role.id).length === 0) {
                            recommendations.push({
                                priority: 'HIGH',
                                message: 'This function needs an official owner',
                                action: 'Assign someone to this role or distribute the responsibilities'
                            });
                        }
                    }
                    
                    // Emerging role recommendations
                    if (formalization.category === 'emerging') {
                        if (!role.operators?.identity?.REC?.length) {
                            recommendations.push({
                                priority: 'HIGH',
                                message: 'Role needs self-validation cycles',
                                action: 'Add review rhythms (weekly check-ins, monthly retrospectives)'
                            });
                        }
                        
                        if (!role.operators?.time?.CON?.length) {
                            recommendations.push({
                                priority: 'HIGH',
                                message: 'Role needs partnership relationships',
                                action: 'Identify 1-2 roles that define success together with this one'
                            });
                        }
                        
                        const assignedPeople = this.data.people.filter(p => p.roleId === role.id);
                        if (assignedPeople.length === 1) {
                            recommendations.push({
                                priority: 'MEDIUM',
                                message: 'Single point of failure risk',
                                action: 'Train backup person or document critical knowledge'
                            });
                        }
                    }
                    
                    // Nearly integrated recommendations
                    if (formalization.percentage >= 70 && formalization.percentage < 90) {
                        if (!role.operators?.time?.ALT?.length) {
                            recommendations.push({
                                priority: 'LOW',
                                message: 'Add operating rhythm',
                                action: 'Define alternating modes (e.g., building vs reviewing phases)'
                            });
                        }
                    }
                    
                    return recommendations.slice(0, 3); // Top 3 recommendations
                },

                // Calculate group maturity
                calculateGroupMaturity(group) {
                    const roles = this.data.roles.filter(r => group.roleIds.includes(r.id));
                    const childGroups = this.data.groups.filter(g => group.childGroupIds.includes(g.id));
                    
                    if (roles.length === 0) {
                        return {
                            stage: 'forming',
                            percent: 0,
                            blockers: ['No roles assigned to this group']
                        };
                    }
                    
                    // Calculate average role maturity
                    let totalScore = 0;
                    let integratedCount = 0;
                    let emergingCount = 0;
                    let shadowCount = 0;
                    
                    roles.forEach(role => {
                        if (role.phasepost) {
                            totalScore += role.phasepost.percentage;
                            if (role.phasepost.category === 'integrated') integratedCount++;
                            else if (role.phasepost.category === 'emerging') emergingCount++;
                            else if (role.phasepost.category === 'shadow') shadowCount++;
                        }
                    });
                    
                    const avgScore = totalScore / roles.length;
                    const blockers = [];
                    
                    if (shadowCount > 0) {
                        blockers.push(`${shadowCount} unofficial function${shadowCount > 1 ? 's' : ''} need owners`);
                    }
                    
                    if (emergingCount > roles.length / 2) {
                        blockers.push('Most roles still developing');
                    }
                    
                    // Determine stage
                    let stage;
                    if (avgScore < 40) stage = 'forming';
                    else if (avgScore < 70) stage = 'stabilizing';
                    else stage = 'integrated';
                    
                    return {
                        stage,
                        percent: Math.round(avgScore),
                        blockers,
                        roleBreakdown: {
                            integrated: integratedCount,
                            emerging: emergingCount,
                            shadow: shadowCount
                        }
                    };
                },

                // Detect shadow functions
                detectShadowFunctions() {
                    const shadows = [];
                    const processedFunctions = new Set();
                    
                    // Scan flows for passive voice and orphaned actions
                    this.data.flows.forEach(flow => {
                        const desc = flow.connection.toLowerCase();
                        if (desc.includes('gets done') || 
                            desc.includes('happens') || 
                            desc.includes('is handled') ||
                            !flow.roleId) {
                            
                            // Extract the function name
                            const functionName = this.extractShadowFunctionName(flow.connection);
                            if (!processedFunctions.has(functionName)) {
                                processedFunctions.add(functionName);
                                
                                shadows.push({
                                    id: Date.now() + Math.random(),
                                    name: functionName,
                                    evidence: [`Referenced in flow: "${flow.connection}"`],
                                    frequency: 1,
                                    urgency: this.calculateShadowUrgency(flow),
                                    suggestedOwners: this.suggestShadowOwners(flow),
                                    status: 'active',
                                    detected: new Date().toISOString()
                                });
                            }
                        }
                    });
                    
                    // Scan for work mentioned in responsibilities but not owned
                    const allWork = this.extractAllWork();
                    const assignedWork = this.extractAssignedWork();
                    
                    allWork.forEach(work => {
                        if (!assignedWork.has(work) && !processedFunctions.has(work)) {
                            processedFunctions.add(work);
                            
                            shadows.push({
                                id: Date.now() + Math.random(),
                                name: work,
                                evidence: ['Work mentioned but no clear owner'],
                                frequency: 1,
                                urgency: 'medium',
                                suggestedOwners: [],
                                status: 'active',
                                detected: new Date().toISOString()
                            });
                        }
                    });
                    
                    // Update shadow functions list (merge with existing)
                    const existingShadows = this.data.shadowFunctions.filter(s => s.status !== 'dismissed');
                    const newShadows = shadows.filter(s => 
                        !existingShadows.some(es => es.name === s.name)
                    );
                    
                    this.data.shadowFunctions = [...existingShadows, ...newShadows];
                },

                // Extract shadow function name
                extractShadowFunctionName(connection) {
                    // Try to extract a meaningful name from the connection
                    const cleaned = connection
                        .replace(/gets done|happens|is handled/gi, '')
                        .replace(/for|by|with|to/gi, '')
                        .trim();
                    
                    return cleaned || 'Unnamed Function';
                },

                // Calculate shadow urgency
                calculateShadowUrgency(flow) {
                    // Based on how many roles it affects
                    const affectedCount = (flow.counterpartRoleIds?.length || 0) + 1;
                    
                    if (affectedCount >= 5) return 'critical';
                    if (affectedCount >= 3) return 'high';
                    if (affectedCount >= 2) return 'medium';
                    return 'low';
                },

                // Suggest shadow owners
                suggestShadowOwners(flow) {
                    const suggestions = [];
                    
                    // Suggest the role that initiates the flow
                    if (flow.roleId) {
                        suggestions.push(flow.roleId);
                    }
                    
                    // Suggest counterpart roles
                    if (flow.counterpartRoleIds) {
                        suggestions.push(...flow.counterpartRoleIds);
                    }
                    
                    return [...new Set(suggestions)]; // Remove duplicates
                },

                // Extract all work mentioned
                extractAllWork() {
                    const work = new Set();
                    
                    // From role responsibilities
                    this.data.roles.forEach(role => {
                        role.responsibilities?.forEach(r => {
                            // Extract key phrases
                            const phrases = this.extractKeyPhrases(r);
                            phrases.forEach(p => work.add(p));
                        });
                    });
                    
                    // From flows
                    this.data.flows.forEach(flow => {
                        const phrases = this.extractKeyPhrases(flow.connection);
                        phrases.forEach(p => work.add(p));
                    });
                    
                    return work;
                },

                // Extract assigned work
                extractAssignedWork() {
                    const assigned = new Set();
                    
                    // Work explicitly owned by roles
                    this.data.roles.forEach(role => {
                        role.ownership?.forEach(o => {
                            const phrases = this.extractKeyPhrases(o);
                            phrases.forEach(p => assigned.add(p));
                        });
                        
                        // Also consider responsibilities as assigned
                        role.responsibilities?.forEach(r => {
                            const phrases = this.extractKeyPhrases(r);
                            phrases.forEach(p => assigned.add(p));
                        });
                    });
                    
                    return assigned;
                },

                // Extract key phrases
                extractKeyPhrases(text) {
                    // Simple extraction - can be improved
                    return [text.toLowerCase().trim()];
                },

                // Update system health UI
                updateSystemHealth() {
                    const systemHealth = document.getElementById('systemHealth');
                    if (!systemHealth) return;
                    
                    if (this.data.analyticsEnabled) {
                        systemHealth.classList.add('active');
                        
                        // Count role categories
                        let integrated = 0, emerging = 0, shadow = 0;
                        this.data.roles.forEach(role => {
                            if (role.phasepost) {
                                if (role.phasepost.category === 'integrated') integrated++;
                                else if (role.phasepost.category === 'emerging') emerging++;
                                else if (role.phasepost.category === 'shadow') shadow++;
                            }
                        });
                        
                        const total = integrated + emerging + shadow;
                        
                        // Update role maturity progress
                        const progressBar = document.getElementById('roleMaturityProgress');
                        const legend = document.getElementById('roleMaturityLegend');
                        if (progressBar) {
                            if (total > 0) {
                                const integratedPercent = (integrated / total) * 100;
                                const emergingPercent = (emerging / total) * 100;
                                const shadowPercent = (shadow / total) * 100;

                                progressBar.innerHTML = `
                                    <div class="maturity-segment integrated" style="width: ${integratedPercent}%"></div>
                                    <div class="maturity-segment emerging" style="width: ${emergingPercent}%"></div>
                                    <div class="maturity-segment shadow" style="width: ${shadowPercent}%"></div>
                                `;

                                if (legend) {
                                    legend.innerHTML = `
                                        <div class="legend-item integrated"><span class="legend-color"></span>${integrated} Integrated</div>
                                        <div class="legend-item emerging"><span class="legend-color"></span>${emerging} Emerging</div>
                                        <div class="legend-item shadow"><span class="legend-color"></span>${shadow} Unofficial</div>
                                    `;
                                }
                            } else {
                                progressBar.innerHTML = `
                                    <div class="maturity-segment integrated" style="width: 0%"></div>
                                    <div class="maturity-segment emerging" style="width: 0%"></div>
                                    <div class="maturity-segment shadow" style="width: 0%"></div>
                                `;

                                if (legend) {
                                    legend.innerHTML = `
                                        <div class="legend-item integrated"><span class="legend-color"></span>0 Integrated</div>
                                        <div class="legend-item emerging"><span class="legend-color"></span>0 Emerging</div>
                                        <div class="legend-item shadow"><span class="legend-color"></span>0 Unofficial</div>
                                    `;
                                }
                            }
                        }
                        
                        // Update role insight
                        const roleInsight = document.getElementById('roleInsight');
                        if (roleInsight) {
                            if (shadow > 0) {
                                roleInsight.textContent = `${shadow} unofficial function${shadow > 1 ? 's' : ''} need owners`;
                            } else if (emerging > integrated) {
                                roleInsight.textContent = `${emerging} roles still developing`;
                            } else if (integrated > 0) {
                                roleInsight.textContent = `${integrated} roles ready to mentor others`;
                            } else {
                                roleInsight.textContent = 'Add roles to see insights';
                            }
                        }
                        
                        // Update team maturity
                        const teamMaturityBar = document.getElementById('teamMaturityBar');
                        const teamInsight = document.getElementById('teamInsight');
                        if (teamMaturityBar && teamInsight) {
                            const avgMaturity = this.calculateOverallMaturity();
                            teamMaturityBar.value = avgMaturity;
                            
                            if (avgMaturity >= 70) {
                                const matureGroups = this.data.groups.filter(g => 
                                    g.maturity && g.maturity.percent >= 70
                                ).length;
                                teamInsight.textContent = `${matureGroups} teams ready to mentor others`;
                            } else if (avgMaturity >= 40) {
                                teamInsight.textContent = 'Organization stabilizing, focus on role development';
                            } else {
                                teamInsight.textContent = 'Early stage - define roles and responsibilities';
                            }
                        }
                        
                        // Update shadow alerts
                        const shadowAlerts = document.getElementById('shadowAlerts');
                        if (shadowAlerts) {
                            const activeShadows = this.data.shadowFunctions.filter(s => s.status === 'active');
                            
                            if (activeShadows.length > 0) {
                                shadowAlerts.innerHTML = `<h3>Detected Unofficial Functions</h3>` + 
                                    activeShadows.slice(0, 3).map(shadow => this.renderShadowAlert(shadow)).join('');
                            } else {
                                shadowAlerts.innerHTML = '';
                            }
                        }
                    } else {
                        systemHealth.classList.remove('active');
                    }
                },

                // Calculate overall maturity
                calculateOverallMaturity() {
                    if (this.data.groups.length === 0) return 0;
                    
                    let total = 0;
                    let count = 0;
                    
                    this.data.groups.forEach(group => {
                        if (group.maturity) {
                            total += group.maturity.percent;
                            count++;
                        }
                    });
                    
                    return count > 0 ? Math.round(total / count) : 0;
                },

                // Render shadow alert
                renderShadowAlert(shadow) {
                    return `
                        <div class="shadow-alert">
                            <h3>Unofficial Function Detected</h3>
                            <p><strong>"${shadow.name}"</strong> appears to be important work that no one officially owns.</p>
                            
                            <div class="evidence">
                                <p>We noticed:</p>
                                <ul>
                                    ${shadow.evidence.map(e => `<li>${e}</li>`).join('')}
                                </ul>
                            </div>
                            
                            <div class="actions">
                                <button class="btn-secondary" onclick="window.app.createRoleFromShadow('${shadow.id}')">Create Official Role</button>
                                <button class="btn-secondary" onclick="window.app.assignShadowToExisting('${shadow.id}')">Add to Existing Role</button>
                                <button class="btn-secondary" onclick="window.app.dismissShadow('${shadow.id}')">Ignore</button>
                            </div>
                        </div>
                    `;
                },

                // Create role from shadow function
                createRoleFromShadow(shadowId) {
                    const shadow = this.data.shadowFunctions.find(s => s.id == shadowId);
                    if (!shadow) return;
                    
                    // Pre-fill the role creation form
                    this.tempResponsibilities = [shadow.name];
                    this.tempOwnership = [];
                    
                    this.showModal(`
                        <div class="modal-header">
                            <h2 class="modal-title">Create Role from Unofficial Function</h2>
                            <button class="modal-close" onclick="window.app.closeModal()">×</button>
                        </div>
                        <form id="addRoleForm" onsubmit="window.app.addRoleFromShadow(event, '${shadowId}')">
                            <div class="modal-body">
                                <div class="form-group">
                                    <label class="form-label">Role Name <span style="color: var(--accent-red);">*</span></label>
                                    <input type="text" class="form-input" name="name" value="${shadow.name}" required>
                                </div>
                                <div class="form-group">
                                    <label class="form-label">Role Code <span style="color: var(--accent-red);">*</span></label>
                                    <input type="text" class="form-input" name="code" required placeholder="e.g., INNOV_LEAD" style="text-transform: uppercase;">
                                </div>
                                <div class="form-group">
                                    <label class="form-label">Purpose</label>
                                    <textarea class="form-input" name="purpose" placeholder="What is this role's purpose?"></textarea>
                                </div>
                                <div class="form-group">
                                    <label class="form-label">Responsibilities</label>
                                    <div id="responsibilitiesList" style="background: var(--bg-secondary); border-radius: 4px; padding: 8px;">
                                        ${this.tempResponsibilities.map((r, i) => `
                                            <div style="padding: 4px;">${r}</div>
                                        `).join('')}
                                    </div>
                                    <p style="font-size: 0.75rem; color: var(--text-secondary); margin-top: 4px;">
                                        Pre-filled from detected function. Add more if needed after creation.
                                    </p>
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn-secondary" onclick="window.app.closeModal()">Cancel</button>
                                <button type="submit" class="btn-primary">Create Role</button>
                            </div>
                        </form>
                    `);
                },

                // Add role from shadow
                addRoleFromShadow(event, shadowId) {
                    event.preventDefault();
                    const form = event.target;
                    
                    const newRole = {
                        id: Date.now(),
                        name: form.name.value.trim(),
                        code: form.code.value.toUpperCase().trim(),
                        purpose: form.purpose.value.trim(),
                        responsibilities: [...this.tempResponsibilities],
                        ownership: [],
                        isTemplate: false,
                        operators: {
                            identity: { INS: [], DES: [], REC: [] },
                            space: { SEG: [], NUL: [], SYN: [] },
                            time: { ALT: [], SUP: [], CON: [] }
                        },
                        created: new Date().toISOString(),
                        modified: new Date().toISOString()
                    };
                    
                    this.data.roles.push(newRole);
                    
                    // Mark shadow as resolved
                    const shadow = this.data.shadowFunctions.find(s => s.id == shadowId);
                    if (shadow) {
                        shadow.status = 'resolved';
                        shadow.resolvedBy = newRole.id;
                    }
                    
                    this.data.hasChanges = true;
                    if (this.data.autoSave) this.saveData();
                    
                    this.render();
                    this.updateCounts();
                    this.updateSyncStatus();
                    this.closeModal();
                    
                    // Re-run analytics
                    if (this.data.analyticsEnabled) {
                        this.runAnalytics();
