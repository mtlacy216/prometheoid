                            <div class="wizard-step ${step >= 1 ? 'active' : ''} ${step > 1 ? 'completed' : ''}">
                                <div class="step-number">1</div>
                                <div>Basics</div>
                            </div>
                            <div class="wizard-step ${step >= 2 ? 'active' : ''} ${step > 2 ? 'completed' : ''}">
                                <div class="step-number">2</div>
                                <div>Responsibilities</div>
