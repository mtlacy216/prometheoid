                                    <label class="form-label">Roles in this Group <span style="color: var(--text-tertiary);">(Optional)</span></label>
                                    <select class="form-select" name="roleIds" multiple style="height: 150px;">
                                        ${roleOptions}
                                    </select>
                                    <p style="font-size: 0.75rem; color: var(--text-secondary); margin-top: 8px;">
                                        Hold Ctrl (or Cmd on Mac) to select multiple roles. You can add roles later.
                                    </p>
