                updateGroup(event, groupId) {
                    event.preventDefault();
                    const form = event.target;
                    const group = this.data.groups.find(g => g.id == groupId);
                    if (!group) return;

                    const oldParentId = group.parentId;
                    const oldChildGroupIds = [...group.childGroupIds];

                    group.name = form.name.value.trim();
                    group.purpose = form.purpose.value.trim();
                    group.roleIds = Array.from(form.roleIds.selectedOptions).map(option => parseInt(option.value));
                    group.childGroupIds = Array.from(form.childGroupIds.selectedOptions).map(option => parseInt(option.value));
                    group.parentId = form.parentId.value ? parseInt(form.parentId.value) : null;

                    // Update parent relationships
                    if (oldParentId !== group.parentId) {
                        // Remove from old parent
                        if (oldParentId) {
                            const oldParent = this.data.groups.find(g => g.id === oldParentId);
                            if (oldParent) {
                                const index = oldParent.childGroupIds.indexOf(groupId);
                                if (index > -1) {
                                    oldParent.childGroupIds.splice(index, 1);
                                }
                            }
                        }
                        
                        // Add to new parent
                        if (group.parentId) {
                            const newParent = this.data.groups.find(g => g.id === group.parentId);
                            if (newParent && !newParent.childGroupIds.includes(groupId)) {
                                newParent.childGroupIds.push(groupId);
                            }
                        }
                    }

                    // Update child relationships
                    oldChildGroupIds.forEach(childId => {
                        if (!group.childGroupIds.includes(childId)) {
                            const child = this.data.groups.find(g => g.id === childId);
                            if (child && child.parentId === groupId) {
                                child.parentId = null;
                            }
                        }
                    });

                    group.childGroupIds.forEach(childId => {
                        const child = this.data.groups.find(g => g.id === childId);
                        if (child && child.parentId !== groupId) {
                            // Remove from old parent
                            if (child.parentId) {
                                const oldParent = this.data.groups.find(g => g.id === child.parentId);
                                if (oldParent) {
                                    const index = oldParent.childGroupIds.indexOf(childId);
                                    if (index > -1) {
                                        oldParent.childGroupIds.splice(index, 1);
                                    }
                                }
                            }
                            child.parentId = groupId;
                        }
                    });

                    this.data.hasChanges = true;
                    if (this.data.autoSave !== false) this.saveData();
                    this.render();
                    this.updateSyncStatus();
                    this.closeModal();
                    
                    // Run analytics if enabled
                    if (this.data.analyticsEnabled) {
                        this.runAnalytics();
                    }
                    
                    this.showNotification('Group updated successfully!');
                },

