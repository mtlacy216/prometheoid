                    `);
                },

                // Add role modal with wizard
                showAddRoleModal() {
                    // Reset wizard state
                    this.currentRoleStep = 1;
                    this.tempResponsibilities = [];
                    this.tempOwnership = [];
                    this.tempRelationships = [];
                    this.detectedOperators = {
                        identity: { INS: [], DES: [], REC: [] },
                        space: { SEG: [], NUL: [], SYN: [] },
                        time: { ALT: [], SUP: [], CON: [] }
                    };
                    
                    this.showRoleWizardStep(1);
                },

