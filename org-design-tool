                updateCounts() {
                    const peopleCount = this.data.people.length;
                    const rolesCount = this.data.roles.length;
                    const groupsCount = this.data.groups.length;
                    const flowsCount = this.data.flows.length;

                    const peopleCountEl = document.getElementById('peopleCount');
                    const rolesCountEl = document.getElementById('rolesCount');
                    const groupsCountEl = document.getElementById('groupsCount');
                    const flowsCountEl = document.getElementById('flowsCount');

                    if (peopleCountEl) peopleCountEl.textContent = peopleCount;
                    if (rolesCountEl) rolesCountEl.textContent = rolesCount;
                    if (groupsCountEl) groupsCountEl.textContent = groupsCount;
                    if (flowsCountEl) flowsCountEl.textContent = flowsCount;
                    
                    // Show AI assist hint for new users
                    const aiHint = document.getElementById('aiAssistHint');
                    if (aiHint && peopleCount === 0 && rolesCount === 0 && flowsCount === 0) {
                        aiHint.style.display = 'flex';
                    } else if (aiHint) {
                        aiHint.style.display = 'none';
                    }
                },

                // Render
                render() {
                    // Don't re-render profile views
                    if (this.currentView && this.currentView.includes('-profile')) {
                        return;
                    }
                    
                    this.renderPeople();
                    this.renderRoles();
                    this.renderGroups();
                    this.renderFlows();
                },

                // Render people
                renderPeople() {
                    const list = document.getElementById('peopleList');
                    if (!list) return;

                    // Filter people based on showInactive setting
                    let peopleToShow = this.data.people;
                    if (!this.data.showInactive) {
                        peopleToShow = peopleToShow.filter(p => p.status === 'active');
                    }

                    if (peopleToShow.length === 0) {
                        list.innerHTML = '<div class="card"><p style="text-align: center; color: var(--text-tertiary);">No people to display</p></div>';
                        return;
                    }

                    list.innerHTML = peopleToShow.map(person => {
                        const role = this.data.roles.find(r => r.id === person.roleId);
                        return `
                            <div class="card" data-person-id="${person.id}">
                                <div class="card-header">
                                    <div style="display: flex; align-items: center; gap: calc(var(--spacing) * 2); flex: 1;">
                                        <div class="avatar" style="cursor: pointer;" onclick="window.app.showPersonProfile(${person.id})" title="Click to view profile">${person.name.split(' ').map(n => n[0]).join('')}</div>
                                        <div style="flex: 1; cursor: pointer;" onclick="window.app.showPersonProfile(${person.id})">
                                            <h3 class="card-title clickable-name" title="Click to view ${person.name}'s profile">
                                                ${person.name}
                                            </h3>
                                            <p class="card-subtitle">${person.email}</p>
                                        </div>
                                    </div>
                                    <div style="display: flex; align-items: center; gap: calc(var(--spacing) * 1);">
                                        <span class="badge badge-${person.status === 'active' ? 'green' : 'red'}">${person.status}</span>
                                        ${person.isTemplate ? '<span class="badge" style="background: var(--bg-tertiary); color: var(--text-tertiary); font-size: 0.7rem;">SAMPLE</span>' : ''}
                                        <button class="btn-icon" onclick="event.stopPropagation(); window.app.editPerson(${person.id})" title="Edit person" style="padding: 4px; width: 24px; height: 24px; font-size: 0.875rem;">
                                            ✏️
                                        </button>
                                        <button class="btn-icon btn-danger" onclick="event.stopPropagation(); window.app.deletePerson(${person.id})" title="Delete person" style="padding: 4px; width: 24px; height: 24px; font-size: 0.875rem;">
                                            ×
                                        </button>
                                    </div>
                                </div>
                                <div class="info-group">
                                    <div class="info-label">Role</div>
                                    <div>${role ? `<span class="entity-link" onclick="window.app.showRoleProfile(${role.id})">${role.name}</span>` : 'Unassigned'}</div>
                                </div>
                                <div class="info-group">
                                    <div class="info-label">Department</div>
                                    <div>${person.department}</div>
                                </div>
                            </div>
                        `;
                    }).join('');
                },

                // Render roles
                renderRoles() {
                    const list = document.getElementById('rolesList');
                    if (!list) return;

                    if (this.data.roles.length === 0) {
                        list.innerHTML = '<div class="card"><p style="text-align: center; color: var(--text-tertiary);">No roles defined yet</p></div>';
                        return;
                    }

                    list.innerHTML = this.data.roles.map(role => {
                        const peopleCount = this.data.people.filter(p => p.roleId === role.id).length;
                        const groups = this.data.groups.filter(g => g.roleIds.includes(role.id));
                        
                        return `
                            <div class="card" data-role-id="${role.id}">
                                <div class="card-header">
                                    <div style="cursor: pointer;" onclick="window.app.showRoleProfile(${role.id})">
                                        <h3 class="card-title clickable-name" title="Click to view ${role.name} role details">
                                            ${role.name}
                                        </h3>
                                        <p class="card-subtitle">${role.code}</p>
                                    </div>
                                    <div style="display: flex; align-items: center; gap: calc(var(--spacing) * 1);">
                                        ${role.phasepost ? `
                                            <span class="maturity-badge ${role.phasepost.category}" title="${role.phasepost.percentage}% developed">
                                                ${role.phasepost.category === 'integrated' ? '✓' : 
                                                  role.phasepost.category === 'emerging' ? '🌱' : 
                                                  '👻'}
                                            </span>
                                        ` : ''}
                                        <span class="badge badge-blue">${peopleCount} people</span>
                                        ${groups.length > 0 ? `<span class="badge badge-purple">${groups.length} group${groups.length > 1 ? 's' : ''}</span>` : ''}
                                        ${role.isTemplate ? '<span class="badge" style="background: var(--bg-tertiary); color: var(--text-tertiary); font-size: 0.7rem;">SAMPLE</span>' : ''}
                                        <button class="btn-icon" onclick="window.app.editRole(${role.id})" title="Edit role" style="padding: 4px; width: 24px; height: 24px; font-size: 0.875rem;">
                                            ✏️
                                        </button>
                                        <button class="btn-icon btn-danger" onclick="window.app.deleteRole(${role.id})" title="Delete role" style="padding: 4px; width: 24px; height: 24px; font-size: 0.875rem;">
                                            ×
                                        </button>
                                    </div>
                                </div>
                                ${role.purpose ? `
                                    <div class="info-group" style="cursor: pointer;" onclick="window.app.showRoleProfile(${role.id})">
                                        <div class="info-label">Purpose</div>
                                        <div style="font-size: 0.875rem; color: var(--text-secondary);">${role.purpose}</div>
                                    </div>
                                ` : ''}
                                <div class="info-group" style="cursor: pointer;" onclick="window.app.showRoleProfile(${role.id})">
                                    <div class="info-label">Responsibilities</div>
                                    <ul class="info-list">
                                        ${role.responsibilities.slice(0, 3).map(r => `<li>${r}</li>`).join('')}
                                        ${role.responsibilities.length > 3 ? `<li style="color: var(--text-tertiary);">...and ${role.responsibilities.length - 3} more</li>` : ''}
                                    </ul>
                                </div>
                            </div>
                        `;
                    }).join('');
                },

                // Render groups
                renderGroups() {
                    const list = document.getElementById('groupsList');
                    if (!list) return;

                    if (this.data.groups.length === 0) {
                        list.innerHTML = '<div class="card"><p style="text-align: center; color: var(--text-tertiary);">No groups defined yet</p></div>';
                        return;
                    }

                    // Get top-level groups (no parent)
                    const topLevelGroups = this.data.groups.filter(g => !g.parentId);

                    list.innerHTML = topLevelGroups.map(group => {
                        const roles = this.data.roles.filter(r => group.roleIds.includes(r.id));
                        const childGroups = this.data.groups.filter(g => group.childGroupIds.includes(g.id));
                        
                        return `
                            <div class="card" data-group-id="${group.id}">
                                <div class="card-header">
                                    <div style="cursor: pointer;" onclick="window.app.showGroupProfile(${group.id})">
                                        <h3 class="card-title clickable-name" title="Click to view ${group.name} group details">
                                            ${group.name}
                                        </h3>
                                        <p class="card-subtitle">${roles.length} roles • ${childGroups.length} sub-groups</p>
                                    </div>
                                    <div style="display: flex; align-items: center; gap: calc(var(--spacing) * 1);">
                                        ${group.maturity ? `
                                            <span class="badge badge-${group.maturity.stage === 'integrated' ? 'green' : group.maturity.stage === 'stabilizing' ? 'yellow' : 'red'}" title="${group.maturity.percent}% mature">
                                                ${group.maturity.percent}%
                                            </span>
                                        ` : ''}
                                        ${group.isTemplate ? '<span class="badge" style="background: var(--bg-tertiary); color: var(--text-tertiary); font-size: 0.7rem;">SAMPLE</span>' : ''}
                                        <button class="btn-icon" onclick="window.app.editGroup(${group.id})" title="Edit group" style="padding: 4px; width: 24px; height: 24px; font-size: 0.875rem;">
                                            ✏️
                                        </button>
                                        <button class="btn-icon btn-danger" onclick="window.app.deleteGroup(${group.id})" title="Delete group" style="padding: 4px; width: 24px; height: 24px; font-size: 0.875rem;">
                                            ×
                                        </button>
                                    </div>
                                </div>
                                ${group.purpose ? `
                                    <div class="info-group" style="cursor: pointer;" onclick="window.app.showGroupProfile(${group.id})">
                                        <div class="info-label">Purpose</div>
                                        <div style="font-size: 0.875rem; color: var(--text-secondary);">${group.purpose}</div>
                                    </div>
                                ` : ''}
                                <div class="info-group" style="cursor: pointer;" onclick="window.app.showGroupProfile(${group.id})">
                                    ${this.renderGroupPreview(group)}
                                </div>
                            </div>
                        `;
                    }).join('');

                    // Also show nested groups that have parents
                    const nestedGroups = this.data.groups.filter(g => g.parentId);
                    if (nestedGroups.length > 0) {
                        list.innerHTML += `
                            <div style="margin-top: 32px;">
                                <h3 style="margin-bottom: 16px; color: var(--text-secondary);">Nested Groups</h3>
                                ${nestedGroups.map(group => {
                                    const parent = this.data.groups.find(g => g.id === group.parentId);
                                    const roles = this.data.roles.filter(r => group.roleIds.includes(r.id));
                                    const childGroups = this.data.groups.filter(g => group.childGroupIds.includes(g.id));
                                    
                                    return `
                                        <div class="card" data-group-id="${group.id}">
                                            <div class="card-header">
                                                <div style="cursor: pointer;" onclick="window.app.showGroupProfile(${group.id})">
                                                    <h3 class="card-title clickable-name" title="Click to view ${group.name} group details">
                                                        ${group.name}
                                                    </h3>
                                                    <p class="card-subtitle">
                                                        ${parent ? `Part of ${parent.name} • ` : ''}
                                                        ${roles.length} roles • ${childGroups.length} sub-groups
                                                    </p>
                                                </div>
                                                <div style="display: flex; align-items: center; gap: calc(var(--spacing) * 1);">
                                                    <button class="btn-icon" onclick="window.app.editGroup(${group.id})" title="Edit group" style="padding: 4px; width: 24px; height: 24px; font-size: 0.875rem;">
                                                        ✏️
                                                    </button>
                                                    <button class="btn-icon btn-danger" onclick="window.app.deleteGroup(${group.id})" title="Delete group" style="padding: 4px; width: 24px; height: 24px; font-size: 0.875rem;">
                                                        ×
                                                    </button>
                                                </div>
                                            </div>
                                            <div class="info-group" style="cursor: pointer;" onclick="window.app.showGroupProfile(${group.id})">
                                                ${this.renderGroupPreview(group)}
                                            </div>
                                        </div>
                                    `;
                                }).join('')}
                            </div>
                        `;
                    }
                },

                // Render group preview
                renderGroupPreview(group, level = 0) {
                    let html = '<div class="group-tree">';
                    
                    // Roles in this group
                    const roles = this.data.roles.filter(r => group.roleIds.includes(r.id));
                    if (roles.length > 0) {
                        html += '<div style="margin-bottom: 8px;">';
                        roles.slice(0, 3).forEach(role => {
                            html += `<div class="group-tree-item">
                                <span class="group-icon">👤</span>
                                <span style="font-size: 0.875rem;">${role.name}</span>
                            </div>`;
                        });
                        if (roles.length > 3) {
                            html += `<div class="group-tree-item" style="color: var(--text-tertiary);">
                                <span class="group-icon">...</span>
                                <span style="font-size: 0.875rem;">and ${roles.length - 3} more roles</span>
                            </div>`;
                        }
                        html += '</div>';
                    }
                    
                    // Child groups
                    const childGroups = this.data.groups.filter(g => group.childGroupIds.includes(g.id));
                    if (childGroups.length > 0) {
                        childGroups.slice(0, 2).forEach(childGroup => {
                            html += `<div class="group-tree-item">
                                <span class="group-icon">📁</span>
                                <span style="font-size: 0.875rem;">${childGroup.name}</span>
                            </div>`;
                        });
                        if (childGroups.length > 2) {
                            html += `<div class="group-tree-item" style="color: var(--text-tertiary);">
                                <span class="group-icon">...</span>
                                <span style="font-size: 0.875rem;">and ${childGroups.length - 2} more sub-groups</span>
                            </div>`;
                        }
                    }
                    
                    html += '</div>';
                    return html;
                },

                // Render flows
                renderFlows() {
                    const list = document.getElementById('flowsList');
                    if (!list) return;

                    if (this.data.flows.length === 0) {
                        list.innerHTML = '<div class="card"><p style="text-align: center; color: var(--text-tertiary);">No flows defined yet</p></div>';
                        return;
                    }

                    list.innerHTML = this.data.flows.map(flow => {
                        const role = this.data.roles.find(r => r.id === flow.roleId);
                        const operator = this.operators[flow.operator] || this.operators[flow.action];
                        
                        // Handle both old format (single counterpart) and new format (multiple counterparts)
                        let counterpartDisplay = '';
                        if (flow.counterpartRoleNames && flow.counterpartRoleNames.length > 0) {
                            // New format with multiple roles
                            if (flow.counterpartRoleNames.length === 1 && flow.counterpartRoleIds[0]) {
                                counterpartDisplay = `<span class="entity-link" onclick="event.stopPropagation(); window.app.showRoleProfile(${flow.counterpartRoleIds[0]})">${flow.counterpartRoleNames[0]}</span>`;
                            } else {
                                counterpartDisplay = `<span style="background: var(--bg-secondary); padding: 2px 8px; border-radius: 4px; font-size: 0.875rem;">${flow.counterpartRoleNames.length} roles</span>`;
                            }
                        } else if (flow.counterpart) {
                            // Old format with single counterpart
                            counterpartDisplay = flow.counterpart;
                        } else {
                            counterpartDisplay = '<span style="color: var(--text-tertiary); font-style: italic;">(No counterpart)</span>';
                        }
                        
                        return `
                            <div class="card clickable" onclick="window.app.showFlowProfile(${flow.id})">
                                <div class="card-header">
                                    <div style="flex: 1;">
                                        <h3 class="card-title">${role ? `<span class="entity-link" onclick="event.stopPropagation(); window.app.showRoleProfile(${role.id})">${role.name}</span>` : 'Unknown Role'}</h3>
                                        <p class="card-subtitle">
                                            <span class="badge badge-${flow.operator || flow.action}">${operator ? operator.symbol : ''} ${operator ? operator.userTerm : flow.action}</span>
                                            ${flow.connection} ${counterpartDisplay}
                                        </p>
                                        ${flow.counterpartRoleNames && flow.counterpartRoleNames.length > 1 ? `
                                            <p style="font-size: 0.75rem; color: var(--text-secondary); margin-top: 8px;">
                                                Applies to: ${flow.counterpartRoleNames.map((name, i) => 
                                                    `<span class="entity-link" onclick="event.stopPropagation(); window.app.showRoleProfile(${flow.counterpartRoleIds[i]})">${name}</span>`
                                                ).join(', ')}
                                            </p>
                                        ` : ''}
                                    </div>
                                    <div style="text-align: right;">
                                        <div style="font-size: 0.75rem; color: var(--text-tertiary);">Updated</div>
                                        <div>${flow.updated}</div>
                                        ${flow.frequency ? `<div style="font-size: 0.75rem; color: var(--text-secondary); margin-top: 4px;">${flow.frequency}</div>` : ''}
                                        ${flow.isTemplate ? '<div style="margin-top: 4px;"><span class="badge" style="background: var(--bg-tertiary); color: var(--text-tertiary); font-size: 0.7rem;">SAMPLE</span></div>' : ''}
                                        <div style="margin-top: 8px;">
                                            <button class="btn-secondary" style="padding: 4px 12px; font-size: 0.75rem;" onclick="event.stopPropagation(); window.app.editFlow(${flow.id})">Edit</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        `;
                    }).join('');
                },

                // Modal management
                showModal(content) {
                    const modal = document.getElementById('modal');
                    const modalContent = document.getElementById('modalContent');
                    if (modal && modalContent) {
                        modalContent.innerHTML = content;
                        modal.classList.add('active');
                    }
                },

                closeModal() {
                    const modal = document.getElementById('modal');
                    if (modal) {
                        modal.classList.remove('active');
                        // Small delay before clearing to ensure any pending operations complete
                        setTimeout(() => {
                            // Clear temporary form data
                            this.tempResponsibilities = [];
                            this.tempOwnership = [];
                            this.tempRelationships = [];
                            this.currentRoleStep = 1;
                            this.detectedOperators = {
                                identity: { INS: [], DES: [], REC: [] },
                                space: { SEG: [], NUL: [], SYN: [] },
                                time: { ALT: [], SUP: [], CON: [] }
                            };
                        }, 100);
                    }
                },

                // Add person modal
                showAddPersonModal() {
                    const roleOptions = this.data.roles.map(r => 
                        `<option value="${r.id}">${r.name}</option>`
                    ).join('');

                    this.showModal(`
