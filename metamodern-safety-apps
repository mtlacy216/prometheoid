class MetamodernOscillator {
  constructor() {
    this.mode = 'balanced';
    this.oscillationInterval = null;
    this.init();
  }
  
  init() {
    this.startOscillation();
    this.setupInteractionHandlers();
  }
  
  startOscillation() {
    // Oscillate between serious and friendly every 8 seconds
    let serious = false;
    
    this.oscillationInterval = setInterval(() => {
      serious = !serious;
      this.updatePersonality(serious ? 'serious' : 'friendly');
    }, 8000);
  }
  
  updatePersonality(mode) {
    const root = document.documentElement;
    
    if (mode === 'serious') {
      root.style.setProperty('--font-casual', '0');
      root.style.setProperty('--font-weight', '500');
      root.style.setProperty('--animation-speed', '1');
      
      // Update text content to be more technical
      this.updateTextTone('technical');
    } else {
      root.style.setProperty('--font-casual', '0.6');
      root.style.setProperty('--font-weight', '400');
      root.style.setProperty('--animation-speed', '1.2');
      
      // Update text content to be more approachable
      this.updateTextTone('friendly');
    }
  }
  
  updateTextTone(tone) {
    const messages = {
      technical: {
        header: 'System Security Status',
        status: 'Connection Status: ',
        operations: 'Execution Log'
      },
      friendly: {
        header: 'Your Privacy Shield 🛡️',
        status: 'You are: ',
        operations: "What's Happening"
      }
    };
    
    // Update various text elements
    const headerEl = document.querySelector('.trust-header h1');
    if (headerEl) {
      headerEl.textContent = messages[tone].header;
    }
  }
  
  setupInteractionHandlers() {
    // Speed up oscillation on hover
    document.addEventListener('mousemove', () => {
      this.speedUpOscillation();
    });
    
    // Slow down when idle
    let idleTimer;
    document.addEventListener('mousemove', () => {
      clearTimeout(idleTimer);
      idleTimer = setTimeout(() => {
        this.slowDownOscillation();
      }, 10000);
    });
  }
  
  speedUpOscillation() {
    if (this.oscillationInterval) {
      clearInterval(this.oscillationInterval);
      this.startOscillation();
    }
  }
  
  slowDownOscillation() {
    // Implement slower oscillation for idle state
  }
}

// Initialize oscillator
const oscillator = new MetamodernOscillator();
