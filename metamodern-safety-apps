## Part IV: Core JavaScript Implementation

### Trust Monitor System

```javascript
// Core trust monitoring system
class TrustMonitor {
  constructor() {
    this.isOnline = navigator.onLine;
    this.operations = [];
    this.listeners = new Set();
    this.init();
  }
  
  init() {
    // Monitor connection status
    window.addEventListener('online', () => this.handleConnectionChange(true));
    window.addEventListener('offline', () => this.handleConnectionChange(false));
    
    // Intercept potentially dangerous operations
    this.interceptNetworkAPIs();
    
    // Start monitoring
    this.startMonitoring();
  }
  
  handleConnectionChange(isOnline) {
    this.isOnline = isOnline;
    this.updateUI();
    
    if (isOnline) {
      this.showWarning('⚠️ Internet connection detected. For maximum security, consider disconnecting.');
    } else {
      this.showSuccess('🔒 Air-gapped! Your data is completely secure.');
    }
  }
  
  interceptNetworkAPIs() {
    // Override fetch to show it's not being used
    const originalFetch = window.fetch;
    window.fetch = (...args) => {
      this.logBlockedOperation('fetch', args[0]);
      throw new Error('Network operations are disabled in this app');
    };
    
    // Override XMLHttpRequest
    const OriginalXHR = window.XMLHttpRequest;
    window.XMLHttpRequest = function() {
      this.logBlockedOperation('XMLHttpRequest', 'attempted');
      throw new Error('Network operations are disabled in this app');
    };
    
    // Log any WebSocket attempts
    const OriginalWebSocket = window.WebSocket;
    window.WebSocket = function(url) {
      this.logBlockedOperation('WebSocket', url);
      throw new Error('WebSocket connections are disabled in this app');
    };
  }
  
  logBlockedOperation(type, details) {
    const operation = {
      type,
      details,
      timestamp: Date.now(),
      blocked: true
    };
    
    this.operations.push(operation);
    this.notifyListeners('blocked', operation);
  }
  
  logLocalOperation(type, details) {
    const operation = {
      type,
      details,
      timestamp: Date.now(),
      local: true
    };
    
    this.operations.push(operation);
    this.notifyListeners('local', operation);
    this.visualizeOperation(operation);
  }
  
  visualizeOperation(operation) {
    // Find the code line that matches this operation
    const codeLines = document.querySelectorAll('.code-line');
    codeLines.forEach(line => {
      if (line.textContent.includes(operation.type)) {
        line.setAttribute('data-executing', 'true');
        setTimeout(() => {
          line.setAttribute('data-executing', 'false');
        }, 600);
      }
    });
    
    // Update the activity feed
    this.updateActivityFeed(operation);
  }
  
  updateActivityFeed(operation) {
    const feed = document.querySelector('.activity-feed');
    if (!feed) return;
    
    const entry = document.createElement('div');
    entry.className = 'activity-entry';
    entry.innerHTML = `
      <span class="activity-time">${new Date(operation.timestamp).toLocaleTimeString()}</span>
      <span class="activity-type">${operation.type}</span>
      <span class="activity-status">✓ Local only</span>
    `;
    
    feed.insertBefore(entry, feed.firstChild);
    
    // Limit feed to last 10 operations
    while (feed.children.length > 10) {
      feed.removeChild(feed.lastChild);
    }
  }
  
  updateUI() {
    // Update connection status
    const statusEl = document.querySelector('.status-indicator');
    if (statusEl) {
      statusEl.setAttribute('data-status', this.isOnline ? 'online' : 'offline');
      statusEl.querySelector('.status-text').textContent = 
        this.isOnline ? 'Online - Consider disconnecting' : 'Offline - Maximum security';
    }
    
    // Update trust proof
    const proofValue = document.querySelector('.status-value');
    if (proofValue) {
      proofValue.textContent = this.isOnline ? 'true ⚠️' : 'false ✓';
    }
    
    // Update document data attribute for CSS
    document.documentElement.setAttribute('data-connection', 
      this.isOnline ? 'online' : 'offline');
  }
  
  showWarning(message) {
    this.showNotification(message, 'warning');
  }
  
  showSuccess(message) {
    this.showNotification(message, 'success');
  }
  
  showNotification(message, type) {
    const notification = document.createElement('div');
    notification.className = `trust-notification ${type}`;
    notification.innerHTML = `
      <div class="notification-content">
        ${message}
      </div>
    `;
    
    document.body.appendChild(notification);
    
    // Animate in
    requestAnimationFrame(() => {
      notification.classList.add('visible');
    });
    
    // Remove after 5 seconds
    setTimeout(() => {
      notification.classList.remove('visible');
      setTimeout(() => notification.remove(), 300);
    }, 5000);
  }
  
  subscribe(callback) {
    this.listeners.add(callback);
  }
  
  notifyListeners(event, data) {
    this.listeners.forEach(callback => callback(event, data));
  }
  
  startMonitoring() {
    // Check connection every 5 seconds
    setInterval(() => {
      if (navigator.onLine !== this.isOnline) {
        this.handleConnectionChange(navigator.onLine);
      }
    }, 5000);
  }
}

