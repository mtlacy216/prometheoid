### Code Visibility System

```javascript
// System for making code execution visible
class CodeVisibility {
  constructor() {
    this.complexityLevel = 'simple';
    this.executionHistory = [];
    this.init();
  }
  
  init() {
    this.setupComplexitySelector();
    this.wrapLocalStorage();
    this.wrapDOMManipulation();
  }
  
  setupComplexitySelector() {
    const buttons = document.querySelectorAll('.complexity-selector button');
    buttons.forEach(button => {
      button.addEventListener('click', (e) => {
        this.setComplexity(e.target.dataset.level);
      });
    });
  }
  
  setComplexity(level) {
    this.complexityLevel = level;
    
    // Update UI
    const display = document.querySelector('.code-display');
    display.setAttribute('data-complexity', level);
    
    // Show/hide appropriate views
    document.querySelector('.simple-view').hidden = level !== 'simple';
    document.querySelector('.detailed-view').hidden = level !== 'detailed';
    document.querySelector('.full-view').hidden = level !== 'full';
    
    // Update button states
    document.querySelectorAll('.complexity-selector button').forEach(btn => {
      btn.setAttribute('aria-checked', btn.dataset.level === level);
    });
  }
  
  wrapLocalStorage() {
    const original = {
      setItem: localStorage.setItem.bind(localStorage),
      getItem: localStorage.getItem.bind(localStorage),
      removeItem: localStorage.removeItem.bind(localStorage)
    };
    
    localStorage.setItem = (key, value) => {
      this.visualizeStorageOperation('set', key, value);
      trustMonitor.logLocalOperation('localStorage.setItem', { key, value });
      return original.setItem(key, value);
    };
    
    localStorage.getItem = (key) => {
      this.visualizeStorageOperation('get', key);
      trustMonitor.logLocalOperation('localStorage.getItem', { key });
      return original.getItem(key);
    };
    
    localStorage.removeItem = (key) => {
      this.visualizeStorageOperation('remove', key);
      trustMonitor.logLocalOperation('localStorage.removeItem', { key });
      return original.removeItem(key);
    };
  }
  
  wrapDOMManipulation() {
    // Wrap common DOM methods to show they're local
    const originalMethods = {
      getElementById: document.getElementById.bind(document),
      querySelector: document.querySelector.bind(document),
      querySelectorAll: document.querySelectorAll.bind(document)
    };
    
    document.getElementById = (id) => {
      this.visualizeDOMOperation('getElementById', id);
      return originalMethods.getElementById(id);
    };
    
    document.querySelector = (selector) => {
      this.visualizeDOMOperation('querySelector', selector);
      return originalMethods.querySelector(selector);
    };
  }
  
  visualizeStorageOperation(operation, key, value) {
    if (this.complexityLevel === 'simple') return;
    
    const visualization = document.createElement('div');
    visualization.className = 'operation-visualization storage';
    visualization.innerHTML = `
      <div class="op-header">💾 Local Storage ${operation}</div>
      <div class="op-details">
        <span class="op-key">Key: ${key}</span>
        ${value ? `<span class="op-value">Value: ${value.substring(0, 50)}...</span>` : ''}
      </div>
      <div class="op-location">📍 Stored in YOUR browser only</div>
    `;
    
    this.showVisualization(visualization);
  }
  
  visualizeDOMOperation(operation, target) {
    if (this.complexityLevel !== 'full') return;
    
    const visualization = document.createElement('div');
    visualization.className = 'operation-visualization dom';
    visualization.innerHTML = `
      <div class="op-header">🖥️ Screen Update</div>
      <div class="op-details">
        <span class="op-method">${operation}</span>
        <span class="op-target">Target: ${target}</span>
      </div>
      <div class="op-location">📍 Changed YOUR screen only</div>
    `;
    
    this.showVisualization(visualization);
  }
  
  showVisualization(element) {
    const container = document.querySelector('.code-display');
    container.appendChild(element);
    
    // Animate in
    requestAnimationFrame(() => {
      element.classList.add('visible');
    });
    
    // Fade out after 3 seconds
    setTimeout(() => {
      element.classList.add('fading');
      setTimeout(() => element.remove(), 500);
    }, 3000);
  }
}

