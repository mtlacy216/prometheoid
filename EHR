        // Friendly name lists for random vault names
        const VAULT_ADJECTIVES = [
            'Azure', 'Crimson', 'Golden', 'Silver', 'Emerald', 'Sapphire', 'Ruby', 'Diamond',
            'Peaceful', 'Serene', 'Gentle', 'Brave', 'Strong', 'Wise', 'Noble', 'Bright',
            'Happy', 'Calm', 'Swift', 'Bold', 'Loyal', 'True', 'Pure', 'Free',
            'Ancient', 'Modern', 'Eternal', 'Cosmic', 'Solar', 'Lunar', 'Stellar', 'Crystal'
        ];
        
        const VAULT_NOUNS = [
            'Mountain', 'Valley', 'River', 'Ocean', 'Forest', 'Garden', 'Meadow', 'Canyon',
            'Phoenix', 'Dragon', 'Eagle', 'Wolf', 'Lion', 'Tiger', 'Bear', 'Hawk',
            'Oak', 'Pine', 'Willow', 'Maple', 'Cedar', 'Birch', 'Aspen', 'Redwood',
