            async uploadDocument() {
                if (!this.pendingFile) return;
                
                const name = document.getElementById('docName').value;
                if (!name) {
                    this.showError('Please enter a document name');
                    return;
                }
                
                // Check if vault is properly unlocked
                if (!this.encryptionKey || this.isLocked) {
                    this.showError('Vault is locked!\n\nPlease unlock your vault first before uploading documents.');
                    return;
                }
                
                // Show loading indicator
                const uploadBtn = document.getElementById('uploadBtn');
                const originalText = uploadBtn.textContent;
                uploadBtn.disabled = true;
                uploadBtn.innerHTML = '<span class="loading"></span> Uploading...';
                
                try {
                    // Generate ID
                    const id = this.generateId();
                    
                    // For large files, read and convert in chunks to avoid stack overflow
                    let base64;
                    
                    // Show progress for large files
                    if (this.pendingFile.size > 5 * 1024 * 1024) {
                        this.showSuccess(`Processing large file (${(this.pendingFile.size / 1024 / 1024).toFixed(2)} MB)...`);
                    }
                    
                    try {
                        // Read file as data URL directly to avoid intermediate array buffer for large files
                        base64 = await new Promise((resolve, reject) => {
                            const reader = new FileReader();
                            reader.onload = (e) => {
                                try {
                                    // Extract base64 from data URL
                                    const dataUrl = e.target.result;
                                    if (!dataUrl || typeof dataUrl !== 'string') {
                                        reject(new Error('Failed to read file - no data'));
                                        return;
                                    }
                                    
                                    const base64Match = dataUrl.match(/^data:[^;]+;base64,(.+)$/);
                                    if (!base64Match || !base64Match[1]) {
                                        reject(new Error('Invalid data URL format'));
                                        return;
                                    }
                                    
                                    const base64Data = base64Match[1];
                                    console.log('File read successfully, base64 length:', base64Data.length);
                                    resolve(base64Data);
                                } catch (error) {
                                    reject(new Error('Failed to extract base64: ' + error.message));
                                }
                            };
                            reader.onerror = () => reject(new Error('File reading failed'));
                            reader.onabort = () => reject(new Error('File reading was aborted'));
                            
                            // Start reading the file
                            reader.readAsDataURL(this.pendingFile);
                        });
                        
                        if (!base64) {
                            throw new Error('Failed to read file data');
                        }
                    } catch (readError) {
                        console.error('File read error:', readError);
                        this.showError('Failed to read file: ' + readError.message);
                        uploadBtn.disabled = false;
                        uploadBtn.textContent = originalText;
                        return;
                    }
                    
                    // Store metadata first
                    const attachment = {
                        id: id,
                        name: name,
                        originalName: this.pendingFile.name,
                        size: this.pendingFile.size,
                        type: this.pendingFile.type,
                        uploadDate: new Date().toISOString(),
                        encryptedFilename: id + '.dat'
                    };
                    
                    // Test encryption before processing file
                    try {
                        const testData = "test";
                        const testEncrypted = await this.encrypt(testData, this.encryptionKey);
                        const testDecrypted = await this.decrypt(testEncrypted, this.encryptionKey);
                        if (testDecrypted !== testData) {
                            throw new Error('Encryption test failed');
