            async uploadDocument() {
                if (!this.pendingFile) return;
                
                const name = document.getElementById('docName').value;
                if (!name) {
                    this.showError('Please enter a document name');
                    return;
                }
                
                // Check if vault is properly unlocked
                if (this.isLocked) {
                    this.showError('Vault is locked!\n\nPlease unlock your vault first before uploading documents.');
                    return;
                }
                
                // Show loading indicator
                const uploadBtn = document.getElementById('uploadBtn');
                const originalText = uploadBtn.textContent;
                uploadBtn.disabled = true;
                uploadBtn.innerHTML = '<span class="loading"></span> Uploading...';
                
                try {
                    // Generate ID
                    const id = this.generateId();
                    
                    // Show progress for large files
                    if (this.pendingFile.size > 5 * 1024 * 1024) {
                        this.showSuccess(`Processing large file (${(this.pendingFile.size / 1024 / 1024).toFixed(2)} MB)...`);
                    }
                    
                    // Read file as base64
                    const base64 = await new Promise((resolve, reject) => {
                        const reader = new FileReader();
                        reader.onload = (e) => {
                            try {
                                const dataUrl = e.target.result;
                                // Extract base64 from data URL
                                const base64Match = dataUrl.match(/^data:[^;]+;base64,(.+)$/);
                                if (!base64Match || !base64Match[1]) {
                                    reject(new Error('Invalid data URL format'));
                                    return;
                                }
                                resolve(base64Match[1]);
                            } catch (error) {
                                reject(error);
                            }
                        };
                        reader.onerror = () => reject(new Error('File reading failed'));
                        reader.readAsDataURL(this.pendingFile);
                    });
                    
                    // Store metadata and data together
                    const attachment = {
                        id: id,
                        name: name,
                        originalName: this.pendingFile.name,
                        size: this.pendingFile.size,
                        type: this.pendingFile.type,
                        uploadDate: new Date().toISOString(),
                        data: base64
                    };
                    
                    // Add to attachments
                    this.attachments[id] = attachment;
                    
                    // Save - catch storage errors
                    try {
                        await this.saveData();
                    } catch (e) {
                        // Remove the attachment that caused the error
                        delete this.attachments[id];
                        throw e;
                    }
                    
                    // Mark as having unsaved changes
                    this.hasUnsavedChanges = true;

                    // Calculate size text before clearing pendingFile
                    const sizeText = this.pendingFile.size > 1024 * 1024
                        ? `${(this.pendingFile.size / 1024 / 1024).toFixed(2)} MB`
                        : `${(this.pendingFile.size / 1024).toFixed(2)} KB`;

                    // Update UI
                    this.updateDocumentsList();
                    this.closeModal('uploadModal');
                    this.resetUploadModal();
                    
                    // Show success message with green checkmark
                    const notification = document.createElement('div');
                    notification.className = 'info-box success';
                    notification.style.cssText = 'position: fixed; top: 1rem; right: 1rem; z-index: 1001; max-width: 400px;';
                    notification.innerHTML = `✅ Document uploaded successfully!<br><br>📄 <strong>${name}</strong><br>💾 ${sizeText}`;
                    document.body.appendChild(notification);
                    setTimeout(() => notification.remove(), 4000);
                    
                } catch (error) {
                    console.error('Upload error:', error);
                    const errorMessage = error.message || 'Unknown error';
                    this.showError('Error uploading document: ' + errorMessage);
                } finally {
                    // Always restore button state
                    uploadBtn.disabled = false;
                    uploadBtn.textContent = originalText;
                }
            }
            
            updateDocumentsList() {
                const container = document.getElementById('documentsList');
                container.innerHTML = '';
                
                if (Object.keys(this.attachments).length === 0) {
                    container.innerHTML = '<p style="text-align: center; color: var(--text-light); padding: 2rem;">No documents uploaded yet</p>';
                    return;
                }
                
                Object.values(this.attachments).forEach(doc => {
                    const item = document.createElement('div');
                    item.className = 'attachment-item';
                    
                    const sizeText = doc.size > 1024 * 1024 
                        ? `${(doc.size / 1024 / 1024).toFixed(2)} MB`
                        : `${(doc.size / 1024).toFixed(2)} KB`;
                        
                    const isImage = doc.type && doc.type.startsWith('image/');
                    
                    item.innerHTML = `
