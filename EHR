                        console.log('Encryption test passed');
                    } catch (testError) {
                        console.error('Encryption test failed:', testError);
                        this.showError('Encryption system error.\n\nTry logging out and back in.');
                        uploadBtn.disabled = false;
                        uploadBtn.textContent = originalText;
                        return;
                    }
                    
                    // Encrypt the file data
                    let encrypted;
                    try {
                        // Check if we have an encryption key
                        if (!this.encryptionKey) {
                            throw new Error('No encryption key available');
                        }
                        
                        // For very large files (over 10MB of base64), use simplified storage
                        // Note: base64 is ~33% larger than original file size
                        if (this.pendingFile.size > 10 * 1024 * 1024) {
                            // Store large files with a marker for simplified handling
                            const wrapper = {
                                type: 'large_file_v2',
                                data: base64,
                                originalSize: this.pendingFile.size,
                                encrypted: false
                            };
                            // Convert to string and encode
                            encrypted = btoa(JSON.stringify(wrapper));
                            console.log('Using simplified storage for large file');
                        } else {
                            // Normal encryption for smaller files
                            console.log('Encrypting file of size:', (base64.length / 1024).toFixed(2), 'KB (base64)');
                            encrypted = await this.encrypt(base64, this.encryptionKey);
                            console.log('Encryption successful');
                        }
                    } catch (encryptError) {
                        console.error('Detailed encryption error:', encryptError);
                        
                        let errorMessage = 'Failed to encrypt file.\n\n';
                        
                        if (encryptError.message.includes('key')) {
                            errorMessage += 'Encryption key error. Try logging out and back in.';
                        } else if (encryptError.name === 'QuotaExceededError') {
                            errorMessage += 'File is too large for encryption.';
                        } else {
                            errorMessage += 'Error details: ' + encryptError.message;
                        }
                        
                        this.showError(errorMessage);
                        uploadBtn.disabled = false;
                        uploadBtn.textContent = originalText;
                        return;
                    }
                    
                    // Try to store file
                    try {
                        localStorage.setItem(`vault_file_${this.instanceId}_${id}`, encrypted);
                        
                        // Add to attachments only after successful storage
                        this.attachments[id] = attachment;
                    } catch (e) {
                        console.error('Storage error:', e);
                        
                        // Calculate approximate storage size
                        const estimatedSize = encrypted.length * 2; // UTF-16 encoding
                        const estimatedSizeMB = (estimatedSize / 1024 / 1024).toFixed(2);
                        
                        if (e.name === 'QuotaExceededError' || e.message.includes('QuotaExceededError')) {
                            this.showError(`Storage quota exceeded!\n\nThe encrypted file (≈${estimatedSizeMB} MB) is too large for browser storage.\n\nTry:\n• Compressing the file first\n• Using a smaller file\n• Clearing browser storage`);
                        } else {
