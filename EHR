            async exportAsJSON() {
                try {
                    // Create a clean export object without sensitive data
                    const exportData = {
                        exportDate: new Date().toISOString(),
                        vaultName: this.vaultName,
                        vaultId: this.instanceId,
                        vaultGuid: this.vaultGuid,
                        personal: this.data.personal || {},
                        insurance: this.data.insurance || {},
                        medical: this.data.medical || {},
                        medications: this.data.medications || {},
                        contacts: this.data.contacts || {},
                        journeys: this.data.journeys || {},
                        journeyData: this.data.journeyData || {},
                        providers: this.providers || {},
                        caseNotes: this.caseNotes || [],
                        documentList: []
                    };
                    
                    // Add document metadata (not the actual files)
                    for (const [id, doc] of Object.entries(this.attachments)) {
                        exportData.documentList.push({
                            name: doc.name,
                            originalName: doc.originalName,
                            type: doc.type,
                            size: doc.size,
                            uploadDate: doc.uploadDate
                        });
                    }
                    
                    // Create and download JSON file
                    const jsonString = JSON.stringify(exportData, null, 2);
                    const blob = new Blob([jsonString], { type: 'application/json' });
                    const url = URL.createObjectURL(blob);
                    const a = document.createElement('a');
                    
                    const now = new Date();
                    const date = now.toISOString().split('T')[0];
                    const time = now.toTimeString().split(' ')[0].replace(/:/g, '-');
                    const filename = `HealthVault_Export_${date}_${time}.json`;
                    
                    a.href = url;
