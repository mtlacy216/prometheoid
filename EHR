            async openBackupFile() {
                if (!this.pendingBackupFile) return;
                
                try {
                    let backupData;
                    
                    // Check file type
                    if (this.pendingBackupFile.name.endsWith('.html')) {
                        // Handle saved HTML vault file
                        const content = await this.pendingBackupFile.text();
                        
                        // Extract embedded data
                        const match = content.match(/<script id="embeddedVaultData" type="application\/json">([\s\S]*?)<\/script>/);
                        if (!match) {
                            this.showError('No vault data found!\n\nThis HTML file doesn\'t contain saved health records.\nMake sure it\'s a file created with "Save to File"');
                            return;
                        }
                        
                        try {
                            backupData = JSON.parse(match[1]);
                        } catch (e) {
                            console.error('JSON parse error:', e);
                            this.showError('Invalid data in HTML file.\n\nThe vault data appears to be corrupted.');
                            return;
                        }
                        
                        // Restore attachments from embedded data
                        if (backupData.attachments) {
                            for (const [id, fileInfo] of Object.entries(backupData.attachments)) {
                                if (fileInfo.data) {
                                    localStorage.setItem(`vault_file_${backupData.instanceId}_${id}`, fileInfo.data);
                                }
                            }
                        }
                        
                    } else {
                        // Handle JSON file directly
                        const content = await this.pendingBackupFile.text();
                        if (!content || content.trim() === '') {
                            this.showError('The JSON file is empty!');
                            return;
                        }
                        try {
                            backupData = JSON.parse(content);
                        } catch (e) {
                            this.showError('Invalid JSON file\n\nThe file doesn\'t contain valid JSON data.');
                            return;
                        }
                    }
                    
                    // Validate the data structure
                    if (!backupData || typeof backupData !== 'object') {
                        this.showError('Invalid file format. Expected JSON data.');
                        return;
                    }
                    
                    if (!backupData.instanceId) {
                        this.showError('Invalid vault file.\n\nThis doesn\'t appear to be a Health Vault backup.');
                        return;
                    }
                    
                    if (!backupData.profile || !backupData.data) {
                        this.showError('Vault file is missing required data.\n\nMake sure this is a complete Health Vault file.');
                        return;
                    }
                    
                    // Set instance ID and vault name from backup
                    this.instanceId = backupData.instanceId;
                    this.vaultName = backupData.vaultName || 'Imported Vault';
                    document.getElementById('instanceId').textContent = this.instanceId;
                    
                    // Restore profile and data to localStorage
                    if (backupData.profile) {
                        localStorage.setItem(`vault_profile_${this.instanceId}`, backupData.profile);
                    }
                    if (backupData.data) {
                        localStorage.setItem(`vault_data_${this.instanceId}`, backupData.data);
                    }
                    
                    this.closeModal('openFileModal');
                    
                    let importMessage = `✅ Vault imported successfully!\n\n${this.vaultName}\n\nYou can now login with your password and 2FA code.`;
                    if (backupData.savedAt) {
                        const savedDate = new Date(backupData.savedAt);
                        importMessage += `\n\nThis vault was saved on ${savedDate.toLocaleDateString()} at ${savedDate.toLocaleTimeString()}`;
                    }
                    this.showSuccess(importMessage);
                    
                    // Reset file input
                    document.getElementById('backupFileInput').value = '';
                    document.getElementById('backupUploadText').innerHTML = 
                        '<div style="font-size: 2rem; margin-bottom: 0.5rem;">📁</div>Click to select vault file<br><small style="color: var(--text-light);">Accepts: .html or .json files</small>';
                    document.getElementById('openBackupBtn').disabled = true;
                    this.pendingBackupFile = null;
                    
