                                Create Your First Note
                            </button>
                        </div>
                    `;
                    return;
                }
                
                // Sort notes by date, newest first
                const sortedNotes = [...this.caseNotes].sort((a, b) => 
                    new Date(b.timestamp) - new Date(a.timestamp)
                );
                
                // Apply filter
                const filterValue = document.getElementById('noteFilter')?.value || 'all';
                const searchValue = document.getElementById('noteSearch')?.value?.toLowerCase() || '';
                
                const filteredNotes = sortedNotes.filter(note => {
                    // Filter by type
                    let passesFilter = true;
                    switch (filterValue) {
                        case 'personal':
                            passesFilter = note.type === 'personal';
                            break;
                        case 'visit':
                            passesFilter = note.type === 'visit';
                            break;
                        case 'symptom':
                            passesFilter = note.type === 'symptom';
                            break;
                        case 'treatment':
                            passesFilter = note.type === 'treatment';
                            break;
                        case 'gac':
                            passesFilter = note.type === 'gac';
                            break;
                        case 'recent':
                            const thirtyDaysAgo = new Date();
                            thirtyDaysAgo.setDate(thirtyDaysAgo.getDate() - 30);
                            passesFilter = new Date(note.timestamp) > thirtyDaysAgo;
                            break;
                    }
                    
                    // Search filter
                    if (searchValue && passesFilter) {
                        const searchableContent = JSON.stringify(note).toLowerCase();
                        passesFilter = searchableContent.includes(searchValue);
                    }
                    
                    return passesFilter;
