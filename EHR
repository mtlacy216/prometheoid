            async login() {
                const password = document.getElementById('loginPassword').value;
                
                if (!password) {
                    this.showError('Please enter your password');
                    return;
                }
                
                try {
                    const profileStr = localStorage.getItem(`vault_profile_${this.instanceId}`);
                    if (!profileStr) {
                        this.showError('No vault data found. This file may be corrupted.');
                        return;
                    }
                    
                    const profile = JSON.parse(profileStr);
                    
                    // Get vault name and GUID from profile - these should already be set from init()
                    // but double-check from profile as well
                    this.vaultName = this.vaultName || profile.vaultName || 'Unknown Vault';
                    this.vaultGuid = this.vaultGuid || profile.vaultGuid || this.instanceId;
                    
                    // Verify password
                    const hash = await this.hashPassword(password);
                    if (hash !== profile.passwordHash) {
                        this.showError('Wrong password');
                        return;
                    }
                    
                    // Success
                    this.passwordHash = hash;
                    this.masterPassword = password;
                    if (this.pendingEncryptedData) {
                        try {
                            const decrypted = await this.decryptText(this.pendingEncryptedData.iv, this.pendingEncryptedData.cipher);
                            const decompressed = await this.decompressText(decrypted);
                            const payload = JSON.parse(decompressed);
                            this.data = payload.data || {};
                            this.attachments = payload.attachments || {};
                            localStorage.setItem(`vault_data_${this.instanceId}`, JSON.stringify(this.data));
                            const compressed = await this.compressText(JSON.stringify(this.attachments));
                            localStorage.setItem(`vault_attachments_${this.instanceId}`, compressed);
                            this.pendingEncryptedData = null;
                        } catch (e) {
                            console.error('Decryption error:', e);
                            this.showError('Unable to decrypt data. Wrong password?');
                            return;
                        }
                    } else {
                        await this.loadData();
                    }
                    this.unlock();
                    
                    // Clear login fields
                    document.getElementById('loginPassword').value = '';
                    
                } catch (error) {
                    console.error('Login error:', error);
                    this.showError('Wrong password');
                }
            }
            
