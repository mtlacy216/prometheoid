            handleJourneyFileSelect(event) {
                const file = event.target.files[0];
                if (!file) return;
                
                if (!file.name.endsWith('.json')) {
                    this.showError('Please select a JSON journey file');
                    event.target.value = '';
                    return;
                }
                
                this.pendingJourneyFile = file;
                
                document.getElementById('journeyUploadText').innerHTML = 
                    `<strong>${file.name}</strong><br>
                    <small>${(file.size / 1024).toFixed(2)} KB</small>`;
                document.getElementById('importJourneyBtn').disabled = false;
            }
            
            async importJourneyFile() {
                if (!this.pendingJourneyFile) return;
                
                try {
                    const content = await this.pendingJourneyFile.text();
                    const journeyData = JSON.parse(content);
                    
                    // Import the journey
                    await this.journeyEngine.importJourney(journeyData);
                    
                    // Save as custom journey
                    if (!this.data.customJourneys) {
                        this.data.customJourneys = {};
                    }
                    this.data.customJourneys[journeyData.journeyId] = journeyData;
                    
                    // Save data
                    await this.saveData();
                    
                    // Update UI
                    this.updateJourneyTabs();
                    this.updateJourneyModulesList();
                    
                    // Reset modal
                    this.closeModal('importJourneyModal');
                    document.getElementById('journeyFileInput').value = '';
                    document.getElementById('journeyUploadText').innerHTML = 
                        '📁 Click to select journey file<br><small>JSON files only (.json)</small>';
                    document.getElementById('importJourneyBtn').disabled = true;
                    this.pendingJourneyFile = null;
                    
                    this.showSuccess(`Journey module "${journeyData.name}" imported successfully!`);
                    
                } catch (error) {
                    console.error('Journey import error:', error);
                    this.showError('Invalid journey file: ' + error.message);
                }
            }
            
            updateJourneyModulesList() {
                const container = document.getElementById('journeyModulesList');
                container.innerHTML = '';
                
                const allJourneys = Object.values(this.journeyEngine.loadedJourneys);
                
                if (allJourneys.length === 0) {
                    container.innerHTML = '<p style="text-align: center; color: var(--text-light); padding: 2rem;">No journey modules loaded</p>';
                    return;
                }
                
                allJourneys.forEach(journey => {
                    const item = document.createElement('div');
                    item.className = 'journey-module-item';
                    
                    item.innerHTML = `
                        <div class="journey-module-info">
                            <div class="journey-module-name">${journey.icon || '📋'} ${journey.name}</div>
                            <div class="journey-module-version">Version ${journey.version} • ${journey.sections.length} sections</div>
                        </div>
                        <div class="journey-module-actions">
                            <button class="btn btn-secondary btn-sm" onclick="exportJourney('${journey.journeyId}')">
                                Export
                            </button>
                        </div>
                    `;
                    
                    container.appendChild(item);
                });
            }
            
            exportJourney(journeyId) {
                const journey = this.journeyEngine.loadedJourneys[journeyId];
                if (!journey) return;
                
                const jsonString = JSON.stringify(journey, null, 2);
                const blob = new Blob([jsonString], { type: 'application/json' });
                const url = URL.createObjectURL(blob);
                const a = document.createElement('a');
                
                a.href = url;
                a.download = `${journey.journeyId}_v${journey.version}.json`;
                a.click();
                URL.revokeObjectURL(url);
                
                this.showSuccess(`Journey module exported: ${journey.name}`);
            }
            
            exportJourneyModules() {
                const modules = {
                    exportDate: new Date().toISOString(),
                    vaultName: this.vaultName,
                    modules: this.journeyEngine.loadedJourneys
                };
                
                const jsonString = JSON.stringify(modules, null, 2);
                const blob = new Blob([jsonString], { type: 'application/json' });
                const url = URL.createObjectURL(blob);
                const a = document.createElement('a');
                
                const date = new Date().toISOString().split('T')[0];
                a.href = url;
                a.download = `journey_modules_${date}.json`;
                a.click();
                URL.revokeObjectURL(url);
                
                this.showSuccess('All journey modules exported');
            }
            
