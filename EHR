                // In production, you'd generate an actual image
                // For now, we'll create a text file
                const card = document.getElementById('recoveryCard');
                const text = card.innerText;
                
                const blob = new Blob([text], { type: 'text/plain' });
                const url = URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url;
                a.download = `HealthVault_Recovery_Card_${this.vaultName.replace(/\s+/g, '_')}.txt`;
                a.click();
                URL.revokeObjectURL(url);
            }
            
            // ==========================================
            // HELPERS
            // ==========================================
            
            generateId() {
                const array = new Uint8Array(16);
                crypto.getRandomValues(array);
                return Array.from(array, byte => byte.toString(16).padStart(2, '0')).join('');
            }
            
            showError(message) {
                // Create error notification
                const notification = document.createElement('div');
                notification.className = 'info-box warning';
                notification.style.cssText = 'position: fixed; top: 1rem; right: 1rem; z-index: 1001; max-width: 400px;';
                
                // Handle multi-line messages
                const lines = message.split('\n');
                lines.forEach((line, index) => {
                    if (index > 0) notification.appendChild(document.createElement('br'));
                    notification.appendChild(document.createTextNode(line));
                });
                
                document.body.appendChild(notification);
                
                setTimeout(() => notification.remove(), 5000);
            }
            
            showSuccess(message) {
                const notification = document.createElement('div');
                notification.className = 'info-box success';
                notification.style.cssText = 'position: fixed; top: 1rem; right: 1rem; z-index: 1001; max-width: 400px;';
                
                // Handle multi-line messages
                const lines = message.split('\n');
                lines.forEach((line, index) => {
                    if (index > 0) notification.appendChild(document.createElement('br'));
                    notification.appendChild(document.createTextNode(line));
                });
                
                document.body.appendChild(notification);
                
                setTimeout(() => notification.remove(), 4000);
            }
            
            closeModal(modalId) {
                document.getElementById(modalId).classList.remove('active');
            }
            
            showGuide() {
                alert('Health Vault Guide:\n\n1. Your password encrypts everything\n2. Your phone app provides extra security\n3. Save backups regularly\n4. Keep your recovery card safe\n\nNeed more help? Check our website.');
            }
            
            showDebugInfo() {
                const embeddedDataElement = document.getElementById('embeddedVaultData');
                if (embeddedDataElement && embeddedDataElement.textContent.trim()) {
                    try {
                        const embeddedData = JSON.parse(embeddedDataElement.textContent);
                        const info = {
                            hasData: true,
                            vaultName: embeddedData.vaultName,
                            instanceId: embeddedData.instanceId,
                            hasProfile: !!embeddedData.profile,
                            hasVaultData: !!embeddedData.data,
                            savedAt: embeddedData.savedAt,
                            profileLength: embeddedData.profile?.length || 0,
                            dataLength: embeddedData.data?.length || 0,
                            attachmentCount: Object.keys(embeddedData.attachments || {}).length
                        };
                        alert('Vault Debug Info:\n\n' + JSON.stringify(info, null, 2));
                    } catch (e) {
                        alert('Error reading embedded data: ' + e.message);
                    }
                } else {
                    alert('No embedded data found in this file.');
                }
            }
            
            showNoPhoneOption() {
                alert('Alternative 2FA Options:\n\nYou can use any authenticator app on a tablet or computer:\n• Authy Desktop\n• 1Password\n• Bitwarden\n\nOr ask a trusted family member to set it up on their phone.');
            }
        }
        
