                    try {
                        this.data = await this.decrypt(encrypted, this.encryptionKey);
                        this.attachments = this.data.attachments || {};
                        this.providers = this.data.providers || {};
                        this.caseNotes = this.data.caseNotes || [];
                        this.providerAccessLog = this.data.providerAccessLog || [];
                        
                        // Load journeys
                        if (this.data.journeys) {
                            for (const journeyId of Object.keys(this.data.journeys)) {
