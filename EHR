                            <strong>${doc.name}</strong><br>
                            <small>${sizeText} • ${new Date(doc.uploadDate).toLocaleDateString()}</small>
                        </div>
                        <div style="display: flex; gap: 0.5rem;">
                            ${isImage ? `<button class="btn btn-secondary" onclick="previewDocument('${doc.id}')">
                                👁️ Preview
                            </button>` : ''}
                            <button class="btn btn-secondary" onclick="downloadDocument('${doc.id}')">
                                📥 Download
                            </button>
                            <button class="btn btn-danger" onclick="deleteDocument('${doc.id}')">
                                🗑️
                            </button>
