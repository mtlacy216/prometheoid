            startSession(minutes) {
                this.clearSession();
                
                this.sessionEndTime = Date.now() + (minutes * 60 * 1000);
                
                this.sessionTimer = setInterval(() => this.updateSessionTimer(), 1000);
                
                // Warning at 5 minutes
                const warningTime = (minutes - 5) * 60 * 1000;
                if (warningTime > 0) {
                    this.sessionWarningTimeout = setTimeout(() => {
                        const message = `⏰ Session expires in 5 minutes!\n\n` +
                                      `Your changes are ONLY in this browser tab.\n` +
                                      `They will be LOST when the session ends.\n\n` +
                                      `Would you like to:\n` +
                                      `• Add more time? (YES)\n` +
                                      `• Save to file now? (NO/Cancel)`;
                        
                        if (confirm(message)) {
                            this.extendTime();
                        } else {
                            this.showSaveModal();
                        }
                    }, warningTime);
                }
                
                // Auto-lock timeout
                this.sessionTimeout = setTimeout(async () => {
                    if (confirm('Session expiring!\n\n⚠️ Your data is only in browser memory.\nSave to file before locking?')) {
                        await this.showSaveModal();
                    } else {
                        alert('Session expired. Please login again.');
                        this.lockVault();
                    }
                }, minutes * 60 * 1000);
            }
            
            clearSession() {
                if (this.sessionTimer) clearInterval(this.sessionTimer);
                if (this.sessionTimeout) clearTimeout(this.sessionTimeout);
                if (this.sessionWarningTimeout) clearTimeout(this.sessionWarningTimeout);
            }
            
            updateSessionTimer() {
                if (!this.sessionEndTime) return;
                
                const remaining = Math.max(0, this.sessionEndTime - Date.now());
                const minutes = Math.floor(remaining / 60000);
                const seconds = Math.floor((remaining % 60000) / 1000);
                
                const timerEl = document.getElementById('sessionTimer');
                const timeEl = document.getElementById('sessionTime');
                
                timeEl.textContent = `${minutes}:${seconds.toString().padStart(2, '0')}`;
                
                timerEl.className = 'session-timer';
                if (minutes < 5) {
                    timerEl.classList.add('danger');
                } else if (minutes < 10) {
                    timerEl.classList.add('warning');
                }
            }
            
            extendTime() {
                this.startSession(45);
                this.showSuccess('Added 45 minutes to your session');
            }
            
