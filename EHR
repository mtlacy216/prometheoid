        // ============================================
        // JOURNEY ENGINE CLASS (ENHANCED)
        // ============================================
        
        class JourneyEngine {
            constructor(app) {
                this.app = app;
                this.loadedJourneys = {};
                this.loadDefaultJourneys();
            }
            
            loadDefaultJourneys() {
                // Load default journey templates
                const defaultTemplates = document.getElementById('defaultJourneyTemplates');
                if (defaultTemplates) {
                    try {
                        const templates = JSON.parse(defaultTemplates.textContent);
                        Object.entries(templates).forEach(([id, journey]) => {
                            this.loadedJourneys[id] = journey;
                        });
                    } catch (e) {
                        console.error('Error loading default journeys:', e);
                    }
                }
            }
            
            async importJourney(journeyData) {
                // Validate journey structure
                if (!journeyData.journeyId || !journeyData.version || !journeyData.sections) {
                    throw new Error('Invalid journey format');
                }
                
                // Check if this is an update
                const existing = this.loadedJourneys[journeyData.journeyId];
                if (existing) {
                    console.log(`Updating journey ${journeyData.journeyId} from v${existing.version} to v${journeyData.version}`);
                }
                
                // Store journey
                this.loadedJourneys[journeyData.journeyId] = journeyData;
                
                // Create tab if it doesn't exist
                this.createJourneyTab(journeyData);
                
                // Render journey content
                this.renderJourneyContent(journeyData);
                
                return journeyData;
            }
            
            createJourneyTab(journey) {
                const tabId = `${journey.journeyId}-tab-btn`;
                let tab = document.getElementById(tabId);
                
                if (!tab) {
                    tab = document.createElement('button');
                    tab.id = tabId;
                    tab.className = 'tab';
                    if (journey.journeyId === 'gender-affirming-care') {
                        tab.className += ' gac-tab';
                    }
                    tab.innerHTML = `${journey.icon || '📋'} ${journey.name}`;
                    tab.onclick = () => this.app.switchTab(journey.journeyId);
                    
                    // Insert at correct position based on tabOrder
                    const dynamicTabs = document.getElementById('dynamicTabs');
                    if (journey.tabOrder === 2) {
                        // Insert at the beginning for second position
                        dynamicTabs.insertBefore(tab, dynamicTabs.firstChild);
                    } else {
                        dynamicTabs.appendChild(tab);
                    }
                }
                
                // Create content area if it doesn't exist
                const contentId = `${journey.journeyId}-tab`;
                let content = document.getElementById(contentId);
                
                if (!content) {
                    content = document.createElement('div');
                    content.id = contentId;
                    content.className = 'tab-content hidden';
                    document.getElementById('tabContent').appendChild(content);
                }
            }
            
            renderJourneyContent(journey) {
                const contentId = `${journey.journeyId}-tab`;
                const content = document.getElementById(contentId);
                if (!content) return;
                
                let html = '';
                
                // Special handling for GAC
                if (journey.journeyId === 'gender-affirming-care') {
                    html = this.renderGACContent(journey);
                } else {
                    // Placeholder for other journeys
                    html = `
                        <div class="card">
                            <h3 class="card-title">${journey.icon} ${journey.name}</h3>
                            <p style="text-align: center; color: var(--text-light); padding: 2rem;">
                                This journey module is coming soon!
                            </p>
                        </div>
                    `;
                }
                
                content.innerHTML = html;
                
                // Populate with existing data
                this.populateJourneyFields(journey.journeyId);
            }
            
            renderGACContent(journey) {
                return `
                    <div class="gac-header">
                        <h3>🏳️‍⚧️ Gender Affirming Care Journey</h3>
                        <p>Track your transition, celebrate milestones, and document your care</p>
                    </div>
                    
                    <div class="card">
                        <div class="card-header">
                            <h3 class="card-title">Quick Actions</h3>
                        </div>
                        <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
                            <button class="btn btn-gac" onclick="showGacNoteModal()">
                                ➕ Add GAC Note
                            </button>
                            <button class="btn btn-secondary" onclick="viewGacTimeline()">
                                📅 View Timeline
                            </button>
                        </div>
                    </div>
                    
                    ${journey.sections.map(section => `
                        <div class="card">
                            <h3 class="card-title">${section.name}</h3>
                            <div class="grid">
                                ${section.fields.map(field => this.renderField(journey.journeyId, section.id, field)).join('')}
                            </div>
                        </div>
                    `).join('')}
                    
                    <div class="card">
                        <h3 class="card-title">Transition Timeline</h3>
                        <div id="gacTimeline" class="gac-timeline">
                            <p style="text-align: center; color: var(--text-light);">Your timeline will appear here as you add notes and milestones</p>
                        </div>
                    </div>
                    
                    <div class="info-box gac">
                        <strong>Resources & Support:</strong><br>
                        • Document your journey at your own pace<br>
                        • Use case notes to track changes and feelings<br>
                        • Keep important documents in the Documents tab<br>
                        • Remember: Your journey is unique and valid 💜
                    </div>
                `;
            }
            
            renderField(journeyId, sectionId, field) {
                const fieldId = `journey_${journeyId}_${sectionId}_${field.id}`;
                let html = '<div class="form-group">';
                
                html += `<label>${field.label}${field.required ? ' *' : ''}</label>`;
                
                switch (field.type) {
                    case 'text':
                        html += `<input type="text" id="${fieldId}" placeholder="${field.placeholder || ''}" onchange="autoSave()">`;
                        break;
                        
                    case 'textarea':
                        html += `<textarea id="${fieldId}" rows="3" placeholder="${field.placeholder || ''}" onchange="autoSave()"></textarea>`;
                        break;
                        
                    case 'date':
                        html += `<input type="date" id="${fieldId}" onchange="autoSave()">`;
                        break;
                        
                    case 'select':
                        html += `<select id="${fieldId}" onchange="autoSave()">`;
                        html += '<option value="">Select...</option>';
                        field.options.forEach(option => {
                            html += `<option value="${option}">${option}</option>`;
                        });
                        html += '</select>';
                        break;
                        
                    case 'number':
                        html += `<input type="number" id="${fieldId}" placeholder="${field.placeholder || ''}" onchange="autoSave()">`;
                        break;
                        
                    case 'list':
                        // Special handling for list fields
                        html += `<div id="${fieldId}_container">
                            <button class="btn btn-secondary btn-sm" onclick="addListItem('${journeyId}', '${sectionId}', '${field.id}')">
                                + Add ${field.label}
                            </button>
                            <div id="${fieldId}_list" class="item-list" style="margin-top: 0.5rem;">
                                <!-- List items will be added here -->
                            </div>
                        </div>`;
                        break;
                }
                
                if (field.bestPractice) {
                    html += `<small style="color: var(--gac-primary);">💡 ${field.bestPractice}</small>`;
                }
                
                html += '</div>';
                
                return html;
            }
            
            populateJourneyFields(journeyId) {
                const journey = this.loadedJourneys[journeyId];
                if (!journey) return;
                
                const journeyData = this.app.data.journeyData?.[journeyId] || {};
                
                journey.sections.forEach(section => {
                    section.fields.forEach(field => {
                        const fieldId = `journey_${journeyId}_${section.id}_${field.id}`;
                        const element = document.getElementById(fieldId);
                        if (element && journeyData[`${section.id}_${field.id}`]) {
                            if (field.type === 'list') {
                                // Handle list fields
                                this.populateListField(journeyId, section.id, field, journeyData[`${section.id}_${field.id}`]);
                            } else {
                                element.value = journeyData[`${section.id}_${field.id}`];
                            }
                        }
                    });
                });
            }
            
            populateListField(journeyId, sectionId, field, data) {
                if (!Array.isArray(data)) return;
                
                const listContainer = document.getElementById(`journey_${journeyId}_${sectionId}_${field.id}_list`);
                if (!listContainer) return;
                
                listContainer.innerHTML = '';
                
                data.forEach((item, index) => {
                    const itemDiv = document.createElement('div');
                    itemDiv.className = 'item-card';
                    itemDiv.innerHTML = `
                        <button class="remove-btn" onclick="removeListItem('${journeyId}', '${sectionId}', '${field.id}', ${index})">×</button>
                        ${field.listFields.map(lf => 
                            `<strong>${lf.label}:</strong> ${item[lf.id] || 'N/A'}<br>`
                        ).join('')}
                    `;
                    listContainer.appendChild(itemDiv);
                });
            }
            
            collectJourneyData(journeyId) {
                const journey = this.loadedJourneys[journeyId];
                if (!journey) return {};
                
                const data = {};
                
                journey.sections.forEach(section => {
                    section.fields.forEach(field => {
                        const fieldId = `journey_${journeyId}_${section.id}_${field.id}`;
                        
                        if (field.type === 'list') {
                            // Collect list data from app state
                            const listData = this.app.data.journeyData?.[journeyId]?.[`${section.id}_${field.id}`];
                            if (listData) {
                                data[`${section.id}_${field.id}`] = listData;
                            }
                        } else {
                            const element = document.getElementById(fieldId);
                            if (element) {
                                data[`${section.id}_${field.id}`] = element.value;
                            }
                        }
                    });
                });
                
                return data;
            }
        }
        
        // ============================================
        // MAIN HEALTH VAULT CLASS (ENHANCED)
        // ============================================
        
        class SimpleHealthVault {
            constructor() {
                // Core properties
                this.instanceId = null;
                this.vaultGuid = null;
                this.vaultName = null;
                this.passwordHash = null;
                this.data = {};
                this.attachments = {};
                this.providers = {};
                this.caseNotes = [];
                this.masterPassword = null;
                this.pendingEncryptedData = null;
                
                // Enhanced properties
                this.journeyEngine = new JourneyEngine(this);
                
                // State
                this.isLocked = true;
                this.sessionTimeout = null;
                this.sessionEndTime = null;
                this.saveTimeout = null;
                this.hasUnsavedChanges = false;
                
                this.init();
            }
            
            async init() {
                // Always clear any existing instance data first to ensure clean state
                this.instanceId = null;
                this.vaultGuid = null;
                this.vaultName = null;
                this.passwordHash = null;
                this.data = {};
                this.attachments = {};
                this.providers = {};
                this.caseNotes = [];
                
                // Force reset all UI states to prevent cached views
                this.resetAllUIStates();
                
                // Clear any form data that might be cached
                this.clearAllFormData();
                
                // Check for embedded data in THIS HTML file
                const embeddedDataElement = document.getElementById('embeddedVaultData');
                if (embeddedDataElement && embeddedDataElement.textContent.trim()) {
                    try {
                        const embeddedData = JSON.parse(embeddedDataElement.textContent);
                        if (embeddedData && embeddedData.instanceId) {
                            // This HTML file contains vault data
                            console.log('Found embedded vault data');
                            
                            // Set the instance ID and vault name from embedded data
                            this.instanceId = embeddedData.instanceId;
                            this.vaultGuid = embeddedData.vaultGuid || this.instanceId;
                            this.vaultName = embeddedData.vaultName || 'Unknown Vault';
                            document.getElementById('instanceId').textContent = this.instanceId;
                            
                            // Restore profile
                            if (embeddedData.profile) {
                                localStorage.setItem(`vault_profile_${this.instanceId}`, JSON.stringify(embeddedData.profile));
                            }
                            if (embeddedData.encrypted) {
                                this.pendingEncryptedData = { iv: embeddedData.iv, cipher: embeddedData.cipher };
                            } else {
                                if (embeddedData.data) {
                                    localStorage.setItem(`vault_data_${this.instanceId}`, JSON.stringify(embeddedData.data));
                                }
                                if (embeddedData.attachments) {
                                    localStorage.setItem(`vault_attachments_${this.instanceId}`, JSON.stringify(embeddedData.attachments));
                                }
                            }
                            
                            // Show login screen for this vault with saved date
                            let subtitle = `${this.vaultName} - Ready to unlock`;
                            if (embeddedData.savedAt) {
                                const savedDate = new Date(embeddedData.savedAt);
                                subtitle = `${this.vaultName} - Saved ${savedDate.toLocaleDateString()} at ${savedDate.toLocaleTimeString()}`;
                            }
                            document.getElementById('welcomeSubtitle').textContent = subtitle;
                            this.showExistingUser();
                            this.setupEventListeners();
                            return;
                        }
                    } catch (e) {
                        console.log('No valid embedded data found');
                    }
                }
                
                // No embedded data - show new user options
                document.getElementById('welcomeSubtitle').textContent = 'Create a new vault or import existing data';
                this.showNewUser();
                
                // Set up event listeners
                this.setupEventListeners();
            }
            
            setupEventListeners() {
                // Password strength checker
                document.getElementById('newPassword')?.addEventListener('input', (e) => {
                    this.checkPasswordStrength(e.target.value);
                });
                
                // Enter key handling
                document.addEventListener('keypress', (e) => {
                    if (e.key === 'Enter') {
                        if (document.getElementById('existingUserLogin').classList.contains('hidden') === false) {
                            this.login();
                        }
                    }
                });
                
                // Exit warning
                window.addEventListener('beforeunload', (e) => {
                    if (!this.isLocked && this.hasUnsavedChanges) {
                        const message = 'Are you sure you want to leave? Make sure you\'ve saved your vault to a file!';
                        e.returnValue = message;
                        return message;
                    }
                });
            }
            
            resetAllUIStates() {
                // Hide all screens first
                document.getElementById('welcomeScreen').classList.remove('hidden');
                document.getElementById('mainApp').classList.add('hidden');
                
                // Reset all welcome screen subsections
                document.getElementById('welcomeIntro').classList.remove('hidden');
                document.getElementById('newUserSetup').classList.add('hidden');
                document.getElementById('existingUserLogin').classList.add('hidden');
                document.getElementById('helpScreen').classList.add('hidden');
                
                // Reset setup steps
                document.getElementById('setupStep1')?.classList.remove('hidden');
                document.getElementById('setupStep2')?.classList.add('hidden');
                
                // Reset modal states
                document.querySelectorAll('.modal').forEach(modal => {
                    modal.classList.remove('active');
                });
                
                // Reset view states
                document.getElementById('normalView')?.classList.remove('hidden');
                document.getElementById('dataView')?.classList.add('hidden');
                
                // Reset tabs to first tab
                document.querySelectorAll('.tab-content').forEach((content, index) => {
                    if (index === 0) {
                        content.classList.remove('hidden');
                    } else {
                        content.classList.add('hidden');
                    }
                });
                
                document.querySelectorAll('.tab').forEach((tab, index) => {
                    if (index === 0) {
                        tab.classList.add('active');
                    } else {
                        tab.classList.remove('active');
                    }
                });
                
                // Clear dynamic tabs
                document.getElementById('dynamicTabs').innerHTML = '';
                
                // Update note form
                this.updateNoteForm();
            }
            
            clearAllFormData() {
                // Clear all input fields
                document.querySelectorAll('input[type="text"], input[type="password"], input[type="email"], input[type="tel"], input[type="date"], textarea, select').forEach(field => {
                    field.value = '';
                });
                
                // Clear checkboxes
                document.querySelectorAll('input[type="checkbox"]').forEach(checkbox => {
                    checkbox.checked = false;
                });
                
                // Reset file inputs
                document.querySelectorAll('input[type="file"]').forEach(fileInput => {
                    fileInput.value = '';
                });
                
                // Clear any temp data
                this.tempPassword = null;
                this.pendingFile = null;
                this.pendingBackupFile = null;
                this.pendingJourneyFile = null;
                this.selectedJourneys = {};
            }
            
            generateVaultName() {
                const adjective = VAULT_ADJECTIVES[Math.floor(Math.random() * VAULT_ADJECTIVES.length)];
                const noun = VAULT_NOUNS[Math.floor(Math.random() * VAULT_NOUNS.length)];
                return `${adjective} ${noun}`;
            }
            
            generateGuid() {
                // Generate a proper GUID
                return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function(c) {
                    const r = Math.random() * 16 | 0;
                    const v = c === 'x' ? r : (r & 0x3 | 0x8);
                    return v.toString(16);
                });
            }
            
            showNewUser() {
                const container = document.getElementById('newOrExisting');
                container.innerHTML = `
                    <div class="info-box tip" style="margin-bottom: 1rem;">
                        <strong>⚠️ Important:</strong> You must create a vault first before you can save any data!
                    </div>
                    
                    <button class="btn btn-primary btn-block" onclick="startNewSetup()">
                        🆕 Create New Health Vault
                    </button>
                    
                    <div style="text-align: center; margin: 1rem 0; color: var(--text-light);">
                        — or —
                    </div>
                    
                    <button class="btn btn-secondary btn-block" onclick="showOpenFile()">
                        📂 Import Existing Vault File
                    </button>
                    
                    <div class="help-section">
                        <small>This is an empty vault template</small>
                    </div>
                `;
            }
            
            showExistingUser() {
                const container = document.getElementById('newOrExisting');
                
                // Update login screen with vault info
                document.getElementById('loginVaultName').textContent = this.vaultName || 'Unknown Vault';
                document.getElementById('loginVaultId').textContent = this.vaultGuid || this.instanceId;
                
                // Check if we have saved date information
                let vaultInfo = '';
                try {
                    const embeddedDataElement = document.getElementById('embeddedVaultData');
                    if (embeddedDataElement && embeddedDataElement.textContent.trim()) {
                        const embeddedData = JSON.parse(embeddedDataElement.textContent);
                        if (embeddedData.savedAt) {
                            const savedDate = new Date(embeddedData.savedAt);
                            vaultInfo = `<div class="info-box tip" style="margin-bottom: 1rem;">
                                <strong>📅 Vault Information:</strong><br>
                                <strong>${this.vaultName}</strong><br>
                                <small style="font-family: monospace;">${this.vaultGuid || this.instanceId}</small><br>
                                Saved on ${savedDate.toLocaleDateString()} at ${savedDate.toLocaleTimeString()}
                            </div>`;
                        }
                    }
                } catch (e) {
                    // Ignore errors
                }
                
                container.innerHTML = vaultInfo + `
                    <button class="btn btn-primary btn-block" onclick="showLogin()">
                        🔓 Unlock This Health Vault
                    </button>
                    
                    <div style="text-align: center; margin: 1rem 0; color: var(--text-light);">
                        — or —
                    </div>
                    
                    <button class="btn btn-secondary btn-block" onclick="showOpenFile()">
                        📂 Import Different Vault File
                    </button>
                    
                    <div class="help-section">
                        <small>This file contains your health records</small>
                    </div>
                `;
                
                // Show the welcome intro screen with the appropriate content
                document.getElementById('welcomeIntro').classList.remove('hidden');
                document.getElementById('existingUserLogin').classList.add('hidden');
                document.getElementById('newUserSetup').classList.add('hidden');
            }
            
            // ==========================================
            // SETUP FLOW (SIMPLIFIED)
            // ==========================================
            
            startNewSetup() {
                document.getElementById('welcomeIntro').classList.add('hidden');
                document.getElementById('newUserSetup').classList.remove('hidden');
                document.getElementById('setupStep1').classList.remove('hidden');
            }
            
            checkPasswordStrength(password) {
                const bars = [
                    document.getElementById('strength1'),
                    document.getElementById('strength2'),
                    document.getElementById('strength3')
                ];
                
                let strength = 0;
                if (password.length >= 8) strength++;
                if (password.match(/[A-Z]/) && password.match(/[a-z]/)) strength++;
                if (password.match(/[0-9]/) || password.match(/[^A-Za-z0-9]/)) strength++;
                
                bars.forEach((bar, index) => {
                    if (index < strength) {
                        bar.classList.add('active');
                    } else {
                        bar.classList.remove('active');
                    }
                });
            }
            
            async setupStep1() {
                const password = document.getElementById('newPassword').value;
                const confirm = document.getElementById('confirmPassword').value;
                
                if (password.length < 8) {
                    this.showError('Password needs to be at least 8 characters');
                    return;
                }
                
                if (password !== confirm) {
                    this.showError('Passwords don\'t match');
                    return;
                }
                
                // Generate instance ID, GUID, and vault name
                this.instanceId = this.generateId();
                this.vaultGuid = this.generateGuid();
                this.vaultName = this.generateVaultName();
                
                // Store password temporarily
                this.tempPassword = password;
                
                // Initialize selected journeys
                this.selectedJourneys = {};
                
                // Move to step 2 (case journeys)
                document.getElementById('setupStep1').classList.add('hidden');
                document.getElementById('setupStep2').classList.remove('hidden');
            }
            
            async completeSetup() {
                // Hash password for storage
                this.passwordHash = await this.hashPassword(this.tempPassword);
                
                // Create profile
                const profile = {
