            }
            
            // List item functions for journey modules
            window.addListItem = function(journeyId, sectionId, fieldId) {
                const journey = app.journeyEngine.loadedJourneys[journeyId];
                if (!journey) return;
                
                const field = journey.sections.find(s => s.id === sectionId)?.fields.find(f => f.id === fieldId);
                if (!field || field.type !== 'list') return;
                
                // Create a modal for adding list items
                const modalHtml = `
                    <div class="modal active" id="tempListModal">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h3 class="modal-title">Add ${field.label}</h3>
                                <button class="close-btn" onclick="document.getElementById('tempListModal').remove()">×</button>
                            </div>
                            ${field.listFields.map(lf => `
                                <div class="form-group">
                                    <label>${lf.label}</label>
                                    <input type="${lf.type}" id="temp_${lf.id}" ${lf.type === 'date' ? '' : 'placeholder="' + (lf.placeholder || '') + '"'}>
                                </div>
                            `).join('')}
                            <button class="btn btn-primary btn-block" onclick="saveListItem('${journeyId}', '${sectionId}', '${fieldId}')">
                                Save
                            </button>
                        </div>
                    </div>
                `;
                
                document.body.insertAdjacentHTML('beforeend', modalHtml);
            }
            
            window.saveListItem = function(journeyId, sectionId, fieldId) {
                const journey = app.journeyEngine.loadedJourneys[journeyId];
                if (!journey) return;
                
                const field = journey.sections.find(s => s.id === sectionId)?.fields.find(f => f.id === fieldId);
                if (!field || field.type !== 'list') return;
                
                // Collect data from temp fields
                const itemData = {};
                field.listFields.forEach(lf => {
                    itemData[lf.id] = document.getElementById(`temp_${lf.id}`)?.value || '';
                });
                
                // Save to journey data
                if (!app.data.journeyData) app.data.journeyData = {};
                if (!app.data.journeyData[journeyId]) app.data.journeyData[journeyId] = {};
                if (!app.data.journeyData[journeyId][`${sectionId}_${fieldId}`]) {
                    app.data.journeyData[journeyId][`${sectionId}_${fieldId}`] = [];
                }
                
                app.data.journeyData[journeyId][`${sectionId}_${fieldId}`].push(itemData);
                
                // Update UI
                app.journeyEngine.populateListField(journeyId, sectionId, field, app.data.journeyData[journeyId][`${sectionId}_${fieldId}`]);
                
                // Remove modal
                document.getElementById('tempListModal').remove();
                
                // Save
                app.autoSave();
            }
            
            window.removeListItem = function(journeyId, sectionId, fieldId, index) {
                if (!confirm('Remove this item?')) return;
                
                if (app.data.journeyData?.[journeyId]?.[`${sectionId}_${fieldId}`]) {
                    app.data.journeyData[journeyId][`${sectionId}_${fieldId}`].splice(index, 1);
                    
                    const journey = app.journeyEngine.loadedJourneys[journeyId];
                    const field = journey.sections.find(s => s.id === sectionId)?.fields.find(f => f.id === fieldId);
                    if (field) {
                        app.journeyEngine.populateListField(journeyId, sectionId, field, app.data.journeyData[journeyId][`${sectionId}_${fieldId}`]);
                    }
                    
                    app.autoSave();
                }
            }
        }
        
        // Initialize when DOM is ready
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initializeApp);
        } else {
            // DOM is already ready
            initializeApp();
        }
    </script>
