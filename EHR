            renderNoteField(sectionId, field) {
                const fieldId = `note_${sectionId}_${field.id}`;
                
                switch (field.type) {
                    case 'textarea':
                        return `<textarea class="dynamic-field-input" id="${fieldId}" rows="3" placeholder="${field.placeholder || ''}"></textarea>`;
                    case 'number':
                        return `<input type="number" class="dynamic-field-input" id="${fieldId}" placeholder="${field.placeholder || ''}">`;
                    default:
                        return `<input type="text" class="dynamic-field-input" id="${fieldId}" placeholder="${field.placeholder || ''}">`;
                }
            }
            
            saveProviderNote() {
                if (!this.selectedNoteTemplate || !this.providerSession.providerId) {
                    this.showError('Invalid note configuration');
                    return;
                }
                
                const provider = this.providers[this.providerSession.providerId];
                if (!provider) {
                    this.showError('Provider not found');
                    return;
                }
                
                // Collect note data
                const noteData = {
                    sections: {}
                };
                
                this.selectedNoteTemplate.sections.forEach(section => {
                    if (section.fields) {
                        noteData.sections[section.id] = {};
                        section.fields.forEach(field => {
                            const fieldId = `note_${section.id}_${field.id}`;
                            const value = document.getElementById(fieldId)?.value;
                            if (value) {
                                noteData.sections[section.id][field.id] = value;
                            }
                        });
                    } else {
                        const value = document.getElementById(`note_${section.id}`)?.value;
                        if (value) {
                            noteData.sections[section.id] = value;
                        }
                    }
                });
                
                // Create case note
                const caseNote = {
                    id: 'note_' + this.generateId(),
                    timestamp: new Date().toISOString(),
                    providerId: provider.id,
                    providerName: provider.name,
                    templateId: this.selectedNoteTemplate.id,
                    templateName: this.selectedNoteTemplate.name,
                    data: noteData
                };
                
                // Add to notes
                this.caseNotes.push(caseNote);
                
                // Save and update
                this.autoSave();
                this.updateCaseNotesList();
                this.closeModal('addNoteModal');
                
                this.showSuccess('Case note added successfully');
            }
            
            updateCaseNotesList() {
                const container = document.getElementById('caseNotesList');
                container.innerHTML = '';
                
                if (this.caseNotes.length === 0) {
                    container.innerHTML = '<p style="text-align: center; color: var(--text-light); padding: 2rem;">No case notes yet. Notes will appear here when providers add them during visits.</p>';
                    return;
                }
                
                // Sort notes by date, newest first
                const sortedNotes = [...this.caseNotes].sort((a, b) => 
                    new Date(b.timestamp) - new Date(a.timestamp)
                );
                
                sortedNotes.forEach(note => {
                    const noteElement = document.createElement('div');
                    noteElement.className = 'case-note';
                    
                    const noteDate = new Date(note.timestamp);
                    
                    let contentHtml = '';
                    Object.entries(note.data.sections).forEach(([sectionId, sectionData]) => {
                        const sectionName = this.getSectionName(note.templateId, sectionId);
                        contentHtml += `
                            <div class="case-note-section">
                                <div class="case-note-section-title">${sectionName}</div>
                                <div class="case-note-section-content">
                        `;
                        
                        if (typeof sectionData === 'string') {
                            contentHtml += sectionData;
                        } else {
                            Object.entries(sectionData).forEach(([fieldId, value]) => {
                                const fieldLabel = this.getFieldLabel(note.templateId, sectionId, fieldId);
                                contentHtml += `<strong>${fieldLabel}:</strong> ${value}<br>`;
                            });
                        }
                        
                        contentHtml += `
                                </div>
                            </div>
                        `;
                    });
                    
                    noteElement.innerHTML = `
                        <div class="case-note-header">
                            <div class="case-note-meta">
                                <div class="case-note-provider">${note.providerName}</div>
                                <div class="case-note-date">${noteDate.toLocaleString()}</div>
                            </div>
                            <div class="case-note-type">${note.templateName}</div>
                        </div>
                        <div class="case-note-content">
                            ${contentHtml}
                        </div>
                    `;
                    
                    container.appendChild(noteElement);
                });
            }
            
            getSectionName(templateId, sectionId) {
                // Find section name from template
                const templates = this.journeyEngine.getNoteTemplates();
                const template = templates.find(t => t.id === templateId);
                if (template) {
                    const section = template.sections.find(s => s.id === sectionId);
                    if (section) return section.name;
                }
                return sectionId.replace(/_/g, ' ').replace(/\b\w/g, l => l.toUpperCase());
            }
            
            getFieldLabel(templateId, sectionId, fieldId) {
                // Find field label from template
                const templates = this.journeyEngine.getNoteTemplates();
                const template = templates.find(t => t.id === templateId);
                if (template) {
                    const section = template.sections.find(s => s.id === sectionId);
                    if (section && section.fields) {
                        const field = section.fields.find(f => f.id === fieldId);
                        if (field) return field.label;
                    }
                }
                return fieldId.replace(/_/g, ' ').replace(/\b\w/g, l => l.toUpperCase());
            }
            
