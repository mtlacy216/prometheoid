                            if (document.getElementById('noteSeverity')) document.getElementById('noteSeverity').value = note.severity || '';
                            if (document.getElementById('noteSymptomStart')) document.getElementById('noteSymptomStart').value = note.startTime || '';
                            if (document.getElementById('noteTriggers')) document.getElementById('noteTriggers').value = note.triggers || '';
                            if (document.getElementById('noteHelps')) document.getElementById('noteHelps').value = note.helps || '';
                            if (document.getElementById('noteAdditional')) document.getElementById('noteAdditional').value = note.additional || '';
                            break;
                            
                        case 'treatment':
                            if (document.getElementById('noteTreatment')) document.getElementById('noteTreatment').value = note.treatment || '';
                            if (document.getElementById('noteTreatmentStart')) document.getElementById('noteTreatmentStart').value = note.startDate || '';
                            if (document.getElementById('noteEffectiveness')) document.getElementById('noteEffectiveness').value = note.effectiveness || '';
                            if (document.getElementById('noteSideEffects')) document.getElementById('noteSideEffects').value = note.sideEffects || '';
