            // Note selector functions
            window.selectMood = function(n) {
                document.querySelectorAll('#moodSelector .mood-option').forEach(opt => {
                    opt.classList.remove('selected');
                });
                event.target.classList.add('selected');
                document.getElementById('noteMood').value = n;
