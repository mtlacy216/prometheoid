                    </div>
                    
                    <button class="btn btn-secondary btn-block" onclick="showOpenFile()">
                        📂 Import Different Vault File
                    </button>
                    
                    <div class="help-section">
                        <small>This file contains encrypted health records</small>
                    </div>
                `;
                
                // Show the welcome intro screen with the appropriate content
                document.getElementById('welcomeIntro').classList.remove('hidden');
                document.getElementById('existingUserLogin').classList.add('hidden');
                document.getElementById('newUserSetup').classList.add('hidden');
            }
            
            // ==========================================
            // SETUP FLOW
            // ==========================================
            
            startNewSetup() {
                document.getElementById('welcomeIntro').classList.add('hidden');
                document.getElementById('newUserSetup').classList.remove('hidden');
                document.getElementById('setupStep1').classList.remove('hidden');
            }
            
            checkPasswordStrength(password) {
                const bars = [
                    document.getElementById('strength1'),
                    document.getElementById('strength2'),
                    document.getElementById('strength3')
                ];
                
                let strength = 0;
                if (password.length >= 8) strength++;
                if (password.match(/[A-Z]/) && password.match(/[a-z]/)) strength++;
                if (password.match(/[0-9]/) || password.match(/[^A-Za-z0-9]/)) strength++;
                
                bars.forEach((bar, index) => {
                    if (index < strength) {
                        bar.classList.add('active');
                    } else {
                        bar.classList.remove('active');
                    }
                });
            }
            
            async setupStep1() {
                const password = document.getElementById('newPassword').value;
                const confirm = document.getElementById('confirmPassword').value;
                
                if (password.length < 8) {
                    this.showError('Password needs to be at least 8 characters');
                    return;
                }
                
                if (password !== confirm) {
                    this.showError('Passwords don\'t match');
                    return;
                }
                
                // Generate instance ID, vault name, and TOTP secret
                this.instanceId = this.generateId();
                this.vaultName = this.generateVaultName();
                this.totpSecret = this.generateTOTPSecret();
                
                // Store password temporarily
                this.tempPassword = password;
                
                // Generate QR code
                const qrContainer = document.getElementById('setupQrCode');
                qrContainer.innerHTML = ''; // Clear any existing QR
                
                const otpUrl = `otpauth://totp/HealthVault:${this.vaultName}?secret=${this.totpSecret}&issuer=HealthVault`;
                new QRCode(qrContainer, {
                    text: otpUrl,
                    width: 200,
                    height: 200,
                    colorDark: "#1e293b",
                    colorLight: "#ffffff",
                    correctLevel: QRCode.CorrectLevel.M
                });
                
                // Move to step 2
                document.getElementById('setupStep1').classList.add('hidden');
                document.getElementById('setupStep2').classList.remove('hidden');
            }
            
            async setupStep2() {
                const code = document.getElementById('setupVerifyCode').value;
                
                if (!this.verifyTOTP(code, this.totpSecret)) {
                    this.showError('That code doesn\'t match. Check your app and try again.');
                    return;
                }
                
                // Initialize selected journeys
                this.selectedJourneys = {};
                
                // Move to step 3 (case journeys)
                document.getElementById('setupStep2').classList.add('hidden');
                document.getElementById('setupStep3').classList.remove('hidden');
            }
            
            async setupStep3() {
                // Generate recovery code
                this.recoveryCode = this.generateRecoveryCode();
                document.getElementById('recoveryCodeDisplay').textContent = this.recoveryCode;
                document.getElementById('recoveryVaultName').textContent = this.vaultName;
                document.getElementById('recoveryVaultId').textContent = this.instanceId;
                
                // Move to step 4 (recovery card)
                document.getElementById('setupStep3').classList.add('hidden');
                document.getElementById('setupStep4').classList.remove('hidden');
            }
            
            async completeSetup() {
                if (!document.getElementById('confirmSaved').checked) {
                    this.showError('Please confirm you\'ve saved your recovery card');
                    return;
                }
                
                // Create profile
                const salt = crypto.getRandomValues(new Uint8Array(16));
                const profile = {
                    salt: btoa(String.fromCharCode(...salt)),
                    created: new Date().toISOString(),
                    instanceId: this.instanceId,
                    vaultName: this.vaultName
                };
                
                // Encrypt test data for password verification
                const key = await this.deriveKey(this.tempPassword, salt);
                const testData = await this.encrypt({ test: true }, this.tempPassword);
                profile.verifier = testData;
                
                // Encrypt TOTP secret and recovery code
                profile.totpSecret = await this.encrypt(this.totpSecret, this.tempPassword);
                profile.recoveryCode = await this.encrypt(this.recoveryCode, this.tempPassword);
                
                // Save profile
                localStorage.setItem(`vault_profile_${this.instanceId}`, JSON.stringify(profile));
                
                // Initialize empty data with selected journeys
                this.encryptionKey = this.tempPassword;
                this.data = {
                    journeys: this.selectedJourneys || {},
                    journeyData: {},
                    providers: {},
                    caseNotes: [],
                    providerAccessLog: []
                };
                this.attachments = {};
                this.providers = {};
                this.caseNotes = [];
                
                // Import selected default journeys
                for (const journeyId of Object.keys(this.selectedJourneys)) {
