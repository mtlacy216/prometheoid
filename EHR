            async loadData() {
                const dataStr = localStorage.getItem(`vault_data_${this.instanceId}`);
                if (dataStr) {
                    try {
                        this.data = JSON.parse(dataStr);
                        this.providers = this.data.providers || {};
                        this.caseNotes = this.data.caseNotes || [];
                        
                        // Load attachments (decompress if needed)
                        const attachmentsStr = localStorage.getItem(`vault_attachments_${this.instanceId}`);
                        if (attachmentsStr) {
                            let attachJSON = attachmentsStr;
                            if (!attachmentsStr.trim().startsWith('{')) {
                                try {
                                    attachJSON = await this.decompressText(attachmentsStr);
                                } catch (err) {
                                    console.error('Decompression error:', err);
                                }
                            }
                            this.attachments = JSON.parse(attachJSON);
                        }
                        
                        // Load journeys
                        if (this.data.journeys) {
                            for (const journeyId of Object.keys(this.data.journeys)) {
                                if (this.journeyEngine.loadedJourneys[journeyId]) {
                                    await this.journeyEngine.importJourney(this.journeyEngine.loadedJourneys[journeyId]);
                                }
                            }
                        }
                        
                        // Load custom journeys
                        if (this.data.customJourneys) {
                            for (const journey of Object.values(this.data.customJourneys)) {
                                await this.journeyEngine.importJourney(journey);
                            }
                        }
                    } catch (error) {
                        this.data = {};
                        this.attachments = {};
                        this.providers = {};
                        this.caseNotes = [];
                    }
                }
            }
            
