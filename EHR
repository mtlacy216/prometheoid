                    const errorMessage = error.stack && error.stack.includes('Maximum call stack') 
                        ? 'File is too large to process. Try a smaller file or compress it first.'
                        : (error.message || 'Unknown error');
                        
                    this.showError('Error uploading document: ' + errorMessage);
                    
