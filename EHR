            async downloadVault() {
                try {
                    // Check if we have a vault set up
                    if (!this.instanceId) {
                        this.showError('No vault found!\n\nYou must create a vault first:\n1. Click "Create New Health Vault"\n2. Set up password\n3. Then you can save your data');
                        this.closeModal('saveModal');
                        return;
                    }
                    
                    if (!this.masterPassword) {
                        this.showError('Please unlock the vault before saving.');
                        this.closeModal('saveModal');
                        return;
                    }

                    // First save current data to ensure everything is up to date
                    await this.saveData();
                    
                    // Wait a moment for localStorage to update
                    await new Promise(resolve => setTimeout(resolve, 100));
                    
                    // Get current HTML
                    let htmlContent = document.documentElement.outerHTML;
                    
                    // Get the data from localStorage
                    const profile = JSON.parse(localStorage.getItem(`vault_profile_${this.instanceId}`) || '{}');
                    const data = JSON.parse(localStorage.getItem(`vault_data_${this.instanceId}`) || '{}');
                    let attachments = {};
                    const attStr = localStorage.getItem(`vault_attachments_${this.instanceId}`);
                    if (attStr) {
                        let attJSON = attStr;
                        if (!attStr.trim().startsWith('{')) {
                            try {
                                attJSON = await this.decompressText(attStr);
                            } catch (err) {
                                console.error('Decompression error:', err);
                            }
                        }
                        attachments = JSON.parse(attJSON);
                    }
                    
                    console.log('Preparing to save:', {
                        hasProfile: !!profile,
                        hasData: !!data,
                        instanceId: this.instanceId,
                        vaultName: this.vaultName,
                        vaultGuid: this.vaultGuid
                    });
                    
                    if (!profile || !data) {
                        this.showError('No data to save! Make sure you have created a vault and entered some information.');
                        return;
                    }
                    
                    const payload = { data: data, attachments: attachments };
                    const compressedPayload = await this.compressText(JSON.stringify(payload));
                    const encData = await this.encryptText(compressedPayload);

                    const embeddedData = {
                        instanceId: this.instanceId,
                        vaultGuid: this.vaultGuid,
                        vaultName: this.vaultName,
                        profile: profile,
                        encrypted: true,
                        iv: encData.iv,
                        cipher: encData.cipher,
                        savedAt: new Date().toISOString()
                    };
                    
                    // Check total size
                    const jsonData = JSON.stringify(embeddedData, null, 2);
                    const estimatedSize = jsonData.length;
                    
                    if (estimatedSize > 50 * 1024 * 1024) {
                        const sizeMB = (estimatedSize / 1024 / 1024).toFixed(2);
                        if (!confirm(`Warning: The vault file will be approximately ${sizeMB} MB.\n\nLarge files may take time to download and could be difficult to open in some browsers.\n\nContinue?`)) {
                            this.closeModal('saveModal');
                            return;
                        }
                    }
                    
                    console.log('Embedded data preview:', {
                        instanceId: embeddedData.instanceId,
                        vaultGuid: embeddedData.vaultGuid,
                        vaultName: embeddedData.vaultName,
                        hasProfile: !!embeddedData.profile,
                        hasData: !!embeddedData.data,
                        savedAt: embeddedData.savedAt,
                        jsonLength: jsonData.length
                    });
                    
                    // Replace the empty embeddedVaultData script with the actual data
                    const scriptRegex = /<script id="embeddedVaultData" type="application\/json">[\s\S]*?<\/script>/;
                    const originalMatch = htmlContent.match(scriptRegex);
                    
                    if (!originalMatch) {
                        console.error('Could not find embeddedVaultData script tag!');
                        this.showError('Error: Could not find data placeholder in HTML');
                        return;
                    }
                    
                    htmlContent = htmlContent.replace(
                        scriptRegex,
                        `<script id="embeddedVaultData" type="application/json">\n${jsonData}\n<\/script>`
                    );
                    
                    // Verify the replacement worked
                    const newMatch = htmlContent.match(scriptRegex);
                    if (!newMatch || newMatch[0].length < 100) {
                        console.error('Data was not properly embedded!');
                        this.showError('Error: Failed to embed data in file');
                        return;
                    }
                    
                    // Update instance ID
                    htmlContent = htmlContent.replace(
                        /<div\s+id="instanceId"\s+style="display:\s*none;">.*?<\/div>/i,
                        `<div id="instanceId" style="display: none;">${this.instanceId}</div>`
                    );
                    
                    // Create and download the file with date and time
                    const blob = new Blob([htmlContent], { type: 'text/html' });
                    const url = URL.createObjectURL(blob);
                    const a = document.createElement('a');
                    
                    // Format: HealthVault_2025-07-28_14-30-45.html
                    const now = new Date();
                    const date = now.toISOString().split('T')[0];
                    const time = now.toTimeString().split(' ')[0].replace(/:/g, '-');
                    const filename = `HealthVault_${date}_${time}.html`;
                    
                    a.href = url;
                    a.download = filename;
                    a.click();
                    URL.revokeObjectURL(url);
                    
                    // Update UI
                    this.closeModal('saveModal');
                    this.showSuccess(`✅ Vault saved successfully!\n\n${this.vaultName}\nFile: ${filename}\n\nOpen this file next time to access your vault.`);
                    
                    // Mark as saved
                    this.hasUnsavedChanges = false;
                    
                    // Hide warning temporarily
                    document.getElementById('unsavedWarning').style.display = 'none';
                    setTimeout(() => {
                        document.getElementById('unsavedWarning').style.display = 'block';
                    }, 300000); // 5 minutes
                    
                } catch (error) {
                    console.error('Save error:', error);
                    this.showError('Error creating vault file: ' + error.message);
                }
            }
            
