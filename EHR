            async updatePassword() {
                const current = document.getElementById('currentPassword').value;
                const newPassword = document.getElementById('newPasswordChange').value;
                const confirm = document.getElementById('confirmNewPassword').value;
                
                if (!current || !newPassword || !confirm) {
                    this.showError('Please fill in all fields');
                    return;
                }
                
                // Verify current password
                const currentHash = await this.hashPassword(current);
                if (currentHash !== this.passwordHash) {
                    this.showError('Current password is incorrect');
                    return;
                }
                
                if (newPassword.length < 8) {
                    this.showError('New password must be at least 8 characters');
                    return;
                }
                
                if (newPassword !== confirm) {
                    this.showError('New passwords don\'t match');
                    return;
                }
                
                // Update password
                this.passwordHash = await this.hashPassword(newPassword);
                
                // Update profile
                const profile = JSON.parse(localStorage.getItem(`vault_profile_${this.instanceId}`));
                profile.passwordHash = this.passwordHash;
                localStorage.setItem(`vault_profile_${this.instanceId}`, JSON.stringify(profile));
                
