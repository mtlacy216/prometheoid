                            if (document.getElementById('noteVisitDate')) document.getElementById('noteVisitDate').value = note.visitDate || '';
                            if (document.getElementById('noteReason')) document.getElementById('noteReason').value = note.reason || '';
                            if (document.getElementById('noteDiscussion')) document.getElementById('noteDiscussion').value = note.discussion || '';
                            if (document.getElementById('noteFollowup')) document.getElementById('noteFollowup').value = note.followup || '';
                            break;
                            
