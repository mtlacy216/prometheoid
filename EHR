            switchTab(tabName) {
                // Hide all tab content
                document.querySelectorAll('.tab-content').forEach(content => {
                    content.classList.add('hidden');
                });
                
                // Show selected tab
                const tabContent = document.getElementById(tabName + '-tab');
                if (tabContent) {
                    tabContent.classList.remove('hidden');
                }
                
                // Update active tab button
                document.querySelectorAll('.tab').forEach(button => {
                    button.classList.remove('active');
                });
                
                // Find the clicked tab button
                const tabButton = Array.from(document.querySelectorAll('.tab')).find(btn => 
                    btn.onclick && btn.onclick.toString().includes(`'${tabName}'`)
                );
                if (tabButton) {
                    tabButton.classList.add('active');
                }
                
                // Update related notes sections when switching tabs
                if (tabName === 'medical') {
                    this.updateRelatedNotes('condition');
                } else if (tabName === 'medications') {
                    this.updateRelatedNotes('medication');
                } else if (tabName === 'gender-affirming-care') {
                    this.updateGacTimeline();
                }
            }
            
            regenerateVaultName() {
                const oldName = this.vaultName;
                const newName = this.generateVaultName();
                this.vaultName = newName;
                
                // Update all displays
                document.getElementById('headerVaultName').textContent = newName;
                document.getElementById('settingsVaultName').textContent = newName;
                document.title = `${newName} - Health Vault`;
                
                // Update profile with new name
                const profile = JSON.parse(localStorage.getItem(`vault_profile_${this.instanceId}`) || '{}');
                profile.vaultName = newName;
                localStorage.setItem(`vault_profile_${this.instanceId}`, JSON.stringify(profile));
                
                // Save the change
                this.autoSave();
                this.showSuccess(`Vault renamed from "${oldName}" to "${newName}"`);
            }
            
