            max-height: 600px;
            border-radius: 0.5rem;
            box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1);
        }

        /* GAC Specific Styles */
        .gac-header {
            background: linear-gradient(135deg, var(--gac-light) 0%, #faf5ff 100%);
            padding: 2rem;
            border-radius: 0.75rem;
            margin-bottom: 2rem;
        }

        .gac-header h3 {
            font-size: 1.5rem;
            color: var(--gac-primary);
            margin-bottom: 0.5rem;
        }

        .gac-timeline {
            position: relative;
            padding-left: 2rem;
            margin: 2rem 0;
        }

        .gac-timeline::before {
            content: '';
            position: absolute;
            left: 0.5rem;
            top: 0;
            bottom: 0;
            width: 2px;
            background: var(--gac-primary);
        }

        .gac-timeline-item {
            position: relative;
            margin-bottom: 2rem;
            padding: 1rem;
            background: var(--bg);
            border-radius: 0.5rem;
            border: 1px solid var(--border);
        }

        .gac-timeline-item::before {
            content: '';
            position: absolute;
            left: -1.75rem;
            top: 1rem;
            width: 1rem;
            height: 1rem;
            background: var(--gac-primary);
            border-radius: 50%;
            border: 3px solid white;
            box-shadow: 0 0 0 2px var(--gac-primary);
        }

        .gac-timeline-date {
            font-weight: 600;
            color: var(--gac-primary);
            margin-bottom: 0.5rem;
        }

        .gac-timeline-content {
            color: var(--text);
        }

        .pronoun-display {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.25rem 0.75rem;
            background: var(--gac-light);
            color: var(--gac-primary);
            border-radius: 1rem;
            font-weight: 600;
            font-size: 0.875rem;
        }

        @keyframes spin {
            to { transform: rotate(360deg); }
        }

        @keyframes pulse {
            0% { 
                opacity: 1; 
                box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1), 0 2px 4px -1px rgba(0,0,0,0.06);
            }
            50% { 
                opacity: 0.8; 
