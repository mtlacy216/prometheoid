                    <div class="legislation-content">
                        <div class="legislation-header">
                            <span class="legislation-id">RS2024-312</span>
                            <div class="legislation-engagement">
                                <span class="engagement-stat">👁 567 watching</span>
                                <span class="engagement-stat">💬 89 comments</span>
                            </div>
                        </div>
                        <h3 class="legislation-title">Climate Action & Green Infrastructure Initiative</h3>
                        <p class="legislation-description">Comprehensive plan to reduce emissions 40% by 2030 through renewable energy, building efficiency upgrades...</p>
                        <div class="legislation-tags">
