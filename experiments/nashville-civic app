                    </div>
                </div>

                <div class="hero-actions">
                    <button class="btn btn-primary">
                        <span>🚀</span> Start Tracking Bills
                    </button>
                    <button class="btn btn-secondary">
                        <span>🎥</span> Watch Today's Meeting
                    </button>
