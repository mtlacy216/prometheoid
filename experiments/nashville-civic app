                        <span class="activity-tag">Housing Justice</span>
                    </div>
                </div>

                <div class="activity-item">
                    <div class="activity-meta">
                        <div class="activity-user">
                            <div class="activity-avatar">M</div>
                            <span>Marcus T.</span>
                        </div>
                        <span class="activity-time">5 min ago</span>
                    </div>
                    <div class="activity-content">
                        Started following transit expansion proposal
                        <span class="activity-tag">Sustainable Transit</span>
                    </div>
                </div>

                <div class="activity-item">
                    <div class="activity-meta">
                        <div class="activity-user">
                            <div class="activity-avatar">C</div>
                            <span>Community Alert</span>
                        </div>
                        <span class="activity-time">12 min ago</span>
                    </div>
