<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Team Operations // Archive</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --paper-white: #FBFBFB;
            --ink-black: #161616;
            --audit-gray: #E5E7EB;
            --flag-red: #EF4444;
            --warning-yellow: #FBBF24;
            --glitch-blue: #2563EB;
            --success-mint: #10B981;
            
            --spacing-unit: 8px;
            --border-style: 2px dashed var(--audit-gray);
            --shadow-card: 0 4px 24px rgba(0, 0, 0, 0.06);
            --shadow-hover: 0 8px 32px rgba(0, 0, 0, 0.12);
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: var(--paper-white);
            color: var(--ink-black);
            line-height: 1.5;
            min-height: 100vh;
            position: relative;
            overflow-x: hidden;
        }

        /* Scanlines overlay */
        body::before {
            content: '';
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-image: repeating-linear-gradient(
                0deg,
                transparent,
                transparent 1px,
                rgba(0, 0, 0, 0.03) 1px,
                rgba(0, 0, 0, 0.03) 2px
            );
            pointer-events: none;
            z-index: 1;
        }

        .container {
            max-width: 1400px;
            margin: 0 auto;
            padding: calc(var(--spacing-unit) * 4);
            position: relative;
            z-index: 2;
        }

        header {
            border-bottom: var(--border-style);
            padding-bottom: calc(var(--spacing-unit) * 4);
            margin-bottom: calc(var(--spacing-unit) * 6);
            background: linear-gradient(135deg, var(--paper-white) 0%, #F3F0FF 100%);
            margin: calc(var(--spacing-unit) * -4) calc(var(--spacing-unit) * -4) calc(var(--spacing-unit) * 4);
            padding: calc(var(--spacing-unit) * 6) calc(var(--spacing-unit) * 4) calc(var(--spacing-unit) * 4);
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            flex-wrap: wrap;
            gap: calc(var(--spacing-unit) * 3);
        }

        body.theme-cyberpunk header {
            background: linear-gradient(135deg, #0A0A0A 0%, #1A0A1A 100%);
        }

        body.theme-terminal header {
            background: linear-gradient(135deg, #000000 0%, #001100 100%);
        }

        h1 {
            font-size: clamp(2.5rem, 6vw, 4rem);
            font-weight: 900;
            font-family: 'JetBrains Mono', monospace;
            letter-spacing: -0.5px;
            margin-bottom: calc(var(--spacing-unit) * 2);
            position: relative;
            display: inline-block;
        }

        h1 span {
            color: var(--glitch-blue);
            transition: all 0.3s ease;
        }

        h1:hover span {
            animation: glitch 0.3s infinite;
        }

        @keyframes glitch {
            0%, 100% {
                text-shadow: 2px 0 var(--flag-red), -2px 0 var(--glitch-blue);
            }
            25% {
                text-shadow: -2px 0 var(--flag-red), 2px 0 var(--glitch-blue);
            }
            50% {
                text-shadow: 2px 2px var(--flag-red), -2px -2px var(--glitch-blue);
            }
            75% {
                text-shadow: -2px -2px var(--flag-red), 2px 2px var(--glitch-blue);
            }
        }

        .tagline {
            font-family: 'JetBrains Mono', monospace;
            color: var(--ink-black);
            opacity: 0.8;
            font-size: 0.875rem;
            letter-spacing: 0.5px;
            margin-bottom: calc(var(--spacing-unit) * 2);
        }

        .controls {
            display: flex;
            gap: calc(var(--spacing-unit) * 2);
            align-items: center;
            flex-wrap: wrap;
            margin-top: calc(var(--spacing-unit) * 3);
        }

        button {
            background: var(--glitch-blue);
            color: white;
            border: none;
            padding: calc(var(--spacing-unit) * 1.5) calc(var(--spacing-unit) * 3);
            padding-left: calc(var(--spacing-unit) * 2);
            border-radius: calc(var(--spacing-unit) * 1);
            cursor: pointer;
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.875rem;
            font-weight: 500;
            letter-spacing: 0.5px;
            transition: all 0.2s ease;
            text-transform: uppercase;
            position: relative;
            overflow: hidden;
        }

        button::before {
            content: '>';
            position: absolute;
            left: calc(var(--spacing-unit) * 0.5);
            opacity: 0;
            transition: opacity 0.2s ease;
        }

        button:hover {
            background: var(--ink-black);
            transform: translateY(-1px);
            box-shadow: var(--shadow-hover);
            padding-left: calc(var(--spacing-unit) * 4);
        }

        button:hover::before {
            opacity: 1;
        }

        .section {
            background: white;
            border: var(--border-style);
            border-radius: calc(var(--spacing-unit) * 1);
            padding: calc(var(--spacing-unit) * 4);
            margin-bottom: calc(var(--spacing-unit) * 5);
            box-shadow: var(--shadow-card);
            position: relative;
            overflow: visible;
        }

        .section:first-of-type {
            margin-top: 0;
        }

        .section::before {
            position: absolute;
            top: calc(var(--spacing-unit) * 1);
            right: calc(var(--spacing-unit) * 2);
            background: var(--flag-red);
            color: white;
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.625rem;
            font-weight: 700;
            padding: calc(var(--spacing-unit) * 0.5) calc(var(--spacing-unit) * 2);
            letter-spacing: 1px;
            transform: rotate(1deg);
            z-index: 10;
        }

        #rolesSection::before {
            content: 'ROLES';
        }

        #standardsSection::before {
            content: 'STANDARDS';
        }

        #permissionsSection::before {
            content: 'PERMISSIONS';
        }

        body.theme-cyberpunk #rolesSection::before {
            content: 'AGENTS';
        }

        body.theme-cyberpunk #standardsSection::before {
            content: 'PROTOCOLS';
        }

        body.theme-cyberpunk #permissionsSection::before {
            content: 'ACCESS';
        }

        body.theme-terminal #rolesSection::before {
            content: 'USERS';
        }

        body.theme-terminal #standardsSection::before {
            content: 'RULES';
        }

        body.theme-terminal #permissionsSection::before {
            content: 'PERMS';
        }

        body.theme-cyberpunk .section::before {
            background: #FF00FF;
            color: #000000;
            text-shadow: 0 0 5px #FF00FF;
        }

        body.theme-terminal .section::before {
            background: #00FF00;
            color: #000000;
            font-weight: 900;
        }

        .section-title {
            font-size: 1.25rem;
            font-weight: 700;
            margin-bottom: calc(var(--spacing-unit) * 3);
            font-family: 'JetBrains Mono', monospace;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: relative;
        }

        .section-title span {
            position: relative;
            z-index: 1;
        }

        .section-title::after {
            content: '';
            position: absolute;
            bottom: -8px;
            left: 0;
            width: 100%;
            height: 1px;
            background: repeating-linear-gradient(
                90deg,
                var(--audit-gray),
                var(--audit-gray) 8px,
                transparent 8px,
                transparent 16px
            );
        }

        .roles-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: calc(var(--spacing-unit) * 3);
            margin-top: calc(var(--spacing-unit) * 2);
        }

        .role-card {
            background: var(--paper-white);
            border: 1px solid var(--audit-gray);
            border-radius: calc(var(--spacing-unit) * 1);
            padding: calc(var(--spacing-unit) * 3);
            transition: all 0.2s ease;
            cursor: pointer;
            position: relative;
            overflow: hidden;
        }

        .role-card::before {
            content: 'ACTIVE';
            position: absolute;
            top: calc(var(--spacing-unit) * 1);
            right: calc(var(--spacing-unit) * 1);
            background: var(--success-mint);
            color: white;
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.625rem;
            font-weight: 700;
            padding: calc(var(--spacing-unit) * 0.5) calc(var(--spacing-unit) * 1);
            letter-spacing: 0.5px;
            opacity: 0;
            transition: opacity 0.2s ease;
            transform: rotate(-1deg);
        }

        .role-card:hover {
            transform: scale(1.02);
            box-shadow: var(--shadow-hover);
            border-color: var(--glitch-blue);
        }

        .role-card:hover::before {
            opacity: 1;
        }

        .role-title {
            font-size: 1.25rem;
            font-weight: 700;
            margin-bottom: calc(var(--spacing-unit) * 2);
            color: var(--ink-black);
            font-family: 'JetBrains Mono', monospace;
        }

        .role-section {
            margin-bottom: calc(var(--spacing-unit) * 2);
        }

        .role-section h4 {
            color: var(--ink-black);
            font-size: 0.75rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: calc(var(--spacing-unit) * 1);
            font-family: 'JetBrains Mono', monospace;
        }

        .role-section ul {
            list-style: none;
            font-size: 0.875rem;
        }

        .role-section li {
            padding: calc(var(--spacing-unit) * 0.5) 0;
            padding-left: calc(var(--spacing-unit) * 2);
            position: relative;
            font-family: 'Inter', sans-serif;
        }

        .role-section li:before {
            content: '+';
            position: absolute;
            left: 0;
            color: var(--glitch-blue);
            font-family: 'JetBrains Mono', monospace;
            font-weight: 700;
        }

        .standards-list {
            display: grid;
            gap: calc(var(--spacing-unit) * 1);
        }

        .standard-item {
            background: var(--paper-white);
            padding: calc(var(--spacing-unit) * 2);
            border: 1px solid var(--audit-gray);
            border-radius: calc(var(--spacing-unit) * 0.5);
            display: flex;
            justify-content: space-between;
            align-items: center;
            transition: all 0.2s ease;
            font-family: 'Inter', sans-serif;
            font-size: 0.875rem;
        }

        .standard-item:hover {
            background: #F9F9F9;
            border-color: var(--glitch-blue);
            padding-left: calc(var(--spacing-unit) * 3);
        }

        .permissions-table {
            overflow-x: auto;
            border: 1px solid var(--audit-gray);
            border-radius: calc(var(--spacing-unit) * 1);
            background: white;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.875rem;
        }

        th, td {
            padding: calc(var(--spacing-unit) * 2);
            text-align: left;
            border-bottom: 1px solid var(--audit-gray);
        }

        th {
            background: var(--paper-white);
            font-weight: 700;
            color: var(--ink-black);
            font-family: 'JetBrains Mono', monospace;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            font-size: 0.75rem;
            position: sticky;
            top: 0;
        }

        tr:hover {
            background: #F9F9F9;
        }

        .modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(22, 22, 22, 0.9);
            z-index: 1000;
            backdrop-filter: blur(4px);
        }

        .modal-content {
            background: white;
            max-width: 600px;
            margin: 5% auto;
            padding: calc(var(--spacing-unit) * 4);
            border-radius: calc(var(--spacing-unit) * 1);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
            max-height: 90vh;
            overflow-y: auto;
            border: 2px solid var(--audit-gray);
            position: relative;
        }

        .modal-content::before {
            content: 'FORM // ACTIVE';
            position: absolute;
            top: calc(var(--spacing-unit) * -1);
            left: calc(var(--spacing-unit) * 2);
            background: var(--warning-yellow);
            color: var(--ink-black);
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.625rem;
            font-weight: 700;
            padding: calc(var(--spacing-unit) * 0.5) calc(var(--spacing-unit) * 2);
            letter-spacing: 1px;
        }

        .modal-close {
            position: absolute;
            top: calc(var(--spacing-unit) * 2);
            right: calc(var(--spacing-unit) * 2);
            background: none;
            border: none;
            font-size: 1.5rem;
            cursor: pointer;
            color: var(--ink-black);
            padding: 0;
            width: 32px;
            height: 32px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            transition: all 0.2s ease;
        }

        .modal-close:hover {
            background: var(--flag-red);
            color: white;
            transform: rotate(90deg);
        }

        .modal-content h2 {
            font-family: 'JetBrains Mono', monospace;
            font-size: 1.5rem;
            margin-bottom: calc(var(--spacing-unit) * 3);
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .form-group {
            margin-bottom: calc(var(--spacing-unit) * 3);
        }

        label {
            display: block;
            margin-bottom: calc(var(--spacing-unit) * 1);
            color: var(--ink-black);
            font-weight: 600;
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        input, select, textarea {
            width: 100%;
            padding: calc(var(--spacing-unit) * 1.5);
            background: var(--paper-white);
            border: 1px solid var(--audit-gray);
            border-radius: calc(var(--spacing-unit) * 0.5);
            color: var(--ink-black);
            font-family: 'Inter', sans-serif;
            font-size: 0.875rem;
            transition: all 0.2s ease;
        }

        input:focus, select:focus, textarea:focus {
            outline: none;
            border-color: var(--glitch-blue);
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
            background: white;
        }

        textarea {
            resize: vertical;
            min-height: 100px;
            font-family: 'JetBrains Mono', monospace;
        }

        .button-group {
            display: flex;
            gap: calc(var(--spacing-unit) * 2);
            justify-content: flex-end;
            margin-top: calc(var(--spacing-unit) * 4);
            padding-top: calc(var(--spacing-unit) * 3);
            border-top: 1px dashed var(--audit-gray);
        }

        .btn-secondary {
            background: white;
            color: var(--ink-black);
            border: 1px solid var(--audit-gray);
        }

        .btn-secondary:hover {
            background: var(--paper-white);
            border-color: var(--ink-black);
        }

        .btn-danger {
            background: var(--flag-red);
        }

        .btn-danger:hover {
            background: #DC2626;
        }

        .delete-btn {
            background: none;
            color: var(--flag-red);
            padding: calc(var(--spacing-unit) * 1);
            font-size: 0.75rem;
            border: 1px solid transparent;
            text-transform: uppercase;
        }

        .delete-btn:hover {
            background: var(--flag-red);
            color: white;
            border-color: var(--flag-red);
        }

        .filter-select {
            background: white;
            padding: calc(var(--spacing-unit) * 1.5) calc(var(--spacing-unit) * 2);
            border: 1px solid var(--audit-gray);
            border-radius: calc(var(--spacing-unit) * 0.5);
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.875rem;
            text-transform: uppercase;
        }

        .empty-state {
            text-align: center;
            padding: calc(var(--spacing-unit) * 6);
            color: var(--ink-black);
            opacity: 0.6;
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.875rem;
        }

        body.theme-cyberpunk .empty-state {
            color: #FF00FF;
        }

        body.theme-terminal .empty-state {
            color: #00FF00;
        }

        .settings-icon {
            position: fixed;
            bottom: calc(var(--spacing-unit) * 3);
            right: calc(var(--spacing-unit) * 3);
            width: calc(var(--spacing-unit) * 6);
            height: calc(var(--spacing-unit) * 6);
            background: var(--ink-black);
            color: white;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            box-shadow: var(--shadow-hover);
            transition: all 0.3s ease;
            font-size: 1.25rem;
        }

        .settings-icon:hover {
            transform: scale(1.1) rotate(90deg);
            background: var(--glitch-blue);
        }

        /* Theme Switcher Styles */
        .theme-switcher {
            position: fixed;
            top: calc(var(--spacing-unit) * 3);
            right: calc(var(--spacing-unit) * 3);
            z-index: 1000;
        }

        .theme-btn {
            background: var(--ink-black);
            color: white;
            border: none;
            padding: calc(var(--spacing-unit) * 1.5);
            border-radius: calc(var(--spacing-unit) * 1);
            cursor: pointer;
            font-size: 1.25rem;
            width: calc(var(--spacing-unit) * 6);
            height: calc(var(--spacing-unit) * 6);
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: var(--shadow-hover);
            transition: all 0.3s ease;
        }

        .theme-btn:hover {
            transform: scale(1.1);
            background: var(--glitch-blue);
        }

        .theme-menu {
            position: absolute;
            top: calc(100% + var(--spacing-unit));
            right: 0;
            background: white;
            border: 2px solid var(--audit-gray);
            border-radius: calc(var(--spacing-unit) * 1);
            box-shadow: var(--shadow-hover);
            padding: calc(var(--spacing-unit) * 1);
            display: none;
            min-width: 200px;
        }

        .theme-menu.active {
            display: block;
        }

        .theme-option {
            padding: calc(var(--spacing-unit) * 1.5) calc(var(--spacing-unit) * 2);
            cursor: pointer;
            transition: all 0.2s ease;
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.875rem;
            display: flex;
            align-items: center;
            gap: calc(var(--spacing-unit) * 1);
            border-radius: calc(var(--spacing-unit) * 0.5);
        }

        .theme-option:hover {
            background: var(--paper-white);
            padding-left: calc(var(--spacing-unit) * 3);
        }

        .theme-option.active {
            background: var(--glitch-blue);
            color: white;
        }

        .theme-option .icon {
            font-size: 1.25rem;
        }

        /* Status Tags */
        .status-tag {
            display: inline-block;
            padding: calc(var(--spacing-unit) * 0.5) calc(var(--spacing-unit) * 1.5);
            border-radius: calc(var(--spacing-unit) * 0.5);
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.625rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-left: calc(var(--spacing-unit) * 1);
        }

        .status-todo {
            background: var(--audit-gray);
            color: var(--ink-black);
        }

        .status-doing {
            background: var(--warning-yellow);
            color: var(--ink-black);
        }

        .status-done {
            background: var(--success-mint);
            color: white;
        }

        body.theme-cyberpunk .status-todo {
            background: #4A4A4A;
            color: #FFFFFF;
        }

        body.theme-cyberpunk .status-doing {
            background: #00FFFF;
            color: #000000;
        }

        body.theme-cyberpunk .status-done {
            background: #00FF88;
            color: #000000;
        }

        body.theme-terminal .status-todo {
            background: #333333;
            color: #00FF00;
        }

        body.theme-terminal .status-doing {
            background: #FFFF00;
            color: #000000;
        }

        body.theme-terminal .status-done {
            background: #00FF00;
            color: #000000;
        }

        .terminology-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
            gap: calc(var(--spacing-unit) * 2);
        }

        footer {
            background: var(--ink-black);
            color: white;
            padding: calc(var(--spacing-unit) * 6) calc(var(--spacing-unit) * 4);
            margin-top: calc(var(--spacing-unit) * 8);
            text-align: center;
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.75rem;
            letter-spacing: 0.5px;
            position: relative;
            z-index: 2;
        }

        .theme-indicator {
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.75rem;
            opacity: 0.8;
            margin-top: calc(var(--spacing-unit) * 1);
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        body.theme-cyberpunk .theme-indicator {
            color: #00FFFF;
            text-shadow: 0 0 5px #00FFFF;
        }

        body.theme-terminal .theme-indicator {
            color: #00FF00;
            text-shadow: 0 0 3px #00FF00;
        }

        @media (max-width: 768px) {
            h1 {
                font-size: 2rem;
            }

            .container {
                padding: calc(var(--spacing-unit) * 2);
            }

            header {
                padding: calc(var(--spacing-unit) * 4) calc(var(--spacing-unit) * 2);
                margin: calc(var(--spacing-unit) * -2) calc(var(--spacing-unit) * -2) calc(var(--spacing-unit) * 3);
            }

            .modal-content {
                margin: 2% calc(var(--spacing-unit) * 2);
            }

            .roles-grid {
                grid-template-columns: 1fr;
            }

            .controls {
                flex-direction: column;
                width: 100%;
            }

            .filter-select, button {
                width: 100%;
            }

            .theme-switcher {
                top: calc(var(--spacing-unit) * 2);
                right: calc(var(--spacing-unit) * 2);
            }
        }

        /* Stamp effect for badges */
        .stamp {
            display: inline-block;
            transform: rotate(-1deg);
            font-family: 'JetBrains Mono', monospace;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1px;
            font-size: 0.625rem;
            padding: calc(var(--spacing-unit) * 0.5) calc(var(--spacing-unit) * 1);
            position: relative;
        }

        .stamp-red {
            background: var(--flag-red);
            color: white;
        }

        .stamp-yellow {
            background: var(--warning-yellow);
            color: var(--ink-black);
        }

        .stamp-mint {
            background: var(--success-mint);
            color: white;
        }

        /* For cyberpunk theme */
        body.theme-cyberpunk .stamp-yellow {
            background: #00FFFF;
            color: #000000;
        }

        body.theme-cyberpunk .stamp-mint {
            background: #00FF88;
            color: #000000;
        }

        body.theme-cyberpunk .stamp-red {
            background: #FF0080;
            color: #FFFFFF;
        }

        /* For terminal theme */
        body.theme-terminal .stamp {
            color: #000000 !important;
        }

        /* Diff-style additions/deletions */
        .diff-add {
            background: rgba(16, 185, 129, 0.1);
            color: var(--success-mint);
            padding: 2px 4px;
            border-radius: 2px;
            font-family: 'JetBrains Mono', monospace;
        }

        .diff-remove {
            background: rgba(239, 68, 68, 0.1);
            color: var(--flag-red);
            padding: 2px 4px;
            border-radius: 2px;
            font-family: 'JetBrains Mono', monospace;
            text-decoration: line-through;
        }

        body.theme-cyberpunk .diff-add {
            background: rgba(0, 255, 136, 0.2);
        }

        body.theme-cyberpunk .diff-remove {
            background: rgba(255, 0, 128, 0.2);
        }

        body.theme-terminal .diff-add {
            background: rgba(0, 255, 0, 0.2);
        }

        body.theme-terminal .diff-remove {
            background: rgba(255, 0, 0, 0.2);
        }

        /* Cyberpunk theme specific styles */
        body.theme-cyberpunk {
            background: #0A0A0A;
            color: #F0F0F0;
        }

        body.theme-cyberpunk h1 span {
            text-shadow: 0 0 10px #FF00FF, 0 0 20px #FF00FF, 0 0 30px #FF00FF;
        }

        body.theme-cyberpunk button {
            box-shadow: 0 0 10px var(--glitch-blue);
        }

        body.theme-cyberpunk .section {
            border: 2px solid var(--audit-gray);
            box-shadow: 0 0 20px rgba(255, 0, 255, 0.3);
        }

        body.theme-cyberpunk .role-card {
            background: #1A1A1A;
            border-color: #FF00FF;
        }

        body.theme-cyberpunk .role-card:hover {
            box-shadow: 0 0 30px rgba(0, 255, 255, 0.5);
            border-color: #00FFFF;
        }

        body.theme-terminal .role-card {
            background: #001100;
            border-color: #00FF00;
        }

        body.theme-terminal .modal {
            background: rgba(0, 0, 0, 0.95);
        }

        body.theme-cyberpunk .modal {
            background: rgba(10, 10, 10, 0.95);
        }

        body.theme-terminal .modal-content {
            background: #000000;
            border: 2px solid #00FF00;
            box-shadow: 0 0 40px rgba(0, 255, 0, 0.5);
        }

        body.theme-terminal .standard-item {
            background: #000000;
        }

        body.theme-cyberpunk::before {
            background-image: repeating-linear-gradient(
                0deg,
                transparent,
                transparent 1px,
                rgba(255, 0, 255, 0.1) 1px,
                rgba(255, 0, 255, 0.1) 2px
            );
        }

        /* Terminal theme specific styles */
        body.theme-terminal {
            background: #000000;
            color: #00FF00;
            font-family: 'JetBrains Mono', monospace;
        }

        body.theme-terminal * {
            font-family: 'JetBrains Mono', monospace !important;
        }

        body.theme-terminal::before {
            background-image: repeating-linear-gradient(
                0deg,
                transparent,
                transparent 1px,
                rgba(0, 255, 0, 0.05) 1px,
                rgba(0, 255, 0, 0.05) 2px
            );
        }

        body.theme-terminal .section {
            background: #001100;
            border: 2px solid #00FF00;
            box-shadow: 0 0 10px rgba(0, 255, 0, 0.3);
        }

        body.theme-terminal input,
        body.theme-terminal select,
        body.theme-terminal textarea {
            background: #000000;
            border-color: #00FF00;
            color: #00FF00;
        }

        body.theme-terminal button {
            text-shadow: 0 0 5px #00FF00;
            background: #00FF00;
            color: #000000;
        }

        body.theme-terminal button:hover {
            background: #00AA00;
            box-shadow: 0 0 20px #00FF00;
        }

        body.theme-terminal .btn-secondary {
            background: #001100;
            color: #00FF00;
            border: 1px solid #00FF00;
        }

        body.theme-terminal .btn-secondary:hover {
            background: #002200;
        }

        body.theme-cyberpunk .modal-content {
            background: #1A1A1A;
            border: 2px solid #FF00FF;
            box-shadow: 0 0 40px rgba(255, 0, 255, 0.5);
        }

        body.theme-cyberpunk .form-group input,
        body.theme-cyberpunk .form-group select,
        body.theme-cyberpunk .form-group textarea {
            background: #0A0A0A;
            border-color: #FF00FF;
            color: #F0F0F0;
        }

        body.theme-cyberpunk .standard-item {
            background: #0A0A0A;
            border-color: #FF00FF;
        }

        body.theme-cyberpunk .delete-btn {
            color: #FF0080;
        }

        body.theme-cyberpunk .delete-btn:hover {
            background: #FF0080;
            color: #0A0A0A;
            border-color: #FF0080;
        }

        body.theme-terminal .delete-btn {
            color: #FF0000;
            border-color: transparent;
        }

        body.theme-terminal .delete-btn:hover {
            background: #FF0000;
            color: #000000;
        }

        body.theme-cyberpunk .settings-icon {
            background: #FF00FF;
            color: #0A0A0A;
        }

        body.theme-terminal .settings-icon {
            background: #00FF00;
            color: #000000;
        }

        body.theme-cyberpunk footer {
            background: #FF00FF;
            color: #0A0A0A;
            text-shadow: none;
        }

        body.theme-terminal footer {
            background: #00FF00;
            color: #000000;
            text-shadow: none;
        }

        body.theme-cyberpunk .permissions-table {
            background: #1A1A1A;
            border-color: #FF00FF;
        }

        body.theme-cyberpunk th {
            background: #0A0A0A;
            color: #00FFFF;
        }

        body.theme-cyberpunk tr:hover {
            background: #2A2A2A;
        }

        body.theme-terminal .permissions-table {
            background: #001100;
            border-color: #00FF00;
        }

        body.theme-terminal th {
            background: #000000;
            color: #00FF00;
        }

        body.theme-terminal tr:hover {
            background: #002200;
        }

        body.theme-terminal h1::after {
            content: '_';
            animation: blink 1s infinite;
        }

        /* Theme transition animation */
        body {
            transition: background 0.3s ease, color 0.3s ease;
        }

        * {
            transition: background 0.3s ease, color 0.3s ease, border-color 0.3s ease;
        }

        /* Bureau theme specific animations */
        body.theme-bureau .role-card::after {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: linear-gradient(135deg, transparent 0%, rgba(37, 99, 235, 0.05) 100%);
            opacity: 0;
            transition: opacity 0.3s ease;
            pointer-events: none;
        }

        body.theme-bureau .role-card:hover::after {
            opacity: 1;
        }

        /* Cyberpunk theme animations */
        @keyframes neonPulse {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.8; }
        }

        body.theme-cyberpunk h1 {
            animation: neonPulse 2s infinite;
        }

        body.theme-cyberpunk .section {
            position: relative;
        }

        body.theme-cyberpunk .section::after {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: linear-gradient(45deg, transparent 30%, rgba(255, 0, 255, 0.1) 50%, transparent 70%);
            animation: scanline 8s linear infinite;
            pointer-events: none;
        }

        @keyframes scanline {
            0% { transform: translateX(-100%); }
            100% { transform: translateX(100%); }
        }

        /* Terminal theme animations */
        @keyframes terminalFlicker {
            0%, 100% { opacity: 1; }
            92% { opacity: 1; }
            93% { opacity: 0.8; }
            94% { opacity: 1; }
        }

        body.theme-terminal {
            animation: terminalFlicker 10s infinite;
        }

        body.theme-terminal input:focus,
        body.theme-terminal select:focus,
        body.theme-terminal textarea:focus {
            box-shadow: 0 0 0 1px #00FF00, 0 0 10px rgba(0, 255, 0, 0.5);
        }

        body.theme-terminal .role-card::before {
            content: '>';
            position: absolute;
            left: calc(var(--spacing-unit) * 1);
            top: calc(var(--spacing-unit) * 1);
            color: #00FF00;
            font-family: 'JetBrains Mono', monospace;
            font-weight: 700;
            animation: blink 1s infinite;
        }

        @keyframes blink {
            0%, 50% { opacity: 1; }
            51%, 100% { opacity: 0; }
        }
    </style>
</head>
<body>
    <!-- Theme Switcher -->
    <div class="theme-switcher">
        <button class="theme-btn" onclick="app.toggleThemeMenu()">🎨</button>
        <div class="theme-menu" id="themeMenu">
            <div class="theme-option active" data-theme="bureau" onclick="app.setTheme('bureau')">
                <span class="icon">📋</span>
                <span>Bureau</span>
            </div>
            <div class="theme-option" data-theme="terminal" onclick="app.setTheme('terminal')">
                <span class="icon">💻</span>
                <span>Terminal</span>
            </div>
            <div class="theme-option" data-theme="cyberpunk" onclick="app.setTheme('cyberpunk')">
                <span class="icon">🌆</span>
                <span>Cyberpunk</span>
            </div>
        </div>
    </div>

    <div class="container">
        <header>
            <div>
                <h1 id="appTitle">Team Operations <span>// Archive</span></h1>
                <p class="tagline">Institutional change log — tracking permissions since 1999</p>
                <div class="theme-indicator" id="themeIndicator">THEME: BUREAU</div>
            </div>
            <div class="controls">
                <select class="filter-select" id="viewSelector" onchange="app.changeView(this.value)">
                    <option value="overview">VIEW: OVERVIEW</option>
                </select>
                <button onclick="app.showAddRoleModal()">+ NEW ROLE</button>
            </div>
        </header>

        <div class="section" id="rolesSection">
            <div class="section-title">
                <span id="rolesSectionTitle">Active Roles</span>
                <button onclick="app.exportData()">EXPORT LOG</button>
            </div>
            <div class="roles-grid" id="rolesGrid"></div>
        </div>

        <div class="section" id="standardsSection">
            <div class="section-title">
                <span id="standardsSectionTitle">Universal Standards</span>
                <button onclick="app.showAddStandardModal()">+ NEW STANDARD</button>
            </div>
            <div class="standards-list" id="standardsList"></div>
        </div>

        <div class="section" id="permissionsSection">
            <div class="section-title">
                <span id="permissionsSectionTitle">Permissions Matrix</span>
                <button onclick="app.showAddPermissionModal()">+ GRANT PERMISSION</button>
            </div>
            <div class="permissions-table">
                <table id="permissionsTable">
                    <thead>
                        <tr>
                            <th id="roleColumnHeader">Role</th>
                            <th id="actionColumnHeader">Action</th>
                            <th id="taskColumnHeader">Task</th>
                            <th id="counterpartColumnHeader">Target</th>
                            <th>Status</th>
                            <th>Modified</th>
                            <th>Ops</th>
                        </tr>
                    </thead>
                    <tbody id="permissionsBody"></tbody>
                </table>
            </div>
        </div>
    </div>

    <footer>
        <p>ARCHIVE STATUS: ACTIVE | LAST SYNC: <span id="lastSync"></span> | v2.0.25</p>
    </footer>

    <div class="settings-icon" onclick="app.showSettingsModal()">⚙</div>

    <!-- Modals -->
    <div class="modal" id="modal">
        <div class="modal-content" id="modalContent"></div>
    </div>

    <script>
        const app = {
            data: {
                terminology: {
                    appTitle: "Team Operations // Archive",
                    rolesSection: "Active Roles",
                    standardsSection: "Universal Standards",
                    permissionsSection: "Permissions Matrix",
                    responsibilities: "Responsibilities",
                    ownership: "Domain Control",
                    roleColumn: "Role",
                    actionColumn: "Action",
                    taskColumn: "Task",
                    counterpartColumn: "Target",
                    actionTypes: {
                        approves: "APPROVES",
                        executes: "EXECUTES",
                        communicates: "NOTIFIES"
                    }
                },
                roles: [],
                standards: [],
                permissions: [],
                currentView: "overview",
                currentRole: null,
                currentTheme: 'bureau'
            },

            themes: {
                bureau: {
                    name: 'Bureau',
                    terminology: {
                        appTitle: "Team Operations // Archive",
                        rolesSection: "Active Roles",
                        standardsSection: "Universal Standards",
                        permissionsSection: "Permissions Matrix"
                    }
                },
                terminal: {
                    name: 'Terminal',
                    terminology: {
                        appTitle: "System Users // Log",
                        rolesSection: "Users",
                        standardsSection: "Rules",
                        permissionsSection: "Access Control"
                    }
                },
                cyberpunk: {
                    name: 'Cyberpunk',
                    terminology: {
                        appTitle: "Agent Network // Database",
                        rolesSection: "Agents",
                        standardsSection: "Protocols",
                        permissionsSection: "Access Matrix"
                    }
                }
            },

            init() {
                this.loadSampleData();
                this.loadTheme();
                this.render();
                this.updateLastSync();
            },

            loadTheme() {
                const savedTheme = localStorage.getItem('appTheme') || 'bureau';
                this.setTheme(savedTheme, false);
            },

            setTheme(themeName, save = true) {
                document.body.className = themeName === 'bureau' ? '' : `theme-${themeName}`;
                this.data.currentTheme = themeName;
                
                // Update theme indicator
                document.getElementById('themeIndicator').textContent = `THEME: ${themeName.toUpperCase()}`;
                
                // Update active state in menu
                document.querySelectorAll('.theme-option').forEach(option => {
                    option.classList.toggle('active', option.dataset.theme === themeName);
                });
                
                // Apply theme terminology
                const theme = this.themes[themeName];
                if (theme && theme.terminology) {
                    Object.assign(this.data.terminology, theme.terminology);
                    this.updateTerminologyDisplay();
                }
                
                if (save) {
                    localStorage.setItem('appTheme', themeName);
                    this.closeThemeMenu();
                }
            },

            toggleThemeMenu() {
                const menu = document.getElementById('themeMenu');
                menu.classList.toggle('active');
            },

            closeThemeMenu() {
                document.getElementById('themeMenu').classList.remove('active');
            },

            updateLastSync() {
                const now = new Date();
                const formatted = now.toISOString().replace('T', ' ').substring(0, 19) + ' UTC';
                document.getElementById('lastSync').textContent = formatted;
            },

            loadSampleData() {
                this.data.roles = [
                    {
                        id: 1,
                        name: "SYS_ADMIN",
                        responsibilities: ["System oversight", "Permission grants", "Audit compliance"],
                        ownership: ["Access control", "Security protocols", "Change management"]
                    },
                    {
                        id: 2,
                        name: "OPERATOR",
                        responsibilities: ["Execute procedures", "Monitor systems", "Report anomalies"],
                        ownership: ["Daily operations", "Incident response"]
                    }
                ];

                this.data.standards = [
                    "All changes must be logged",
                    "No unauthorized modifications",
                    "Maintain audit trail integrity",
                    "Follow chain of command"
                ];

                this.data.permissions = [
                    {
                        id: 1,
                        roleId: 1,
                        action: "approves",
                        task: "System modifications",
                        counterpart: "OPERATOR",
                        status: "done",
                        updated: new Date().toISOString().substring(0, 10)
                    }
                ];
            },

            render() {
                this.updateTerminologyDisplay();
                this.renderRoles();
                this.renderStandards();
                this.renderPermissions();
                this.updateViewSelector();
            },

            updateTerminologyDisplay() {
                document.getElementById('appTitle').innerHTML = this.data.terminology.appTitle.replace('//', '<span>//</span>');
                document.getElementById('rolesSectionTitle').textContent = this.data.terminology.rolesSection;
                document.getElementById('standardsSectionTitle').textContent = this.data.terminology.standardsSection;
                document.getElementById('permissionsSectionTitle').textContent = this.data.terminology.permissionsSection;
                document.getElementById('roleColumnHeader').textContent = this.data.terminology.roleColumn;
                document.getElementById('actionColumnHeader').textContent = this.data.terminology.actionColumn;
                document.getElementById('taskColumnHeader').textContent = this.data.terminology.taskColumn;
                document.getElementById('counterpartColumnHeader').textContent = this.data.terminology.counterpartColumn;
                document.title = this.data.terminology.appTitle.replace(' //', ' |');
            },

            renderRoles() {
                const grid = document.getElementById('rolesGrid');
                if (this.data.roles.length === 0) {
                    grid.innerHTML = '<div class="empty-state">NO ROLES DEFINED // SYSTEM UNINITIALIZED</div>';
                    return;
                }

                grid.innerHTML = this.data.roles.map(role => `
                    <div class="role-card" onclick="app.showRoleDetail(${role.id})">
                        <h3 class="role-title">${role.name}</h3>
                        <div class="role-section">
                            <h4>${this.data.terminology.responsibilities}:</h4>
                            <ul>
                                ${role.responsibilities.map(r => `<li>${r}</li>`).join('')}
                            </ul>
                        </div>
                        <div class="role-section">
                            <h4>${this.data.terminology.ownership}:</h4>
                            <ul>
                                ${role.ownership.map(o => `<li>${o}</li>`).join('')}
                            </ul>
                        </div>
                        <button class="delete-btn" onclick="event.stopPropagation(); app.deleteRole(${role.id})">REVOKE</button>
                    </div>
                `).join('');
            },

            renderStandards() {
                const list = document.getElementById('standardsList');
                if (this.data.standards.length === 0) {
                    list.innerHTML = '<div class="empty-state">NO STANDARDS DEFINED // CHAOS MODE</div>';
                    return;
                }

                list.innerHTML = this.data.standards.map((standard, index) => `
                    <div class="standard-item">
                        <span>§ ${index + 1}. ${standard}</span>
                        <button class="delete-btn" onclick="app.deleteStandard(${index})">STRIKE</button>
                    </div>
                `).join('');
            },

            renderPermissions() {
                const tbody = document.getElementById('permissionsBody');
                const permissions = this.data.permissions;

                if (permissions.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="7" class="empty-state">NO PERMISSIONS GRANTED // ACCESS DENIED</td></tr>';
                    return;
                }

                tbody.innerHTML = permissions.map(perm => {
                    const role = this.data.roles.find(r => r.id === perm.roleId);
                    const statusClass = `status-${perm.status || 'todo'}`;
                    const statusText = (perm.status || 'todo').toUpperCase();
                    
                    return `
                        <tr>
                            <td><span class="stamp stamp-mint">${role ? role.name : 'UNKNOWN'}</span></td>
                            <td>${this.data.terminology.actionTypes[perm.action]}</td>
                            <td>${perm.task}</td>
                            <td>${perm.counterpart}</td>
                            <td><span class="status-tag ${statusClass}">${statusText}</span></td>
                            <td>${perm.updated}</td>
                            <td><button class="delete-btn" onclick="app.deletePermission(${perm.id})">REVOKE</button></td>
                        </tr>
                    `;
                }).join('');
            },

            updateViewSelector() {
                const selector = document.getElementById('viewSelector');
                selector.innerHTML = '<option value="overview">VIEW: OVERVIEW</option>' +
                    this.data.roles.map(role => `<option value="role-${role.id}">VIEW: ${role.name}</option>`).join('');
            },

            showRoleDetail(roleId) {
                const role = this.data.roles.find(r => r.id === roleId);
                if (!role) return;

                this.showModal(`
                    <h2>ROLE DETAIL // ${role.name}</h2>
                    <div class="role-detail">
                        <div class="form-group">
                            <label>${this.data.terminology.responsibilities}</label>
                            <div style="background: var(--paper-white); padding: var(--spacing-unit); border-radius: 4px;">
                                ${role.responsibilities.map(r => `<div class="diff-add">+ ${r}</div>`).join('')}
                            </div>
                        </div>
                        <div class="form-group">
                            <label>${this.data.terminology.ownership}</label>
                            <div style="background: var(--paper-white); padding: var(--spacing-unit); border-radius: 4px;">
                                ${role.ownership.map(o => `<div class="diff-add">+ ${o}</div>`).join('')}
                            </div>
                        </div>
                        <div class="form-group">
                            <label>PERMISSIONS GRANTED</label>
                            <div style="background: var(--paper-white); padding: var(--spacing-unit); border-radius: 4px;">
                                ${this.data.permissions.filter(p => p.roleId === roleId).map(p => 
                                    `<div style="margin-bottom: 8px;">
                                        <span class="stamp stamp-yellow">${this.data.terminology.actionTypes[p.action]}</span>
                                        ${p.task} → ${p.counterpart}
                                        <span class="status-tag status-${p.status || 'todo'}">${(p.status || 'todo').toUpperCase()}</span>
                                    </div>`
                                ).join('') || '<span style="opacity: 0.6;">No permissions granted</span>'}
                            </div>
                        </div>
                    </div>
                    <div class="button-group">
                        <button type="button" onclick="app.closeModal()">CLOSE</button>
                    </div>
                `);
            },

            showModal(content) {
                document.getElementById('modalContent').innerHTML = `
                    <button class="modal-close" onclick="app.closeModal()">×</button>
                    ${content}
                `;
                document.getElementById('modal').style.display = 'block';
            },

            closeModal() {
                document.getElementById('modal').style.display = 'none';
            },

            showAddRoleModal() {
                this.showModal(`
                    <h2>NEW ROLE</h2>
                    <form id="addRoleForm">
                        <div class="form-group">
                            <label>IDENTIFIER</label>
                            <input type="text" name="name" required placeholder="ROLE_NAME">
                        </div>
                        <div class="form-group">
                            <label>${this.data.terminology.responsibilities} (one per line)</label>
                            <textarea name="responsibilities" required placeholder="Define responsibilities..."></textarea>
                        </div>
                        <div class="form-group">
                            <label>${this.data.terminology.ownership} (one per line)</label>
                            <textarea name="ownership" required placeholder="Define ownership domains..."></textarea>
                        </div>
                        <div class="button-group">
                            <button type="button" class="btn-secondary" onclick="app.closeModal()">CANCEL</button>
                            <button type="submit">CREATE</button>
                        </div>
                    </form>
                `);
                document.getElementById('addRoleForm').addEventListener('submit', (e) => this.addRole(e));
            },

            addRole(event) {
                event.preventDefault();
                const form = event.target;
                const newRole = {
                    id: Date.now(),
                    name: form.name.value.toUpperCase().replace(/\s+/g, '_'),
                    responsibilities: form.responsibilities.value.split('\n').filter(r => r.trim()),
                    ownership: form.ownership.value.split('\n').filter(o => o.trim())
                };
                this.data.roles.push(newRole);
                this.render();
                this.closeModal();
                this.updateLastSync();
            },

            deleteRole(id) {
                if (confirm('CONFIRM: Permanently revoke this role?')) {
                    this.data.roles = this.data.roles.filter(r => r.id !== id);
                    this.data.permissions = this.data.permissions.filter(p => p.roleId !== id);
                    this.render();
                    this.updateLastSync();
                }
            },

            showAddStandardModal() {
                this.showModal(`
                    <h2>NEW STANDARD</h2>
                    <form id="addStandardForm">
                        <div class="form-group">
                            <label>STANDARD DEFINITION</label>
                            <input type="text" name="standard" required placeholder="Define standard...">
                        </div>
                        <div class="button-group">
                            <button type="button" class="btn-secondary" onclick="app.closeModal()">CANCEL</button>
                            <button type="submit">CREATE</button>
                        </div>
                    </form>
                `);
                document.getElementById('addStandardForm').addEventListener('submit', (e) => this.addStandard(e));
            },

            addStandard(event) {
                event.preventDefault();
                this.data.standards.push(event.target.standard.value);
                this.renderStandards();
                this.closeModal();
                this.updateLastSync();
            },

            deleteStandard(index) {
                if (confirm('CONFIRM: Strike this standard from the record?')) {
                    this.data.standards.splice(index, 1);
                    this.renderStandards();
                    this.updateLastSync();
                }
            },

            showAddPermissionModal() {
                const roleOptions = this.data.roles.map(r => `<option value="${r.id}">${r.name}</option>`).join('');
                this.showModal(`
                    <h2>GRANT PERMISSION</h2>
                    <form id="addPermissionForm">
                        <div class="form-group">
                            <label>${this.data.terminology.roleColumn}</label>
                            <select name="roleId" required>${roleOptions}</select>
                        </div>
                        <div class="form-group">
                            <label>${this.data.terminology.actionColumn}</label>
                            <select name="action" required>
                                <option value="approves">${this.data.terminology.actionTypes.approves}</option>
                                <option value="executes">${this.data.terminology.actionTypes.executes}</option>
                                <option value="communicates">${this.data.terminology.actionTypes.communicates}</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label>${this.data.terminology.taskColumn}</label>
                            <input type="text" name="task" required placeholder="Define task...">
                        </div>
                        <div class="form-group">
                            <label>${this.data.terminology.counterpartColumn}</label>
                            <input type="text" name="counterpart" required placeholder="Target entity...">
                        </div>
                        <div class="form-group">
                            <label>STATUS</label>
                            <select name="status" required>
                                <option value="todo">TO DO</option>
                                <option value="doing">DOING</option>
                                <option value="done">DONE</option>
                            </select>
                        </div>
                        <div class="button-group">
                            <button type="button" class="btn-secondary" onclick="app.closeModal()">CANCEL</button>
                            <button type="submit">GRANT</button>
                        </div>
                    </form>
                `);
                document.getElementById('addPermissionForm').addEventListener('submit', (e) => this.addPermission(e));
            },

            addPermission(event) {
                event.preventDefault();
                const form = event.target;
                const newPermission = {
                    id: Date.now(),
                    roleId: parseInt(form.roleId.value),
                    action: form.action.value,
                    task: form.task.value,
                    counterpart: form.counterpart.value,
                    status: form.status.value,
                    updated: new Date().toISOString().substring(0, 10)
                };
                this.data.permissions.push(newPermission);
                this.renderPermissions();
                this.closeModal();
                this.updateLastSync();
            },

            deletePermission(id) {
                if (confirm('CONFIRM: Revoke this permission?')) {
                    this.data.permissions = this.data.permissions.filter(p => p.id !== id);
                    this.renderPermissions();
                    this.updateLastSync();
                }
            },

            showSettingsModal() {
                const t = this.data.terminology;
                this.showModal(`
                    <h2>SYSTEM CONFIG</h2>
                    <form id="settingsForm">
                        <div class="terminology-grid">
                            <div class="form-group">
                                <label>SYSTEM NAME</label>
                                <input type="text" name="appTitle" value="${t.appTitle}" required>
                            </div>
                            <div class="form-group">
                                <label>ROLES LABEL</label>
                                <input type="text" name="rolesSection" value="${t.rolesSection}" required>
                            </div>
                            <div class="form-group">
                                <label>STANDARDS LABEL</label>
                                <input type="text" name="standardsSection" value="${t.standardsSection}" required>
                            </div>
                            <div class="form-group">
                                <label>PERMISSIONS LABEL</label>
                                <input type="text" name="permissionsSection" value="${t.permissionsSection}" required>
                            </div>
                            <div class="form-group">
                                <label>RESPONSIBILITIES</label>
                                <input type="text" name="responsibilities" value="${t.responsibilities}" required>
                            </div>
                            <div class="form-group">
                                <label>OWNERSHIP</label>
                                <input type="text" name="ownership" value="${t.ownership}" required>
                            </div>
                            <div class="form-group">
                                <label>ROLE COL</label>
                                <input type="text" name="roleColumn" value="${t.roleColumn}" required>
                            </div>
                            <div class="form-group">
                                <label>ACTION COL</label>
                                <input type="text" name="actionColumn" value="${t.actionColumn}" required>
                            </div>
                            <div class="form-group">
                                <label>TASK COL</label>
                                <input type="text" name="taskColumn" value="${t.taskColumn}" required>
                            </div>
                            <div class="form-group">
                                <label>TARGET COL</label>
                                <input type="text" name="counterpartColumn" value="${t.counterpartColumn}" required>
                            </div>
                            <div class="form-group">
                                <label>ACTION: APPROVES</label>
                                <input type="text" name="actionApproves" value="${t.actionTypes.approves}" required>
                            </div>
                            <div class="form-group">
                                <label>ACTION: EXECUTES</label>
                                <input type="text" name="actionExecutes" value="${t.actionTypes.executes}" required>
                            </div>
                            <div class="form-group">
                                <label>ACTION: NOTIFIES</label>
                                <input type="text" name="actionCommunicates" value="${t.actionTypes.communicates}" required>
                            </div>
                        </div>
                        <div class="button-group">
                            <button type="button" class="btn-secondary" onclick="app.resetTerminology()">RESET TO THEME DEFAULTS</button>
                            <button type="button" class="btn-secondary" onclick="app.importData()">IMPORT</button>
                            <button type="button" class="btn-secondary" onclick="app.closeModal()">CANCEL</button>
                            <button type="submit">APPLY CONFIG</button>
                        </div>
                    </form>
                `);
                document.getElementById('settingsForm').addEventListener('submit', (e) => this.saveTerminology(e));
            },

            saveTerminology(event) {
                event.preventDefault();
                const form = event.target;
                this.data.terminology = {
                    appTitle: form.appTitle.value,
                    rolesSection: form.rolesSection.value,
                    standardsSection: form.standardsSection.value,
                    permissionsSection: form.permissionsSection.value,
                    responsibilities: form.responsibilities.value,
                    ownership: form.ownership.value,
                    roleColumn: form.roleColumn.value,
                    actionColumn: form.actionColumn.value,
                    taskColumn: form.taskColumn.value,
                    counterpartColumn: form.counterpartColumn.value,
                    actionTypes: {
                        approves: form.actionApproves.value,
                        executes: form.actionExecutes.value,
                        communicates: form.actionCommunicates.value
                    }
                };
                this.render();
                this.closeModal();
                this.updateLastSync();
            },

            resetTerminology() {
                if (confirm('Reset all terminology to theme defaults?')) {
                    const theme = this.themes[this.data.currentTheme];
                    this.data.terminology = {...this.data.terminology, ...theme.terminology};
                    this.render();
                    this.showSettingsModal();
                }
            },

            exportData() {
                const exportData = {
                    metadata: {
                        version: "2.0.25",
                        exported: new Date().toISOString(),
                        theme: this.data.currentTheme
                    },
                    terminology: this.data.terminology,
                    roles: this.data.roles,
                    standards: this.data.standards,
                    permissions: this.data.permissions
                };
                const dataStr = JSON.stringify(exportData, null, 2);
                const dataBlob = new Blob([dataStr], {type: 'application/json'});
                const url = URL.createObjectURL(dataBlob);
                const link = document.createElement('a');
                link.href = url;
                link.download = `team-ops-export-${new Date().toISOString().substring(0, 10)}.json`;
                link.click();
                URL.revokeObjectURL(url);
            },

            importData() {
                const input = document.createElement('input');
                input.type = 'file';
                input.accept = '.json';
                input.onchange = (e) => {
                    const file = e.target.files[0];
                    const reader = new FileReader();
                    reader.onload = (event) => {
                        try {
                            const importedData = JSON.parse(event.target.result);
                            // Apply theme if included
                            if (importedData.metadata && importedData.metadata.theme) {
                                this.setTheme(importedData.metadata.theme);
                            }
                            this.data.terminology = importedData.terminology || this.data.terminology;
                            this.data.roles = importedData.roles || [];
                            this.data.standards = importedData.standards || [];
                            this.data.permissions = importedData.permissions || [];
                            this.render();
                            this.closeModal();
                            this.updateLastSync();
                        } catch (error) {
                            alert('Import failed: Invalid file format');
                        }
                    };
                    reader.readAsText(file);
                };
                input.click();
            }
        };

        // Close modal when clicking outside
        document.getElementById('modal').addEventListener('click', (e) => {
            if (e.target.id === 'modal') {
                app.closeModal();
            }
        });

        // Close theme menu when clicking outside
        document.addEventListener('click', (e) => {
            if (!e.target.closest('.theme-switcher')) {
                app.closeThemeMenu();
            }
        });

        // Initialize app
        app.init();
    </script>
</body>
</html>
